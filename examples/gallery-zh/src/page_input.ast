// page_input.ast — Gallery 输入页（APP）：文本框/下拉/开关/复选/滑杆。
// 下拉状态在 Select 类里（src/select.ast，全局 g_lang_select）；
// 写回与同步顺序见 page_input。
外部("aui_scroll") 方法 滚动(键: 整数): 整数
外部("aui_weight") 方法 权重(宽: 整数): 整数
外部("aui_column") 方法 列(键: 整数): 整数
外部("aui_row") 方法 行(键: 整数): 整数
外部("aui_pad") 方法 边距(尺寸: 整数): 整数
外部("aui_gap") 方法 间距(尺寸: 整数): 整数
外部("aui_label") 方法 标签(键: 整数, 文本: 指针): 整数
外部("aui_text_field") 方法 文本框(键: 整数, 提示: 指针): 整数
外部("aui_text_value") 方法 文本取值(键: 整数): 指针
外部("aui_focus_get") 方法 焦点取值(): 整数
外部("aui_button") 方法 按钮(键: 整数, 文本: 指针, 回调: 方法(指针): 整数, 用户: 指针): 整数
外部("aui_switch") 方法 开关(键: 整数, 开: 整数, 回调: 方法(指针): 整数, 用户: 指针): 整数
外部("aui_checkbox") 方法 复选框(键: 整数, 文本: 指针, 选中: 整数, 回调: 方法(指针): 整数, 用户: 指针): 整数
外部("aui_slider") 方法 滑杆(键: 整数, 值: 整数, 步长: 整数, 回调: 方法(指针): 整数, 用户: 指针): 整数
外部("aui_slider_value") 方法 滑杆取值(键: 整数): 整数
外部("aui_progress") 方法 进度条(键: 整数, 值: 整数): 整数
外部("aui_keyboard") 方法 键盘(目标键: 整数): 整数
外部("aui_text_clear") 方法 清空文本(键: 整数): 整数
外部("aui_focus") 方法 聚焦(键: 整数): 整数
外部("aui_invalidate") 方法 刷新(): 整数
外部("aui_end") 方法 结束节点(): 整数
外部("aui_mount") 方法 挂载(规格: 视图, 用户: 指针): 整数
方法 on_clear(用户: 指针): 整数
    清空文本(110)
    返回 刷新()
结束 方法
方法 on_focus(用户: 指针): 整数
    聚焦(110)
    返回 刷新()
结束 方法
方法 on_notify(用户: 指针): 整数
    变量 s: 指针<应用> = 用户
    s.提醒 = 1 - s.提醒
    返回 刷新()
结束 方法
方法 on_promo(用户: 指针): 整数
    变量 s: 指针<应用> = 用户
    s.推广 = 1 - s.推广
    返回 刷新()
结束 方法
方法 on_slider(用户: 指针): 整数
    变量 s: 指针<应用> = 用户
    s.滑杆 = 滑杆取值(160)
    返回 刷新()
结束 方法
方法 page_input(s: 指针<应用>, 用户: 指针): 整数
    滚动(1000)
    权重(1)
    列(1001)
    边距(20)
    间距(12)
    标签(101, 指针("文本框 + 下拉"))
    g_text_field.initialize(110, 指针("点按输入…"))
    挂载(g_text_field.build(用户), 用户)
    如果 焦点取值() == 0
        标签(111, 指针("实时值"))
        行(112)
        边距(12)
        标签(113, 文本取值(110))
        权重(1)
        结束节点()
    结束 如果
    行(114)
    间距(8)
    按钮(115, 指针("清除"), on_clear, 用户)
    按钮(116, 指针("聚焦"), on_focus, 用户)
    结束节点()
    标签(120, 指针("语言"))
    g_lang_select.initialize(130, 指针("选择语言"))
    s.语言 = g_lang_select.value()
    g_lang_select.sync(s.语言)
    挂载(g_lang_select.build(用户, 指针("英语"), 指针("德语"), 指针("中文")), 用户)
    行(140)
    间距(8)
    标签(141, 指针("提醒"))
    权重(1)
    开关(143, s.提醒, on_notify, 用户)
    结束节点()
    复选框(150, 指针("推广"), s.推广, on_promo, 用户)
    标签(155, 指针("音量"))
    滑杆(160, s.滑杆, 10, on_slider, 用户)
    进度条(170, s.滑杆)
    结束节点()
    结束节点()
    如果 焦点取值() != 0
        键盘(110)
    结束 如果
    返回 0
结束 方法
