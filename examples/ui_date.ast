// ui_date.ast — v1.28.0 日期选择示例：日历卡片 + 受控日期回显。
//
// 日期选择器是单个叶子控件：内部维护“日网格 / 年网格”两种视图和当前
// 显示月份，选中日期由应用持有（s.y/s.m/s.d）。点某天后库只回调一次，
// 应用在回调里用 aui_date_selected(30, out) 读取新值并重建页面；翻月、
// 翻 20 年、切换标题都不回调。标题中间可点，20 年一页的年网格里选年；
// 左右箭头在日视图翻月、年视图翻页。min/max 是闭区间，本例限定
// 2024-01-01..2027-12-31，越界日期会被置灰，箭头到边界停住。

include "../src/aui.ast";

let g_font: ptr = 0; // W4: .auf removed (no font files in repo; runtime adapter, see font_runtime.ast)

struct Demo {
    y: i32,
    m: i32,
    d: i32,
    dark: i32,
    calls: i32
}

let g_demo: Demo = Demo { 2026, 10, 15, 0, 0 };

// 日期回显缓冲（"2026-10-15"）。标签命令只存指针，所以用全局稳定缓冲。
let g_text: u8[16] = 0;

fn put2(p: ptr, off: i32, v: i32) -> i32 {
    let vv: i32 = v;
    if (vv < 0) { vv = 0; }
    let hi: i32 = vv / 10;
    let lo: i32 = vv - hi * 10;
    let w1: i32 = store_u8(p + off, 48 + hi);
    let w2: i32 = store_u8(p + off + 1, 48 + lo);
    return 2;
}

fn put4(p: ptr, off: i32, v: i32) -> i32 {
    let vv: i32 = v;
    if (vv < 0) { vv = 0; }
    let div: i32 = 1000;
    let k: i32 = 0;
    while (div > 0) {
        let q: i32 = vv / div;
        let w: i32 = store_u8(p + off + k, 48 + q);
        vv = vv - q * div;
        div = div / 10;
        k = k + 1;
    }
    return 4;
}

// "YYYY-MM-DD" 写进 g_text。
fn fmt_date(y: i32, m: i32, d: i32) -> i32 {
    let p: ptr = g_text;
    let off: i32 = 0;
    off = off + put4(p, off, y);
    let w1: i32 = store_u8(p + off, 45);
    off = off + 1;
    off = off + put2(p, off, m);
    let w2: i32 = store_u8(p + off, 45);
    off = off + 1;
    off = off + put2(p, off, d);
    let w3: i32 = store_u8(p + off, 0);
    return off;
}

fn on_dark(user: ptr) -> i32 {
    let s: ptr<Demo> = user;
    s.dark = 1 - s.dark;
    aui_set_dark(s.dark);
    aui_invalidate();
    return 0;
}

fn on_pick(user: ptr) -> i32 {
    let s: ptr<Demo> = user;
    let out: i32[3] = 0;
    if (aui_date_selected(30, out) == 0) {
        s.y = out[0];
        s.m = out[1];
        s.d = out[2];
    }
    s.calls = s.calls + 1;
    aui_state_set(900, s.calls);
    aui_state_set(901, s.y * 10000 + s.m * 100 + s.d);
    aui_invalidate();
    return 0;
}

fn build(user: ptr) -> i32 {
    let s: ptr<Demo> = user;
    aui_root();
    aui_column(1);
    aui_weight(1);
    aui_pad(16);
    aui_gap(10);

    aui_row(2);
    aui_gap(12);
    aui_label(3, "AsterUI Date");
    aui_weight(1);
    aui_switch(25, s.dark, on_dark, user);
    aui_end();

    aui_label(4, "v1.28.0 date picker");

    aui_column(5);
    aui_bg(aui_theme_color(AUI_COLOR_SURFACE));
    aui_radius(8);
    aui_pad(12);
    aui_gap(8);

    aui_label(6, "Travel date");

    aui_date_picker(30, s.y, s.m, s.d, on_pick, user);
    aui_date_min(2024, 1, 1);
    aui_date_max(2027, 12, 31);

    let fl: i32 = fmt_date(s.y, s.m, s.d);
    aui_row(7);
    aui_gap(8);
    aui_label(8, "Selected");
    aui_label(9, g_text);
    aui_end();

    aui_end();   // card

    aui_label(10, "Arrows: month. Title: years.");
    aui_align(3);

    aui_end();   // root column
    return 0;
}

fn app_init(user: ptr) -> i32 {
    aui_set_font(g_font, 1);
    return 0;
}

fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32 {
    return aui_android_attach(activity, saved, savedSize,
                              build, &g_demo, app_init, 0);
}
