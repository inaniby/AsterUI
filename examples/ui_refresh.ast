// ui_refresh.ast — v1.30 下拉刷新示例：可滚动的条目列表 + 受控刷新计数。
//
// 把列表放进 aui_refresh_box：内容在顶部时继续下拖会产生阻尼位移，
// 松手超过 68 dp 调用一次 on_refresh。示例不做网络请求，只用 700 ms
// 的反馈窗口展示指示圈旋转，然后自动收起。深色开关和行点击计数
// 分别写入应用状态 900 / 901，方便假宿主断言。

include "../src/aui.ast";

let g_font: ptr = 0; // W4: .auf removed (no font files in repo; runtime adapter, see font_runtime.ast)

struct Demo {
    calls: i32,
    taps: i32,
    dark: i32
}

let g_demo: Demo = Demo { 0, 0, 0 };

fn on_refresh(user: ptr) : i32 {
    let s: ptr<Demo> = user;
    s.calls = s.calls + 1;
    aui_state_set(900, s.calls);
    aui_invalidate();
    return 0;
}

fn on_item(user: ptr) : i32 {
    let s: ptr<Demo> = user;
    s.taps = s.taps + 1;
    aui_state_set(901, s.taps);
    aui_invalidate();
    return 0;
}

fn on_dark(user: ptr) : i32 {
    let s: ptr<Demo> = user;
    s.dark = 1 - s.dark;
    aui_set_dark(s.dark);
    aui_invalidate();
    return 0;
}

fn build(user: ptr) : i32 {
    let s: ptr<Demo> = user;
    aui_root();
    aui_column(1);
    aui_weight(1);
    aui_pad(16);
    aui_gap(8);

    aui_row(2);
    aui_gap(12);
    aui_label(3, "AsterUI Refresh");
    aui_spacer(4, 0);
    aui_weight(1);
    aui_switch(25, s.dark, on_dark, user);
    aui_end();

    aui_row(5);
    aui_gap(8);
    aui_label(6, "Refreshes");
    aui_text_i32(7, s.calls);
    aui_spacer(8, 0);
    aui_weight(1);
    aui_label(9, "Clicks");
    aui_text_i32(10, s.taps);
    aui_end();

    // 刷新容器：唯一的子节点是内容列，行数超过视口即可滚动。
    // refreshing 由应用持有；本例回调后保持 0，靠 700 ms 反馈窗口收尾。
    aui_refresh_box(30, 0, on_refresh, user);
    aui_weight(1);
    aui_column(40);
    aui_pad(0);
    aui_gap(6);
    let i: i32 = 0;
    while (i < 24) {
        aui_button(100 + i, "Row item - tap to count", on_item, user);
        aui_align(3);
        i = i + 1;
    }
    aui_end();
    aui_end();

    aui_label(11, "Pull down to refresh");
    aui_align(1);

    aui_end();
    return 0;
}

fn app_init(user: ptr) : i32 {
    aui_set_font(g_font, 1);
    return 0;
}

fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) : i32 {
    return aui_android_attach(activity, saved, savedSize,
                              build, &g_demo, app_init, 0);
}
