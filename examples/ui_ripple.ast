// ui_ripple.ast — v1.48 按压水波纹（Indication）示例。
//
// 对照 HuxerUI indication.h：开启后按住列表行或按钮，从触点扩散一圈主题
// 主色的状态层（12% alpha，320 ms），松手后 220 ms 淡出。默认开启；点
// “Toggle” 按钮可关闭/重新开启，关闭时立即清除当前波纹。点行会写下标，
// 点按钮会累加计数，状态同时写进 aui_state_set，方便假宿主断言。

include "../src/aui.ast";

let g_font: ptr = 0; // W4: .auf removed (no font files in repo; runtime adapter, see font_runtime.ast)

let COUNT: i32 = 20;
let ROWDP: i32 = 72;

struct Demo {
    on: i32,
    sel: i32,
    taps: i32
}

let g_demo: Demo = Demo { 1, -1, 0 };

fn on_row(user: ptr) -> i32 {
    let d: ptr<Demo> = user;
    d.sel = aui_vlist_tap_index();
    aui_state_set(971, d.sel);
    aui_invalidate();
    return 0;
}

fn on_tap(user: ptr) -> i32 {
    let d: ptr<Demo> = user;
    d.taps = d.taps + 1;
    aui_state_set(972, d.taps);
    aui_invalidate();
    return 0;
}

fn on_toggle(user: ptr) -> i32 {
    let d: ptr<Demo> = user;
    d.on = 1 - d.on;
    aui_ripple(d.on);
    aui_state_set(973, d.on);
    aui_invalidate();
    return 0;
}

fn bind_rows(user: ptr) -> i32 {
    let d: ptr<Demo> = user;
    let i: i32 = aui_vlist_first();
    let e: i32 = aui_vlist_last();
    while (i <= e) {
        aui_vlist_row(i);
        aui_bg(aui_theme_color(AUI_COLOR_SURFACE));
        aui_pad(16);
        aui_gap(0);
        aui_label(1000 + i, "Row");
        aui_text_i32(0, i);
        aui_end();
        i = i + 1;
    }
    return 0;
}

fn build(user: ptr) -> i32 {
    let d: ptr<Demo> = user;
    aui_root();
    aui_column(1);
    aui_weight(1);
    aui_pad(0);
    aui_gap(8);

    aui_row(2);
    aui_pad(16);
    aui_gap(8);
    aui_label(3, "Indication");
    aui_spacer(4, 1);
    aui_weight(1);
    aui_label(5, "Press and hold");
    aui_end();

    aui_vlist(10, COUNT, ROWDP, bind_rows, on_row, user);
    aui_weight(1);
    aui_pad(0);
    aui_end();

    aui_row(6);
    aui_pad(16);
    aui_gap(8);
    aui_label(7, "Taps:");
    aui_text_i32(8, d.taps);
    aui_spacer(0, 1);
    aui_label(9, "Rows:");
    aui_text_i32(11, COUNT);
    aui_end();

    aui_row(12);
    aui_pad(16);
    aui_gap(12);
    aui_button(20, "Tap", on_tap, user);
    aui_button(21, "Toggle", on_toggle, user);
    aui_end();

    aui_end();
    return 0;
}

fn app_init(user: ptr) -> i32 {
    let d: ptr<Demo> = user;
    aui_set_font(g_font, 1);
    aui_ripple(d.on);
    aui_state_set(973, d.on);
    return 0;
}

fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32 {
    return aui_android_attach(activity, saved, savedSize,
                              build, &g_demo, app_init, 0);
}
