// gallery_linux.ast -- Gallery 的 Linux 入口（与 ANativeActivity_onCreate 平行）。
//
// v2.20.0 (M4)：main(argc, argv) → gallery_headless_init() 注册
// build/user → app_init(user) → fbdev_run(argc, argv)。
// extern 函数不可取地址，所以 build/app_init 不跨文件传，只在本文件
// 内调 gallery_headless_init（它在 ui_gallery.ast 内取 build 地址）。

include "../src/aui.ast";

extern fn gallery_headless_init() : i32;
extern fn gallery_user() : ptr;
extern fn gallery_set_tab(t: i32) : i32;
extern fn app_init(user: ptr) : i32;
extern fn fbdev_run(argc: i32, argv: ptr) : i32;

// 脚本 "tab n" 的落点：Gallery 切标签。
fn fb_on_tab(n: i32) : i32 {
    return gallery_set_tab(n);
}

fn main(argc: i32, argv: ptr) : i32 {
    let gi: i32 = gallery_headless_init();
    let u: ptr = gallery_user();
    let ai: i32 = app_init(u);
    return fbdev_run(argc, argv);
}
