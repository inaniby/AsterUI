}

fn tab_varlist(s: ptr<Gallery>, user: ptr) -> i32 {
    if (g_vl_n == 0) {
        let i: i32 = 0;
        while (i < 120) {
            g_vl_ids[i] = i;
            i = i + 1;
        }
        g_vl_n = 120;
        g_vl_next = 120;
    }
    aui_column(2001);
    aui_weight(1);
    aui_pad(10);
    aui_gap(8);
    aui_row(2002);
    aui_gap(8);
    aui_button(2010, "跳到 #80", on_vl_jump, user);
    aui_button(2011, "顶部插入", on_vl_insert, user);
    aui_button(2012, "删除首条", on_vl_delete, user);
    aui_end();
    // 状态行读的是上一拍的统计（首帧列表节点尚未建好，读到 0；下一拍
    // 起就是实测值——窗口校验会在首帧后触发重建）。
    let st: i32 = aui_debug_vlist_var_stats(2000, g_vl_st);
    let r: i32 = info_row(2013, "条数", g_vl_n);
    let r2: i32 = info_row(2014, "总高 px", g_vl_st[0]);
    let r3: i32 = info_row(2015, "已测量", g_vl_st[1]);
    let r4: i32 = info_row(2016, "选中行", s.vl_sel);
    aui_vlist_var(2000, g_vl_n, 48, bind_vl, on_vl_tap, user);
    aui_weight(1);
    aui_pad(0);
    // v2.11：列表是 push_container，必须在这里闭合；否则后面的行会
    // 嵌进列表内、被按 aux2=0 排到与第 0 行相同的位置上（与首行重叠）。
    aui_end();
    aui_row(2030);
    aui_gap(8);
    aui_label(2031, "Badge");
    aui_badge(2032, "NEW", 0xFFFFFFFF, 0xFF3366CC);
    aui_badge_count(2033, 3);
    aui_badge_count(2034, 128);
    aui_badge_count(2035, 0);
    aui_badge_dot(2036, 0xFFE53935);
    aui_end();
    return 0;
}

// ---- v2.17 Table tab: virtualized table (aui_vtable) ----
// Mirrors the HuxerUI virtual_table example: 10000 rows x 100 cols,
// "R{row} · C{col}" cells with (row+col) parity backgrounds, header
// row with column titles, first column narrower (64dp), second wider
// (200dp), rest default 128dp. Tap a cell to select it (status rows
// below show R/C; the selected cell gets the tint background).
fn bind_vt(user: ptr) -> i32 {
    let fc: i32 = aui_vtable_first_col();
    let lc: i32 = aui_vtable_last_col();
    let c: i32 = fc;
    while (c <= lc) {
        aui_vtable_header(c);
        aui_bg(0xFF9E9E9E);
        aui_pad(4);
        aui_row(0);
        aui_label(0, "C");
        aui_text_i32(0, c);
        aui_end();
        aui_end();
        c = c + 1;
    }
    let fr: i32 = aui_vtable_first_row();
    let lr: i32 = aui_vtable_last_row();
    let r: i32 = fr;
    while (r <= lr) {
        let cc: i32 = fc;
        while (cc <= lc) {
            aui_vtable_cell(r, cc);
            if (r == g_gal.vt_row && cc == g_gal.vt_col) {
                aui_bg(aui_theme_color(AUI_COLOR_TINT));
            } else if ((r + cc) % 2 == 0) {
                aui_bg(0xFFF0F0F0);
            }
            aui_pad(4);
            aui_row(0);
            aui_label(0, "R");
            aui_text_i32(0, r);
            aui_label(0, " · C");
            aui_text_i32(0, cc);
            aui_end();
            aui_end();
            cc = cc + 1;
        }
        r = r + 1;
    }
    return 0;
}

fn on_vt_tap(user: ptr) -> i32 {
    let s: ptr<Gallery> = user;
    s.vt_row = aui_vtable_tap_row();
    s.vt_col = aui_vtable_tap_col();
    aui_invalidate();
    return 0;
}

fn on_vt_jump(user: ptr) -> i32 {
    let r: i32 = aui_vtable_scroll_to(3000, 5000, 50, 0);
    return 0;
}

fn on_vt_home(user: ptr) -> i32 {
    let r: i32 = aui_vtable_scroll_to(3000, 0, 0, 0);
    return 0;
}

fn tab_vtable(s: ptr<Gallery>, user: ptr) -> i32 {
    aui_column(3001);
    aui_weight(1);
    aui_pad(10);
    aui_gap(8);
    aui_row(3002);
    aui_gap(8);
    aui_button(3010, "Jump R5000 C50", on_vt_jump, user);
    aui_button(3011, "Top-left", on_vt_home, user);
    aui_end();
    let r: i32 = info_row(3013, "Rows", 10000);
    let r2: i32 = info_row(3014, "Cols", 100);
    let r3: i32 = info_row(3015, "Selected row", s.vt_row);
    let r4: i32 = info_row(3016, "Selected col", s.vt_col);
    aui_vtable_col(3000, 0, 64);
    aui_vtable_col(3000, 1, 200);
    aui_vtable(3000, 10000, 100, 32, bind_vt, on_vt_tap, user);
    aui_weight(1);
    aui_pad(0);
    aui_end();
    return 0;
}

// ---- v2.18 Pinch tab: two-finger pinch zooms a Canvas around the focal
// point (aui_pinch). Keys 3100s. Zoom is Q16.16, clamped to 0.25x-4x in
// the callback; the focal point is stored in canvas-local px (window px
// minus the canvas rect, read at callback time). Reset returns to 1.00x,
// centred. One finger still scrolls the page (the pinch only engages
// with two fingers on the canvas).
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;

fn pinch_x(x: i32, fx: i32, z: i32) -> i32 {
    return fx + (x - fx) * z / 65536;
}

fn pinch_draw(user: ptr) -> i32 {
    let s: ptr<Gallery> = user;
    let sz: i32[2] = 0;
    aui_cv_size(sz);
    let w: i32 = sz[0];
    let h: i32 = sz[1];
    let z: i32 = s.pn_zoom;
    let fx: i32 = s.pn_fx;
    let fy: i32 = s.pn_fy;
    if (fx < 0) { fx = w / 2; }
    if (fy < 0) { fy = h / 2; }
    let bg: i32 = aui_cv_rect(0, 0, w, h, 0xFFF6F6F8, 0);
    // Grid every 40 px (base space), transformed about the focal point.
    let gx: i32 = 0;
    while (gx <= w) {
        let x1: i32 = pinch_x(gx, fx, z);
        let l1: i32 = aui_cv_line(x1, pinch_x(0, fy, z), x1, pinch_x(h, fy, z), 0xFFE3E3E3, 1);
        gx = gx + 40;
    }
    let gy: i32 = 0;
    while (gy <= h) {
        let y1: i32 = pinch_x(gy, fy, z);
        let l2: i32 = aui_cv_line(pinch_x(0, fx, z), y1, pinch_x(w, fx, z), y1, 0xFFE3E3E3, 1);
        gy = gy + 40;
    }
    // Ring + triangle + rect, all transformed about the focal point.
    let cx: i32 = w / 2;
    let cy: i32 = h / 2;
    let d: i32 = 120 * z / 65536;
    let rg: i32 = aui_cv_ring(pinch_x(cx - 60, fx, z), pinch_x(cy - 60, fy, z), d, 0xFF3A6DF0, 4);
    let tw: i32 = 80 * z / 65536;
    let tr: i32 = aui_cv_tri(pinch_x(cx - 40, fx, z), pinch_x(cy + 40, fy, z), tw, tw, 0xFFE53935, 0);
    let rw: i32 = 60 * z / 65536;
    let rc: i32 = aui_cv_rect(pinch_x(40, fx, z), pinch_x(40, fy, z), rw, rw, 0xFF43A047, 8);
    return 0;
}

// v2.20.3：跨手势累积。框架 aui_pinch_scale() 是每手势累计值
// （Started 时复位到 65536），直接写进已存缩放会在每新手势跳回
// 100%。这里 Started 时记 base = 当前已存缩放，Changed 时已存缩放
// = clamp(base x scale, 0.25x-4x)；Ended/Canceled 时 active 已是 0，
// 已存值不动。Started/Changed 的区分不靠 scale 值（手势中途回到
// 1.00x 时 scale 同样是 65536），靠 pn_in 标志看 active 的 0->1 跃变。
fn on_pn_zoom(user: ptr) -> i32 {
    let s: ptr<Gallery> = user;
    if (aui_pinch_active() == 0) {
        s.pn_in = 0;
        return 0;
    }
    if (s.pn_in == 0) {
        s.pn_base = s.pn_zoom;
        s.pn_in = 1;
    }
    let z: i32 = aui_pinch_scale();
    let nz: i32 = i32((i64(s.pn_base) * i64(z)) / 65536);
    if (nz < 16384) { nz = 16384; }
    if (nz > 262144) { nz = 262144; }
    s.pn_zoom = nz;
    let r: i32[4] = 0;
    if (aui_debug_rect(3100, r) == 0) {
        s.pn_fx = aui_pinch_cx() - r[0];
        s.pn_fy = aui_pinch_cy() - r[1];
    }
    aui_invalidate();
    return 0;
}

fn on_pn_reset(user: ptr) -> i32 {
    let s: ptr<Gallery> = user;
    s.pn_zoom = 65536;
    s.pn_base = 65536;
    s.pn_in = 0;
    s.pn_fx = -1;
    s.pn_fy = -1;
    aui_invalidate();
    return 0;
}

fn tab_pinch(s: ptr<Gallery>, user: ptr) -> i32 {
    aui_scroll(3104);
    aui_weight(1);
    aui_column(3105);
    aui_pad(20);
    aui_gap(12);
    aui_label(3106, "Pinch Zoom");
    aui_label(3107, "Two fingers pinch to zoom the canvas around the focal point. One finger scrolls the page.");
    aui_row(3108);
    aui_gap(8);
    aui_button(3109, "Reset 1.00x", on_pn_reset, user);
    aui_end();
    let r: i32 = info_row(3110, "Zoom %", s.pn_zoom * 100 / 65536);
    aui_column(3120);
    aui_bg(aui_theme_color(AUI_COLOR_SURFACE));
    aui_radius(8);
    aui_pad(16);
    aui_gap(0);
    aui_canvas(3100, 0, CV_H_DP, pinch_draw, user);
    aui_align(3);
    aui_pinch(on_pn_zoom, user);
    aui_end();
    aui_label(3130, "Canvas 280 dp high. Grid 40 px, ring, triangle, rect.");
    aui_end();
    aui_end();
    return 0;
}

// ---- v2.19：语义树导出展示 ----
// 导出缓冲（文件级静态：导出文本的指针必须在回调返回后仍有效）。
let g_sem_buf: u8[16384] = 0;

// ---- v2.19.2：版本号显示缓冲 ----
// System 标签页的版本行写进这里（文件级静态：label 的指针必须在回调
// 返回后仍有效，与 g_sem_buf 同理）。内容由 gallery_ver_text() 每帧
// 从 aui_app_version_name/code 现拼——启动日志行读的是同一份常量，
// 这里不写第二份版本号。
let g_ver_buf: u8[48] = 0;

// 把 NUL 结尾的源串追加到 g_ver_buf[p..]，返回新的 p。
fn ver_cat(src: ptr, p: i32) -> i32 {
    let i: i32 = 0;
    while (load_u8(src + i) != 0) {
        store_u8(g_ver_buf + p, load_u8(src + i));
        p = p + 1;
        i = i + 1;
    }
    return p;
}

// 拼 "Version <name> (code <code>)"，返回长度（不含 NUL）。
fn gallery_ver_text() -> i32 {
    let p: i32 = ver_cat("Version ", 0);
    let nm: ptr = aui_app_version_name();
    if (nm != 0) { p = ver_cat(nm, p); } else { p = ver_cat("?", p); }
    p = ver_cat(" (code ", p);
    let tmp: u8[16] = 0;
    let n: i32 = fmt_i32(tmp, aui_app_version_code());
    let i: i32 = 0;
    while (i < n) {
        store_u8(g_ver_buf + p, load_u8(tmp + i));
        p = p + 1;
        i = i + 1;
    }
    p = ver_cat(")", p);
    store_u8(g_ver_buf + p, 0);
    return p;
}

fn on_sem_refresh(user: ptr) -> i32 {
    let s: ptr<Gallery> = user;
    s.sem_len = aui_sem_export(g_sem_buf, 16384);
    aui_invalidate();
    return 0;
}

fn tab_semantics(s: ptr<Gallery>, user: ptr) -> i32 {
    aui_scroll(3204);
    aui_weight(1);
    aui_column(3205);
    aui_pad(20);
    aui_gap(12);
    aui_label(3206, "Semantics");
    aui_label(3207, "One export of the live tree: role, label, key, bounds. Tap Refresh after layout; the dump below is hidden from the export itself.");
    // 样例控件：显式语义（标题角色、文本与 label 不同的按钮）与默认派生并存。
    aui_label(3216, "Sample controls");
    aui_semantics(AUI_SEM_HEADING, "Sample controls");
    aui_button(3217, "Open", on_noop, user);
    aui_semantics(0, "Open settings");
    aui_row(3218);
    aui_gap(8);
    aui_switch(3219, 1, on_noop, user);
    aui_slider(3220, 500, 10, on_noop, user);
    aui_end();
    aui_row(3230);
    aui_gap(8);
    aui_button(3231, "Refresh export", on_sem_refresh, user);
    aui_end();
    // 字节数读数行：与 info_row 同构，但整行隐藏出导出——它显示的正是
    // 本次导出的长度，留在树里会让导出随自身长度变（自指），二次导出
    // 永远对不上；读数是关于导出的元信息，不是内容，藏起来才对。
    aui_row(3240);
    aui_gap(8);
    aui_label(3241, "Export bytes");
    aui_spacer(3242, 0);
    aui_weight(1);
    aui_text_i32(3243, s.sem_len);
    aui_end();
    aui_sem_hide();
    // 展示区：隐藏容器（自身不进导出，否则每次刷新多出一批行）。
    aui_column(3250);
    aui_gap(2);
    aui_sem_hide();
    if (s.sem_len == 0) {
        aui_label(3251, "Tap Refresh to export the live tree.");
    } else {
        if (s.sem_len < 0) {
            aui_label(3251, "(truncated: buffer 16 KB)");
        }
        // 每行一个 label（key 3260 起，最多 120 行；导出本身不受此限）。
        let p: i32 = 0;
        let start: i32 = 0;
        let shown: i32 = 0;
        while (shown < 120 && p < 16384) {
            let c: i32 = load_u8(g_sem_buf + p);
            if (c == 0) { break; }
            if (c == 10) {
                let r2: i32 = aui_label_n(3260 + shown, g_sem_buf + start, p - start);
                shown = shown + 1;
                p = p + 1;
                start = p;
            } else {
                p = p + 1;
            }
        }
    }
    aui_end();
    aui_end();
    aui_end();
    return 0;
}

fn build(user: ptr) -> i32 {
    // v2.20.3：应用版本——全应用唯一定义处（须与 aster.proj 的
    // version-name 2.20.3 / version-code 45 一致；gallery_smoke 断言
    // System 标签页的显示行，[27/27] 核对 APK 清单）。启动日志行与
    // System 标签页都读这里登记的值。登记点放 build：app_init 存而
    // 不调，build 是设备与 headless 两条路径上首帧前必跑的钩子。
    let v0: i32 = aui_set_app_version("2.20.3", 45);
    let s: ptr<Gallery> = user;
    aui_root();
    aui_column(1);
    aui_weight(1);
    aui_top_bar(5, "AsterUI Gallery", AUI_ICON_ARROW_LEFT, on_top_back, user);
    aui_end();
    aui_tabs(10, s.tab, on_tab, user);
    aui_tab(11, "Input");
    aui_tab(12, "Overlay");
    aui_tab(13, "Scroll");
    aui_tab(14, "Nav");
    aui_tab(15, "System");
    aui_tab(16, "Fonts");
    aui_tab(17, "Canvas");
    aui_tab(18, "VarList");
    aui_tab(19, "Split");
    aui_tab(20, "Theme");
    aui_tab(21, "Anim");
    aui_tab(22, "Table");
    aui_tab(23, "Pinch");
    aui_tab(24, "Semantics");
    aui_end();
    if (s.tab == 0) {
        let r: i32 = tab_input(s, user);
    } else if (s.tab == 1) {
        let r: i32 = tab_overlay(s, user);
    } else if (s.tab == 2) {
        let r: i32 = tab_scroll(s, user);
    } else if (s.tab == 3) {
        let r: i32 = tab_nav(s, user);
    } else if (s.tab == 4) {
        let r: i32 = tab_system(s, user);
    } else if (s.tab == 5) {
        let r: i32 = tab_fonts(s, user);
    } else if (s.tab == 6) {
        let r: i32 = tab_canvas(s, user);
    } else if (s.tab == 7) {
        let r: i32 = tab_varlist(s, user);
    } else if (s.tab == 8) {
        let r: i32 = tab_split(s, user);
    } else if (s.tab == 9) {
        let r: i32 = tab_theme(s, user);
    } else if (s.tab == 10) {
        let r: i32 = tab_anim(s, user);
    } else if (s.tab == 11) {
        let r: i32 = tab_vtable(s, user);
    } else if (s.tab == 12) {
        let r: i32 = tab_pinch(s, user);
    } else {
        let r: i32 = tab_semantics(s, user);
    }
    aui_end();
    if (s.dlg_open != 0) {
        aui_dialog(250, s.dlg_open, on_dlg_dismiss, user);
        aui_label(251, "Delete this draft?");
        aui_label(252, "This draft will be removed from the list and cannot be restored.");
        aui_align(3);
        aui_row(255);
        aui_gap(12);
        aui_button(256, "Cancel", on_dlg_cancel, user);
        aui_weight(1);
        aui_button(257, "Delete", on_dlg_delete, user);
        aui_weight(1);
        aui_end();
        aui_end();
    }
    return 0;
}

fn app_init(user: ptr) -> i32 {
    aui_set_font(0, 1);
    aui_set_fallback_font(0, 1);
    aui_nav_transition(240);
    return 0;
}

fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32 {
    return aui_android_attach(activity, saved, savedSize,
                              build, &g_gal, app_init, 0);
}

// ---- Headless-test diagnostics (no Android dependency) ----
// The build callback address can only be taken in the object that
// defines it, so the app registers itself for headless tests.
fn gallery_headless_init() -> i32 {
    return aui_headless_init(build, &g_gal);
}

fn gallery_user() -> ptr {
    return &g_gal;
}

fn gallery_set_tab(t: i32) -> i32 {
    g_gal.tab = t;
    aui_invalidate();
    return 0;
}

fn gallery_tab() -> i32 {
    return g_gal.tab;
}

// v2.18: pinch zoom (Q16.16, 65536 = 1.00x) for the smoke test.
fn gallery_pn_zoom() -> i32 {
    return g_gal.pn_zoom;
}

// v2.19: semantic export length in bytes (0 = never exported, -1 = truncated) for the smoke test.
fn gallery_sem_len() -> i32 {
    return g_gal.sem_len;
}

fn gallery_drafts() -> i32 {
    return g_gal.drafts;
}

fn gallery_menu_item() -> i32 {
    return g_gal.menu_item;
}

fn gallery_dialog_last() -> i32 {
    return g_gal.dlg_last;
}

fn gallery_scroll_taps() -> i32 {
    return g_gal.scroll_taps;
}

