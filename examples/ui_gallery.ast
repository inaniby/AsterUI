// v2.15：主题令牌展示（第 10 个标签）。调色板色块、三种排版角色、
// 形状/间距令牌取样、一个局部主题子树（深青卡片）与一个全局兄弟卡。
// 除 LARGE 形状取样（16 dp，构形证明）外，其余卡片都用 SMALL（8 dp），
// 外观与 v2.14 一致。
fn theme_token_name(token: i32) -> ptr {
    if (token == 0) { return "background"; }
    if (token == 1) { return "surface"; }
    if (token == 2) { return "primary"; }
    if (token == 3) { return "primary_dark"; }
    if (token == 4) { return "on_surface"; }
    if (token == 5) { return "on_primary"; }
    if (token == 6) { return "on_surface_variant"; }
    if (token == 7) { return "pressed"; }
    if (token == 8) { return "primary_container"; }
    if (token == 9) { return "scrollbar"; }
    if (token == 10) { return "keyboard_bg"; }
    if (token == 11) { return "system_bar"; }
    if (token == 12) { return "scrim"; }
    if (token == 13) { return "error"; }
    if (token == 14) { return "inverse_surface"; }
    return "inverse_on_surface";
}

// 色块行：48x60 的令牌色块（两空格标签 + 令牌背景）+ 令牌名。
fn swatch_row(key: i32, name: ptr, token: i32) -> i32 {
    aui_row(key);
    aui_gap(8);
    aui_label(key + 1, "  ");
    aui_bg(aui_token_color(token));
    aui_shape_radius(AUI_SHAPE_SMALL);
    aui_label(key + 2, name);
    aui_end();
    return 0;
}

// 间距行：名 + 令牌间距（行内 gap 本身就是该令牌的值）+ 数值。
fn space_row(key: i32, name: ptr, token: i32) -> i32 {
    aui_row(key);
    aui_gap(aui_space(token));
    aui_label(key + 1, name);
    aui_text_i32(key + 2, aui_space(token));
    aui_end();
    return 0;
}

// 形状取样卡：surface 底 + 令牌圆角 + 令牌名。
fn shape_card(key: i32, name: ptr, token: i32) -> i32 {
    aui_column(key);
    aui_bg(aui_token_color(AUI_TOK_SURFACE));
    aui_shape_radius(token);
    aui_pad(8);
    aui_label(key + 1, name);
    aui_end();
    return 0;
}

fn tab_theme(s: ptr<Gallery>, user: ptr) -> i32 {
    aui_scroll(2200);
    aui_weight(1);
    aui_column(2201);
    aui_pad(20);
    aui_gap(12);
    aui_label(2202, "Theme tokens");
    aui_text_role(AUI_ROLE_TITLE);
    // ---- 颜色令牌 ----
    aui_label(2203, "Colors");
    aui_text_role(AUI_ROLE_LABEL);
    let i: i32 = 0;
    while (i < 16) {
        let rk: i32 = 2210 + i * 3;
        let sr: i32 = swatch_row(rk, theme_token_name(i), i);
        i = i + 1;
    }
    // ---- 排版角色 ----
    aui_label(2258, "Type roles");
    aui_text_role(AUI_ROLE_LABEL);
    aui_label(2260, "Title 64 px");
    aui_text_role(AUI_ROLE_TITLE);
    aui_label(2261, "Body 48 px");
    aui_label(2262, "Label 48 px bold");
    aui_text_role(AUI_ROLE_LABEL);
    aui_button(2263, "Title button", on_noop, user);
    aui_text_role(AUI_ROLE_TITLE);
    aui_button(2264, "Body button", on_noop, user);
    // ---- 形状令牌 ----
    aui_label(2265, "Shapes");
    aui_text_role(AUI_ROLE_LABEL);
    let sc0: i32 = shape_card(2270, "XS 4 dp", AUI_SHAPE_XS);
    let sc1: i32 = shape_card(2271, "SMALL 8 dp", AUI_SHAPE_SMALL);
    let sc2: i32 = shape_card(2272, "MEDIUM 12 dp", AUI_SHAPE_MEDIUM);
    // LARGE（16 dp）是本页唯一的非默认圆角：构形证明。
    let sc3: i32 = shape_card(2273, "LARGE 16 dp", AUI_SHAPE_LARGE);
    let sc4: i32 = shape_card(2274, "XL 28 dp", AUI_SHAPE_XL);
    let sc5: i32 = shape_card(2275, "FULL capsule", AUI_SHAPE_FULL);
    // ---- 间距令牌 ----
    aui_label(2276, "Spacing");
    aui_text_role(AUI_ROLE_LABEL);
    let sp0: i32 = space_row(2280, "XS", AUI_SPACE_XS);
    let sp1: i32 = space_row(2283, "SM", AUI_SPACE_SM);
    let sp2: i32 = space_row(2286, "MD", AUI_SPACE_MD);
    let sp3: i32 = space_row(2289, "LG", AUI_SPACE_LG);
    let sp4: i32 = space_row(2292, "XL", AUI_SPACE_XL);
    // ---- 局部主题：深青子树（颜色 + 形状都被覆盖）----
    aui_label(2300, "Nested theme");
    aui_text_role(AUI_ROLE_LABEL);
    aui_theme_begin(2310);
    aui_theme_set(AUI_TOK_SURFACE, 0xFF00695C);
    aui_theme_set(AUI_TOK_PRIMARY, 0xFF00897B);
    aui_theme_set(AUI_TOK_ON_SURFACE, 0xFFFFFFFF);
    aui_theme_shape(AUI_SHAPE_SMALL, 16);
    aui_column(2311);
    aui_bg(aui_token_color(AUI_TOK_SURFACE));
    aui_shape_radius(AUI_SHAPE_SMALL);
    aui_pad(12);
    aui_label(2312, "Nested: teal surface, teal button, 16 dp");
    aui_button(2313, "Nested button", on_noop, user);
    aui_end();
    aui_end();
    // 全局兄弟卡：同样结构，走全局令牌（surface + 8 dp）。
    aui_column(2315);
    aui_bg(aui_token_color(AUI_TOK_SURFACE));
    aui_shape_radius(AUI_SHAPE_SMALL);
    aui_pad(12);
    aui_label(2316, "Sibling: global surface, 8 dp");
    aui_end();
    aui_end();
    return 0;
}

// v2.16：动画演示回调与第 11 个标签。弹簧卡片（点按在 1.0x 与 1.15x
// 间切换）、关键帧脉冲（TX 0→120dp，600ms，无限往返）、缩放滑杆
// （0.5x..1.5x，预览卡片弹簧跟随）、补间滑入重播、减弱动效开关。
// 动画只影响绘制，布局矩形与命中测试不变。
let g_an_kf_frac: i32[3] = 0;
let g_an_kf_prog: i32[3] = 0;
let g_an_kf_curve: i32[3] = 0;

fn on_an_spring(user: ptr) -> i32 {
    let s: ptr<Gallery> = user;
    s.an_spring = 1 - s.an_spring;
    let target: i32 = 65536;
    if (s.an_spring != 0) { target = 75366; }
    let r: i32 = aui_anim_spring(2410, AUI_ANIM_SCALE, target, 320, 820);
    aui_invalidate();
    return 0;
}

fn on_an_pulse_start(user: ptr) -> i32 {
    let s: ptr<Gallery> = user;
    s.an_pulse = 1;
    g_an_kf_frac[0] = 0;
    g_an_kf_frac[1] = 700;
    g_an_kf_frac[2] = 1000;
    g_an_kf_prog[0] = 0;
    g_an_kf_prog[1] = 900;
    g_an_kf_prog[2] = 1000;
    g_an_kf_curve[0] = AUI_EASE_OUT;
    g_an_kf_curve[1] = AUI_EASE_IN_OUT;
    g_an_kf_curve[2] = AUI_EASE_LINEAR;
    let r: i32 = aui_anim_keyframe(2420, AUI_ANIM_TX, 0, 120, 600, 3,
                                   g_an_kf_frac, g_an_kf_prog, g_an_kf_curve,
                                   -1, 1);
    aui_invalidate();
    return 0;
}

fn on_an_pulse_stop(user: ptr) -> i32 {
    let s: ptr<Gallery> = user;
    s.an_pulse = 0;
    let r: i32 = aui_anim_reset(2420, AUI_ANIM_TX);
    aui_invalidate();
    return 0;
}

fn on_an_scale(user: ptr) -> i32 {
    let s: ptr<Gallery> = user;
    s.an_scale = aui_slider_value(2430);
    // 滑杆 0..1000 → 0.5x..1.5x；弹簧改目标保留速度，拖动跟手。
    let target: i32 = 32768 + s.an_scale * 65536 / 1000;
    let r: i32 = aui_anim_spring(2440, AUI_ANIM_SCALE, target, 320, 820);
    aui_invalidate();
    return 0;
}

fn on_an_replay(user: ptr) -> i32 {
    let r1: i32 = aui_anim(2435, AUI_ANIM_TX, 40, 0, 200, AUI_EASE_OUT);
    let r2: i32 = aui_anim(2435, AUI_ANIM_ALPHA, 0, 255, 200, AUI_EASE_OUT);
    aui_invalidate();
    return 0;
}

fn on_an_rm(user: ptr) -> i32 {
    let s: ptr<Gallery> = user;
    s.an_rm = 1 - s.an_rm;
    let prev: i32 = aui_set_reduced_motion(s.an_rm);
    aui_invalidate();
    return 0;
}

fn tab_anim(s: ptr<Gallery>, user: ptr) -> i32 {
    aui_scroll(2400);
