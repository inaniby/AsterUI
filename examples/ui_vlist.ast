// ui_vlist.ast — v1.45 虚拟列表示例：5000 条数据，只构建可见行。
//
// 对照 HuxerUI VirtualList：固定行高 64 dp，行内容由 on_bind 按
// aui_vlist_first()..aui_vlist_last() 现场生成；滚动、惯性、滚动条和
// 裁剪与 aui_scroll 相同。点行把下标写回应用（选中行铺浅蓝底），
// 同时写入 aui_state_set(970)，方便假宿主断言。

include "../src/aui.ast";

let g_font: ptr = 0; // W4: .auf removed (no font files in repo; runtime adapter, see font_runtime.ast)

let COUNT: i32 = 5000;
let ROW_DP: i32 = 64;

struct Demo {
    sel: i32
}

let g_demo: Demo = Demo { 2 };

fn on_row(user: ptr) -> i32 {
    let d: ptr<Demo> = user;
    d.sel = aui_vlist_tap_index();
    aui_state_set(970, d.sel);
    aui_invalidate();
    return 0;
}

fn bind_rows(user: ptr) -> i32 {
    let d: ptr<Demo> = user;
    let i: i32 = aui_vlist_first();
    let e: i32 = aui_vlist_last();
    while (i <= e) {
        aui_vlist_row(i);
        if (i == d.sel) { aui_bg(0xFFDCE7FF); }
        aui_row(0);
        aui_pad(12);
        aui_gap(12);
        aui_icon(0, AUI_ICON_STAR, 24);
        aui_label(0, "Item");
        aui_text_i32(0, i);
        aui_spacer(0, 1);
        aui_weight(1);
        aui_icon(0, AUI_ICON_CHEVRON_RIGHT, 18);
        aui_end();
        aui_end();
        i = i + 1;
    }
    return 0;
}

fn build(user: ptr) -> i32 {
    let d: ptr<Demo> = user;
    aui_root();
    aui_column(1);
    aui_weight(1);

    aui_row(2);
    aui_pad(16);
    aui_gap(8);
    aui_label(3, "VirtualList");
    aui_spacer(4, 1);
    aui_weight(1);
    aui_label(5, "5000 rows");
    aui_end();

    aui_vlist(10, COUNT, ROW_DP, bind_rows, on_row, user);
    aui_weight(1);
    aui_end();

    aui_row(6);
    aui_pad(16);
    aui_gap(8);
    aui_label(7, "Selected:");
    aui_text_i32(8, d.sel);
    aui_end();

    aui_end();
    return 0;
}

fn app_init(user: ptr) -> i32 {
    aui_set_font(g_font, 1);
    aui_state_set(970, g_demo.sel);
    return 0;
}

fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32 {
    return aui_android_attach(activity, saved, savedSize,
                              build, &g_demo, app_init, 0);
}
