// ui_settings.ast — v1.21 选择控件示例：复选框 / 单选框 / 分段控件 / 滑块。
//
// 状态全部由应用持有（和开关同一套模型）：控件只调回调，应用改完状态后
// aui_invalidate()，下一帧按新状态重建。单选组的互斥也在这里维护。
// 滑块的百分比标签在拖动过程中实时更新：回调里读 aui_slider_value。

include "../aui.ast";

let g_font: ptr = 0; // W4: .auf removed (no font files in repo; runtime adapter, see font_runtime.ast)

struct Settings {
    notify: i32,
    vibrate: i32,
    dark: i32,
    bright: i32,
    volume: i32,
    unit: i32
}

let g_set: Settings = Settings { 1, 1, 0, 500, 700, 0 };

fn on_notify(user: ptr) -> i32 {
    let s: ptr<Settings> = user;
    s.notify = 1 - s.notify;
    aui_invalidate();
    return 0;
}

fn on_vibrate(user: ptr) -> i32 {
    let s: ptr<Settings> = user;
    s.vibrate = 1 - s.vibrate;
    aui_invalidate();
    return 0;
}

fn on_light(user: ptr) -> i32 {
    let s: ptr<Settings> = user;
    s.dark = 0;
    aui_set_dark(0);
    aui_invalidate();
    return 0;
}

fn on_dark(user: ptr) -> i32 {
    let s: ptr<Settings> = user;
    s.dark = 1;
    aui_set_dark(1);
    aui_invalidate();
    return 0;
}

fn on_bright(user: ptr) -> i32 {
    let s: ptr<Settings> = user;
    s.bright = aui_slider_value(40);
    aui_invalidate();
    return 0;
}

fn on_volume(user: ptr) -> i32 {
    let s: ptr<Settings> = user;
    s.volume = aui_slider_value(41);
    aui_invalidate();
    return 0;
}

// v1.21：分段控件。点任意一段都会回调，新下标从容器 key 读。
fn on_unit(user: ptr) -> i32 {
    let s: ptr<Settings> = user;
    s.unit = aui_segmented_value(67);
    aui_invalidate();
    return 0;
}

fn on_reset(user: ptr) -> i32 {
    let s: ptr<Settings> = user;
    s.notify = 1;
    s.vibrate = 1;
    s.dark = 0;
    s.bright = 500;
    s.volume = 700;
    s.unit = 0;
    aui_set_dark(0);
    aui_invalidate();
    return 0;
}

fn value_row(key: i32, title: ptr, value: i32) -> i32 {
    aui_row(key);
    aui_gap(8);
    aui_label(key + 1, title);
    aui_spacer(key + 2, 0);
    aui_weight(1);
    aui_text_i32(key + 3, value);
    aui_label(key + 4, "%");
    aui_end();
    return 0;
}

fn build(user: ptr) -> i32 {
    let s: ptr<Settings> = user;
    aui_root();
    aui_scroll(1000);
    aui_weight(1);
    aui_column(1001);
    aui_pad(24);
    aui_gap(12);

    aui_label(2, "Settings");
    aui_label(3, "v1.21 selection controls");

    // ---- Notifications ----
    aui_column(10);
    aui_pad(16);
    aui_gap(4);
    aui_bg(aui_theme_color(AUI_COLOR_SURFACE));
    aui_radius(16);
    aui_label(11, "Notifications");
    aui_checkbox(12, "Push notifications", s.notify, on_notify, user);
    aui_checkbox(13, "Vibrate on mention", s.vibrate, on_vibrate, user);
    aui_end();

    // ---- Appearance ----
    aui_column(20);
    aui_pad(16);
    aui_gap(4);
    aui_bg(aui_theme_color(AUI_COLOR_SURFACE));
    aui_radius(16);
    aui_label(21, "Appearance");
    let lt: i32 = 0;
    if (s.dark == 0) { lt = 1; }
    let dk: i32 = 0;
    if (s.dark != 0) { dk = 1; }
    aui_radio(22, "Light theme", lt, on_light, user);
    aui_radio(23, "Dark theme", dk, on_dark, user);
    aui_end();

    // ---- Display ----
    aui_column(30);
    aui_pad(16);
    aui_gap(4);
    aui_bg(aui_theme_color(AUI_COLOR_SURFACE));
    aui_radius(16);
    aui_label(31, "Display");
    let vr: i32 = value_row(32, "Brightness", s.bright / 10);
    aui_slider(40, s.bright, 100, on_bright, user);
    let vr2: i32 = value_row(45, "Volume", s.volume / 10);
    aui_slider(41, s.volume, 0, on_volume, user);
    aui_end();

    // ---- v1.21：分段控件（单位切换）----
    aui_column(60);
    aui_pad(16);
    aui_gap(4);
    aui_bg(aui_theme_color(AUI_COLOR_SURFACE));
    aui_radius(16);
    aui_label(61, "Climate");
    let hval: i32 = 175;
    let hunit: ptr = "cm";
    if (s.unit != 0) {
        hval = 69;
        hunit = "in";
    }
    aui_row(62);
    aui_gap(8);
    aui_label(63, "Height");
    aui_spacer(64, 0);
    aui_weight(1);
    aui_text_i32(65, hval);
    aui_label(66, hunit);
    aui_end();
    aui_segmented(67, s.unit, on_unit, user);
    aui_segment(68, "cm");
    aui_segment(69, "in");
    aui_end();
    aui_end();

    aui_button(50, "Reset to defaults", on_reset, user);
    aui_align(3);
    aui_label(51, "Drag a slider: the label follows");
    aui_label(52, "the live value while you drag.");
    aui_spacer(53, 16);

    aui_end();   // content column
    aui_end();   // scroll viewport
    return 0;
}

fn app_init(user: ptr) -> i32 {
    aui_set_font(g_font, 1);
    return 0;
}

fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32 {
    return aui_android_attach(activity, saved, savedSize,
                              build, &g_set, app_init, 0);
}
