// ui_anim.ast — v1.10 动画演示：两张卡片淡入 + 上滑，Replay 重播。
//
// 动画只改绘制阶段（alpha / ty），不触发 build 与 layout；帧由库内 16 ms
// timerfd 驱动，和滚动 fling 共用一个表。key 与节点 key 相同，子树自动继承
// 父节点的透明度与位移。Replay 先 aui_anim_reset 删除旧槽，再重新创建。

include "../src/aui.ast";

let g_font: ptr = 0; // W4: .auf removed (no font files in repo; runtime adapter, see font_runtime.ast)

struct AnimApp {
    started: i32
}

let g_app: AnimApp = AnimApp { 0 };

fn start_in() -> i32 {
    // 卡片 100：ease-out，短一点；卡片 200：smoothstep，稍慢。
    let a1: i32 = aui_anim(100, AUI_ANIM_ALPHA, 0, 255, 280, AUI_EASE_OUT);
    let t1: i32 = aui_anim(100, AUI_ANIM_TY, 18, 0, 280, AUI_EASE_OUT);
    let a2: i32 = aui_anim(200, AUI_ANIM_ALPHA, 0, 255, 380, AUI_EASE_IN_OUT);
    let t2: i32 = aui_anim(200, AUI_ANIM_TY, 28, 0, 380, AUI_EASE_IN_OUT);
    return 0;
}

fn on_replay(user: ptr) -> i32 {
    let r1: i32 = aui_anim_reset(100, AUI_ANIM_ALPHA);
    let r2: i32 = aui_anim_reset(100, AUI_ANIM_TY);
    let r3: i32 = aui_anim_reset(200, AUI_ANIM_ALPHA);
    let r4: i32 = aui_anim_reset(200, AUI_ANIM_TY);
    let s: i32 = start_in();
    let v: i32 = aui_invalidate();
    return 0;
}

fn card(key: i32, title: ptr, body: ptr) -> i32 {
    aui_column(key);
    aui_pad(18);
    aui_gap(8);
    aui_bg(aui_theme_color(AUI_COLOR_SURFACE));
    aui_radius(16);
    aui_label(key + 1, title);
    aui_label(key + 2, body);
    return 0;
}

fn app_build(user: ptr) -> i32 {
    let app: ptr<AnimApp> = user;
    aui_root();
    aui_scroll(1);
    aui_weight(1);
    aui_pad(24);
    aui_gap(16);

    aui_label(2, "AsterUI");
    aui_label(3, "v1.10 animation slots");
    aui_label(4, "alpha 0..255 / tx,ty in dp / 64 slots");

    let c1: i32 = card(100, "Fade + slide",
        "Ease-out. The whole card fades in while moving up 18 dp.");
    let c2: i32 = card(200, "Smoothstep",
        "A slower smoothstep curve, moving 28 dp. Paint-only transforms.");
    aui_button(300, "Replay", on_replay, user);
    aui_align(3);

    aui_label(5, "Replay resets the four slots and starts again.");

    aui_end();

    // 只在首帧启动；之后 build（主题切换等）不会打断进行中的动画。
    if (app.started == 0) {
        app.started = 1;
        let s: i32 = start_in();
    }
    return 0;
}

fn app_init(user: ptr) -> i32 {
    aui_set_font(g_font, 1);
    return 0;
}

fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32 {
    return aui_android_attach(activity, saved, savedSize,
                              app_build, &g_app, app_init, 0);
}
