// ui_hlist.ast — v1.47 横向虚拟列表示例：1000 张卡片，只构建可见项。
//
// 对照 HuxerUI VirtualList.ScrollAxis(Horizontal)：项宽 160 dp、项高
// 撑满容器、项间距 8 dp，内容由 on_bind 按 aui_hlist_first()..
// aui_hlist_last() 现场生成；左右拖动、惯性、底部横滚动条和裁剪。
// 点项把下标写回应用（选中项铺浅蓝底），同时写入 aui_state_set(970)，
// 方便假宿主断言。

include "../aui.ast";

let g_font: ptr = 0; // W4: .auf removed (no font files in repo; runtime adapter, see font_runtime.ast)

let COUNT: i32 = 1000;
let WDP: i32 = 160;

struct Demo {
    sel: i32
}

let g_demo: Demo = Demo { 1 };

fn on_item(user: ptr) -> i32 {
    let d: ptr<Demo> = user;
    d.sel = aui_hlist_tap_index();
    aui_state_set(970, d.sel);
    aui_invalidate();
    return 0;
}

fn bind_items(user: ptr) -> i32 {
    let d: ptr<Demo> = user;
    let i: i32 = aui_hlist_first();
    let e: i32 = aui_hlist_last();
    while (i <= e) {
        aui_hlist_item(i);
        if (i == d.sel) {
            aui_bg(0xFFDCE7FF);
        }
        aui_pad(12);
        aui_gap(8);
        aui_icon(0, AUI_ICON_STAR, 24);
        aui_label(0, "Card");
        aui_text_i32(0, i);
        aui_end();
        i = i + 1;
    }
    return 0;
}

fn build(user: ptr) -> i32 {
    let d: ptr<Demo> = user;
    aui_root();
    aui_column(1);
    aui_weight(1);

    aui_row(2);
    aui_pad(16);
    aui_gap(8);
    aui_label(3, "HorizontalList");
    aui_spacer(4, 1);
    aui_weight(1);
    aui_label(5, "1000 cards");
    aui_end();

    aui_hlist(10, COUNT, WDP, 0, bind_items, on_item, user);
    aui_gap(8);
    aui_weight(1);
    aui_end();

    aui_row(6);
    aui_pad(16);
    aui_gap(8);
    aui_label(7, "Selected:");
    aui_text_i32(8, d.sel);
    aui_end();

    aui_end();
    return 0;
}

fn app_init(user: ptr) -> i32 {
    aui_set_font(g_font, 1);
    aui_state_set(970, g_demo.sel);
    return 0;
}

fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32 {
    return aui_android_attach(activity, saved, savedSize,
                              build, &g_demo, app_init, 0);
}
