// ui_sheet.ast — v1.38 底部弹出层示例。
//
// aui_sheet 在内容区底部弹出白色卡片：左右各留 16 dp、最大 640 dp 宽、
// 顶部 14 dp 圆角、进入时 240 ms 上滑。点遮罩、按 BACK 或从顶部 32 dp
// 把手区往下拖都能关闭，回调里用 aui_sheet_reason() 区分
// （1 遮罩 / 2 BACK / 3 下拉），应用在回调里把 open 置 0。
// aui_sheet_handle(0) 隐藏顶部手柄。
include "../src/aui.ast";

let g_font: ptr = 0; // W4: .auf removed (no font files in repo; runtime adapter, see font_runtime.ast)

struct Demo {
    open: i32,
    taps: i32,
    last: i32,
    reason: i32,
    amount: i32,
    dark: i32,
    hide: i32
}

let g_demo: Demo = Demo { 0, 0, 0, 0, 500, 0, 0 };

fn note(s: ptr<Demo>, id: i32) : i32 {
    s.taps = s.taps + 1;
    s.last = id;
    aui_state_set(970, s.taps);
    aui_state_set(971, s.last);
    aui_invalidate();
    return 0;
}

fn close_with(s: ptr<Demo>, id: i32) : i32 {
    s.reason = aui_sheet_reason();
    s.open = 0;
    aui_state_set(972, s.reason);
    return note(s, id);
}

fn on_open(user: ptr) : i32 {
    let s: ptr<Demo> = user;
    s.open = 1;
    return note(s, 10);
}

fn on_sheet(user: ptr) : i32 {
    let s: ptr<Demo> = user;
    return close_with(s, 20);
}

fn on_confirm(user: ptr) : i32 {
    let s: ptr<Demo> = user;
    s.open = 0;
    return note(s, 21);
}

fn on_cancel(user: ptr) : i32 {
    let s: ptr<Demo> = user;
    s.open = 0;
    return note(s, 22);
}

fn on_amount(user: ptr) : i32 {
    let s: ptr<Demo> = user;
    let v: i32 = aui_slider_value(24);
    s.amount = v;
    aui_state_set(973, v);
    aui_invalidate();
    return 0;
}

fn on_dark(user: ptr) : i32 {
    let s: ptr<Demo> = user;
    s.dark = 1 - s.dark;
    aui_set_dark(s.dark);
    aui_invalidate();
    return 0;
}

fn on_hide(user: ptr) : i32 {
    let s: ptr<Demo> = user;
    s.hide = 1 - s.hide;
    return note(s, 30);
}

fn build(user: ptr) : i32 {
    let s: ptr<Demo> = user;
    aui_root();
    aui_scroll(1);
    aui_weight(1);
    aui_column(100);
    aui_pad(20);
    aui_gap(12);

    aui_label(2, "AsterUI Bottom Sheet");
    aui_label(3, "v1.38.0 bottom sheet demo");

    aui_button(10, "Open sheet", on_open, user);

    aui_row(11);
    aui_gap(8);
    aui_label(12, "Opens");
    aui_spacer(13, 0);
    aui_weight(1);
    aui_text_i32(14, s.taps);
    aui_end();   // row 11

    aui_row(15);
    aui_gap(8);
    aui_label(16, "Last action");
    aui_spacer(17, 0);
    aui_weight(1);
    aui_text_i32(18, s.last);
    aui_end();   // row 15

    aui_row(19);
    aui_gap(8);
    aui_label(25, "Close reason");
    aui_spacer(26, 0);
    aui_weight(1);
    aui_text_i32(27, s.reason);
    aui_end();   // row 19

    aui_row(28);
    aui_gap(8);
    aui_label(29, "Hide handle");
    aui_spacer(31, 0);
    aui_weight(1);
    aui_switch(32, s.hide, on_hide, user);
    aui_end();   // row 28

    aui_row(33);
    aui_gap(8);
    aui_label(34, "Dark theme");
    aui_spacer(35, 0);
    aui_weight(1);
    aui_switch(36, s.dark, on_dark, user);
    aui_end();   // row 33

    aui_end();   // column
    aui_end();   // scroll

    if (s.open != 0) {
        aui_sheet(20, s.open, on_sheet, user);
        aui_sheet_handle(1 - s.hide);
        aui_label(40, "Quick actions");
        aui_label(41, "Drag down from the handle, tap outside, or press BACK.");
        aui_slider(24, s.amount, 5, on_amount, user);
        aui_row(42);
        aui_gap(12);
        aui_button(43, "Cancel", on_cancel, user);
        aui_weight(1);
        aui_button(44, "Confirm", on_confirm, user);
        aui_weight(1);
        aui_end();   // row 42
        aui_end();   // sheet 20
    }
    return 0;
}

fn app_init(user: ptr) : i32 {
    aui_set_font(g_font, 1);
    return 0;
}

fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) : i32 {
    return aui_android_attach(activity, saved, savedSize,
                              build, &g_demo, app_init, 0);
}
