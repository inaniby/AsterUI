// ui_tree.ast — v1.33 树视图示例：多层目录 + 展开/收起 + 选中 + 禁用行。
//
// 受控组件：展开位掩码和选中行都由应用保存。每行带自己的 Row 记录
// （id + 是否分支），回调里按 id 选中、分支再翻转展开位，然后
// aui_invalidate()。可见行由应用按展开位决定，与 HuxerUI 的 TreeView
// 用法一致。状态同时写进 aui_state_set（960 = 选中 id，961 = 展开位），
// 方便假宿主断言。

include "../aui.ast";

let g_font: ptr = 0; // W4: .auf removed (no font files in repo; runtime adapter, see font_runtime.ast)

struct Row {
    id: i32,
    branch: i32
}

struct Demo {
    sel: i32,
    exp: i32
}

// 20 行 × 32 dp + 内边距，在 420 dpi 手机上是可滚动内容（滚动条可见）。
let g_rows: Row[24] = Row { 0, 0 };
// 默认选中 aui.ast（3）；展开 AsterUI(2) / stdlib(4) / examples(32) /
// docs(512) / generated(4096)，共 20 行。
let g_demo: Demo = Demo { 3, 4646 };

fn row_init(i: i32, id: i32, branch: i32) -> i32 {
    g_rows[i].id = id;
    g_rows[i].branch = branch;
    return 0;
}

fn row_flags(s: ptr<Demo>, id: i32, branch: i32) -> i32 {
    let f: i32 = 0;
    if (branch != 0) { f = f | AUI_TREE_BRANCH; }
    if (branch != 0 && (s.exp & (1 << id)) != 0) {
        f = f | AUI_TREE_EXPANDED;
    }
    if (s.sel == id) { f = f | AUI_TREE_SELECTED; }
    return f;
}

fn on_row(user: ptr) -> i32 {
    let r: ptr<Row> = user;
    g_demo.sel = r.id;
    if (r.branch != 0) {
        g_demo.exp = g_demo.exp ^ (1 << r.id);
    }
    aui_state_set(960, g_demo.sel);
    aui_state_set(961, g_demo.exp);
    aui_invalidate();
    return 0;
}

fn build(user: ptr) -> i32 {
    let s: ptr<Demo> = user;
    aui_root();
    aui_column(1);
    aui_weight(1);
    aui_pad(16);
    aui_gap(10);

    aui_label(2, "AsterUI TreeView");
    aui_label(3, "Tap a branch to expand, a row to select");
    aui_align(1);

    aui_tree(10);
    aui_weight(1);
    aui_pad(4);

    aui_tree_item(100, "AsterUI", 0, row_flags(s, 1, 1), on_row, &g_rows[0]);
    if ((s.exp & 2) != 0) {
        aui_tree_item(101, "stdlib", 1, row_flags(s, 2, 1), on_row, &g_rows[1]);
        if ((s.exp & 4) != 0) {
            aui_tree_item(102, "aui.ast", 2, row_flags(s, 3, 0), on_row, &g_rows[2]);
            aui_tree_item(103, "aui_impl.ast", 2, row_flags(s, 4, 0), on_row, &g_rows[3]);
        }
        aui_tree_item(104, "examples", 1, row_flags(s, 5, 1), on_row, &g_rows[4]);
        if ((s.exp & 32) != 0) {
            aui_tree_item(105, "ui_tree.ast", 2, row_flags(s, 6, 0), on_row, &g_rows[5]);
            aui_tree_item(106, "ui_list.ast", 2, row_flags(s, 7, 0), on_row, &g_rows[6]);
        }
        aui_tree_item(107, "README.md", 1, row_flags(s, 8, 0), on_row, &g_rows[7]);
        aui_tree_item(108, "docs", 1, row_flags(s, 9, 1), on_row, &g_rows[8]);
        if ((s.exp & 512) != 0) {
            aui_tree_item(109, "AsterUI-design.md", 2, row_flags(s, 10, 0), on_row, &g_rows[9]);
        }
        aui_tree_item(110, "build.sh (locked)", 1,
                      row_flags(s, 11, 0) | AUI_TREE_DISABLED, on_row, &g_rows[10]);
        aui_tree_item(111, "generated", 1, row_flags(s, 12, 1), on_row, &g_rows[11]);
        if ((s.exp & 4096) != 0) {
            aui_tree_item(112, "chunk_00.ast", 2, row_flags(s, 13, 0), on_row, &g_rows[12]);
            aui_tree_item(113, "chunk_01.ast", 2, row_flags(s, 14, 0), on_row, &g_rows[13]);
            aui_tree_item(114, "chunk_02.ast", 2, row_flags(s, 15, 0), on_row, &g_rows[14]);
            aui_tree_item(115, "chunk_03.ast", 2, row_flags(s, 16, 0), on_row, &g_rows[15]);
            aui_tree_item(116, "chunk_04.ast", 2, row_flags(s, 17, 0), on_row, &g_rows[16]);
            aui_tree_item(117, "chunk_05.ast", 2, row_flags(s, 18, 0), on_row, &g_rows[17]);
            aui_tree_item(118, "chunk_06.ast", 2, row_flags(s, 19, 0), on_row, &g_rows[18]);
            aui_tree_item(119, "chunk_07.ast", 2, row_flags(s, 20, 0), on_row, &g_rows[19]);
        }
    }
    aui_end();

    aui_row(20);
    aui_gap(8);
    aui_label(21, "Selected:");
    aui_text_i32(22, s.sel);
    aui_label(23, "Expand:");
    aui_text_i32(24, s.exp);
    aui_end();

    aui_end();
    return 0;
}

fn app_init(user: ptr) -> i32 {
    aui_set_font(g_font, 1);
    row_init(0, 1, 1);
    row_init(1, 2, 1);
    row_init(2, 3, 0);
    row_init(3, 4, 0);
    row_init(4, 5, 1);
    row_init(5, 6, 0);
    row_init(6, 7, 0);
    row_init(7, 8, 0);
    row_init(8, 9, 1);
    row_init(9, 10, 0);
    row_init(10, 11, 0);
    row_init(11, 12, 1);
    row_init(12, 13, 0);
    row_init(13, 14, 0);
    row_init(14, 15, 0);
    row_init(15, 16, 0);
    row_init(16, 17, 0);
    row_init(17, 18, 0);
    row_init(18, 19, 0);
    row_init(19, 20, 0);
    aui_state_set(960, g_demo.sel);
    aui_state_set(961, g_demo.exp);
    return 0;
}

fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32 {
    return aui_android_attach(activity, saved, savedSize,
                              build, &g_demo, app_init, 0);
}
