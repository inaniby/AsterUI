# aster.proj — AsterUI Gallery template (English).
# Copy this directory, change package/label, then ./build.sh.
kind apk
package com.example.asterui.gallery
label AsterUI Gallery
version-code 1
version-name 0.1-cn
target-sdk 35
page-size 16384
[language]
default = "en"
