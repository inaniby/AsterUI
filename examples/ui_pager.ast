// ui_pager.ast — v1.24 分页示例：Tab 栏 + 可左右滑动的三页内容。
//
// 手势与标签双向同步：点 Tab 只改 s.tab，分页容器下一帧自动用 200 ms
// 吸附到目标页；左右滑动超过 35% 页宽（或快速一甩）只回调一次，应用用
// aui_pager_value(20) 读提议页并存回 s.tab，Tab 栏随即高亮新页。
// 每页内部仍可纵向滚动：横向拖动占优时分页接管，纵向拖动交给滚动。

include "../aui.ast";

let g_font: ptr = 0; // W4: .auf removed (no font files in repo; runtime adapter, see font_runtime.ast)

struct Demo {
    tab: i32,
    feed: i32,
    dark: i32,
    promo: i32,
    alerts: i32
}

let g_demo: Demo = Demo { 0, 0, 0, 1, 1 };

fn clamp_tab(v: i32) -> i32 {
    if (v < 0) { return 0; }
    if (v > 2) { return 2; }
    return v;
}

fn on_tab(user: ptr) -> i32 {
    let s: ptr<Demo> = user;
    s.tab = clamp_tab(aui_tabs_value(10));
    aui_invalidate();
    return 0;
}

fn on_page(user: ptr) -> i32 {
    let s: ptr<Demo> = user;
    s.tab = clamp_tab(aui_pager_value(20));
    aui_invalidate();
    return 0;
}

fn on_next(user: ptr) -> i32 {
    let s: ptr<Demo> = user;
    s.tab = (s.tab + 1) % 3;
    aui_invalidate();
    return 0;
}

fn on_refresh(user: ptr) -> i32 {
    let s: ptr<Demo> = user;
    s.feed = s.feed + 1;
    aui_invalidate();
    return 0;
}

fn on_dark(user: ptr) -> i32 {
    let s: ptr<Demo> = user;
    s.dark = 1 - s.dark;
    aui_set_dark(s.dark);
    aui_invalidate();
    return 0;
}

fn on_promo(user: ptr) -> i32 {
    let s: ptr<Demo> = user;
    s.promo = 1 - s.promo;
    aui_invalidate();
    return 0;
}

fn on_alerts(user: ptr) -> i32 {
    let s: ptr<Demo> = user;
    s.alerts = 1 - s.alerts;
    aui_invalidate();
    return 0;
}

fn info_row(key: i32, title: ptr, value: ptr) -> i32 {
    aui_row(key);
    aui_gap(8);
    aui_label(key + 1, title);
    aui_spacer(key + 2, 0);
    aui_weight(1);
    aui_label(key + 3, value);
    aui_end();
    return 0;
}

// 页内滚动区：页高固定为分页视口，内容多时独立纵向滚动。
fn page_scroll(key: i32) -> i32 {
    aui_scroll(key);
    aui_weight(1);
    aui_pad(16);
    aui_gap(12);
    return 0;
}

fn build_feed(s: ptr<Demo>) -> i32 {
    aui_label(101, "Your feed");
    aui_label(102, "Swipe left or right to change page.");
    aui_align(3);
    aui_row(103);
    aui_gap(8);
    aui_label(104, "Refreshes");
    aui_spacer(105, 0);
    aui_weight(1);
    aui_text_i32(106, s.feed);
    aui_end();
    aui_button(107, "Refresh feed", on_refresh, s);
    aui_button(108, "Next page", on_next, s);
    aui_label(109, "This page scrolls vertically on its own.");
    aui_align(3);
    return 0;
}

fn build_stats(s: ptr<Demo>) -> i32 {
    aui_label(111, "Component stats");
    info_row(112, "Controls", "12");
    info_row(115, "Layouts", "4");
    info_row(118, "Pages", "3");
    aui_progress(121, 760);
    aui_label(122, "v1.24 coverage: 76%");
    aui_align(3);
    aui_button(123, "Next page", on_next, s);
    aui_label(124, "Drag vertically inside any page to scroll.");
    aui_align(3);
    return 0;
}

fn build_settings(s: ptr<Demo>) -> i32 {
    aui_label(131, "Preferences");
    aui_checkbox(132, "Promotions", s.promo, on_promo, s);
    aui_checkbox(133, "Mention alerts", s.alerts, on_alerts, s);
    aui_switch(134, s.dark, on_dark, s);
    aui_label(135, "Dark theme");
    aui_button(136, "Next page", on_next, s);
    aui_label(137, "Tab and pager share one selection value.");
    aui_align(3);
    return 0;
}

fn build(user: ptr) -> i32 {
    let s: ptr<Demo> = user;
    aui_root();
    aui_column(1);
    aui_weight(1);
    aui_pad(20);
    aui_gap(12);

    aui_label(2, "AsterUI Pager");
    aui_label(3, "v1.24 swipe pages");

    aui_tabs(10, s.tab, on_tab, user);
    aui_tab(11, "Feed");
    aui_tab(12, "Stats");
    aui_tab(13, "Settings");
    aui_end();

    // ---- 分页容器：所有页并排，视口外由绘制阶段裁剪 ----
    aui_pager(20, s.tab, on_page, user);
    aui_weight(1);

    // 三页内容始终都建：滑动/吸附时离场页也要完整显示，不能变空白。
    aui_page(21);
    page_scroll(22);
    let rf: i32 = build_feed(s);
    aui_end();   // scroll
    aui_end();   // page

    aui_page(31);
    page_scroll(32);
    let rs: i32 = build_stats(s);
    aui_end();
    aui_end();

    aui_page(41);
    page_scroll(42);
    let rt: i32 = build_settings(s);
    aui_end();
    aui_end();

    aui_end();   // pager
    aui_end();   // root column
    return 0;
}

fn app_init(user: ptr) -> i32 {
    aui_set_font(g_font, 1);
    return 0;
}

fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32 {
    return aui_android_attach(activity, saved, savedSize,
                              build, &g_demo, app_init, 0);
}
