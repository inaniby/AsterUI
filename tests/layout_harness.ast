// layout_harness.ast — v1.37 ui_layout 的真实宿主路径冒烟测试（qemu-user）。
//
// 720×1280 / density 420 的假宿主，走 ANativeActivity 回调创建窗口，然后：
// 版本号 14806；标签流按行换行、每个标签片都画出来；点标签切换选中位；
// 图标流 5+2 换行；切换 justify 后首图标右移、模式值回读；水平/垂直
// 分隔线几何与颜色；自定义红色分隔线；点图标按钮回调；滚动；深色主题。
//
// 返回码：0 通过；10 attach 失败；11 回调表没写；12 屏幕全黑；
// 13 版本号不是 14806；20 标签流几何不对；21 标签片缺失；
// 22 标签点按状态不对；23 图标流没有换行；24 居中模式不对；
// 25 space-between 模式不对；26 水平分隔线不对；27 垂直分隔线不对；
// 28 带缩进的分隔线不对；29 自定义颜色不对；30 图标按钮回调不对；
// 31 深色主题不对；32 滚动/裁剪不对；90 内容超出 720×1280。
extern let g_fake_pixels: i32[921600];

extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_flow(key: i32, out: ptr) -> i32;
extern fn aui_debug_divider(key: i32, out: ptr) -> i32;
extern fn aui_debug_icon(key: i32, out: ptr) -> i32;
extern fn aui_debug_scroll(key: i32) -> i32;
extern fn aui_debug_scroll_max(key: i32) -> i32;
extern fn aui_debug_scroll_set(key: i32, px: i32) -> i32;
extern fn aui_invalidate_layout() -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_frame(now: i64) -> i32;
extern fn aui_state_get(key: i32) -> i32;
extern fn aui_invalidate() -> i32;
extern fn aui_version() -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;

let g_act: i64[11] = 0;
let g_cb: i64[16] = 0;
let g_win: i64[4] = 0;
let g_assets: i64[1] = 0;
let g_ext_path: u8[32] = 0;
let g_harness_anchor: ptr = g_act;

fn call_cb(off: i32, a: ptr, b: ptr) -> i32 {
    let cb: ptr = load_ptr(g_act);
    let f: fn(ptr, ptr) -> i32 = load_ptr(cb + off);
    return f(a, b);
}

fn frame_at(t: i64) -> i32 {
    fake_set_clock(t);
    return aui_frame(t);
}

fn tap_at(t: i64, x: i32, y: i32) -> i32 {
    fake_set_clock(t);
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    fake_set_clock(t + 50000000);
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn tap_key(t: i64, k: i32) -> i32 {
    let r: i32[4] = 0;
    if (aui_debug_rect(k, r) != 0) { return -1; }
    return tap_at(t, r[0] + r[2] / 2, r[1] + r[3] / 2);
}

fn px_off(x: i32, y: i32) -> i32 { return (y * 720 + x) * 4; }
fn chan(x: i32, y: i32, c: i32) -> i32 {
    if (x < 0 || y < 0 || x >= 720 || y >= 1280) { return 255; }
    return i32(load_u8(g_fake_pixels + px_off(x, y) + c));
}
fn lum(x: i32, y: i32) -> i32 {
    let r: i32 = chan(x, y, 0);
    let g: i32 = chan(x, y, 1);
    let b: i32 = chan(x, y, 2);
    return (r * 3 + g * 6 + b) / 10;
}
fn dark_in(x0: i32, y0: i32, x1: i32, y1: i32, lim: i32) -> i32 {
    let y: i32 = y0;
    while (y < y1) {
        let x: i32 = x0;
        while (x < x1) {
            if (lum(x, y) < lim) { return 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}
fn light_in(x0: i32, y0: i32, x1: i32, y1: i32, lim: i32) -> i32 {
    let y: i32 = y0;
    while (y < y1) {
        let x: i32 = x0;
        while (x < x1) {
            if (lum(x, y) > lim) { return 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}
fn red_in(x0: i32, y0: i32, x1: i32, y1: i32) -> i32 {
    let y: i32 = y0;
    while (y < y1) {
        let x: i32 = x0;
        while (x < x1) {
            if (chan(x, y, 0) > chan(x, y, 1) + 20) { return 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

// 把 key 滚到视口内（顶部留 ty 像素），成功返回 1。
fn show_key(t: i64, k: i32, ty: i32) -> i32 {
    let r: i32[4] = 0;
    if (aui_debug_rect(k, r) != 0) { return 0; }
    let ny: i32 = aui_debug_scroll(1) + r[1] - ty;
    if (ny < 0) { ny = 0; }
    let mx: i32 = aui_debug_scroll_max(1);
    if (ny > mx) { ny = mx; }
    aui_debug_scroll_set(1, ny);
    aui_invalidate_layout();
    frame_at(t);
    if (aui_debug_rect(k, r) != 0) { return 0; }
    if (r[1] < 0 || r[1] + r[3] > 1280) { return 0; }
    return 1;
}

fn rect_ok(r: ptr, w: i32, h: i32) -> i32 {
    let p: ptr<i32> = r;
    if (p[0] < 0 || p[1] < 0) { return 0; }
    if (p[0] + p[2] > w || p[1] + p[3] > h) { return 0; }
    return 1;
}

fn main() -> i32 {
    let act: ptr = g_act;
    *(act + 0) = g_cb;
    let assets: ptr = g_assets;
    *(act + 64) = assets;
    let ep: ptr = g_ext_path;
    store_u8(ep + 0, 47);
    store_u8(ep + 1, 116);
    store_u8(ep + 2, 109);
    store_u8(ep + 3, 112);
    store_u8(ep + 4, 47);
    store_u8(ep + 5, 97);
    store_u8(ep + 6, 115);
    store_u8(ep + 7, 116);
    store_u8(ep + 8, 101);
    store_u8(ep + 9, 114);
    store_u8(ep + 10, 117);
    store_u8(ep + 11, 105);
    store_u8(ep + 12, 45);
    store_u8(ep + 13, 105);
    store_u8(ep + 14, 99);
    store_u8(ep + 15, 111);
    store_u8(ep + 16, 110);
    store_u8(ep + 17, 0);
    *(act + 40) = ep;

    if (g_harness_anchor == 0) { return 10; }
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    let r: i32 = ANativeActivity_onCreate(act, 0, 0);
    if (r != 0) { return 10; }

    let cb: ptr = load_ptr(g_act);
    let f56: ptr = load_ptr(cb + 56);
    let f72: ptr = load_ptr(cb + 72);
    if (f56 == 0 || f72 == 0) { return 11; }

    let win: ptr = g_win;
    let s1: i32 = call_cb(0, act, 0);
    let s2: i32 = call_cb(8, act, 0);
    let s3: i32 = call_cb(56, act, win);
    let s4: i32 = call_cb(72, act, win);

    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < 720 * 1280 * 4) {
        sum = sum + load_u8(g_fake_pixels + i);
        i = i + 1;
    }
    if (sum == 0) { return 12; }
    if (aui_version() != 14806) { return 13; }

    let base: i64 = 5000000000;
    frame_at(base);

    // ---- A. 标签流：宽 615 px、至少两行 ----
    let f: i32[6] = 0;
    if (aui_debug_flow(10, f) != 0) { return 20; }
    if (f[2] != 615 || f[4] < 2 || f[5] != 0) { return 20; }
    let fx: i32 = f[0];
    let fy: i32 = f[1];
    let fw: i32 = f[2];
    let fh: i32 = f[3];

    // ---- B. 6 个标签片都在流内、都画出来 ----
    let k: i32 = 11;
    let lx0: i32 = -1;
    let ly0: i32 = -1;
    let other: i32 = 0;
    while (k <= 16) {
        let c: i32[4] = 0;
        if (aui_debug_rect(k, c) != 0) { return 21; }
        if (c[0] < fx || c[1] < fy) { return 21; }
        if (c[0] + c[2] > fx + fw || c[1] + c[3] > fy + fh) { return 21; }
        if (rect_ok(c, 720, 1280) == 0) { return 21; }
        if (lx0 < 0) { lx0 = c[0]; ly0 = c[1]; }
        if (c[1] != ly0) { other = 1; }
        if (c[0] == lx0 && c[1] == ly0 && k != 11) { return 21; }
        if (dark_in(c[0] + 6, c[1] + 6, c[0] + c[2] - 6, c[1] + c[3] - 6, 200) == 0) {
            return 21;
        }
        k = k + 1;
    }
    if (other == 0) { return 21; }   // 6 个标签必须至少换到第二行

    // ---- C. 点标签切换选中位 ----
    if (tap_key(base + 20000000, 11) != 0) { return 22; }
    frame_at(base + 50000000);
    if (aui_state_get(970) != 1 || aui_state_get(971) != 1) { return 22; }
    if (aui_state_get(973) != 1) { return 22; }
    if (tap_key(base + 70000000, 11) != 0) { return 22; }
    frame_at(base + 100000000);
    if (aui_state_get(970) != 2 || aui_state_get(973) != 0) { return 22; }
    if (tap_key(base + 120000000, 16) != 0) { return 22; }
    frame_at(base + 150000000);
    if (aui_state_get(970) != 3 || aui_state_get(973) != 32) { return 22; }
    if (aui_state_get(971) != 6) { return 22; }

    // ---- D. 图标流：7 个 40 dp 图标排成 5 + 2 ----
    if (aui_debug_flow(20, f) != 0) { return 23; }
    if (f[2] != 615 || f[4] != 2 || f[5] != 0) { return 23; }
    let a: i32[6] = 0;
    if (aui_debug_icon(21, a) != 0) { return 23; }
    if (a[2] != 105) { return 23; }
    let x21: i32 = a[0];
    let y21: i32 = a[1];
    if (aui_debug_icon(25, a) != 0) { return 23; }
    if (a[1] != y21) { return 23; }
    if (aui_debug_icon(26, a) != 0) { return 23; }
    if (a[1] <= y21) { return 23; }

    // ---- E. 切到居中：首图标右移，模式回读 1 ----
    if (show_key(base + 190000000, 32, 300) == 0) { return 24; }
    if (tap_key(base + 200000000, 32) != 0) { return 24; }
    frame_at(base + 230000000);
    if (aui_state_get(972) != 1) { return 24; }
    if (aui_debug_flow(20, f) != 0) { return 24; }
    if (f[5] != 1) { return 24; }
    if (aui_debug_icon(21, a) != 0) { return 24; }
    if (a[0] <= x21) { return 24; }

    // ---- F. 切到 space-between：模式回读 3，首图标回到左边 ----
    if (show_key(base + 240000000, 34, 300) == 0) { return 25; }
    if (tap_key(base + 250000000, 34) != 0) { return 25; }
    frame_at(base + 280000000);
    if (aui_state_get(972) != 3) { return 25; }
    if (aui_debug_flow(20, f) != 0) { return 25; }
    if (f[5] != 3) { return 25; }
    if (aui_debug_icon(21, a) != 0) { return 25; }
    if (a[0] != fx) { return 25; }

    // ---- G. 水平分隔线：整宽 615、1 dp 粗、比底色深 ----
    if (show_key(base + 300000000, 40, 300) == 0) { return 26; }
    let d: i32[6] = 0;
    if (aui_debug_divider(40, d) != 0) { return 26; }
    if (d[2] != 615 || d[3] != 2 || d[5] != 2) { return 26; }
    let bg: i32 = lum(4, 400);
    if (bg < 230) { return 26; }
    if (dark_in(d[0] + d[2] / 2 - 2, d[1], d[0] + d[2] / 2 + 2,
                d[1] + d[3] + 1, bg - 8) == 0) { return 26; }

    // ---- H. 垂直分隔线：1 dp 宽、拉伸到行高 105 ----
    if (show_key(base + 320000000, 52, 300) == 0) { return 27; }
    if (aui_debug_divider(52, d) != 0) { return 27; }
    if (d[2] != 2 || d[3] != 105 || d[4] != 1) { return 27; }
    let vx: i32 = d[0] + d[2] / 2;
    let vy: i32 = d[1] + d[3] / 2;
    if (lum(vx, vy) >= bg - 8) { return 27; }
    if (lum(vx + 8, vy) <= bg - 6) { return 27; }

    // ---- I. 带 16 dp 缩进的分隔线：盒内居中，顶部留白 ----
    if (show_key(base + 340000000, 41, 300) == 0) { return 28; }
    if (aui_debug_divider(41, d) != 0) { return 28; }
    if (d[2] != 615) { return 28; }
    if (d[3] <= 60) { return 28; }
    if (lum(d[0] + d[2] / 2, d[1]) <= bg - 8) { return 28; }
    if (dark_in(d[0] + d[2] / 2 - 4, d[1], d[0] + d[2] / 2 + 4, d[1] + d[3], bg - 8) == 0) {
        return 28;
    }

    // ---- J. 自定义红色分隔线（32 dp 缩进） ----
    if (show_key(base + 360000000, 42, 300) == 0) { return 29; }
    if (aui_debug_divider(42, d) != 0) { return 29; }
    if (red_in(d[0], d[1], d[0] + d[2], d[1] + d[3]) == 0) { return 29; }
    if (rect_ok(d, 720, 1280) == 0) { return 29; }

    // ---- K. 点分隔线之间的图标按钮（51 / 53 / 55） ----
    if (show_key(base + 380000000, 51, 300) == 0) { return 30; }
    if (tap_key(base + 400000000, 51) != 0) { return 30; }
    frame_at(base + 430000000);
    if (aui_state_get(971) != 31) { return 30; }
    if (tap_key(base + 450000000, 53) != 0) { return 30; }
    frame_at(base + 480000000);
    if (aui_state_get(971) != 32) { return 30; }
    if (tap_key(base + 500000000, 55) != 0) { return 30; }
    frame_at(base + 530000000);
    if (aui_state_get(971) != 33) { return 30; }
    if (aui_state_get(970) != 8) { return 30; }

    // ---- L. 深色主题：底色变深，分隔线仍比底色亮 ----
    if (show_key(base + 550000000, 75, 1000) == 0) { return 31; }
    if (tap_key(base + 570000000, 75) != 0) { return 31; }
    frame_at(base + 600000000);
    if (lum(4, 400) > 60) { return 31; }
    if (show_key(base + 620000000, 40, 300) == 0) { return 31; }
    if (aui_debug_divider(40, d) != 0) { return 31; }
    let dbg: i32 = lum(4, 400);
    if (dark_in(d[0] + d[2] / 2 - 2, d[1], d[0] + d[2] / 2 + 2,
                d[1] + d[3] + 1, dbg + 10) == 0) { return 31; }
    if (light_in(d[0] + d[2] / 2 - 2, d[1], d[0] + d[2] / 2 + 2,
                 d[1] + d[3] + 1, 120) != 0) { return 31; }

    // ---- M. 滚动范围与裁剪 ----
    if (aui_debug_scroll_max(1) <= 0) { return 32; }
    if (show_key(base + 650000000, 42, 300) == 0) { return 32; }
    if (show_key(base + 680000000, 11, 300) == 0) { return 32; }

    return 0;
}
