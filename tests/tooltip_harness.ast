// tooltip_harness.ast — v1.27 ui_tooltip 的真实宿主路径冒烟测试（qemu-user）。
//
// 720×1280 / density 420 的假宿主，走 ANativeActivity 回调创建窗口，然后：
// 长按 Above 按钮 -> 500 ms 后气泡出现在按钮上方、水平居中；
// 按住期间抬起不触发点击，气泡转停留 1.5 s 后消失；短按照常点击；
// 长按容器 row 20 -> 气泡贴着容器（下方或翻到上方），start 对齐；
// 长按底部提示 -> end 对齐；BACK 只收起气泡，不触发点击。
// 同时检查版本号 14806，节点数不因气泡改变。
//
// 返回码：0 通过；10 attach 失败；11 回调表没写；12 屏幕全黑；
// 13 版本号不是 14806；14 长按没有进入待定；15 500 ms 没有显示；
// 16 按钮上方气泡几何不对；17 长按抬起触发了点击；
// 18 停留时间不对；19 节点数变化；20 短按没有点击或出现气泡；
// 21 容器气泡几何不对；22 底部提示 end 对齐不对；
// 23 BACK 没有收起气泡；24 BACK 触发了点击；90/91 示例内容超出 720×1280。
extern let g_fake_pixels: i32[921600];

extern fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_node_count() -> i32;
extern fn aui_debug_tooltip(out: ptr) -> i32;
extern fn aui_debug_tooltip_state() -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_frame(now: i64) -> i32;
extern fn aui_state_get(key: i32) -> i32;
extern fn aui_version() -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_post_key(action: i32, code: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;

let g_act: i64[11] = 0;
let g_cb: i64[16] = 0;
let g_win: i64[4] = 0;
let g_assets: i64[1] = 0;
let g_ext_path: u8[32] = 0;
let g_harness_anchor: ptr = g_act;
let g_tip: i32[4] = 0;

fn call_cb(off: i32, a: ptr, b: ptr) -> i32 {
    let cb: ptr = load_ptr(g_act);
    let f: fn(ptr, ptr) -> i32 = load_ptr(cb + off);
    return f(a, b);
}

fn down(x: i32, y: i32) -> i32 {
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn up(x: i32, y: i32) -> i32 {
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn tap(x: i32, y: i32) -> i32 {
    down(x, y);
    up(x, y);
    return 0;
}

fn press_back() -> i32 {
    fake_post_key(0, 4);
    aui_on_input(1, 0, 0);
    fake_post_key(1, 4);
    aui_on_input(1, 0, 0);
    return 0;
}

fn frame_at(t: i64) -> i32 {
    fake_set_clock(t);
    return aui_frame(t);
}

fn cx_of(r: ptr<i32>) -> i32 {
    return r[0] + r[2] / 2;
}

fn cy_of(r: ptr<i32>) -> i32 {
    return r[1] + r[3] / 2;
}

fn main() -> i32 {
    let act: ptr = g_act;
    *(act + 0) = g_cb;
    let assets: ptr = g_assets;
    *(act + 64) = assets;
    store_u8(g_ext_path + 0, 47);
    store_u8(g_ext_path + 1, 116);
    store_u8(g_ext_path + 2, 109);
    store_u8(g_ext_path + 3, 112);
    store_u8(g_ext_path + 4, 47);
    store_u8(g_ext_path + 5, 97);
    store_u8(g_ext_path + 6, 115);
    store_u8(g_ext_path + 7, 116);
    store_u8(g_ext_path + 8, 101);
    store_u8(g_ext_path + 9, 114);
    store_u8(g_ext_path + 10, 117);
    store_u8(g_ext_path + 11, 105);
    store_u8(g_ext_path + 12, 45);
    store_u8(g_ext_path + 13, 116);
    store_u8(g_ext_path + 14, 114);
    store_u8(g_ext_path + 15, 97);
    store_u8(g_ext_path + 16, 99);
    store_u8(g_ext_path + 17, 101);
    store_u8(g_ext_path + 18, 0);
    let ep: ptr = g_ext_path;
    *(act + 40) = ep;

    if (g_harness_anchor == 0) { return 10; }
    let r: i32 = ANativeActivity_onCreate(act, 0, 0);
    if (r != 0) { return 10; }

    let cb: ptr = load_ptr(g_act);
    let f56: ptr = load_ptr(cb + 56);
    let f72: ptr = load_ptr(cb + 72);
    if (f56 == 0 || f72 == 0) { return 11; }

    let win: ptr = g_win;
    let s1: i32 = call_cb(0, act, 0);
    let s2: i32 = call_cb(8, act, 0);
    let s3: i32 = call_cb(56, act, win);
    let s4: i32 = call_cb(72, act, win);

    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < 720 * 1280 * 4) {
        sum = sum + load_u8(g_fake_pixels + i);
        i = i + 1;
    }
    if (sum == 0) { return 12; }
    if (aui_version() != 14806) { return 13; }

    let base: i64 = 3000000000;
    frame_at(base);
    let base_n: i32 = aui_debug_node_count();

    let b10: i32[4] = 0;
    let b11: i32[4] = 0;
    let row: i32[4] = 0;
    let hint: i32[4] = 0;
    if (aui_debug_rect(10, b10) != 0) { return 14; }
    if (aui_debug_rect(11, b11) != 0) { return 14; }
    if (aui_debug_rect(20, row) != 0) { return 14; }
    if (aui_debug_rect(32, hint) != 0) { return 14; }

    // ---- A. 长按 Above：300 ms 待定，520 ms 显示，气泡在按钮上方居中 ----
    let t1: i64 = base + 1000000000;
    let x1: i32 = cx_of(b10);
    let y1: i32 = cy_of(b10);
    fake_set_clock(t1);
    down(x1, y1);
    frame_at(t1);
    if (aui_debug_tooltip_state() != 1) { return 14; }
    frame_at(t1 + 300000000);
    if (aui_debug_tooltip_state() != 1) { return 14; }
    frame_at(t1 + 520000000);
    if (aui_debug_tooltip_state() != 2) { return 15; }
    if (aui_debug_tooltip(g_tip) != 1) { return 15; }
    let tx: i32 = g_tip[0] >> 16;
    let ty: i32 = g_tip[1] >> 16;
    let tw: i32 = g_tip[2] >> 16;
    let th: i32 = g_tip[3] >> 16;
    // 4 dp 间距在 420 dpi 下是 10.5 px；矩形取整允许 3 px 误差。
    let gapy: i32 = ty + th - (b10[1] - 10);
    if (gapy < -3 || gapy > 3) { return 16; }
    // 居中：气泡盖住锚点中心；放不下时夹到内容区左右边距（8 dp = 21 px）。
    let span: i32 = 0;
    if (tx <= cx_of(b10) && cx_of(b10) < tx + tw) { span = 1; }
    if (tx >= 18 && tx <= 24) { span = 1; }
    if (tx + tw >= 696 && tx + tw <= 702) { span = 1; }
    if (span == 0) { return 16; }

    // ---- 抬起：不点击，转入停留，1.5 s 后消失 ----
    up(x1, y1);
    if (aui_state_get(900) != 0) { return 17; }
    frame_at(t1 + 700000000);
    if (aui_debug_tooltip_state() != 3) { return 18; }
    frame_at(t1 + 2600000000);
    if (aui_debug_tooltip_state() != 0) { return 18; }
    if (aui_debug_node_count() != base_n) { return 19; }

    // ---- B. 短按 Below：点击照常，不出现气泡 ----
    tap(cx_of(b11), cy_of(b11));
    if (aui_state_get(900) != 1) { return 20; }
    if (aui_debug_tooltip_state() != 0) { return 20; }

    // ---- C. 容器 row 20：气泡贴容器边缘，start 对齐左边缘 ----
    let t3: i64 = base + 4000000000;
    fake_set_clock(t3);
    down(cx_of(row), cy_of(row));
    frame_at(t3 + 520000000);
    if (aui_debug_tooltip_state() != 2) { return 21; }
    if (aui_debug_tooltip(g_tip) != 1) { return 21; }
    let cx0: i32 = g_tip[0] >> 16;
    let cy0: i32 = g_tip[1] >> 16;
    let ch0: i32 = g_tip[3] >> 16;
    let cw0: i32 = g_tip[2] >> 16;
    let cstart: i32 = 0;
    if (cx0 >= row[0] - 1 && cx0 <= row[0] + 1) { cstart = 1; }
    if (cx0 + cw0 >= 696 && cx0 + cw0 <= 702) { cstart = 1; }
    if (cstart == 0) { return 21; }
    // 下方放不下时实现会翻到上方；两种都要求留 4 dp 间距。
    let below: i32 = cy0 - (row[1] + row[3] + 10);
    let above: i32 = cy0 + ch0 - (row[1] - 10);
    if (below < -3 || below > 3) {
        if (above < -3 || above > 3) { return 21; }
    }
    up(cx_of(row), cy_of(row));
    frame_at(t3 + 2000000000);

    // ---- D. 底部提示：上方 + end，气泡右边缘贴锚点右边缘 ----
    if (hint[1] + hint[3] > 1280) { return 90; }
    if (cy_of(hint) >= 1280) { return 91; }
    let t4: i64 = base + 6000000000;
    fake_set_clock(t4);
    down(cx_of(hint), cy_of(hint));
    frame_at(t4 + 520000000);
    if (aui_debug_tooltip_state() != 2) { return 22; }
    if (aui_debug_tooltip(g_tip) != 1) { return 22; }
    let hx: i32 = g_tip[0] >> 16;
    let hw: i32 = g_tip[2] >> 16;
    let hend: i32 = 0;
    if (hx + hw >= hint[0] + hint[2] - 1 && hx + hw <= hint[0] + hint[2] + 1) { hend = 1; }
    if (hx >= 18 && hx <= 24) { hend = 1; }
    if (hend == 0) { return 22; }

    // ---- E. BACK 只收起气泡，不触发点击 ----
    press_back();
    frame_at(t4 + 700000000);
    if (aui_debug_tooltip_state() != 0) { return 23; }
    if (aui_state_get(900) != 1) { return 24; }
    up(cx_of(hint), cy_of(hint));
    frame_at(t4 + 800000000);
    if (aui_debug_tooltip_state() != 0) { return 23; }
    if (aui_state_get(900) != 1) { return 24; }

    let s5: i32 = call_cb(24, act, 0);
    let s6: i32 = call_cb(32, act, 0);
    let s7: i32 = call_cb(40, act, 0);
    return 0;
}
