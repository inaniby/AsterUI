// w3_log_test.ast -- W3: 文件日志合并验证（qemu-user / headless）。
//
// 覆盖自研 runtime/log.ast 合并进参照后端的关键行为：
//   A. 行格式 "[<ms>] <L> AUI: <msg>"，时间戳是 i64 毫秒；
//   B. 40 天量级时钟下时间戳仍为正、无 "[-"（M1.2b 回归形）；
//   C. aui_log_tail 回读到最新行；
//   D. 128 KiB 轮转：写满后最早的行消失、最新的行还在；
//   E. aui_log_lines() 计数。
//
// 日志写进当前工作目录的 w3_log_test.log（qemu-user 直通宿主文件
// 系统）；跑测试的脚本应先 cd 到干净目录。无 .auf 字体依赖。
//
// 返回码：0 通过；1 主文件设置失败；2 行数不对；3 尾部回读不到首行；
// 4 时间戳不是 40 天量级或出现负时间戳；5 轮转后旧行还在；
// 6 轮转后最新行不在；7 尾部超长。
// 链接：test.o + aui_impl.o + font_runtime.o + truetype.o + text.o +
//   embeds.o + std.o + fake_ndk.o（见 ADOPTION-NOTES.md W3 节）。

include "../aui.ast";

extern fn fake_set_clock(t: i64) -> i32;

let g_tail: u8[8192] = 0;
let g_anchor: ptr = g_tail;

// 在 buf（blen 字节）里找 needle（NUL 结尾）；找到返回 1。
fn contains(buf: ptr, blen: i32, needle: ptr) -> i32 {
    let nlen: i32 = 0;
    while (load_u8(needle + nlen) != 0) {
        nlen = nlen + 1;
    }
    if (nlen == 0 || nlen > blen) { return 0; }
    let i: i32 = 0;
    while (i + nlen <= blen) {
        let j: i32 = 0;
        while (j < nlen) {
            if (load_u8(buf + i + j) != load_u8(needle + j)) { break; }
            j = j + 1;
        }
        if (j == nlen) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn main() -> i32 {
    // 40 天：3456000 s = 3456000000 ms（i64 运算，避免超大字面量）。
    let base: i64 = i64(3456000) * i64(1000000000);
    fake_set_clock(base);

    let s: i32 = aui_log_set_file("w3_log_test.log");
    if (s != 0) { return 1; }

    // ---- A/B. 首行 + 40 天时间戳 ----
    let l0: i32 = aui_log(4, "w3 first");
    let l1: i32 = aui_log1(4, "w3 count ", 7, "");
    if (aui_log_lines() != 2) { return 2; }
    let n: i32 = aui_log_tail(g_tail, 8192);
    if (n <= 0) { return 3; }
    if (contains(g_tail, n, "w3 first") == 0) { return 3; }
    if (contains(g_tail, n, "w3 count 7") == 0) { return 3; }
    if (contains(g_tail, n, "[3456000000] I AUI: w3 first") == 0) { return 4; }
    if (contains(g_tail, n, "[-") != 0) { return 4; }

    // ---- D. 轮转：写 ~150 KiB，旧行应被截掉 ----
    let i: i32 = 0;
    while (i < 5000) {
        let lx: i32 = aui_log1(4, "w3 rot ", i, "");
        i = i + 1;
    }
    let lz: i32 = aui_log(4, "w3 LAST-MARKER");
    if (aui_log_lines() != 5003) { return 2; }
    let n2: i32 = aui_log_tail(g_tail, 8192);
    if (n2 <= 0 || n2 > 8192) { return 7; }
    if (contains(g_tail, n2, "w3 LAST-MARKER") == 0) { return 6; }
    if (contains(g_tail, n2, "w3 first") != 0) { return 5; }
    if (contains(g_tail, n2, "w3 rot 0") != 0) { return 5; }
    if (contains(g_tail, n2, "[-") != 0) { return 4; }

    return 0;
}
