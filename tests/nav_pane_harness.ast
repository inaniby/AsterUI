// nav_pane_harness.ast — v1.42 ui_nav_pane 的真实宿主路径冒烟测试（qemu-user）。
//
// 720×1280 / density 420 的假宿主，走 ANativeActivity 回调创建窗口，然后：
// 版本号 14806；侧边导航栏收缩 72 dp（189 px）、项 48 dp（126 px）；
// 点第二项回调并回读下标、再点不回调；指示胶囊随选中移动；禁用项；
// 深色表面；最后展开到 256 dp（672 px）验证文字与裁剪。
//
// 返回码：0 通过；10 attach 失败；11 回调表没写；12 屏幕全黑；
// 13 版本号不是 14806；20 栏几何不对；21 子项布局不对；22 点击/回读不对；
// 23 已选中/禁用不对；24 展开文字不对；25 深色不对；26 收回失败。
extern let g_fake_pixels: i32[921600];

extern fn aui_debug_overlay(on: i32) -> i32;
extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_nav_pane(key: i32, out: ptr) -> i32;
extern fn aui_debug_nav_pane_item(key: i32, out: ptr) -> i32;
extern fn aui_debug_scroll(key: i32) -> i32;
extern fn aui_debug_scroll_max(key: i32) -> i32;
extern fn aui_debug_scroll_set(key: i32, px: i32) -> i32;
extern fn aui_invalidate_layout() -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_frame(now: i64) -> i32;
extern fn aui_state_get(key: i32) -> i32;
extern fn aui_invalidate() -> i32;
extern fn aui_version() -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;

let g_act: i64[11] = 0;
let g_cb: i64[16] = 0;
let g_win: i64[4] = 0;
let g_assets: i64[1] = 0;
let g_ext_path: u8[32] = 0;
let g_harness_anchor: ptr = g_act;

fn call_cb(off: i32, a: ptr, b: ptr) -> i32 {
    let cb: ptr = load_ptr(g_act);
    let f: fn(ptr, ptr) -> i32 = load_ptr(cb + off);
    return f(a, b);
}

fn frame_at(t: i64) -> i32 {
    fake_set_clock(t);
    return aui_frame(t);
}

fn tap_at(t: i64, x: i32, y: i32) -> i32 {
    fake_set_clock(t);
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    fake_set_clock(t + 50000000);
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn tap_key(t: i64, k: i32) -> i32 {
    let r: i32[4] = 0;
    if (aui_debug_rect(k, r) != 0) { return -1; }
    return tap_at(t, r[0] + r[2] / 2, r[1] + r[3] / 2);
}

fn px_off(x: i32, y: i32) -> i32 { return (y * 720 + x) * 4; }
fn chan(x: i32, y: i32, c: i32) -> i32 {
    if (x < 0 || y < 0 || x >= 720 || y >= 1280) { return 255; }
    return i32(load_u8(g_fake_pixels + px_off(x, y) + c));
}

// 在 [x0,x1) × [y0,y1) 里数深色像素（< 160，区分正文与浅色指示胶囊）。
fn ink_dark(x0: i32, x1: i32, y0: i32, y1: i32) -> i32 {
    let cnt: i32 = 0;
    let x: i32 = x0;
    while (x < x1) {
        let y: i32 = y0;
        while (y < y1) {
            if (chan(x, y, 0) < 160) { cnt = cnt + 1; }
            y = y + 1;
        }
        x = x + 1;
    }
    return cnt;
}

// 底部整宽一栏的开关始终可见，直接点即可。
fn toggle_switch(t: i64, k: i32) -> i32 {
    if (tap_key(t, k) != 0) { return 0; }
    frame_at(t + 120000000);
    return 1;
}

fn main() -> i32 {
    let act: ptr = g_act;
    *(act + 0) = g_cb;
    let assets: ptr = g_assets;
    *(act + 64) = assets;
    let ep: ptr = g_ext_path;
    store_u8(ep + 0, 47);
    store_u8(ep + 1, 116);
    store_u8(ep + 2, 109);
    store_u8(ep + 3, 112);
    store_u8(ep + 4, 47);
    store_u8(ep + 5, 97);
    store_u8(ep + 6, 115);
    store_u8(ep + 7, 116);
    store_u8(ep + 8, 101);
    store_u8(ep + 9, 114);
    store_u8(ep + 10, 117);
    store_u8(ep + 11, 105);
    store_u8(ep + 12, 45);
    store_u8(ep + 13, 105);
    store_u8(ep + 14, 99);
    store_u8(ep + 15, 111);
    store_u8(ep + 16, 110);
    store_u8(ep + 17, 0);
    *(act + 40) = ep;

    if (g_harness_anchor == 0) { return 10; }
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    let r: i32 = ANativeActivity_onCreate(act, 0, 0);
    if (r != 0) { return 10; }

    let cb: ptr = load_ptr(g_act);
    let f56: ptr = load_ptr(cb + 56);
    let f72: ptr = load_ptr(cb + 72);
    if (f56 == 0 || f72 == 0) { return 11; }

    let win: ptr = g_win;
    let s1: i32 = call_cb(0, act, 0);
    let s2: i32 = call_cb(8, act, 0);
    let s3: i32 = call_cb(56, act, win);
    let s4: i32 = call_cb(72, act, win);

    // v2.8：本 harness 测的是侧边栏、不是 overlay。窗口回调会把
    // DEBUG overlay 默认开（APK 行为），缎带红（R=155）会落在右上角
    // 检查区、被 ink_dark（<160）计为深墨。夹具里显式关掉 overlay；
    // 下面所有侧边栏断言一字不动，overlay 本身由 debug_overlay_test
    // 覆盖。
    let dbg_off: i32 = aui_debug_overlay(0);

    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < 720 * 1280 * 4) {
        sum = sum + load_u8(g_fake_pixels + i);
        i = i + 1;
    }
    if (sum == 0) { return 12; }
    if (aui_version() != 14806) { return 13; }

    let base: i64 = 5000000000;
    frame_at(base);

    // ---- 收缩态：72 dp 宽、铺满视口、4 项 48 dp 高 ----
    let p: i32[8] = 0;
    let q: i32[8] = 0;
    if (aui_debug_nav_pane(10, p) != 0) { return 20; }
    if (p[0] != 0 || p[1] != 63 || p[2] != 189 || p[3] != 881) { return 20; }
    if (p[4] != 0 || p[5] != 4 || p[6] != 0 || p[7] != 21) { return 20; }
    if (chan(180, 900, 0) != 0xFF || chan(180, 900, 1) != 0xFF) { return 20; }

    if (aui_debug_nav_pane_item(11, q) != 0) { return 21; }
    if (q[0] != 21 || q[1] != 63 || q[2] != 147 || q[3] != 126) { return 21; }
    if (q[4] != 0 || q[6] != 1) { return 21; }
    if (aui_debug_nav_pane_item(12, q) != 0) { return 21; }
    if (q[0] != 21 || q[1] != 189 || q[2] != 147 || q[4] != 1 || q[6] != 0) { return 21; }
    if (aui_debug_nav_pane_item(13, q) != 0) { return 21; }
    if (q[1] != 315 || q[4] != 2 || q[6] != 0) { return 21; }
    if (aui_debug_nav_pane_item(14, q) != 0) { return 21; }
    if (q[1] != 441 || q[4] != 3 || q[6] != 0 || q[7] != 0) { return 21; }

    // ---- 指示胶囊：第一项有主色 12%，第二项同位置是白 ----
    if (chan(40, 123, 0) >= 245) { return 20; }
    if (chan(40, 249, 0) != 0xFF) { return 20; }
    // 收缩态没有文字（胶囊是浅色，深墨计数为 0）。
    if (ink_dark(150, 168, 93, 163) != 0) { return 24; }

    // ---- 点第二项：回调一次、回读下标 1、胶囊跟着走 ----
    if (tap_key(base + 100000000, 12) != 0) { return 22; }
    frame_at(base + 150000000);
    if (aui_state_get(980) != 1 || aui_state_get(981) != 1) { return 22; }
    if (aui_state_get(991) != 11) { return 22; }
    if (aui_debug_nav_pane(10, p) != 0) { return 22; }
    if (p[4] != 1) { return 22; }
    if (chan(40, 123, 0) != 0xFF) { return 22; }
    if (chan(40, 249, 0) >= 245) { return 22; }

    // ---- 再点已选中项：不回调 ----
    if (tap_key(base + 200000000, 12) != 0) { return 23; }
    frame_at(base + 250000000);
    if (aui_state_get(981) != 1) { return 23; }
    if (aui_state_get(991) != 11) { return 23; }

    // ---- 禁用 Star：标记可读、点击不回调 ----
    if (toggle_switch(base + 400000000, 68) == 0) { return 31; }
    if (aui_state_get(983) != 1) { return 32; }
    if (aui_debug_nav_pane_item(14, q) != 0) { return 33; }
    if (q[7] != 1) { return 34; }
    if (aui_state_get(991) != 21) { return 35; }
    if (tap_key(base + 450000000, 14) != 0) { return 36; }
    frame_at(base + 500000000);
    if (aui_state_get(981) != 1) { return 37; }
    if (aui_state_get(991) != 21) { return 38; }

    // ---- 深色主题：栏表面 1E1E24 ----
    if (toggle_switch(base + 600000000, 72) == 0) { return 25; }
    if (aui_state_get(984) != 1) { return 25; }
    if (chan(180, 900, 0) != 0x1E || chan(180, 900, 1) != 0x1E ||
        chan(180, 900, 2) != 0x24) { return 25; }
    if (toggle_switch(base + 700000000, 72) == 0) { return 25; }

    // ---- 选中 Home，便于展开态检查文字 ----
    if (tap_key(base + 750000000, 11) != 0) { return 22; }
    frame_at(base + 760000000);
    if (aui_state_get(980) != 0) { return 22; }

    // ---- 展开：256 dp（672 px），文字在图标右侧，右侧裁剪 ----
    if (toggle_switch(base + 800000000, 64) == 0) { return 24; }
    if (aui_state_get(982) != 1) { return 24; }
    if (aui_debug_nav_pane(10, p) != 0) { return 24; }
    if (p[0] != 0 || p[2] != 672 || p[3] != 881 || p[6] != 1) { return 24; }
    if (aui_debug_nav_pane_item(11, q) != 0) { return 24; }
    if (q[0] != 21 || q[2] != 630 || q[3] != 126) { return 24; }
    if (q[4] != 0 || q[6] != 1) { return 24; }
    if (ink_dark(150, 620, 93, 163) <= 0) { return 24; }
    if (ink_dark(631, 719, 93, 163) != 0) { return 24; }

    // ---- 再收回：开关始终可点，宽度回到 72 dp ----
    if (toggle_switch(base + 900000000, 64) == 0) { return 26; }
    if (aui_state_get(982) != 0) { return 26; }
    if (aui_debug_nav_pane(10, p) != 0) { return 26; }
    if (p[2] != 189 || p[6] != 0) { return 26; }
    if (aui_debug_nav_pane_item(11, q) != 0) { return 26; }
    if (q[2] != 147) { return 26; }

    return 0;
}
