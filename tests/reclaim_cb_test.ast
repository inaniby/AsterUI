// reclaim_cb_test.ast — Phase 0 回调池探针（英文）：同一 (fn, user) 回调
// 注册/注销 10,000 次，池复用正常（高水位恒为 1）；句柄代数、重复注销、
// 容量填满 A-120、Window 退休 A-122、state 表满 A-103 与释放。
//
// 返回码：0 通过；1 注册失败；2 调用结果错；3 注销失败；4 池未归零；
// 5 cycles 不对；6 高水位不是 1；7 复用槽位不对；8 复用后代数未变；
// 9 重复注销未报 A-121；10 调用已注销句柄未报 A-121；11 填满 64 槽失败；
// 12 第 65 个注册未报 A-120；13 释放 64 槽后池未归零；14 退休注销数不对；
// 15 退休后注册未报 A-122；16 退休后调用旧句柄未报 A-121；17 退休后
// aui_cb_init 未恢复注册；18 state 填满未报 A-103；19 state 释放失败；
// 20 释放后重填未恢复。

include "../src/aui.ast";

let g_hits: i32 = 0;

fn tap_cb(user: ptr) : i32 {
    g_hits = g_hits + 1;
    return 0;
}

fn main() : i32 {
    aui_cb_init();
    // ---- 同一回调注册/调用/注销 10,000 次 ----
    let i: i32 = 0;
    while (i < 10000) {
        let h: i32 = aui_cb_register(tap_cb, 0);
        if (h < 0) { return 1; }
        let r: i32 = aui_cb_invoke(h, 0);
        if (r != 0 || g_hits != i + 1) { return 2; }
        let rel: i32 = aui_cb_release(h);
        if (rel != 1) { return 3; }
        i = i + 1;
    }
    if (aui_debug_cb_used() != 0) { return 4; }
    if (aui_debug_cb_cycles() != 20000) { return 5; }
    if (aui_debug_cb_hwm() != 1) { return 6; }

    // ---- 句柄复用：同一槽位、代数 +1 ----
    let h1: i32 = aui_cb_register(tap_cb, 0);
    if (h1 < 0) { return 1; }
    let rel1: i32 = aui_cb_release(h1);
    if (rel1 != 1) { return 3; }
    let h2: i32 = aui_cb_register(tap_cb, 0);
    if (h2 < 0) { return 1; }
    if ((h2 & 255) != (h1 & 255)) { return 7; }
    if (h2 == h1) { return 8; }
    // ---- 重复注销与调用已注销句柄 ----
    aui_clear_error();
    let rel2: i32 = aui_cb_release(h1);
    if (rel2 != 0 || aui_last_error() != 121) { return 9; }
    aui_clear_error();
    let bad: i32 = aui_cb_invoke(h1, 0);
    if (bad != -1 || aui_last_error() != 121) { return 10; }
    // h2 仍有效，用完注销。
    let rel3: i32 = aui_cb_release(h2);
    if (rel3 != 1) { return 3; }

    // ---- 容量：填满 64 槽，第 65 个记 A-120 ----
    let hs: i32[64] = 0;
    let k: i32 = 0;
    while (k < 64) {
        hs[k] = aui_cb_register(tap_cb, 0);
        if (hs[k] < 0) { return 11; }
        k = k + 1;
    }
    aui_clear_error();
    let over: i32 = aui_cb_register(tap_cb, 0);
    if (over != -1 || aui_last_error() != 120) { return 12; }
    k = 0;
    while (k < 64) {
        aui_cb_release(hs[k]);
        k = k + 1;
    }
    if (aui_debug_cb_used() != 0) { return 13; }

    // ---- Window 退休：先禁新注册，再注销释放 ----
    let a: i32 = aui_cb_register(tap_cb, 0);
    let b: i32 = aui_cb_register(tap_cb, 0);
    let retired_n: i32 = aui_cb_retire_all();
    if (retired_n != 2) { return 14; }
    if (aui_debug_cb_used() != 0) { return 4; }
    aui_clear_error();
    let after: i32 = aui_cb_register(tap_cb, 0);
    if (after != -1 || aui_last_error() != 122) { return 15; }
    aui_clear_error();
    let bad2: i32 = aui_cb_invoke(a, 0);
    if (bad2 != -1 || aui_last_error() != 121) { return 16; }
    // aui_cb_init 恢复（清 retired）。
    aui_cb_init();
    let ok: i32 = aui_cb_register(tap_cb, 0);
    if (ok < 0) { return 17; }
    aui_cb_release(ok);

    // ---- state 表：填满 256 槽，第 257 个记 A-103；释放后可重填 ----
    aui_clear_error();
    let s: i32 = 0;
    while (s < 256) {
        aui_state_set(1000 + s, s);
        s = s + 1;
    }
    aui_clear_error();
    aui_state_set(9999, 1);
    if (aui_last_error() != 103) { return 18; }
    let rels: i32 = aui_state_release(1000);
    if (rels != 1) { return 19; }
    aui_clear_error();
    aui_state_set(9999, 1);
    if (aui_last_error() != 0) { return 20; }
    if (aui_state_get(9999) != 1) { return 20; }
    return 0;
}
