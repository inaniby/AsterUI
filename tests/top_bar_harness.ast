// top_bar_harness.ast — v1.40 ui_top_bar 的真实宿主路径冒烟测试（qemu-user）。
//
// 720×1280 / density 420 的假宿主，走 ANativeActivity 回调创建窗口，然后：
// 版本号 14806；应用栏 48 dp（126 px）、leading 40 dp 贴左、两个动作贴右、
// 标题区间（leading 后 4 dp / 动作前 4 dp）；点 leading/Search/More 回调；
// 居中对齐、底部提示线、长标题裁剪、深色表面。
//
// 返回码：0 通过；10 attach 失败；11 回调表没写；12 屏幕全黑；
// 13 版本号不是 14806；20 栏几何不对；21 标题区间不对；22 回调不对；
// 23 居中不对；24 提示线不对；25 长标题不对；26 深色不对。
extern let g_fake_pixels: i32[921600];

extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_hit(px: i32, py: i32) -> i32;
extern fn aui_debug_top_bar(key: i32, out: ptr) -> i32;
extern fn aui_debug_scroll(key: i32) -> i32;
extern fn aui_debug_scroll_max(key: i32) -> i32;
extern fn aui_debug_scroll_set(key: i32, px: i32) -> i32;
extern fn aui_invalidate_layout() -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_frame(now: i64) -> i32;
extern fn aui_state_get(key: i32) -> i32;
extern fn aui_invalidate() -> i32;
extern fn aui_version() -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_post_key(action: i32, code: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;

let g_act: i64[11] = 0;
let g_cb: i64[16] = 0;
let g_win: i64[4] = 0;
let g_assets: i64[1] = 0;
let g_ext_path: u8[32] = 0;
let g_harness_anchor: ptr = g_act;

fn call_cb(off: i32, a: ptr, b: ptr) -> i32 {
    let cb: ptr = load_ptr(g_act);
    let f: fn(ptr, ptr) -> i32 = load_ptr(cb + off);
    return f(a, b);
}

fn frame_at(t: i64) -> i32 {
    fake_set_clock(t);
    return aui_frame(t);
}

fn tap_at(t: i64, x: i32, y: i32) -> i32 {
    fake_set_clock(t);
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    fake_set_clock(t + 50000000);
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn tap_key(t: i64, k: i32) -> i32 {
    let r: i32[4] = 0;
    if (aui_debug_rect(k, r) != 0) { return -1; }
    return tap_at(t, r[0] + r[2] / 2, r[1] + r[3] / 2);
}

fn px_off(x: i32, y: i32) -> i32 { return (y * 720 + x) * 4; }
fn chan(x: i32, y: i32, c: i32) -> i32 {
    if (x < 0 || y < 0 || x >= 720 || y >= 1280) { return 255; }
    return i32(load_u8(g_fake_pixels + px_off(x, y) + c));
}

// 把 key 滚到视口内（顶部留 ty 像素），成功返回 1。
fn show_key(t: i64, k: i32, ty: i32) -> i32 {
    let r: i32[4] = 0;
    if (aui_debug_rect(k, r) != 0) { return 0; }
    let ny: i32 = aui_debug_scroll(30) + r[1] - ty;
    if (ny < 0) { ny = 0; }
    let mx: i32 = aui_debug_scroll_max(30);
    if (ny > mx) { ny = mx; }
    aui_debug_scroll_set(30, ny);
    aui_invalidate_layout();
    frame_at(t);
    if (aui_debug_rect(k, r) != 0) { return 0; }
    if (r[1] < 0 || r[1] + r[3] > 1280) { return 0; }
    return 1;
}

fn toggle_switch(t: i64, k: i32) -> i32 {
    if (show_key(t, k, 700) == 0) { return 0; }
    if (tap_key(t + 10000000, k) != 0) { return 0; }
    frame_at(t + 120000000);
    return 1;
}

fn main() -> i32 {
    let act: ptr = g_act;
    *(act + 0) = g_cb;
    let assets: ptr = g_assets;
    *(act + 64) = assets;
    let ep: ptr = g_ext_path;
    store_u8(ep + 0, 47);
    store_u8(ep + 1, 116);
    store_u8(ep + 2, 109);
    store_u8(ep + 3, 112);
    store_u8(ep + 4, 47);
    store_u8(ep + 5, 97);
    store_u8(ep + 6, 115);
    store_u8(ep + 7, 116);
    store_u8(ep + 8, 101);
    store_u8(ep + 9, 114);
    store_u8(ep + 10, 117);
    store_u8(ep + 11, 105);
    store_u8(ep + 12, 45);
    store_u8(ep + 13, 105);
    store_u8(ep + 14, 99);
    store_u8(ep + 15, 111);
    store_u8(ep + 16, 110);
    store_u8(ep + 17, 0);
    *(act + 40) = ep;

    if (g_harness_anchor == 0) { return 10; }
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    let r: i32 = ANativeActivity_onCreate(act, 0, 0);
    if (r != 0) { return 10; }

    let cb: ptr = load_ptr(g_act);
    let f56: ptr = load_ptr(cb + 56);
    let f72: ptr = load_ptr(cb + 72);
    if (f56 == 0 || f72 == 0) { return 11; }

    let win: ptr = g_win;
    let s1: i32 = call_cb(0, act, 0);
    let s2: i32 = call_cb(8, act, 0);
    let s3: i32 = call_cb(56, act, win);
    let s4: i32 = call_cb(72, act, win);

    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < 720 * 1280 * 4) {
        sum = sum + load_u8(g_fake_pixels + i);
        i = i + 1;
    }
    if (sum == 0) { return 12; }
    if (aui_version() != 14806) { return 13; }

    let base: i64 = 5000000000;
    frame_at(base);

    let p: i32[16] = 0;
    let ar: i32[4] = 0;
    if (aui_debug_top_bar(10, p) != 0) { return 20; }
    if (p[0] != 0 || p[1] != 63 || p[2] != 720 || p[3] != 126) { return 20; }
    if (p[4] != 0 || p[5] != -10 || p[6] != 2 || p[7] != 0) { return 20; }

    // ---- leading 与动作几何（8 dp 内边距、40 dp 触控块、垂直居中） ----
    if (aui_debug_rect(-10, ar) != 0) { return 20; }
    if (ar[0] != 21 || ar[1] != 73 || ar[2] != 105 || ar[3] != 105) { return 20; }
    if (p[10] != 21 || p[11] != 105) { return 20; }
    if (aui_debug_rect(21, ar) != 0) { return 20; }
    if (ar[0] != 489 || ar[1] != 73 || ar[2] != 105) { return 20; }
    if (aui_debug_rect(22, ar) != 0) { return 20; }
    if (ar[0] != 594 || ar[1] != 73) { return 20; }

    // ---- 标题区间：leading 后 4 dp，动作前 4 dp；标题已绘制 ----
    if (p[8] != 136 || p[9] != 478) { return 21; }
    if (p[13] != 11 || p[12] <= 0 || p[12] >= p[9] - p[8]) { return 21; }
    if (p[14] != 136) { return 21; }
    if (p[15] <= 0 || (p[15] - p[1]) + 40 > 126) { return 21; }
    if (chan(4, 67, 0) != 0xFF || chan(4, 67, 1) != 0xFF) { return 20; }

    // ---- 回调：leading / Search / More ----
    if (tap_key(base + 100000000, -10) != 0) { return 22; }
    if (aui_state_get(980) != 1) { return 22; }
    if (tap_key(base + 200000000, 21) != 0) { return 22; }
    if (aui_state_get(981) != 1) { return 22; }
    if (tap_key(base + 300000000, 22) != 0) { return 22; }
    if (aui_state_get(982) != 1) { return 22; }
    if (aui_state_get(991) != 3) { return 22; }
    frame_at(base + 350000000);

    // ---- 居中对齐 ----
    if (toggle_switch(base + 400000000, 55) == 0) { return 23; }
    if (aui_state_get(983) != 1) { return 23; }
    if (aui_debug_top_bar(10, p) != 0) { return 23; }
    if (p[4] != 1) { return 23; }
    // 半像素几何下再 >>16，居中有 1 px 容差。
    let want_mid: i32 = p[8] + (p[9] - p[8] - p[12]) / 2;
    if (p[14] < want_mid - 1 || p[14] > want_mid + 1) { return 23; }
    if (p[14] <= p[8]) { return 23; }

    // ---- 底部提示线：最底 1 px 变暗，上一 px 仍是 surface ----
    if (toggle_switch(base + 600000000, 59) == 0) { return 24; }
    if (aui_state_get(984) != 1) { return 24; }
    if (aui_debug_top_bar(10, p) != 0) { return 24; }
    if (p[7] != 1) { return 24; }
    if (chan(300, 188, 0) >= 245) { return 24; }
    if (chan(300, 187, 0) != 0xFF) { return 24; }

    // ---- 长标题：宽度超过区间，起点贴左 ----
    if (toggle_switch(base + 800000000, 63) == 0) { return 25; }
    if (aui_state_get(985) != 1) { return 25; }
    if (aui_debug_top_bar(10, p) != 0) { return 25; }
    if (p[12] <= p[9] - p[8]) { return 25; }
    if (p[14] != p[8]) { return 25; }

    // ---- 深色主题：应用栏 surface 1E1E24 ----
    if (toggle_switch(base + 1000000000, 67) == 0) { return 26; }
    if (aui_state_get(986) != 1) { return 26; }
    if (aui_debug_top_bar(10, p) != 0) { return 26; }
    if (p[3] != 126) { return 26; }
    if (chan(4, 67, 0) != 0x1E) { return 26; }
    if (chan(4, 67, 1) != 0x1E) { return 26; }
    if (chan(4, 67, 2) != 0x24) { return 26; }

    return 0;
}
