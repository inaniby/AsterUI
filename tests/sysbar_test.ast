// sysbar_test.ast — v2.13 系统栏条带跟主题 + JNI 图标颜色离屏自检。
//
// headless 没有 JVM：测试在内存里搭一个假 JNIEnv 表（与
// ~/workspace/jni-probe/jni-table-call.ast 同一做法），假 Window /
// 假 controller 记录 setSystemBarsAppearance 收到的 appearance/mask。
// 校验：
// A0. 初始状态（sdk 0）：条带是 v1.15 旧深色，图标/JNI 状态为 0。
// A.  sdk 35 + 注入假 env：深色主题 -> appearance 0（浅色图标）+
//     深色条带（跟深色底色）；浅色主题 -> appearance 8（深色图标）+
//     浅色条带（跟浅色底色）；GetMethodID 顺序 getWindow、
//     getInsetsController、setSystemBarsAppearance；局部引用各删一次。
// B.  getInsetsController 返回空：回落（jni=2），条带按上次已知图标
//     取安全色（深色图标配浅色条带）；恢复后下一次翻主题即自愈。
// C.  注入异常：ExceptionCheck 报 1 后框架调 ExceptionClear 清掉
//     并回落；异常清掉后下一次翻主题即自愈。
// D.  env 缺失：回落，不崩；恢复 env 后下一次翻主题即自愈。
// E.  SDK 门：sdk 29 以下不调 JNI（setSystemBarsAppearance 一次
//     也不到）；sdk 回 35 后恢复正常。
// F.  显式覆盖仍优先：aui_set_system_bar(色) 压过主题角色；传 0 恢复。
// G.  同主题再调 aui_set_dark 不重复换图标。
// 无像素冻结基线：校验的是 appearance/条带色/回落状态，断言本身就是检查。
// 返回码：0 通过；2 版本号；10-19 A0；20-39 A；40-49 B；50-59 C；
// 60-69 D；70-79 E；80-89 F；90-99 G。
include "../src/aui.ast";
include "../src/aster_std.ast";

extern fn aui_set_dark(on: i32) -> i32;
extern fn aui_system_bar_color() -> u32;
extern fn aui_set_system_bar(color: u32) -> i32;
extern fn aui_debug_set_sdk(v: i32) -> i32;
extern fn aui_debug_set_jni_env(env: ptr) -> i32;
extern fn aui_debug_set_jni_act(act: ptr) -> i32;
extern fn aui_debug_sysbar_icons() -> i32;
extern fn aui_debug_sysbar_jni() -> i32;
extern fn aui_headless_init(build: fn(ptr) -> i32, user: ptr) -> i32;
extern fn aui_version() -> i32;

// ---- 假 JNI 表 + 假对象 + 记录桩 ----
// 表下标与框架一致（AOSP libnativehelper include_jni/jni.h）：
// ExceptionClear 17、DeleteLocalRef 23、GetObjectClass 31、
// GetMethodID 33、CallObjectMethodA 36、CallVoidMethodA 63、
// ExceptionCheck 228。
let sb_tbl: u8[2048] = 0;
let sb_env: u8[8] = 0;
let sb_act: u8[8] = 0;
let sb_win: u8[8] = 0;
let sb_ctl: u8[8] = 0;
let sb_cls: u8[8] = 0;
let sb_mid_getwin: u8[8] = 0;
let sb_mid_getctl: u8[8] = 0;
let sb_mid_setapp: u8[8] = 0;
let sb_last_app: i32 = -1;
let sb_last_mask: i32 = -1;
let sb_set_calls: i32 = 0;
let sb_getmid_names: u8[16] = 0;
let sb_getmid_n: i32 = 0;
let sb_delref_n: i32 = 0;
let sb_clear_calls: i32 = 0;
let sb_exc_on: i32 = 0;
let sb_null_ctl: i32 = 0;
let sb_null_win: i32 = 0;

fn sb_getclass(env: ptr, obj: ptr) -> ptr { return sb_cls; }

fn sb_getmid(env: ptr, cls: ptr, name: ptr, sig: ptr) -> ptr {
    if (sb_getmid_n < 16) {
        store_u8(sb_getmid_names + sb_getmid_n, load_u8(name));
        sb_getmid_n = sb_getmid_n + 1;
    }
    let c: i32 = load_u8(name);
    if (c == 115) { return sb_mid_setapp; }   // 's' setSystemBarsAppearance
    let c3: i32 = load_u8(name + 3);
    if (c3 == 87) { return sb_mid_getwin; }   // "getWindow"[3] = 'W'
    return sb_mid_getctl;                     // "getInsetsController"[3] = 'I'
}

fn sb_callobj(env: ptr, obj: ptr, mid: ptr, args: ptr) -> ptr {
    if (mid == sb_mid_getwin) {
        if (sb_null_win != 0) { return 0; }
        return sb_win;
    }
    if (mid == sb_mid_getctl) {
        if (sb_null_ctl != 0) { return 0; }
        return sb_ctl;
    }
    return 0;
}

fn sb_callvoid(env: ptr, obj: ptr, mid: ptr, args: ptr) -> i32 {
    sb_set_calls = sb_set_calls + 1;
    sb_last_app = i32(load_i64(args));
    sb_last_mask = i32(load_i64(args + 8));
    return 0;
}

fn sb_exc(env: ptr) -> i32 {
    if (sb_exc_on != 0) { return 1; }
    return 0;
}

fn sb_clear(env: ptr) -> i32 {
    sb_clear_calls = sb_clear_calls + 1;
    sb_exc_on = 0;
    return 0;
}

fn sb_delref(env: ptr, obj: ptr) -> i32 {
    sb_delref_n = sb_delref_n + 1;
    return 0;
}

fn build(user: ptr) -> i32 {
    aui_root();
    aui_column(1);
    aui_label(10, "Sysbar");
    aui_end();
    return 0;
}

fn main() -> i32 {
    if (aui_version() != 14806) { return 2; }
    *(sb_tbl + 17 * 8) = sb_clear;
    *(sb_tbl + 23 * 8) = sb_delref;
    *(sb_tbl + 31 * 8) = sb_getclass;
    *(sb_tbl + 33 * 8) = sb_getmid;
    *(sb_tbl + 36 * 8) = sb_callobj;
    *(sb_tbl + 63 * 8) = sb_callvoid;
    *(sb_tbl + 228 * 8) = sb_exc;
    *(sb_env) = sb_tbl;
    aui_headless_init(build, 0);

    // ---- A0. 初始状态：sdk 0，条带是 v1.15 旧深色 ----
    if (aui_system_bar_color() != 0xFF1B1B1F) { return 10; }
    if (aui_debug_sysbar_icons() != 0) { return 11; }
    if (aui_debug_sysbar_jni() != 0) { return 12; }

    // ---- A. sdk 35 + 注入假 env ----
    let s0: i32 = aui_debug_set_sdk(35);
    let e0: i32 = aui_debug_set_jni_env(sb_env);
    let a0: i32 = aui_debug_set_jni_act(sb_act);
    // 深色：appearance 0（浅色图标），条带跟深色底色。
    let d1: i32 = aui_set_dark(1);
    if (sb_last_app != 0 || sb_last_mask != 8) { return 20; }
    if (sb_set_calls != 1) { return 21; }
    if (aui_debug_sysbar_icons() != 0) { return 22; }
    if (aui_debug_sysbar_jni() != 1) { return 23; }
    if (aui_system_bar_color() != 0xFF121216) { return 24; }
    // GetMethodID 顺序：getWindow、getInsetsController、setSystemBarsAppearance。
    if (sb_getmid_n != 3) { return 25; }
    if (load_u8(sb_getmid_names + 0) != 103) { return 26; }
    if (load_u8(sb_getmid_names + 1) != 103) { return 26; }
    if (load_u8(sb_getmid_names + 2) != 115) { return 26; }
    // 局部引用：acls、wcls、win、ccls、ctl 各删一次。
    if (sb_delref_n != 5) { return 27; }
    // 浅色：appearance 8（深色图标），条带跟浅色底色。
    let d2: i32 = aui_set_dark(0);
    if (sb_last_app != 8 || sb_last_mask != 8) { return 28; }
    if (sb_set_calls != 2) { return 29; }
    if (aui_debug_sysbar_icons() != 8) { return 30; }
    if (aui_debug_sysbar_jni() != 1) { return 31; }
    if (aui_system_bar_color() != 0xFFF6F6F8) { return 32; }

    // ---- B. 空 controller 回落 ----
    sb_null_ctl = 1;
    let d3: i32 = aui_set_dark(1);
    if (aui_debug_sysbar_jni() != 2) { return 40; }
    if (aui_debug_sysbar_icons() != 8) { return 41; }
    // 回落条带按上次已知图标取安全色：深色图标配浅色条带。
    if (aui_system_bar_color() != 0xFFF6F6F8) { return 42; }
    sb_null_ctl = 0;
    let d4: i32 = aui_set_dark(0);
    if (aui_debug_sysbar_jni() != 1) { return 43; }
    if (aui_system_bar_color() != 0xFFF6F6F8) { return 44; }

    // ---- C. 注入异常回落 + 自愈 ----
    sb_exc_on = 1;
    let cc0: i32 = sb_clear_calls;
    let d5: i32 = aui_set_dark(1);
    if (aui_debug_sysbar_jni() != 2) { return 50; }
    if (sb_clear_calls != cc0 + 1) { return 51; }
    if (aui_debug_sysbar_icons() != 8) { return 52; }
    if (aui_system_bar_color() != 0xFFF6F6F8) { return 53; }
    // 异常已被 mock 的 ExceptionClear 清掉，再翻一次即自愈。
    let d6: i32 = aui_set_dark(0);
    if (aui_debug_sysbar_jni() != 1) { return 54; }
    if (sb_last_app != 8) { return 55; }
    if (aui_system_bar_color() != 0xFFF6F6F8) { return 56; }

    // ---- D. 无 env 回落 ----
    let e1: i32 = aui_debug_set_jni_env(0);
    let d7: i32 = aui_set_dark(1);
    if (aui_debug_sysbar_jni() != 2) { return 60; }
    if (aui_system_bar_color() != 0xFFF6F6F8) { return 61; }
    let e2: i32 = aui_debug_set_jni_env(sb_env);
    let d8: i32 = aui_set_dark(0);
    if (aui_debug_sysbar_jni() != 1) { return 62; }

    // ---- E. SDK 门：29 以下不调 JNI ----
    let sc0: i32 = sb_set_calls;
    let s1: i32 = aui_debug_set_sdk(29);
    let d9: i32 = aui_set_dark(1);
    if (aui_debug_sysbar_jni() != 2) { return 70; }
    if (sb_set_calls != sc0) { return 71; }
    let s2: i32 = aui_debug_set_sdk(35);
    let d10: i32 = aui_set_dark(0);
    if (aui_debug_sysbar_jni() != 1) { return 72; }

    // ---- F. 显式覆盖仍优先；传 0 恢复主题角色 ----
    let o1: i32 = aui_set_system_bar(0xFF112233);
    if (aui_system_bar_color() != 0xFF112233) { return 80; }
    let o2: i32 = aui_set_system_bar(0);
    if (aui_system_bar_color() != 0xFFF6F6F8) { return 81; }

    // ---- G. 同主题再调不重复换图标 ----
    let sc1: i32 = sb_set_calls;
    let d11: i32 = aui_set_dark(0);
    if (sb_set_calls != sc1) { return 90; }

    return 0;
}
