// flex_repro.ast -- TEMPORARY headless repro for the v2.1 blob glyphs.
// Renders a set of code points through the adapter and dumps each
// 48x48 bitmap as ASCII art (# = alpha>128, + = alpha>0) plus ink
// counts. Run under qemu against the VM TTCs (Regular then Bold).
// ASCII-only source.

include "../aster_std.ast";

extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_rt_active() -> i32;
extern fn aui_rt_glyph(cp: i32) -> i32;
extern fn aui_rt_bm() -> ptr;
extern fn aui_rt_bw() -> i32;
extern fn aui_rt_bh() -> i32;
extern fn aui_rt_src() -> i32;
extern fn ui_tt_decode_failures() -> i32;
extern fn ui_tt_scan_overflows() -> i32;

fn out_str(s: ptr) -> i32 {
    return write_all(1, s, strlen(s));
}

fn out_i32(v: i32) -> i32 {
    let buf: u8[32] = 0;
    let n: i32 = fmt_i32(buf, v);
    return write_all(1, buf, n);
}

fn dump_glyph(name: ptr, cp: i32) -> i32 {
    let g: i32 = aui_rt_glyph(cp);
    let s1: i32 = out_str("=== ");
    let s2: i32 = out_str(name);
    let s3: i32 = out_str(" cp=");
    let s4: i32 = out_i32(cp);
    let s5: i32 = out_str(" glyph=");
    let s6: i32 = out_i32(g);
    let s7: i32 = out_str(" src=");
    let s8: i32 = out_i32(aui_rt_src());
    let s9: i32 = out_str("\n");
    if (g == 0) {
        return 0;
    } else {
    }
    let bm: ptr = aui_rt_bm();
    let bw: i32 = aui_rt_bw();
    let bh: i32 = aui_rt_bh();
    let ink: i32 = 0;
    let full: i32 = 0;
    let y: i32 = 0;
    while (y < bh) {
        let x: i32 = 0;
        while (x < bw) {
            let v: i32 = load_u8(bm + y * bw + x);
            if (v > 128) {
                let w: i32 = write_all(1, "#", 1);
                full = full + 1;
            } else {
                if (v > 0) {
                    let w2: i32 = write_all(1, "+", 1);
                } else {
                    let w3: i32 = write_all(1, ".", 1);
                }
            }
            if (v > 0) {
                ink = ink + 1;
            } else {
            }
            x = x + 1;
        }
        let nl: i32 = write_all(1, "\n", 1);
        y = y + 1;
    }
    let t1: i32 = out_str("ink=");
    let t2: i32 = out_i32(ink);
    let t3: i32 = out_str(" full=");
    let t4: i32 = out_i32(full);
    let t5: i32 = out_str(" decodefail=");
    let t6: i32 = out_i32(ui_tt_decode_failures());
    let t7: i32 = out_str(" overflow=");
    let t8: i32 = out_i32(ui_tt_scan_overflows());
    let t9: i32 = out_str("\n");
    return 0;
}

fn main() -> i32 {
    let lt: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    let a0: i32 = out_str("--- Regular TTC load=");
    let a1: i32 = out_i32(lt);
    let a2: i32 = out_str(" active=");
    let a3: i32 = out_i32(aui_rt_active());
    let a4: i32 = out_str("\n");
    let d1: i32 = dump_glyph("A", 65);
    let d2: i32 = dump_glyph("e", 101);
    let d3: i32 = dump_glyph("o", 111);
    let d4: i32 = dump_glyph("a", 97);
    let d5: i32 = dump_glyph("g", 103);
    let d6: i32 = dump_glyph("c", 99);
    let d7: i32 = dump_glyph("p", 112);
    let d8: i32 = dump_glyph("0", 48);
    let d9: i32 = dump_glyph("5", 53);
    let d10: i32 = dump_glyph("6", 54);
    let d11: i32 = dump_glyph("S", 83);
    let d12: i32 = dump_glyph("B", 66);
    let d13: i32 = dump_glyph("yi3", 0x5DF2);
    let d14: i32 = dump_glyph("zhong", 0x4E2D);
    let lt2: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc");
    let b0: i32 = out_str("--- Bold TTC load=");
    let b1: i32 = out_i32(lt2);
    let b2: i32 = out_str(" active=");
    let b3: i32 = out_i32(aui_rt_active());
    let b4: i32 = out_str("\n");
    let e1: i32 = dump_glyph("A", 65);
    let e2: i32 = dump_glyph("e", 101);
    let e3: i32 = dump_glyph("o", 111);
    let e4: i32 = dump_glyph("a", 97);
    let e5: i32 = dump_glyph("g", 103);
    let e6: i32 = dump_glyph("c", 99);
    let e7: i32 = dump_glyph("p", 112);
    let e8: i32 = dump_glyph("0", 48);
    let e9: i32 = dump_glyph("5", 53);
    let e10: i32 = dump_glyph("6", 54);
    let e11: i32 = dump_glyph("S", 83);
    let e12: i32 = dump_glyph("B", 66);
    let e13: i32 = dump_glyph("yi3", 0x5DF2);
    let e14: i32 = dump_glyph("zhong", 0x4E2D);
    let e: i32 = eputs("DONE: flex_repro\n");
    return 0;
}
