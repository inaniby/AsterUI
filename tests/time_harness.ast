// time_harness.ast — v1.29 ui_time 的真实宿主路径冒烟测试（qemu-user）。
//
// 720×1280 / density 420 的假宿主，走 ANativeActivity 回调创建窗口，然后：
// 初始 09:30 / 24 小时制；点分字段再点表盘 05 分 -> 09:05，拖动到 10 分；
// 选时点外圈 12 -> 12:10 并自动进入选分；开 12 小时制后 AM/PM 切换；
// 24 小时制内圈 00/13；步长 15 的吸附；深色主题变深。版本号 14806。
//
// 返回码：0 通过；10 attach 失败；11 回调表没写；12 屏幕全黑；
// 13 版本号不是 14806；14 选择器几何不对；15 初始状态不对；
// 16 切分字段失败；17 点表盘 05 分失败；18 拖动到 10 分失败；
// 19 选时/自动进分失败；20 12 小时制切换失败；21 AM/PM 失败；
// 22 内圈 00/13 失败；23 步长 15 吸附失败；24 分钟 25 -> 30 失败；
// 25 深色底没变深；26 12h/15m 开关宽度不一致；27 23/24/25 分映射失败；
// 28 1 分钟手柄像素不对；90 内容超出 720×1280。
extern let g_fake_pixels: i32[921600];

extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_time_part(key: i32, part: i32, out: ptr) -> i32;
extern fn aui_debug_time_view(key: i32, out: ptr) -> i32;
extern fn aui_debug_node_count() -> i32;
extern fn aui_debug_scroll(key: i32) -> i32;
extern fn aui_debug_scroll_max(key: i32) -> i32;
extern fn aui_debug_scroll_set(key: i32, px: i32) -> i32;
extern fn aui_invalidate_layout() -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_frame(now: i64) -> i32;
extern fn aui_state_get(key: i32) -> i32;
extern fn aui_version() -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;

let g_act: i64[11] = 0;
let g_cb: i64[16] = 0;
let g_win: i64[4] = 0;
let g_assets: i64[1] = 0;
let g_ext_path: u8[32] = 0;
let g_harness_anchor: ptr = g_act;

fn call_cb(off: i32, a: ptr, b: ptr) -> i32 {
    let cb: ptr = load_ptr(g_act);
    let f: fn(ptr, ptr) -> i32 = load_ptr(cb + off);
    return f(a, b);
}

fn tap(x: i32, y: i32) -> i32 {
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn drag(x0: i32, y0: i32, x1: i32, y1: i32) -> i32 {
    fake_post_motion(0, x0, y0);
    aui_on_input(1, 0, 0);
    let i: i32 = 1;
    while (i <= 4) {
        let mx: i32 = x0 + (x1 - x0) * i / 4;
        let my: i32 = y0 + (y1 - y0) * i / 4;
        fake_post_motion(2, mx, my);
        aui_on_input(1, 0, 0);
        i = i + 1;
    }
    fake_post_motion(1, x1, y1);
    aui_on_input(1, 0, 0);
    return 0;
}

fn frame_at(t: i64) -> i32 {
    fake_set_clock(t);
    return aui_frame(t);
}

fn part(key: i32, idx: i32) -> i32 {
    let v: i32[1] = 0;
    return aui_debug_time_part(key, idx, v);
}

fn px_off(x: i32, y: i32) -> i32 {
    return (y * 720 + x) * 4;
}

// 返回 0..255 的亮度。
fn lum(x: i32, y: i32) -> i32 {
    let o: i32 = px_off(x, y);
    let r: i32 = i32(load_u8(g_fake_pixels + o + 0));
    let g: i32 = i32(load_u8(g_fake_pixels + o + 1));
    let b: i32 = i32(load_u8(g_fake_pixels + o + 2));
    return (r + g + b) / 3;
}

fn main() -> i32 {
    let act: ptr = g_act;
    *(act + 0) = g_cb;
    let assets: ptr = g_assets;
    *(act + 64) = assets;
    store_u8(g_ext_path + 0, 47);
    store_u8(g_ext_path + 1, 116);
    store_u8(g_ext_path + 2, 109);
    store_u8(g_ext_path + 3, 112);
    store_u8(g_ext_path + 4, 47);
    store_u8(g_ext_path + 5, 97);
    store_u8(g_ext_path + 6, 115);
    store_u8(g_ext_path + 7, 116);
    store_u8(g_ext_path + 8, 101);
    store_u8(g_ext_path + 9, 114);
    store_u8(g_ext_path + 10, 117);
    store_u8(g_ext_path + 11, 105);
    store_u8(g_ext_path + 12, 45);
    store_u8(g_ext_path + 13, 116);
    store_u8(g_ext_path + 14, 114);
    store_u8(g_ext_path + 15, 97);
    store_u8(g_ext_path + 16, 99);
    store_u8(g_ext_path + 17, 101);
    store_u8(g_ext_path + 18, 0);
    let ep: ptr = g_ext_path;
    *(act + 40) = ep;

    if (g_harness_anchor == 0) { return 10; }
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    let r: i32 = ANativeActivity_onCreate(act, 0, 0);
    if (r != 0) { return 10; }

    let cb: ptr = load_ptr(g_act);
    let f56: ptr = load_ptr(cb + 56);
    let f72: ptr = load_ptr(cb + 72);
    if (f56 == 0 || f72 == 0) { return 11; }

    let win: ptr = g_win;
    let s1: i32 = call_cb(0, act, 0);
    let s2: i32 = call_cb(8, act, 0);
    let s3: i32 = call_cb(56, act, win);
    let s4: i32 = call_cb(72, act, win);

    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < 720 * 1280 * 4) {
        sum = sum + load_u8(g_fake_pixels + i);
        i = i + 1;
    }
    if (sum == 0) { return 12; }
    if (aui_version() != 14806) { return 13; }

    let base: i64 = 3000000000;
    frame_at(base);

    // ---- A. 几何：卡片内选择器，表盘半径约 265 px ----
    let v: i32[8] = 0;
    if (aui_debug_time_view(30, v) != 0) { return 14; }
    let x0: i32 = v[0];
    let y0: i32 = v[1];
    let w0: i32 = v[2];
    let h0: i32 = v[3];
    let cx: i32 = v[4];
    let cy: i32 = v[5];
    let dr: i32 = v[6];
    let hh: i32 = v[7];
    if (w0 < 570 || w0 > 580 || h0 < 745 || h0 > 760) { return 14; }
    if (dr < 250 || dr > 260 || hh < 130 || hh > 140) { return 14; }
    // 页面已可滚动（根改为 aui_scroll(1)），表盘底部在折叠线下是正常的；
    // 底部可达性见 H 节。
    if (part(30, 0) != 9 || part(30, 1) != 30) { return 15; }
    if (part(30, 2) != 0 || part(30, 3) != 0) { return 15; }
    if (part(30, 4) != 1 || part(30, 5) != 570) { return 15; }
    if (aui_state_get(900) != 0) { return 15; }

    let hy: i32 = y0 + 32 + hh / 2;
    let hx_hour: i32 = cx - 105;
    let hx_min: i32 = cx + 105;
    let light: i32 = lum(x0 + w0 - 20, y0 + 10);

    // ---- B. 分字段：05 分 -> 09:05，拖动到 10 分 ----
    tap(hx_min, hy);
    frame_at(base + 1000000000);
    if (part(30, 2) != 1) { return 16; }
    if (aui_state_get(900) != 0) { return 16; }
    let rr: i32 = (dr * 78) / 100;
    tap(cx + rr / 2, cy - (rr * 866) / 1000);
    frame_at(base + 2000000000);
    if (part(30, 0) != 9 || part(30, 1) != 5) { return 17; }
    if (aui_state_get(900) != 1 || aui_state_get(901) != 905) { return 17; }
    drag(cx + rr / 2, cy - (rr * 866) / 1000,
         cx + (rr * 866) / 1000, cy - rr / 2);
    frame_at(base + 3000000000);
    if (part(30, 0) != 9 || part(30, 1) != 10) { return 18; }
    if (aui_state_get(901) != 910) { return 18; }
    if (aui_state_get(900) < 2) { return 18; }

    // ---- B2. 1 分钟粒度（v1.29.1）：23/24/25 分手柄对准角度；24 分时
    // 5 dp 圆头不会像旧 14 dp 圆那样盖住 25 分标签。 ----
    tap(cx + (rr * 42363) / 65536, cy + (rr * 47161) / 65536);
    frame_at(base + 3500000000);
    if (part(30, 0) != 9 || part(30, 1) != 23) { return 27; }
    let t24x: i32 = cx + (rr * 37566) / 65536;
    let t24y: i32 = cy + (rr * 51958) / 65536;
    tap(t24x, t24y);
    frame_at(base + 3600000000);
    if (part(30, 0) != 9 || part(30, 1) != 24) { return 27; }
    // 手柄中心被 25 分标签盖住（v1.29.1 标签后画）；在中心 +/-2 px 邻域内找主色。
    let prim28: i32 = 0;
    let tp28: i32 = i32(load_u8(g_fake_pixels + px_off(t24x, t24y - 2) + 0));
    let tq28: i32 = i32(load_u8(g_fake_pixels + px_off(t24x, t24y - 2) + 2));
    if (tq28 >= 200 && tp28 <= 120) { prim28 = 1; }
    tp28 = i32(load_u8(g_fake_pixels + px_off(t24x + 2, t24y) + 0));
    tq28 = i32(load_u8(g_fake_pixels + px_off(t24x + 2, t24y) + 2));
    if (tq28 >= 200 && tp28 <= 120) { prim28 = 1; }
    tp28 = i32(load_u8(g_fake_pixels + px_off(t24x, t24y + 2) + 0));
    tq28 = i32(load_u8(g_fake_pixels + px_off(t24x, t24y + 2) + 2));
    if (tq28 >= 200 && tp28 <= 120) { prim28 = 1; }
    tp28 = i32(load_u8(g_fake_pixels + px_off(t24x - 2, t24y) + 0));
    tq28 = i32(load_u8(g_fake_pixels + px_off(t24x - 2, t24y) + 2));
    if (tq28 >= 200 && tp28 <= 120) { prim28 = 1; }
    if (prim28 == 0) { return 28; }
    let qx: i32 = t24x + 25;
    let qy: i32 = t24y - 18;
    let qr: i32 = i32(load_u8(g_fake_pixels + px_off(qx, qy) + 0));
    let qb: i32 = i32(load_u8(g_fake_pixels + px_off(qx, qy) + 2));
    // 主色 B-R 约 180；tint / 文字都远小于 60。
    if (qb - qr > 60) { return 28; }
    tap(cx + (rr * 32768) / 65536, cy + (rr * 56756) / 65536);
    frame_at(base + 3700000000);
    if (part(30, 0) != 9 || part(30, 1) != 25) { return 27; }
    // 回到 10 分，后续用例继续。
    tap(cx + (rr * 866) / 1000, cy - rr / 2);
    frame_at(base + 3800000000);
    if (part(30, 1) != 10) { return 27; }

    // ---- C. 选时：外圈 12 -> 12:10，松手自动进选分 ----
    tap(hx_hour, hy);
    frame_at(base + 4000000000);
    if (part(30, 2) != 0) { return 19; }
    tap(cx, cy - rr);
    frame_at(base + 5000000000);
    if (part(30, 0) != 12 || part(30, 1) != 10) { return 19; }
    if (part(30, 2) != 1) { return 19; }
    if (aui_state_get(901) != 1210) { return 19; }

    // ---- D. 12 小时制：AM/PM 组切换 ----
    let sw: i32[4] = 0;
    if (aui_debug_rect(26, sw) != 0) { return 20; }
    tap(sw[0] + sw[2] / 2, sw[1] + sw[3] / 2);
    frame_at(base + 6000000000);
    if (part(30, 3) != 1) { return 20; }
    if (part(30, 0) != 12 || part(30, 1) != 10) { return 20; }
    // v1.29.1：weight 只能给空位。12h 与 15m 两个开关必须同宽，
    // 不能把 12h 开关本身拉长（否则右侧整组看起来“偏移”）。
    let sw2: i32[4] = 0;
    if (aui_debug_rect(27, sw2) != 0) { return 26; }
    if (sw[2] != sw2[2] || sw[3] != sw2[3]) { return 26; }
    if (sw[2] < 110 || sw[2] > 150) { return 26; }
    let px_am: i32 = cx + 199;
    let y_am: i32 = y0 + 32 + hh / 4;
    let y_pm: i32 = y0 + 32 + hh - hh / 4;
    tap(px_am, y_am);
    frame_at(base + 7000000000);
    if (part(30, 0) != 0 || part(30, 1) != 10) { return 21; }
    if (aui_state_get(901) != 10) { return 21; }
    tap(px_am, y_pm);
    frame_at(base + 8000000000);
    if (part(30, 0) != 12 || part(30, 1) != 10) { return 21; }
    if (aui_state_get(901) != 1210) { return 21; }

    // ---- E. 回 24 小时制：外圈 9，内圈 00 / 13 ----
    tap(sw[0] + sw[2] / 2, sw[1] + sw[3] / 2);
    frame_at(base + 9000000000);
    if (part(30, 3) != 0) { return 22; }
    tap(hx_hour, hy);
    frame_at(base + 10000000000);
    tap(cx - rr, cy);
    frame_at(base + 11000000000);
    if (part(30, 0) != 9 || part(30, 1) != 10) { return 22; }
    tap(hx_hour, hy);
    frame_at(base + 12000000000);
    let ri: i32 = (dr * 52) / 100;
    tap(cx, cy - ri);
    frame_at(base + 13000000000);
    if (part(30, 0) != 0 || part(30, 1) != 10) { return 22; }
    tap(hx_hour, hy);
    frame_at(base + 14000000000);
    tap(cx + ri / 2, cy - (ri * 866) / 1000);
    frame_at(base + 15000000000);
    if (part(30, 0) != 13 || part(30, 1) != 10) { return 22; }

    // ---- F. 步长 15：10 分 -> 15，25 分 -> 30 ----
    if (aui_debug_rect(27, sw) != 0) { return 23; }
    tap(sw[0] + sw[2] / 2, sw[1] + sw[3] / 2);
    frame_at(base + 16000000000);
    if (part(30, 4) != 15) { return 23; }
    tap(hx_min, hy);
    frame_at(base + 17000000000);
    tap(cx + (rr * 866) / 1000, cy - rr / 2);
    frame_at(base + 18000000000);
    if (part(30, 0) != 13 || part(30, 1) != 15) { return 23; }
    if (aui_state_get(901) != 1315) { return 23; }
    tap(cx + rr / 2, cy + (rr * 866) / 1000);
    frame_at(base + 19000000000);
    if (part(30, 0) != 13 || part(30, 1) != 30) { return 24; }
    if (aui_state_get(901) != 1330) { return 24; }

    // ---- G. 深色主题：选择器卡片底应明显变暗 ----
    if (aui_debug_rect(25, sw) != 0) { return 25; }
    tap(sw[0] + sw[2] / 2, sw[1] + sw[3] / 2);
    frame_at(base + 20000000000);
    let dark: i32 = lum(x0 + w0 - 20, y0 + 10);
    if (light < 200) { return 25; }
    if (dark > 80) { return 25; }

    // ---- H. 页面底部可滚到：滚到底后提示行完全可见 ----
    let mx90: i32 = aui_debug_scroll_max(1);
    aui_debug_scroll_set(1, mx90);
    aui_invalidate_layout();
    frame_at(base + 21000000000);
    let hr: i32[4] = 0;
    if (aui_debug_rect(15, hr) != 0) { return 90; }
    if (hr[1] < 63 || hr[1] + hr[3] > 1217) { return 90; }

    let s5: i32 = call_cb(24, act, 0);
    let s6: i32 = call_cb(32, act, 0);
    let s7: i32 = call_cb(40, act, 0);
    return 0;
}
