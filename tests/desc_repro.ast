// desc_repro.ast -- TEMPORARY headless repro for the v2.2 descender
// clipping. Renders descender glyphs through the adapter and counts
// ink below the baseline row (42 at 48px em, map_asc 880) and below
// the old 48-row cell bottom. Pre-fix: bh == 48 and zero ink below
// row 48 (the tails are clipped). Post-fix: bh > 48 with ink in
// rows 48..bh-1. Run under qemu against the VM TTC (Regular).
// ASCII-only source.

include "../aster_std.ast";

extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_rt_active() -> i32;
extern fn aui_rt_glyph(cp: i32) -> i32;
extern fn aui_rt_bm() -> ptr;
extern fn aui_rt_bw() -> i32;
extern fn aui_rt_bh() -> i32;
extern fn aui_rt_src() -> i32;
extern fn ui_tt_decode_failures() -> i32;
extern fn ui_tt_scan_overflows() -> i32;

fn out_str(s: ptr) -> i32 {
    return write_all(1, s, strlen(s));
}

fn out_i32(v: i32) -> i32 {
    let buf: u8[32] = 0;
    let n: i32 = fmt_i32(buf, v);
    return write_all(1, buf, n);
}

// Ink in rows [r0, r1) of the staged bitmap.
fn ink_rows(bm: ptr, bw: i32, r0: i32, r1: i32) -> i32 {
    let n: i32 = 0;
    let y: i32 = r0;
    while (y < r1) {
        let x: i32 = 0;
        while (x < bw) {
            if (load_u8(bm + y * bw + x) > 0) {
                n = n + 1;
            } else {
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return n;
}

fn dump_glyph(name: ptr, cp: i32) -> i32 {
    let g: i32 = aui_rt_glyph(cp);
    let s1: i32 = out_str("=== ");
    let s2: i32 = out_str(name);
    let s3: i32 = out_str(" cp=");
    let s4: i32 = out_i32(cp);
    let s5: i32 = out_str(" glyph=");
    let s6: i32 = out_i32(g);
    let s7: i32 = out_str(" src=");
    let s8: i32 = out_i32(aui_rt_src());
    let s9: i32 = out_str("\n");
    if (g == 0) {
        return 0;
    } else {
    }
    let bm: ptr = aui_rt_bm();
    let bw: i32 = aui_rt_bw();
    let bh: i32 = aui_rt_bh();
    let ink: i32 = ink_rows(bm, bw, 0, bh);
    // Baseline row 42 (map_asc 880 * 48 / upm 1000); rows 43.. are
    // below the baseline, rows 48.. are below the old cell bottom.
    let below_base: i32 = ink_rows(bm, bw, 43, bh);
    let below_cell: i32 = 0;
    if (bh > 48) {
        below_cell = ink_rows(bm, bw, 48, bh);
    } else {
    }
    let t1: i32 = out_str("bh=");
    let t2: i32 = out_i32(bh);
    let t3: i32 = out_str(" bw=");
    let t4: i32 = out_i32(bw);
    let t5: i32 = out_str(" ink=");
    let t6: i32 = out_i32(ink);
    let t7: i32 = out_str(" below_base=");
    let t8: i32 = out_i32(below_base);
    let t9: i32 = out_str(" below_cell48=");
    let ta: i32 = out_i32(below_cell);
    let tb: i32 = out_str("\n");
    let y: i32 = 0;
    while (y < bh) {
        let x: i32 = 0;
        while (x < bw) {
            let v: i32 = load_u8(bm + y * bw + x);
            if (v > 128) {
                let w: i32 = write_all(1, "#", 1);
            } else {
                if (v > 0) {
                    let w2: i32 = write_all(1, "+", 1);
                } else {
                    let w3: i32 = write_all(1, ".", 1);
                }
            }
            x = x + 1;
        }
        let n1: i32 = write_all(1, "\n", 1);
        y = y + 1;
    }
    return 0;
}

fn main() -> i32 {
    let lt: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    if (lt != 1) {
        let e: i32 = eputs("FAIL: TTC load failed\n");
        return 2;
    } else {
    }
    let d1: i32 = dump_glyph("g", 103);
    let d2: i32 = dump_glyph("p", 112);
    let d3: i32 = dump_glyph("y", 121);
    let d4: i32 = dump_glyph("j", 106);
    let d5: i32 = dump_glyph("q", 113);
    let d6: i32 = dump_glyph("A", 65);
    let d7: i32 = dump_glyph("zhong", 0x4E2D);
    let d8: i32 = dump_glyph("e", 101);
    let df: i32 = ui_tt_decode_failures();
    let so: i32 = ui_tt_scan_overflows();
    let u1: i32 = out_str("decodefail=");
    let u2: i32 = out_i32(df);
    let u3: i32 = out_str(" scanoverflow=");
    let u4: i32 = out_i32(so);
    let u5: i32 = out_str("\n");
    if (df != 0) {
        let e2: i32 = eputs("FAIL: decode failures != 0\n");
        return 3;
    } else {
    }
    let e3: i32 = eputs("PASS: desc_repro\n");
    return 0;
}
