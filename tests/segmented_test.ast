// segmented_test.ast — v1.21 分段控件离屏自检（qemu-user）。
//
// W5 重定基线：先加载 VM 的 TrueType 字体（aui_rt_set_font_path），文本用
// 原生 48 px em（scale 1，旧 8 px 字体 1 倍已删）。SafeArea 内容区 y 从 24 起。
// 段高 = 行高 60 + 14 = 74（measure_segment）；段宽 = 文字宽 + 28（最小 48）：
// "A"/"B" 58 px，"Longer" 183 px。主容器 288 宽不变（铺满），三段各 96。
// 密度 160（dp == px），320x240。布局：column pad 16 gap 8，
// 第一行标题，第二行三分段（Low/Mid/High），第三行一个 row 里放 "W" + 两分段（A/B），
// 再一行放 "T" + 三分段（A/Longer/B，固有宽度 58+183+58=299）。
// 校验：容器/段矩形（等宽、末段吃余数）、8dp 边框 + 1dp 内衬、2dp 胶囊内缩、
// 选中主色、未选 SURFACE、按下 PRESSED、标签颜色、点按回调与下标回读、
// 行内固有宽度（不铺满）、点容器外不回调。
// 返回码：0 通过；1 首次绘制；2 节点数；3 容器矩形；4~6 三个段矩形；
// 7 选中胶囊；8 外边框；9 内衬上边；10 胶囊上边；11 胶囊下边；12 内衬下边；
// 13 未选段底色；14 左边框；15 选中段白字；16 未选段深字；17 点 High 下标；
// 18 点 High 次数；19 重绘；20 High 变主色；21 Low 回底色；22 重建后回读；
// 23 点 Low 下标；24 点 Low 次数；25 重绘；26 Low 变主色；27 High 回底色；
// 28 再点已选中段次数；29 下标不变；30 按下 High 变 PRESSED；31 按下态上边；
// 32 松手选中 High；33 松手次数；34 松手后主色；35 点容器外不回调；
// 90 字体加载失败。
// 36 行内容器固有宽度；37~38 行内两段矩形；39 行内初始下标；40 点 B 下标；
// 41 点 B 次数；42 重绘；43 B 主色；44 A 底色；45 主控件不受影响；
// 46 重建后行内回读；47 未知 key 返回 -1；48 三段容器固有宽度；
// 49~51 三段矩形（172/3 在 Q16.16 里等分，坐标取整）；52 三段初始下标。

include "../src/aui.ast";

extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;

let g_buf: u8[307200] = 0;   // 320x240 RGBA
let g_font: ptr = 0; // W4: .auf removed (no font files in repo; runtime adapter, see font_runtime.ast)

struct T {
    sel: i32,
    taps: i32,
    rsel: i32,
    rtaps: i32
}

let g_t: T = T { 0, 0, 0, 0 };

fn on_seg(user: ptr) -> i32 {
    let t: ptr<T> = user;
    t.sel = aui_segmented_value(3);
    t.taps = t.taps + 1;
    aui_invalidate();
    return 0;
}

fn on_row(user: ptr) -> i32 {
    let t: ptr<T> = user;
    t.rsel = aui_segmented_value(9);
    t.rtaps = t.rtaps + 1;
    aui_invalidate();
    return 0;
}

fn build(user: ptr) -> i32 {
    let t: ptr<T> = user;
    aui_root();
    aui_column(1);
    aui_pad(16);
    aui_gap(8);
    aui_label(2, "Pick");
    aui_segmented(3, t.sel, on_seg, user);
    aui_segment(4, "Low");
    aui_segment(5, "Mid");
    aui_segment(6, "High");
    aui_end();
    aui_row(7);
    aui_gap(8);
    aui_label(8, "W");
    aui_segmented(9, t.rsel, on_row, user);
    aui_segment(10, "A");
    aui_segment(11, "B");
    aui_end();
    aui_end();
    aui_row(12);
    aui_gap(8);
    aui_label(13, "T");
    aui_segmented(14, 0, on_row, user);
    aui_segment(15, "A");
    aui_segment(16, "Longer");
    aui_segment(17, "B");
    aui_end();
    aui_end();
    aui_end();
    return 0;
}

fn off(x: i32, y: i32) -> i32 {
    return (y * 320 + x) * 4;
}

fn is_color(x: i32, y: i32, r: i32, g: i32, b: i32) -> i32 {
    let o: i32 = off(x, y);
    if (load_u8(g_buf + o + 0) != r) { return 0; }
    if (load_u8(g_buf + o + 1) != g) { return 0; }
    if (load_u8(g_buf + o + 2) != b) { return 0; }
    return 1;
}

// 区域内是否存在指定颜色（文字/胶囊不需要知道具体字形像素位置）。
fn has_color(x0: i32, y0: i32, x1: i32, y1: i32, r: i32, g: i32, b: i32) -> i32 {
    let y: i32 = y0;
    while (y < y1) {
        let x: i32 = x0;
        while (x < x1) {
            if (is_color(x, y, r, g, b) != 0) { return 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

fn render() -> i32 {
    return aui_headless_render(320, 240, g_buf);
}

fn tap(x: i32, y: i32) -> i32 {
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn main() -> i32 {
    // W5 re-baseline: load the VM TrueType font first (same hook the
    // 11-14 harnesses use); scale 1 = native 48 px em as in every
    // example/harness app.
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    if (font_ok != 1) { return 90; }
    aui_set_font(g_font, 1);
    aui_debug_set_density(160);
    aui_headless_init(build, &g_t);
    if (render() == 0) { return 1; }
    if (aui_debug_node_count() != 18) { return 2; }

    // W5 re-baseline: SafeArea y=24 + pad16 + 标题 60 + gap8 → 容器 y=108，
    // 高取最高段 74（行高 60+14）；列宽 320 铺满 288（探针实测）。
    let c3: i32[4] = 0;
    if (aui_debug_rect(3, c3) != 0) { return 3; }
    if (c3[0] != 16 || c3[1] != 108 || c3[2] != 288 || c3[3] != 74) { return 3; }

    let s4: i32[4] = 0;
    if (aui_debug_rect(4, s4) != 0) { return 4; }
    if (s4[0] != 16 || s4[1] != 108 || s4[2] != 96 || s4[3] != 74) { return 4; }
    let s5: i32[4] = 0;
    if (aui_debug_rect(5, s5) != 0) { return 5; }
    if (s5[0] != 112 || s5[1] != 108 || s5[2] != 96 || s5[3] != 74) { return 5; }
    let s6: i32[4] = 0;
    if (aui_debug_rect(6, s6) != 0) { return 6; }
    // 288 / 3 = 96 整除，末段正好 96。
    if (s6[0] != 208 || s6[1] != 108 || s6[2] != 96 || s6[3] != 74) { return 6; }

    // W5 re-baseline: 容器 y 108..182（高 74）：胶囊上边 110、下边 179，
    // 内衬下边 180；中心行 y=145；文字行 y 115..175。
    // 选中段：2dp 胶囊内缩；外层 1dp HINT 边框 + 内衬 SURFACE。
    // W5 re-baseline: 胶囊色采样改到 y=112（胶囊上边内、文字行 115 之上；
    // 旧中心行采样点 (24,145) 现落在加宽的白字 "L" 字干上）。
    // v2.11：选中片从固定 6 dp 改成真胶囊（半径 = 高的一半 = 35），
    // 角上 x=24 的采样点落到胶囊切掉的角外；改采 x=64（胶囊直边区
    // 中点：行 110/179 的填充是 [48,80)，行 112 是 [41,87)；y=112
    // 在文字行 115 之上，避开白字），意图不变。
    if (is_color(64, 112, 0x3A, 0x6D, 0xF0) == 0) { return 7; }
    if (is_color(24, 108, 0x8A, 0x8A, 0x93) == 0) { return 8; }
    if (is_color(24, 109, 0xFF, 0xFF, 0xFF) == 0) { return 9; }
    if (is_color(64, 110, 0x3A, 0x6D, 0xF0) == 0) { return 10; }
    if (is_color(64, 179, 0x3A, 0x6D, 0xF0) == 0) { return 11; }
    if (is_color(24, 180, 0xFF, 0xFF, 0xFF) == 0) { return 12; }
    // 未选段是 SURFACE，不是页面底色。
    if (is_color(120, 112, 0xFF, 0xFF, 0xFF) == 0) { return 13; }
    if (is_color(16, 145, 0x8A, 0x8A, 0x93) == 0) { return 14; }
    // 选中段白字（ON_PRIMARY），未选段深字（TEXT）。
    if (has_color(36, 115, 92, 175, 0xFF, 0xFF, 0xFF) == 0) { return 15; }
    if (has_color(132, 115, 188, 175, 0x1A, 0x1A, 0x1E) == 0) { return 16; }

    // 点 High（第三段）：回调里从容器 key 读到新下标。
    tap(256, 145);   // W5 re-baseline: 段中心行 y=145。
    if (g_t.sel != 2) { return 17; }
    if (g_t.taps != 1) { return 18; }
    if (render() == 0) { return 19; }
    // v2.11：采样点改到胶囊直边区中点（x=256，见上），角上 x=216
    // 已在胶囊外；(24,112) 仍是 Low 段的底色（选中片已撤）。
    if (is_color(256, 112, 0x3A, 0x6D, 0xF0) == 0) { return 20; }
    if (is_color(24, 112, 0xFF, 0xFF, 0xFF) == 0) { return 21; }
    if (aui_segmented_value(3) != 2) { return 22; }

    // 点 Low：回到 0。
    tap(64, 145);   // W5 re-baseline: 段中心行 y=145。
    if (g_t.sel != 0) { return 23; }
    if (g_t.taps != 2) { return 24; }
    if (render() == 0) { return 25; }
    if (is_color(64, 112, 0x3A, 0x6D, 0xF0) == 0) { return 26; }
    if (is_color(216, 112, 0xFF, 0xFF, 0xFF) == 0) { return 27; }

    // 再点已选中的段：回调照常触发，下标不变。
    tap(64, 145);
    if (g_t.taps != 3) { return 28; }
    if (g_t.sel != 0) { return 29; }

    // 只按下 High：未选中段显示 PRESSED 胶囊（2dp 内缩），松手后才选中。
    fake_post_motion(0, 256, 145);   // W5 re-baseline: 段中心行 y=145。
    aui_on_input(1, 0, 0);
    if (render() == 0) { return 30; }
    // v2.11：同上，按下态胶囊采样点改到直边区中点。
    if (is_color(256, 112, 0xE8, 0xEE, 0xFF) == 0) { return 30; }
    if (is_color(256, 110, 0xE8, 0xEE, 0xFF) == 0) { return 31; }
    fake_post_motion(1, 256, 145);
    aui_on_input(1, 0, 0);
    if (g_t.sel != 2) { return 32; }
    if (g_t.taps != 4) { return 33; }
    if (render() == 0) { return 34; }
    // v2.11：同上，松手后 High 选中，采样点改到直边区中点。
    if (is_color(256, 112, 0x3A, 0x6D, 0xF0) == 0) { return 34; }

    // 点容器外：不回调。
    tap(8, 145);   // W5 re-baseline: 段中心行 y=145（x=8 在容器外）。
    if (g_t.taps != 4) { return 35; }

    // W5 re-baseline: 行内分段控件保持固有宽度：2 × 58 = 116，不铺满整行
    // （"A"/"B" 文字宽 30 + 28；容器 y=190，高 74，探针实测）。
    let c9: i32[4] = 0;
    if (aui_debug_rect(9, c9) != 0) { return 36; }
    if (c9[2] != 116 || c9[3] != 74) { return 36; }
    let l8: i32[4] = 0;
    if (aui_debug_rect(8, l8) != 0) { return 37; }
    if (c9[0] != l8[0] + l8[2] + 8) { return 37; }
    let a10: i32[4] = 0;
    if (aui_debug_rect(10, a10) != 0) { return 37; }
    if (a10[0] != c9[0] || a10[1] != c9[1] || a10[2] != 58 || a10[3] != 74) { return 37; }
    let b11: i32[4] = 0;
    if (aui_debug_rect(11, b11) != 0) { return 38; }
    if (b11[0] != c9[0] + 58 || b11[1] != c9[1] || b11[2] != 58 || b11[3] != 74) { return 38; }
    if (aui_segmented_value(9) != 0) { return 39; }

    // 点 B：行内控件独立选中，不影响上方的主控件。
    tap(c9[0] + 72, c9[1] + 16);
    if (g_t.rsel != 1) { return 40; }
    if (g_t.rtaps != 1) { return 41; }
    if (render() == 0) { return 42; }
    // W5 re-baseline: B 段从 c9[0]+58 起；采样点取 B 段中心 x、胶囊上边行
    // y=c9[1]+2（中心行采样点落在白字 "B" 字干上，探针证实）。
    if (is_color(c9[0] + 87, c9[1] + 2, 0x3A, 0x6D, 0xF0) == 0) { return 43; }
    // W5 re-baseline: A 段底色采样也移到文字行之上（y=c9[1]+2），避开 "A" 字。
    if (is_color(c9[0] + 10, c9[1] + 2, 0xFF, 0xFF, 0xFF) == 0) { return 44; }
    if (aui_segmented_value(3) != 2) { return 45; }
    if (aui_segmented_value(9) != 1) { return 46; }
    if (aui_segmented_value(999) != -1) { return 47; }

    // W5 re-baseline: 第三行 3 段固有宽度 58 + 183 + 58 = 299；Q16.16 等分
    // 后每段 99.67，坐标取整显示为 99/99/99（右边缘仍在容器内沿，探针实测）。
    let c14: i32[4] = 0;
    if (aui_debug_rect(14, c14) != 0) { return 48; }
    if (c14[2] != 299 || c14[3] != 74) { return 48; }
    let cw: i32 = c14[2] / 3;
    let a15: i32[4] = 0;
    if (aui_debug_rect(15, a15) != 0) { return 49; }
    if (a15[0] != c14[0] || a15[2] != cw) { return 49; }
    let a16: i32[4] = 0;
    if (aui_debug_rect(16, a16) != 0) { return 50; }
    if (a16[0] != c14[0] + cw || a16[2] != cw) { return 50; }
    let a17: i32[4] = 0;
    if (aui_debug_rect(17, a17) != 0) { return 51; }
    // W5 re-baseline: 第三段 x 不是 c14[0]+cw*2：段边界按 Q16.16 累积取整，
    // floor(2*299/3)=199，而 2*floor(299/3)=198（旧 172 时两者恰好同为 114）。
    // 段宽仍为 cw=99（探针实测 a17=(251,?,99)）。
    let cw2: i32 = ((c14[2] << 16) / 3 * 2) >> 16;
    if (a17[0] != c14[0] + cw2 || a17[2] != cw) { return 51; }
    if (aui_segmented_value(14) != 0) { return 52; }
    return 0;
}
