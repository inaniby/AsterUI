// vlist_var_test.ast — v2.10 不定高虚拟列表 + Badge 离屏自检（qemu-user）。
//
// 校验（对照 HuxerUI VirtualList.EstimatedItemExtent / tree_view Badge）：
// A. 量一次缓存：首帧估计窗口 + 第二帧真实窗口后，写回次数 == 已测量项数；
//    再渲染一帧，写回次数、已测量项数、总高全都不变；缓存高度按行内容
//    规律（1/2/3 行）分布。
// B. 程序化滚动到项：scroll_to_item(80, 居中) 后第 80 行居中；
//    scroll_to_item(199, 底对齐) 后末行贴底、偏移 == 最大偏移；
//    scroll_to_item(0, 顶对齐) 后偏移 0；点第 2 行回调下标 2。
// C. 失效规则（stale-height 回归）：改第 5 行内容后不调 invalidate，
//    缓存高度与总高都不变（文档行为）；调 invalidate 后下一拍重测，
//    高度与总高按新内容变化。
// D. 增删平移：insert(2) 后旧第 2 行高度移到第 3 行；remove(2) 后移回，
//    总高恢复；count 字段跟随。
// E. 窗口化渲染：200 条数据只建视口附近的行（节点数有界，150 行不在窗口内）。
// F. 宽度变化整表失效：窗口 360 -> 320 再回 360，写回次数增长（重测），
//    但行高值不变（同行数内容高度与宽度无关）。
// G. 固定列表不受影响（同一登记表、另一 key）：窗口、行几何、最大偏移
//    与 vlist_test 的口径一致。
// H. Badge：文字角标可见；count 3 可见、count 0 隐藏（零尺寸）、
//    count 128 显示 "99+"（比 "3" 宽）；圆点 8x8。
// I. 兄弟行不重叠（v2.11 回归）：Badge 行在列表下方，偏移 0 与跳到
//    #80 后都不与首个可见行重叠。
// 无像素冻结基线：校验的是几何/缓存行为，断言本身就是检查。
// 返回码：0 通过；1 首次绘制；2 版本号；10-19 A；20-29 B；30-39 C；
// 40-49 D；50-59 E；60-69 F；70-79 G；80-89 H；90 字体加载失败；
// 91-94 I。
include "../src/aui.ast";
include "../src/aster_std.ast";

extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_scroll(key: i32) -> i32;
extern fn aui_debug_scroll_max(key: i32) -> i32;
extern fn aui_debug_node_count() -> i32;
extern fn aui_debug_set_density(dpi: i32) -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;

let g_buf: u8[691200] = 0;   // 360x480 RGBA
let g_font: ptr = 0;

let COUNT0: i32 = 200;
let ESTDP: i32 = 48;

struct V {
    count: i32,
    phase: i32,
    bind_calls: i32,
    taps: i32,
    sel: i32,
    ov_idx: i32,    // 内容覆盖下标（-1 = 无）
    ov_lines: i32   // 覆盖后的行数
}

let g_v: V = V { 200, 0, 0, 0, -1, -1, 0 };

fn var_lines(v: ptr<V>, i: i32) -> i32 {
    if (i == v.ov_idx) { return v.ov_lines; }
    return 1 + (i * 7) % 3;
}

fn on_var_tap(user: ptr) -> i32 {
    let v: ptr<V> = user;
    v.sel = aui_vlist_tap_index();
    if (aui_vlist_tap_key() != 20) { v.sel = -2; }
    v.taps = v.taps + 1;
    aui_invalidate();
    return 0;
}

fn bind_var(user: ptr) -> i32 {
    let v: ptr<V> = user;
    v.bind_calls = v.bind_calls + 1;
    let i: i32 = aui_vlist_first();
    let e: i32 = aui_vlist_last();
    while (i <= e) {
        aui_vlist_var_row(i);
        aui_pad(6);
        aui_gap(2);
        aui_row(0);
        aui_label(0, "Msg");
        aui_text_i32(0, i);
        aui_end();
        let l: i32 = var_lines(v, i);
        let j: i32 = 1;
        while (j < l) {
            aui_label(0, "more text here");
            j = j + 1;
        }
        aui_end();
        i = i + 1;
    }
    return 0;
}

fn on_fixed_tap(user: ptr) -> i32 {
    let v: ptr<V> = user;
    v.sel = aui_vlist_tap_index();
    if (aui_vlist_tap_key() != 30) { v.sel = -2; }
    v.taps = v.taps + 1;
    aui_invalidate();
    return 0;
}

fn bind_fixed(user: ptr) -> i32 {
    let v: ptr<V> = user;
    v.bind_calls = v.bind_calls + 1;
    let i: i32 = aui_vlist_first();
    let e: i32 = aui_vlist_last();
    while (i <= e) {
        aui_vlist_row(i);
        if (i == v.sel) { aui_bg(0xFF3366CC); }
        aui_row(0);
        aui_pad(4);
        aui_label_n(0, "item ", 5);
        aui_text_i32(0, i);
        aui_end();
        aui_end();
        i = i + 1;
    }
    return 0;
}

fn build(user: ptr) -> i32 {
    aui_root();
    aui_column(1);
    aui_weight(1);
    aui_pad(0);
    aui_gap(0);
    let v: ptr<V> = user;
    if (v.phase == 0) {
        aui_label(10, "VarList");
        aui_vlist_var(20, v.count, ESTDP, bind_var, on_var_tap, user);
        aui_weight(1);
        aui_pad(0);
        // v2.11：列表是 push_container，必须在这里闭合；否则后面的行会
        // 嵌进列表内、被按 aux2=0 排到与第 0 行相同的位置上（与首行重叠）。
        aui_end();
        aui_row(40);
        aui_gap(8);
        aui_badge(41, "NEW", 0xFFFFFFFF, 0xFF3366CC);
        aui_badge_count(42, 3);
        aui_badge_count(43, 0);
        aui_badge_count(44, 128);
        aui_badge_dot(45, 0xFFE53935);
        aui_end();
    } else {
        aui_vlist(30, 100, 32, bind_fixed, on_fixed_tap, user);
        aui_weight(1);
        aui_pad(0);
        aui_end();           // v2.11：固定列表同上，建完即闭合。
    }
    aui_end();               // 列 1。
    return 0;
}

fn render2() -> i32 {
    let n: i32 = aui_headless_render(360, 480, g_buf);
    if (n <= 0) { return 0; }
    let n2: i32 = aui_headless_render(360, 480, g_buf);
    return n2;
}

// v2.11：Badge 行（key 40）必须在列表（key 20）下方，且不与首个可见
// 行重叠。返回 0 通过；1 行矩形缺失；2 列表矩形缺失；3 首行矩形缺失；
// 4 重叠（漏 aui_end 时行嵌进列表内、与第 0 行同 y）。
fn badge_row_clear() -> i32 {
    let rb: i32[4] = 0;
    if (aui_debug_rect(40, rb) != 0) { return 1; }
    let lv: i32[8] = 0;
    if (aui_debug_vlist_var(20, lv) != 0) { return 2; }
    let rr: i32[6] = 0;
    if (aui_debug_vlist_var_row(20, lv[5], rr) != 0) { return 3; }
    if (rb[1] < lv[1] + lv[3]) { return 4; }
    if (rb[1] < rr[1] + rr[3]) { return 4; }
    return 0;
}

fn tap(x: i32, y: i32) -> i32 {
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn main() -> i32 {
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    if (font_ok != 1) { return 90; }
    aui_set_font(g_font, 1);
    aui_debug_set_density(160);
    aui_headless_init(build, &g_v);
    if (render2() <= 0) { return 1; }
    if (aui_version() != 14806) { return 2; }

    // ---- A. 量一次缓存 ----
    let st: i32[4] = 0;
    if (aui_debug_vlist_var_stats(20, st) != 0) { return 10; }
    let w0: i32 = st[2];
    let m0: i32 = st[1];
    let t0: i32 = st[0];
    if (m0 <= 0) { return 10; }
    if (w0 != m0) { return 11; }
    // 再渲染一帧：写回次数、已测量数、总高全都不变。
    if (render2() <= 0) { return 1; }
    if (aui_debug_vlist_var_stats(20, st) != 0) { return 10; }
    if (st[2] != w0) { return 12; }
    if (st[1] != m0) { return 13; }
    if (st[0] != t0) { return 14; }
    // 缓存高度按行内容规律分布：取窗口内 1/2/3 行各一例。
    let lv: i32[8] = 0;
    if (aui_debug_vlist_var(20, lv) != 0) { return 10; }
    let first: i32 = lv[5];
    let last: i32 = lv[6];
    if (last - first < 2) { return 15; }
    let r0: i32[6] = 0;
    let r1: i32[6] = 0;
    let r2: i32[6] = 0;
    if (aui_debug_vlist_var_row(20, 0, r0) != 0) { return 16; }
    if (aui_debug_vlist_var_row(20, 1, r1) != 0) { return 16; }
    if (aui_debug_vlist_var_row(20, 2, r2) != 0) { return 16; }
    if (r0[5] != 1 || r1[5] != 1 || r2[5] != 1) { return 17; }
    let h1: i32 = r0[4];
    let h2: i32 = r1[4];
    let h3: i32 = r2[4];
    if (h2 <= h1 || h3 <= h2) { return 18; }
    if (h3 - h2 != h2 - h1) { return 19; }

    // ---- B. 程序化滚动到项 ----
    // 居中到第 80 行：行中心 == 列表中心（±1 px）。
    // 注意：首次滚动时第 80 行附近尚未量过高，偏移按估计高算；渲染后
    // 附近行量出真实高度，再滚一次收敛到精确位置（估计→实测的正常用法）。
    let sc: i32 = aui_vlist_var_scroll_to_item(20, 80, 1);
    if (sc < 0) { return 20; }
    if (render2() <= 0) { return 1; }
    let scb: i32 = aui_vlist_var_scroll_to_item(20, 80, 1);
    if (scb < 0) { return 20; }
    if (sc < 0) { return 20; }
    if (render2() <= 0) { return 1; }
    if (aui_debug_vlist_var(20, lv) != 0) { return 20; }
    if (80 < lv[5] || 80 > lv[6]) { return 21; }
    let r80: i32[6] = 0;
    if (aui_debug_vlist_var_row(20, 80, r80) != 0) { return 22; }
    let cy_list: i32 = lv[1] + lv[3] / 2;
    let cy_row: i32 = r80[1] + r80[3] / 2;
    if (cy_row < cy_list - 1 || cy_row > cy_list + 1) { return 23; }
    // 底对齐到末行：末行底 == 列表底，偏移 == 最大偏移（同样滚两次收敛）。
    let sc2: i32 = aui_vlist_var_scroll_to_item(20, 199, 2);
    if (sc2 < 0) { return 20; }
    if (render2() <= 0) { return 1; }
    let sc2b: i32 = aui_vlist_var_scroll_to_item(20, 199, 2);
    if (sc2b < 0) { return 20; }
    if (sc2 < 0) { return 20; }
    if (render2() <= 0) { return 1; }
    if (aui_debug_vlist_var(20, lv) != 0) { return 20; }
    if (199 < lv[5] || 199 > lv[6]) { return 24; }
    let r199: i32[6] = 0;
    if (aui_debug_vlist_var_row(20, 199, r199) != 0) { return 25; }
    if (r199[1] + r199[3] != lv[1] + lv[3]) { return 26; }
    if (lv[7] != aui_debug_scroll_max(20)) { return 27; }
    // 顶对齐回第 0 行：偏移 0，第 0 行顶 == 列表内容顶。
    let sc3: i32 = aui_vlist_var_scroll_to_item(20, 0, 0);
    if (sc3 != 0) { return 28; }
    if (render2() <= 0) { return 1; }
    if (aui_debug_vlist_var(20, lv) != 0) { return 20; }
    if (lv[7] != 0) { return 28; }
    let rt0: i32[6] = 0;
    if (aui_debug_vlist_var_row(20, 0, rt0) != 0) { return 29; }
    if (rt0[1] != lv[1]) { return 29; }
    // 点第 2 行：回调下标 2。注意不能点行中心：第 2 行中心 y 恰好
    // 落在列表底边上（290 + 196/2 = 388 = 列表底），命中会走到
    // Badge 行；点行高 1/4 处（仍在行内、也在列表视口内）。
    let rr2: i32[6] = 0;
    if (aui_debug_vlist_var_row(20, 2, rr2) != 0) { return 29; }
    let t3: i32 = tap(rr2[0] + rr2[2] / 2, rr2[1] + rr2[3] / 4);
    if (render2() <= 0) { return 1; }
    if (g_v.sel != 2 || g_v.taps < 1) { return 29; }

    // ---- C. 失效规则（stale-height 回归）----
    // 第 2 行现在是 3 行高（回到顶部后仍在窗口内）；改成 1 行内容后不调
    // invalidate：缓存与总高不变。
    let r5a: i32[6] = 0;
    if (aui_debug_vlist_var_row(20, 2, r5a) != 0) { return 30; }
    if (r5a[4] != h3) { return 31; }
    if (aui_debug_vlist_var_stats(20, st) != 0) { return 30; }
    let tC: i32 = st[0];
    g_v.ov_idx = 2;
    g_v.ov_lines = 1;
    if (render2() <= 0) { return 1; }
    let r5b: i32[6] = 0;
    if (aui_debug_vlist_var_row(20, 2, r5b) != 0) { return 32; }
    if (r5b[4] != h3) { return 33; }
    if (aui_debug_vlist_var_stats(20, st) != 0) { return 30; }
    if (st[0] != tC) { return 34; }
    // 调 invalidate：下一拍重测，高度回落到 1 行高，总高同步减少。
    let iv: i32 = aui_vlist_var_invalidate(20, 2);
    if (iv != 0) { return 35; }
    if (render2() <= 0) { return 1; }
    let r5c: i32[6] = 0;
    if (aui_debug_vlist_var_row(20, 2, r5c) != 0) { return 36; }
    if (r5c[4] != h1) { return 37; }
    if (aui_debug_vlist_var_stats(20, st) != 0) { return 30; }
    if (st[0] != tC - (h3 - h1)) { return 38; }
    g_v.ov_idx = -1;
    g_v.ov_lines = 0;
    let iv2: i32 = aui_vlist_var_invalidate(20, 2);
    if (render2() <= 0) { return 1; }
    let r5d: i32[6] = 0;
    if (aui_debug_vlist_var_row(20, 2, r5d) != 0) { return 39; }
    if (r5d[4] != h3) { return 39; }

    // ---- D. 增删平移 ----
    let ra2: i32[6] = 0;
    let ra3: i32[6] = 0;
    if (aui_debug_vlist_var_row(20, 2, ra2) != 0) { return 40; }
    if (aui_debug_vlist_var_row(20, 3, ra3) != 0) { return 40; }
    let h2old: i32 = ra2[4];
    if (aui_debug_vlist_var_stats(20, st) != 0) { return 40; }
    let tD: i32 = st[0];
    g_v.count = 201;
    let ins: i32 = aui_vlist_var_insert(20, 2);
    if (ins != 0) { return 41; }
    if (render2() <= 0) { return 1; }
    let rb3: i32[6] = 0;
    if (aui_debug_vlist_var_row(20, 3, rb3) != 0) { return 42; }
    if (rb3[4] != h2old) { return 43; }
    if (aui_debug_vlist_var(20, lv) != 0) { return 40; }
    if (lv[4] != 201) { return 44; }
    if (aui_debug_vlist_var_stats(20, st) != 0) { return 40; }
    if (st[0] <= tD) { return 45; }
    g_v.count = 200;
    let rem: i32 = aui_vlist_var_remove(20, 2);
    if (rem != 0) { return 46; }
    if (render2() <= 0) { return 1; }
    let rc2: i32[6] = 0;
    if (aui_debug_vlist_var_row(20, 2, rc2) != 0) { return 47; }
    if (rc2[4] != h2old) { return 48; }
    if (aui_debug_vlist_var_stats(20, st) != 0) { return 40; }
    if (st[0] != tD) { return 49; }

    // ---- E. 窗口化渲染 ----
    if (aui_debug_vlist_var(20, lv) != 0) { return 50; }
    if (lv[6] - lv[5] > 20) { return 51; }
    if (aui_debug_node_count() > 120) { return 52; }
    let r150: i32[6] = 0;
    if (aui_debug_vlist_var_row(20, 150, r150) == 0) { return 53; }

    // ---- F. 宽度变化整表失效 ----
    if (aui_debug_vlist_var_stats(20, st) != 0) { return 60; }
    let wF: i32 = st[2];
    // 窗口尺寸变化本身不置 need_layout（真机上 aui_cb_rect 做这件事）；
    // 离屏测试里显式 invalidate 触发重建 + 重布局，measure 才拿到新 avail。
    aui_invalidate();
    let nF: i32 = aui_headless_render(320, 480, g_buf);
    if (nF <= 0) { return 61; }
    let nF2: i32 = aui_headless_render(320, 480, g_buf);
    if (nF2 <= 0) { return 61; }
    if (aui_debug_vlist_var_stats(20, st) != 0) { return 60; }
    if (st[2] <= wF) { return 62; }
    let rF: i32[6] = 0;
    if (aui_debug_vlist_var_row(20, 0, rF) != 0) { return 63; }
    if (rF[4] != h1) { return 64; }
    aui_invalidate();
    let nF3: i32 = aui_headless_render(360, 480, g_buf);
    if (nF3 <= 0) { return 61; }
    let nF4: i32 = aui_headless_render(360, 480, g_buf);
    if (nF4 <= 0) { return 61; }
    if (render2() <= 0) { return 1; }

    // ---- G. 固定列表不受影响 ----
    g_v.phase = 1;
    aui_invalidate();
    if (render2() <= 0) { return 1; }
    let rf: i32[8] = 0;
    if (aui_debug_vlist(30, rf) != 0) { return 70; }
    if (rf[4] != 100) { return 71; }
    if (rf[5] != 0) { return 72; }
    if (rf[6] < 10 || rf[6] > 20) { return 73; }
    let fr0: i32[4] = 0;
    let fr5: i32[4] = 0;
    if (aui_debug_vlist_row(30, 0, fr0) != 0) { return 74; }
    if (aui_debug_vlist_row(30, 5, fr5) != 0) { return 74; }
    if (fr5[1] - fr0[1] != 5 * 32) { return 75; }
    let mx: i32 = aui_debug_scroll_max(30);
    if (mx != 100 * 32 - rf[3]) { return 76; }
    let sv: i32 = aui_vlist_scroll_to(30, 100000);
    if (sv != mx) { return 77; }
    if (render2() <= 0) { return 1; }
    if (aui_debug_vlist(30, rf) != 0) { return 70; }
    if (rf[7] != mx) { return 78; }

    // ---- H. Badge ----
    g_v.phase = 0;
    aui_invalidate();
    if (render2() <= 0) { return 1; }
    let b41: i32[5] = 0;
    let b42: i32[5] = 0;
    let b43: i32[5] = 0;
    let b44: i32[5] = 0;
    let b45: i32[5] = 0;
    if (aui_debug_badge(41, b41) != 0) { return 80; }
    if (aui_debug_badge(42, b42) != 0) { return 80; }
    if (aui_debug_badge(43, b43) != 0) { return 80; }
    if (aui_debug_badge(44, b44) != 0) { return 80; }
    if (aui_debug_badge(45, b45) != 0) { return 80; }
    if (b41[4] != 1 || b41[2] <= 0 || b41[3] <= 0) { return 81; }
    if (b42[4] != 1 || b42[2] <= 0) { return 82; }
    if (b43[4] != 0 || b43[2] != 0 || b43[3] != 0) { return 83; }
    if (b44[4] != 1 || b44[2] <= b42[2]) { return 84; }
    if (b45[4] != 1 || b45[2] != 8 || b45[3] != 8) { return 85; }
    if (b41[3] != b42[3]) { return 86; }

    // ---- I. 兄弟行不重叠（v2.11 回归）----
    // Badge 行在列表下方：偏移 0 时不与第 0 行重叠；跳到 #80 后不与
    // 首个可见行重叠；最后回到顶部，仍不重叠。
    if (badge_row_clear() != 0) { return 91; }
    // scroll_to_item 返回新偏移（>= 0），负数才是失败。
    let sci: i32 = aui_vlist_var_scroll_to_item(20, 80, 1);
    if (sci < 0) { return 92; }
    if (render2() <= 0) { return 1; }
    if (badge_row_clear() != 0) { return 93; }
    let sc0: i32 = aui_vlist_var_scroll_to_item(20, 0, 0);
    if (sc0 < 0) { return 92; }
    if (render2() <= 0) { return 1; }
    if (badge_row_clear() != 0) { return 94; }

    return 0;
}
