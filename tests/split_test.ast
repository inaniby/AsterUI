// split_test.ast — v2.12 可调分栏离屏自检（qemu-user）。
//
// 窗口 360x480 @160dpi（1 dp = 1 px）；离屏 SafeArea 上下各 24 dp，
// 内容区 y=24..456（高 432），上半分栏 y=24..240（高 216），下半
// y=240..456（高 216）。
// 取整说明：窗格尺寸是 Q16.16 精确值（两窗格+分隔条之和恒等于总长）；
// 调试接口读到的像素是各自向下取整，分到小数时两窗格像素和可能比
// 总长少 1 px（如 84.8→84、127.2→127），这是取整显示，不是布局缺口。
// 校验（对照 HuxerUI SplitLayout / examples/split_layout）：
// A. 初始几何：横向分栏按比例 500 分两窗格、分隔条中心在两窗格之间；
//    纵向分栏按比例 400 分两窗格；调试接口读到的矩形/比例/最小值一致。
// B. 拖动分隔条：DOWN 命中 + MOVE + UP 后比例按指针位移变化（500 ->
//    640），回调只调一次且读到新比例；重建后比例不弹回初值；DOWN+UP
//    不动不调回调、不改比例。
// C. 最小窗格夹取：往左拖到底，比例夹在 min 边界（134），首窗格宽 ==
//    48 dp 最小值，第二窗格占剩余。
// D. 程序化写比例：set_ratio(250) 后窗格按新比例分；写 1500 夹到 1000
//    （第二窗格被最小值夹住）；写接口不调回调；未知 key 返回 -1。
// E. 纵向拖动：DOWN 命中 + MOVE + UP 后比例 400 -> 635，窗格高按新
//    比例分，回调调一次。
// F. 命中区外不抢：分隔条命中区外按下再拖动，比例不变、回调不调；
//    点窗格空白处不触发分隔条回调。
// G. 单窗格/多余子节点/大最小值：单窗格无分隔条、铺满；第三个子节点
//    被忽略（零尺寸）；min 200 dp 时总长不够两窗格均分，拖动锁在 500。
// H. 嵌套分栏：窗格里再放一个分栏，内外几何各自正确，内部分隔条
//    可拖动（500 -> 640）。
// 无像素冻结基线：校验的是几何/比例/拖动行为，断言本身就是检查。
// 返回码：0 通过；1 首次绘制；2 版本号；10-19 A；20-29 B；30-39 C；
// 40-49 D；50-59 E；60-69 F；70-79 G；80-89 H；90 字体加载失败。
include "../src/aui.ast";
include "../src/aster_std.ast";

extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_node_count() -> i32;
extern fn aui_debug_set_density(dpi: i32) -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;

let g_buf: u8[691200] = 0;   // 360x480 RGBA
let g_font: ptr = 0;

struct S {
    h_calls: i32,
    h_ratio: i32,
    v_calls: i32,
    v_ratio: i32,
    n_calls: i32,
    n_ratio: i32,
    phase: i32
}

let g_s: S = S { 0, 0, 0, 0, 0, 0, 0 };

fn on_split_h(user: ptr) -> i32 {
    let s: ptr<S> = user;
    s.h_calls = s.h_calls + 1;
    s.h_ratio = aui_split_ratio(100);
    return 0;
}

fn on_split_v(user: ptr) -> i32 {
    let s: ptr<S> = user;
    s.v_calls = s.v_calls + 1;
    s.v_ratio = aui_split_ratio(110);
    return 0;
}

fn on_split_n(user: ptr) -> i32 {
    let s: ptr<S> = user;
    s.n_calls = s.n_calls + 1;
    s.n_ratio = aui_split_ratio(152);
    return 0;
}

fn build(user: ptr) -> i32 {
    aui_root();
    aui_column(1);
    aui_weight(1);
    aui_pad(0);
    aui_gap(0);
    let s: ptr<S> = user;
    if (s.phase == 0) {
        // 横向分栏（上半）+ 纵向分栏（下半），各 360x216（内容区 y=24..456）。
        aui_split(100, 1, 500, on_split_h, user);
        aui_weight(1);
        aui_pad(0);
        aui_column(101);
        aui_label(102, "L");
        aui_end();
        aui_column(103);
        aui_label(104, "R");
        aui_end();
        aui_end();
        aui_split(110, 0, 400, on_split_v, user);
        aui_weight(1);
        aui_pad(0);
        aui_column(111);
        aui_label(112, "T");
        aui_end();
        aui_column(113);
        aui_label(114, "B");
        aui_end();
        aui_end();
    } else if (s.phase == 1) {
        // 单窗格：无分隔条，单个子节点铺满。
        aui_split(120, 1, 500, on_split_h, user);
        aui_weight(1);
        aui_pad(0);
        aui_column(121);
        aui_label(122, "Only");
        aui_end();
        aui_end();
    } else if (s.phase == 2) {
        // 第三个子节点被忽略；min 200 dp 时总长不够、两窗格均分。
        aui_split(130, 1, 500, on_split_h, user);
        aui_split_min(200);
        aui_weight(1);
        aui_pad(0);
        aui_column(131);
        aui_label(132, "A");
        aui_end();
        aui_column(133);
        aui_label(134, "B");
        aui_end();
        aui_column(135);
        aui_label(136, "C");
        aui_end();
        aui_end();
    } else {
        // 嵌套：外层横向分栏，左窗格里再放一个纵向分栏。
        aui_split(150, 1, 500, on_split_h, user);
        aui_weight(1);
        aui_pad(0);
        aui_column(151);
        aui_split(152, 0, 500, on_split_n, user);
        aui_weight(1);
        aui_pad(0);
        aui_column(153);
        aui_label(154, "N1");
        aui_end();
        aui_column(155);
        aui_label(156, "N2");
        aui_end();
        aui_end();
        aui_end();
        aui_column(157);
        aui_label(158, "R");
        aui_end();
        aui_end();
    }
    aui_end();               // 列 1。
    return 0;
}

fn render2() -> i32 {
    let n: i32 = aui_headless_render(360, 480, g_buf);
    if (n <= 0) { return 0; }
    let n2: i32 = aui_headless_render(360, 480, g_buf);
    return n2;
}

fn down(x: i32, y: i32) -> i32 {
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn move_to(x: i32, y: i32) -> i32 {
    fake_post_motion(2, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn up(x: i32, y: i32) -> i32 {
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn tap(x: i32, y: i32) -> i32 {
    let d: i32 = down(x, y);
    let u: i32 = up(x, y);
    return 0;
}

fn main() -> i32 {
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    if (font_ok != 1) { return 90; }
    aui_set_font(g_font, 1);
    aui_debug_set_density(160);
    aui_headless_init(build, &g_s);
    if (render2() <= 0) { return 1; }
    if (aui_version() != 14806) { return 2; }

    // ---- A. 初始几何 ----
    // 横向分栏：[0,24,360,216]，比例 500 -> 两窗格各 178，分隔条中心 x=180。
    let sp: i32[8] = 0;
    if (aui_debug_split(100, sp) != 0) { return 10; }
    if (sp[0] != 0 || sp[1] != 24 || sp[2] != 360 || sp[3] != 216) { return 11; }
    if (sp[4] != 1 || sp[5] != 500 || sp[6] != 48 || sp[7] != 180) { return 12; }
    let p0: i32[4] = 0;
    let p1: i32[4] = 0;
    if (aui_debug_split_pane(100, 0, p0) != 0) { return 13; }
    if (aui_debug_split_pane(100, 1, p1) != 0) { return 13; }
    if (p0[0] != 0 || p0[1] != 24 || p0[2] != 178 || p0[3] != 216) { return 14; }
    if (p1[0] != 182 || p1[1] != 24 || p1[2] != 178 || p1[3] != 216) { return 15; }
    if (aui_debug_split_pane(100, 2, p0) != -1) { return 16; }
    // 纵向分栏：[0,240,360,216]，比例 400 -> 上 84 / 下 128，分隔条中心 y=326。
    let sv: i32[8] = 0;
    if (aui_debug_split(110, sv) != 0) { return 10; }
    if (sv[0] != 0 || sv[1] != 240 || sv[2] != 360 || sv[3] != 216) { return 17; }
    if (sv[4] != 0 || sv[5] != 400 || sv[6] != 48 || sv[7] != 326) { return 18; }
    if (aui_debug_split_pane(110, 0, p0) != 0) { return 13; }
    if (aui_debug_split_pane(110, 1, p1) != 0) { return 13; }
    if (p0[0] != 0 || p0[1] != 240 || p0[2] != 360 || p0[3] != 84) { return 19; }
    // 84.8 + 127.2 = 212（Q16.16 精确），像素各自取整为 84 / 127。
    if (p1[0] != 0 || p1[1] != 328 || p1[2] != 360 || p1[3] != 127) { return 19; }

    // ---- B. 拖动分隔条 ----
    // DOWN+UP 不动：不调回调、不改比例。
    let c0: i32 = g_s.h_calls;
    let t0: i32 = tap(180, 120);
    if (g_s.h_calls != c0) { return 20; }
    if (aui_split_ratio(100) != 500) { return 21; }
    // DOWN(180,120) -> MOVE(230,120) -> UP：位移 +50，总长 356，
    // 新比例 500 + 50*1000/356 = 640；回调一次、读到 640。
    let d0: i32 = down(180, 120);
    let m0: i32 = move_to(230, 120);
    let u0: i32 = up(230, 120);
    if (render2() <= 0) { return 1; }
    if (g_s.h_calls != c0 + 1) { return 22; }
    if (g_s.h_ratio != 640) { return 23; }
    if (aui_split_ratio(100) != 640) { return 24; }
    // 重建后比例不弹回初值 500（登记表规则的回归：初值只在首次构建生效）。
    if (render2() <= 0) { return 1; }
    if (aui_split_ratio(100) != 640) { return 25; }
    // 窗格按新比例分：356*640/1000 = 227 / 129，分隔条中心 229。
    if (aui_debug_split(100, sp) != 0) { return 10; }
    if (sp[7] != 229) { return 26; }
    if (aui_debug_split_pane(100, 0, p0) != 0) { return 13; }
    if (aui_debug_split_pane(100, 1, p1) != 0) { return 13; }
    if (p0[2] != 227) { return 27; }
    // 227.84 + 128.16 = 356（Q16.16 精确），像素各自取整为 227 / 128。
    if (p1[0] != 231 || p1[2] != 128) { return 28; }

    // ---- C. 最小窗格夹取 ----
    // 从 229 往左拖到底（x=10）：原始值 640-219*1000/356 = 25，夹到
    // lo = 48*1000/356 = 134；首窗格宽 == 48 dp 最小值。
    let c1: i32 = g_s.h_calls;
    let d1: i32 = down(229, 120);
    let m1: i32 = move_to(10, 120);
    let u1: i32 = up(10, 120);
    if (render2() <= 0) { return 1; }
    if (aui_split_ratio(100) != 134) { return 30; }
    if (g_s.h_calls <= c1) { return 31; }
    if (aui_debug_split_pane(100, 0, p0) != 0) { return 13; }
    if (aui_debug_split_pane(100, 1, p1) != 0) { return 13; }
    if (p0[2] != 48) { return 32; }
    if (p1[0] != 52 || p1[2] != 308) { return 33; }

    // ---- D. 程序化写比例 ----
    let c2: i32 = g_s.h_calls;
    if (aui_split_set_ratio(100, 250) != 0) { return 40; }
    if (render2() <= 0) { return 1; }
    if (aui_split_ratio(100) != 250) { return 41; }
    // 写接口不调回调。
    if (g_s.h_calls != c2) { return 42; }
    if (aui_debug_split_pane(100, 0, p0) != 0) { return 13; }
    if (p0[2] != 89) { return 43; }
    // 写 1500 夹到 1000：首窗格被第二窗格的最小值夹住（356-48=308）。
    if (aui_split_set_ratio(100, 1500) != 0) { return 40; }
    if (render2() <= 0) { return 1; }
    if (aui_split_ratio(100) != 1000) { return 44; }
    if (aui_debug_split_pane(100, 0, p0) != 0) { return 13; }
    if (p0[2] != 308) { return 45; }
    // 未知 key：读/写都返回 -1。
    if (aui_split_ratio(999) != -1) { return 46; }
    if (aui_split_set_ratio(999, 500) != -1) { return 47; }
    if (aui_debug_split(999, sp) != -1) { return 48; }
    if (aui_debug_split_pane(999, 0, p0) != -1) { return 49; }
    // 恢复 500，给后面的命中区测试一个确定的分隔条位置（中心 180）。
    if (aui_split_set_ratio(100, 500) != 0) { return 40; }
    if (render2() <= 0) { return 1; }
    if (aui_split_ratio(100) != 500) { return 41; }

    // ---- E. 纵向拖动 ----
    // DOWN(180,326) -> MOVE(180,376) -> UP：位移 +50，总长 212，
    // 新比例 400 + 50*1000/212 = 635；上窗格高 212*635/1000 = 134。
    let c3: i32 = g_s.v_calls;
    let d2: i32 = down(180, 326);
    let m2: i32 = move_to(180, 376);
    let u2: i32 = up(180, 376);
    if (render2() <= 0) { return 1; }
    if (g_s.v_calls != c3 + 1) { return 50; }
    if (g_s.v_ratio != 635) { return 51; }
    if (aui_split_ratio(110) != 635) { return 52; }
    if (aui_debug_split(110, sv) != 0) { return 10; }
    if (sv[7] != 376) { return 53; }
    if (aui_debug_split_pane(110, 0, p0) != 0) { return 13; }
    if (aui_debug_split_pane(110, 1, p1) != 0) { return 13; }
    if (p0[3] != 134) { return 54; }
    // 134.62 + 77.38 = 212（Q16.16 精确），像素各自取整为 134 / 77。
    if (p1[1] != 378 || p1[3] != 77) { return 55; }

    // ---- F. 命中区外不抢 ----
    // 横向分隔条中心 x=180，命中区 168..192。DOWN(200,120) 在区外，
    // 再拖到 (250,120)：比例不变、回调不调。
    let c4: i32 = g_s.h_calls;
    let d3: i32 = down(200, 120);
    let m3: i32 = move_to(250, 120);
    let u3: i32 = up(250, 120);
    if (render2() <= 0) { return 1; }
    if (g_s.h_calls != c4) { return 60; }
    if (aui_split_ratio(100) != 500) { return 61; }
    // 点窗格空白处（左窗格内、标签外）不触发分隔条回调。
    let t1: i32 = tap(50, 30);
    if (g_s.h_calls != c4) { return 62; }
    if (aui_split_ratio(100) != 500) { return 63; }

    // ---- G. 单窗格 / 多余子节点 / 大最小值 ----
    g_s.phase = 1;
    aui_invalidate();
    if (render2() <= 0) { return 1; }
    let s1: i32[8] = 0;
    if (aui_debug_split(120, s1) != 0) { return 70; }
    if (s1[7] != -1) { return 71; }
    if (aui_debug_split_pane(120, 0, p0) != 0) { return 13; }
    if (p0[0] != 0 || p0[1] != 24 || p0[2] != 360 || p0[3] != 432) { return 72; }
    if (aui_debug_split_pane(120, 1, p1) != -1) { return 73; }
    g_s.phase = 2;
    aui_invalidate();
    if (render2() <= 0) { return 1; }
    let s2: i32[8] = 0;
    if (aui_debug_split(130, s2) != 0) { return 70; }
    if (s2[6] != 200) { return 74; }
    // min 200：总长 356 < 2*200，两窗格均分 178/178。
    if (aui_debug_split_pane(130, 0, p0) != 0) { return 13; }
    if (aui_debug_split_pane(130, 1, p1) != 0) { return 13; }
    if (p0[2] != 178 || p1[0] != 182 || p1[2] != 178) { return 75; }
    // 第三个子节点（key 135 的列）从未被排布：零尺寸。
    let r3: i32[4] = 0;
    if (aui_debug_rect(135, r3) != 0) { return 76; }
    if (r3[0] != 0 || r3[1] != 0 || r3[2] != 0 || r3[3] != 0) { return 77; }
    // 拖动锁在 500：从 180 拖到 280，比例仍是 500。
    let c5: i32 = g_s.h_calls;
    let d4: i32 = down(180, 120);
    let m4: i32 = move_to(280, 120);
    let u4: i32 = up(280, 120);
    if (render2() <= 0) { return 1; }
    if (aui_split_ratio(130) != 500) { return 78; }
    if (g_s.h_calls != c5) { return 79; }

    // ---- H. 嵌套分栏 ----
    g_s.phase = 3;
    aui_invalidate();
    if (render2() <= 0) { return 1; }
    let so: i32[8] = 0;
    if (aui_debug_split(150, so) != 0) { return 80; }
    if (so[0] != 0 || so[1] != 24 || so[2] != 360 || so[3] != 432) { return 81; }
    if (so[4] != 1 || so[5] != 500 || so[7] != 180) { return 82; }
    let sn: i32[8] = 0;
    if (aui_debug_split(152, sn) != 0) { return 83; }
    if (sn[0] != 0 || sn[1] != 24 || sn[2] != 178 || sn[3] != 432) { return 84; }
    if (sn[4] != 0 || sn[5] != 500 || sn[7] != 240) { return 85; }
    if (aui_debug_split_pane(152, 0, p0) != 0) { return 13; }
    if (aui_debug_split_pane(152, 1, p1) != 0) { return 13; }
    if (p0[3] != 214 || p1[1] != 242 || p1[3] != 214) { return 86; }
    // 拖内部分隔条：DOWN(89,240) -> MOVE(89,300) -> UP，位移 +60，
    // 总长 428，新比例 500 + 60*1000/428 = 640。
    let c6: i32 = g_s.n_calls;
    let d5: i32 = down(89, 240);
    let m5: i32 = move_to(89, 300);
    let u5: i32 = up(89, 300);
    if (render2() <= 0) { return 1; }
    if (g_s.n_calls != c6 + 1) { return 87; }
    if (g_s.n_ratio != 640) { return 88; }
    if (aui_split_ratio(152) != 640) { return 89; }

    return 0;
}
