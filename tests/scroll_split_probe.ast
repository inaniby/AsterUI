// scroll_split_probe.ast -- v2.7.2 每帧成本拆分探针（qemu-user）。
// v2.7.3：rp 再拆分——移位 vs 暴露带重放 vs 固定装饰重放（新增
// MARK 段 replay_band10 / replay_top / replay_bar / drawcmds_full；
// COUNT 行：命令总数/文本命令数/各重放矩形命中数）。
//
// 假窗口 1216×2688（用户真机 REDMAGIC，520 dpi），ScrollView 60 行
// （照 Gallery 列表页，与 scroll_big_test 同场景）。v2.7.1 真机日志：
// blit 已接合（292/314），但每帧 c 中位仍 20 ms、帧间隔中位 26 ms
// （约 38 fps）。本探针拆 c 的构成，定位每帧成本的大头：
//   (1) 拖动步的 SPLIT 行：rp/cp 两阶段耗时（present_now 的新插桩；
//       headless 下假时钟冻结，rp/cp 恒为 0——读数以真机日志为准，
//       这里只断言直搬与像素等价）；
//   (2) MARK 行之间的原生拷贝/重放耗时（python  wrapper 按行时间戳
//       计：mem_copy_fwd 4 MiB ×50、fb_shift_rows 全视口 ×20、
//       fb_replay 整屏 ×10、fb_replay 暴露带 ×50）。
// 断言与 scroll_big_test 同款：拖动步 k>=2 直搬（blit=1）、字形缓存
// miss/evict 增量 0、直搬帧与强制整屏重画逐像素一致。
//
// 返回码：0 通过；1 矩形失败；2 像素不等；10 attach；11 回调；
// 12 首帧空白；13 版本号；20 滚动上限不足 180；21 窗口尺寸失败；
// 30 拖动直搬不足 5；32 字形缓存未命中/逐出；33 每步 build 非 0；
// 34 每步 paint 越界；90 字体加载失败。

include "../src/aui.ast";
include "../src/aster_std.ast";

extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_scroll(key: i32) -> i32;
extern fn aui_debug_scroll_max(key: i32) -> i32;
extern fn aui_debug_node_count() -> i32;
extern fn aui_debug_build_count() -> i32;
extern fn aui_debug_cmd_count() -> i32;
extern fn aui_debug_frame_blit() -> i32;
extern fn aui_debug_fbuf_ok() -> i32;
extern fn aui_debug_paint_gen() -> i32;
extern fn aui_debug_blit_diag(out: ptr) -> i32;
extern fn aui_debug_cmds_why(out: ptr) -> i32;
extern fn aui_debug_cmd_at(idx: i32, out: ptr) -> i32;
extern fn aui_debug_tt_cache(out: ptr) -> i32;
extern fn aui_debug_frame_split(out: ptr) -> i32;
extern fn mem_copy_fwd(dst: ptr, src: ptr, n: i32) -> i32;
extern fn fb_shift_rows(fb: ptr, stride: i32, bpp: i32, x0: i32, x1: i32, dsty: i32, srcy: i32, nrows: i32, back: i32) -> i32;
extern fn fb_replay(fb: ptr, stride: i32, fmt: i32, l: i32, t: i32, r: i32, b: i32) -> i32;
extern fn draw_cmds(bits: ptr, stride: i32, fmt: i32) -> i32;
extern let g_aui_fbuf0: i32[1048576];
extern let g_aui_fbuf1: i32[1048576];
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_frame(now: i64) -> i32;
extern fn aui_invalidate() -> i32;
extern fn aui_version() -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;
extern fn fake_set_win_size(w: i32, h: i32) -> i32;
extern fn fake_bits() -> ptr;

let g_act: i64[11] = 0;
let g_cb: i64[16] = 0;
let g_win: i64[4] = 0;
let g_assets: i64[1] = 0;
let g_ext_path: u8[32] = 0;
let g_harness_anchor: ptr = g_act;

let g_font: ptr = 0;

// 当前值：[0] build [1] paint [2] cmds [3] nodes [4] light
// [5] blit [6] fail [7] off [8] miss [9] evict [10] live
let g_snap: i32[11] = 0;
// 步前基线：[0] build [1] paint [2] miss [3] evict
let g_pre: i32[4] = 0;
// MOVE 之后立刻拍下的直搬快照：[0] light [1] blit [2] fail [3] fbok。
let g_blit_mv: i32[4] = 0;
let g_diag: i32[40] = 0;
let g_why: i32[6] = 0;
let g_cache: i32[6] = 0;
let g_blit_moves: i32 = 0;
// v2.7.2：上帧两阶段耗时 [rp, cp]（aui_debug_frame_split 读回）。
// v2.7.3：读回扩到 [rp, cp, sh, re]——缓冲必须是 4 格，2 格会在
// 写 *(out+8) / *(out+12) 时越界（曾把相邻的 g_vp[1] 写成 0）。
let g_split: i32[4] = 0;
// v2.7.3：滚动节点矩形（drag_round 里由 aui_debug_rect 填，
// raw_timings 用它拼固定装饰重放矩形：顶部 4px、右侧滚动条）。
let g_vp: i32[4] = 0;
// v2.7.3：命令统计 [总数， 文本命令数， 命中暴露带， 命中顶部， 命中滚动条]。
let g_cstat: i32[5] = 0;

fn call_cb(off: i32, a: ptr, b: ptr) -> i32 {
    let cb: ptr = load_ptr(g_act);
    let f: fn(ptr, ptr) -> i32 = load_ptr(cb + off);
    return f(a, b);
}

fn frame_at(t: i64) -> i32 {
    fake_set_clock(t);
    return aui_frame(t);
}

fn out_str(s: ptr) -> i32 { return write_all(1, s, strlen(s)); }

fn out_i32(v: i32) -> i32 {
    let buf: u8[16] = 0;
    let n: i32 = fmt_i32(buf, v);
    return write_all(1, buf, n);
}

fn snap_counts(key: i32) -> i32 {
    g_snap[0] = aui_debug_build_count();
    g_snap[1] = aui_debug_paint_gen();
    g_snap[2] = aui_debug_cmd_count();
    g_snap[3] = aui_debug_node_count();
    let tc: i32 = aui_debug_tt_cache(g_cache);
    g_snap[8] = g_cache[1];
    g_snap[9] = g_cache[2];
    g_snap[10] = g_cache[3];
    g_snap[7] = aui_debug_scroll(key);
    return 0;
}

fn snap_blit() -> i32 {
    let dg: i32 = aui_debug_blit_diag(g_diag);
    let wy: i32 = aui_debug_cmds_why(g_why);
    g_snap[4] = g_diag[0];
    g_snap[5] = aui_debug_frame_blit();
    g_snap[6] = g_diag[23];
    g_blit_mv[0] = g_snap[4];
    g_blit_mv[1] = g_snap[5];
    g_blit_mv[2] = g_snap[6];
    g_blit_mv[3] = g_diag[21];
    return 0;
}

fn mark_pre() -> i32 {
    g_pre[0] = aui_debug_build_count();
    g_pre[1] = aui_debug_paint_gen();
    let tc: i32 = aui_debug_tt_cache(g_cache);
    g_pre[2] = g_cache[1];
    g_pre[3] = g_cache[2];
    return 0;
}

fn blit_line(step: i32, tag: ptr) -> i32 {
    let s1: i32 = out_str("SCROLLBIGBLIT step=");
    let s2: i32 = out_i32(step);
    let s3: i32 = out_str(" ");
    let s4: i32 = out_str(tag);
    let s5: i32 = out_str(" light=");
    let s6: i32 = out_i32(g_blit_mv[0]);
    let s7: i32 = out_str(" blit=");
    let s8: i32 = out_i32(g_blit_mv[1]);
    let s9: i32 = out_str(" fail=");
    let sa: i32 = out_i32(g_blit_mv[2]);
    let sb: i32 = out_str(" fbok=");
    let sc: i32 = out_i32(g_blit_mv[3]);
    let sd: i32 = out_str(" why=");
    let se: i32 = out_i32(g_why[1]);
    let sf: i32 = out_str("\n");
    return 0;
}

// v2.7.2：拖动步的两阶段耗时（headless 下假时钟冻结，rp/cp 恒为 0，
// 以真机日志为准；这里只带 blit 标志做回归断言）。
fn split_line(step: i32) -> i32 {
    let d: i32 = aui_debug_frame_split(g_split);
    let s1: i32 = out_str("SPLIT step=");
    let s2: i32 = out_i32(step);
    let s3: i32 = out_str(" rp=");
    let s4: i32 = out_i32(g_split[0]);
    let s5: i32 = out_str(" cp=");
    let s6: i32 = out_i32(g_split[1]);
    let s7: i32 = out_str(" sh=");
    let sa: i32 = out_i32(g_split[2]);
    let sb: i32 = out_str(" re=");
    let sc: i32 = out_i32(g_split[3]);
    let s8: i32 = out_str(" blit=");
    let s9: i32 = out_i32(g_blit_mv[1]);
    let sa2: i32 = out_str("\n");
    return 0;
}

// v2.7.3：命令统计：总数 / 文本命令数 / 与各重放矩形相交的命令数
// （框用 aui_debug_cmd_at 读回的像素框近似；命令自带 clip 只会更小）。
fn cmd_stats() -> i32 {
    let total: i32 = aui_debug_cmd_count();
    let ntext: i32 = 0;
    let hband: i32 = 0;
    let htop: i32 = 0;
    let hbar: i32 = 0;
    let i: i32 = 0;
    let q: i32[8] = 0;
    let sv: i32 = out_str("VP x=");
    let sv2: i32 = out_i32(g_vp[0]);
    let sv3: i32 = out_str(" y=");
    let sv4: i32 = out_i32(g_vp[1]);
    let sv5: i32 = out_str(" w=");
    let sv6: i32 = out_i32(g_vp[2]);
    let sv7: i32 = out_str(" h=");
    let sv8: i32 = out_i32(g_vp[3]);
    let sv9: i32 = out_str(" nodes=");
    let sva: i32 = out_i32(aui_debug_node_count());
    let svb: i32 = out_str(" build=");
    let svc: i32 = out_i32(aui_debug_build_count());
    let svd: i32 = out_str("\n");
    while (i < total) {
        let rr: i32 = aui_debug_cmd_at(i, q);
        if (rr == 0) {
            if (q[0] == 2) { ntext = ntext + 1; }
            let x0: i32 = q[1];
            let y0: i32 = q[2];
            let x1: i32 = q[1] + q[3];
            let y1: i32 = q[2] + q[4];
            if (x1 > 0 && x0 < 1216 && y1 > 2588 && y0 < 2688) { hband = hband + 1; }
            if (x1 > g_vp[0] && x0 < g_vp[0] + g_vp[2] && y1 > g_vp[1] && y0 < g_vp[1] + 4) {
                htop = htop + 1;
                let t1: i32 = out_str("TOPHIT idx=");
                let t2: i32 = out_i32(i);
                let t3: i32 = out_str(" op=");
                let t4: i32 = out_i32(q[0]);
                let t5: i32 = out_str(" x0=");
                let t6: i32 = out_i32(x0);
                let t7: i32 = out_str(" y0=");
                let t8: i32 = out_i32(y0);
                let t9: i32 = out_str(" x1=");
                let ta: i32 = out_i32(x1);
                let tb: i32 = out_str(" y1=");
                let tc: i32 = out_i32(y1);
                let td: i32 = out_str("\n");
            }
            if (x1 > g_vp[0] + g_vp[2] - 10 && x0 < g_vp[0] + g_vp[2] && y1 > g_vp[1] && y0 < g_vp[1] + g_vp[3]) { hbar = hbar + 1; }
        }
        i = i + 1;
    }
    g_cstat[0] = total;
    g_cstat[1] = ntext;
    g_cstat[2] = hband;
    g_cstat[3] = htop;
    g_cstat[4] = hbar;
    let s1: i32 = out_str("COUNT cmds=");
    let s2: i32 = out_i32(total);
    let s3: i32 = out_str(" text=");
    let s4: i32 = out_i32(ntext);
    let s5: i32 = out_str(" band100_hit=");
    let s6: i32 = out_i32(hband);
    let s7: i32 = out_str(" top_hit=");
    let s8: i32 = out_i32(htop);
    let s9: i32 = out_str(" bar_hit=");
    let sa: i32 = out_i32(hbar);
    let sb: i32 = out_str("\n");
    return 0;
}

// v2.7.2：原生拷贝/重放耗时（MARK 行之间由外部计时：
// copy4m = mem_copy_fwd 4 MiB ×50；shift = fb_shift_rows 全视口 ×20；
// replay_full = fb_replay 整屏 ×10；replay_strip = fb_replay 暴露带 ×50）。
// 注意：这些调用会改写帧缓冲，只在全部断言完成后跑。
fn raw_timings() -> i32 {
    let fb0: ptr = g_aui_fbuf0;
    let fb1: ptr = g_aui_fbuf1;
    let m0: i32 = out_str("MARK copy4m\n");
    let i: i32 = 0;
    while (i < 50) {
        let r0: i32 = mem_copy_fwd(fb1, fb0, 4194304);
        i = i + 1;
    }
    let m1: i32 = out_str("MARK shift\n");
    let j: i32 = 0;
    while (j < 20) {
        let r1: i32 = fb_shift_rows(fb0, 1216, 4, 0, 1216, 0, 100, 2588, 1);
        j = j + 1;
    }
    let m2: i32 = out_str("MARK replay_full\n");
    let k: i32 = 0;
    while (k < 10) {
        let r2: i32 = fb_replay(fb0, 1216, 4, 0, 0, 1216, 2688);
        k = k + 1;
    }
    let m3: i32 = out_str("MARK replay_strip\n");
    let l: i32 = 0;
    while (l < 50) {
        let r3: i32 = fb_replay(fb0, 1216, 4, 0, 2588, 1216, 2688);
        l = l + 1;
    }
    // v2.7.3：更细的拆分（各 ×20，整屏重画 ×5；套件 timeout 20，
    // 总时长须留余量）。band10 = 10 px 暴露带（惯性末段典型位移）；
    // top = 顶部 4 px 固定装饰；bar = 右侧 10 px 滚动条带；
    // drawcmds_full = draw_cmds 整屏重画（与 replay_full 对照）。
    let m5: i32 = out_str("MARK replay_band10\n");
    let a: i32 = 0;
    while (a < 20) {
        let ra: i32 = fb_replay(fb0, 1216, 4, 0, 2678, 1216, 2688);
        a = a + 1;
    }
    let m6: i32 = out_str("MARK replay_top\n");
    let b: i32 = 0;
    while (b < 20) {
        let rb: i32 = fb_replay(fb0, 1216, 4, g_vp[0], g_vp[1], g_vp[0] + g_vp[2], g_vp[1] + 4);
        b = b + 1;
    }
    let m7: i32 = out_str("MARK replay_bar\n");
    let c: i32 = 0;
    while (c < 20) {
        let rc: i32 = fb_replay(fb0, 1216, 4, g_vp[0] + g_vp[2] - 10, g_vp[1], g_vp[0] + g_vp[2], g_vp[1] + g_vp[3]);
        c = c + 1;
    }
    let m8: i32 = out_str("MARK drawcmds_full\n");
    let d: i32 = 0;
    while (d < 5) {
        let rd: i32 = draw_cmds(fb0, 1216, 4);
        d = d + 1;
    }
    let m4: i32 = out_str("MARK done\n");
    return 0;
}

fn cost_line(step: i32, tag: ptr, key: i32) -> i32 {
    let s0: i32 = snap_counts(key);
    let s1: i32 = out_str("SCROLLBIG step=");
    let s2: i32 = out_i32(step);
    let s3: i32 = out_str(" ");
    let s4: i32 = out_str(tag);
    let s5: i32 = out_str(" build=");
    let s6: i32 = out_i32(g_snap[0] - g_pre[0]);
    let s7: i32 = out_str(" paint=");
    let s8: i32 = out_i32(g_snap[1] - g_pre[1]);
    let s9: i32 = out_str(" cmds=");
    let sa: i32 = out_i32(g_snap[2]);
    let sb: i32 = out_str(" nodes=");
    let sc: i32 = out_i32(g_snap[3]);
    let sd: i32 = out_str(" light=");
    let se: i32 = out_i32(g_snap[4]);
    let sf: i32 = out_str(" blit=");
    let sg: i32 = out_i32(g_snap[5]);
    let sh: i32 = out_str(" fail=");
    let si: i32 = out_i32(g_snap[6]);
    let sj: i32 = out_str(" fbok=");
    let sk: i32 = out_i32(g_diag[21]);
    let sl: i32 = out_str(" miss=");
    let sm: i32 = out_i32(g_snap[8] - g_pre[2]);
    let sn: i32 = out_str(" evict=");
    let so: i32 = out_i32(g_snap[9] - g_pre[3]);
    let sp: i32 = out_str(" live=");
    let sq: i32 = out_i32(g_snap[10]);
    let sr: i32 = out_str(" off=");
    let ss: i32 = out_i32(g_snap[7]);
    let st: i32 = out_str("\n");
    return 0;
}

// 帧哈希：FNV-1a 32 位，扫全部 1216×2688 个 i32（与
// scroll_cost_harness 的 pixel_hash 同式，计数不同）。
fn pixel_hash() -> i32 {
    let h: i32 = -2128831035;
    let bits: ptr = fake_bits();
    let i: i32 = 0;
    while (i < 1216 * 2688) {
        h = (h ^ *(bits + i * 4)) * 16777619;
        i = i + 1;
    }
    return h;
}

// 像素等价：直搬帧与强制整屏重画必须逐像素一致，并打印冻结哈希。
fn pixel_check(key: i32, t: i64) -> i32 {
    let h1: i32 = pixel_hash();
    let iv: i32 = aui_invalidate();
    frame_at(t);
    let h2: i32 = pixel_hash();
    let eq: i32 = 0;
    if (h1 == h2) { eq = 1; }
    let h0: i32 = out_str("SPLITHASH ");
    let h3: i32 = out_i32(h1);
    let h4: i32 = out_str("\n");
    let s1: i32 = out_str("PIXELCHECK big blit=");
    let s2: i32 = out_i32(h1);
    let s3: i32 = out_str(" full=");
    let s4: i32 = out_i32(h2);
    let s5: i32 = out_str(" eq=");
    let s6: i32 = out_i32(eq);
    let s7: i32 = out_str(" off=");
    let s8: i32 = out_i32(aui_debug_scroll(key));
    let s9: i32 = out_str("\n");
    if (h1 != h2) { return 1; }
    return 0;
}

fn build(user: ptr) -> i32 {
    aui_root();
    aui_column(1);
    aui_weight(1);
    // 页眉三行宽字母表（与 scroll_cost_harness 场景 0 相同）。
    aui_label(2, "ABCDEFGHIJKLMNOPQRSTU");
    aui_label(3, "VWXYZabcdefghijklmno");
    aui_label(4, "pqrstuvwxyz0123456789");
    aui_scroll(100);
    aui_weight(1);
    aui_column(101);
    aui_pad(10);
    aui_gap(6);
    aui_bg(aui_theme_color(AUI_COLOR_SURFACE));
    aui_radius(14);
    // 60 行：1216×2688 视口下内容也远高于视口，滚动上限远大于
    // 180 px 拖动总量（30 行在真机分辨率下几乎滚不动）。
    let i: i32 = 0;
    while (i < 60) {
        aui_row(1100 + i);
        aui_pad(12);
        aui_gap(12);
        aui_bg(aui_theme_color(AUI_COLOR_TINT));
        aui_radius(10);
        aui_label(1400 + i, "Item");
        aui_text_i32(1450 + i, i);
        aui_end();
        i = i + 1;
    }
    aui_end();
    aui_end();
    aui_row(5);
    aui_pad(16);
    aui_gap(8);
    aui_label(6, "Footer");
    aui_end();
    aui_end();
    return 0;
}

fn app_init(user: ptr) -> i32 {
    aui_set_font(g_font, 1);
    return 0;
}

fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32 {
    return aui_android_attach(activity, saved, savedSize,
                              build, 0, app_init, 0);
}

// 一轮拖动：DOWN 在容器中心，6 步各 30 px 上滑。第 1 步是 force_full
// 整屏帧（按设计）；其后 5 步必须直搬。
fn drag_round(key: i32, base: i64) -> i32 {
    g_blit_moves = 0;
    let r: i32[4] = 0;
    if (aui_debug_rect(key, r) != 0) { return 1; }
    g_vp[0] = r[0];
    g_vp[1] = r[1];
    g_vp[2] = r[2];
    g_vp[3] = r[3];
    let cx: i32 = r[0] + r[2] / 2;
    let cy: i32 = r[1] + r[3] / 2;
    let t0: i64 = base;
    let mp: i32 = mark_pre();
    let sb: i32 = snap_blit();
    let c0: i32 = cost_line(0, "base", key);
    fake_set_clock(t0);
    fake_post_motion(0, cx, cy);
    aui_on_input(1, 0, 0);
    let mp1: i32 = mark_pre();
    let sb1: i32 = snap_blit();
    let c1: i32 = cost_line(1, "down", key);
    let k: i32 = 1;
    while (k <= 6) {
        let tt: i64 = t0 + i64(k) * 16000000;
        let mpk: i32 = mark_pre();
        fake_set_clock(tt);
        fake_post_motion(2, cx, cy - k * 30);
        aui_on_input(1, 0, 0);
        // 直搬 verdict 在 MOVE 之后立刻读并打印；frame_at 只推进
        // 计时器，不再重读（空泵会把标志清成 fail=1）。
        let sbk: i32 = snap_blit();
        let bk: i32 = blit_line(1 + k, "move");
        frame_at(tt);
        let sp: i32 = split_line(1 + k);
        let ck: i32 = cost_line(1 + k, "move", key);
        if (g_snap[0] - g_pre[0] != 0) { return 33; }
        if (g_snap[1] - g_pre[1] != 1) { return 34; }
        if (g_snap[8] - g_pre[2] != 0) { return 32; }
        if (g_snap[9] - g_pre[3] != 0) { return 32; }
        if (k >= 2) {
            if (g_blit_mv[1] == 1) { g_blit_moves = g_blit_moves + 1; }
        }
        k = k + 1;
    }
    if (g_blit_moves < 5) { return 30; }
    // 像素等价：最后一步 MOVE 的直搬帧 vs 强制整屏重画（UP 之前，
    // 偏移静止在 180，惯性还没启动）。
    let pc: i32 = pixel_check(key, t0 + 7 * 16000000);
    if (pc != 0) { return 2; }
    return 0;
}

fn main() -> i32 {
    // 先定窗口尺寸再 attach：锁窗口时 fake 宿主按此尺寸出缓冲。
    if (fake_set_win_size(1216, 2688) != 0) { return 21; }
    let act: ptr = g_act;
    *(act + 0) = g_cb;
    let assets: ptr = g_assets;
    *(act + 64) = assets;
    store_u8(g_ext_path + 0, 47);
    store_u8(g_ext_path + 1, 116);
    store_u8(g_ext_path + 2, 109);
    store_u8(g_ext_path + 3, 112);
    store_u8(g_ext_path + 4, 47);
    store_u8(g_ext_path + 5, 97);
    store_u8(g_ext_path + 6, 115);
    store_u8(g_ext_path + 7, 116);
    store_u8(g_ext_path + 8, 101);
    store_u8(g_ext_path + 9, 114);
    store_u8(g_ext_path + 10, 117);
    store_u8(g_ext_path + 11, 105);
    store_u8(g_ext_path + 12, 45);
    store_u8(g_ext_path + 13, 116);
    store_u8(g_ext_path + 14, 114);
    store_u8(g_ext_path + 15, 97);
    store_u8(g_ext_path + 16, 99);
    store_u8(g_ext_path + 17, 101);
    store_u8(g_ext_path + 18, 0);
    let ep: ptr = g_ext_path;
    *(act + 40) = ep;

    if (g_harness_anchor == 0) { return 10; }
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    if (font_ok != 1) { return 90; }
    let r: i32 = ANativeActivity_onCreate(act, 0, 0);
    if (r != 0) { return 10; }

    let cb: ptr = load_ptr(g_act);
    let f56: ptr = load_ptr(cb + 56);
    let f72: ptr = load_ptr(cb + 72);
    if (f56 == 0 || f72 == 0) { return 11; }

    let win: ptr = g_win;
    let s1: i32 = call_cb(0, act, 0);
    let s2: i32 = call_cb(8, act, 0);
    let s3: i32 = call_cb(56, act, win);
    let s4: i32 = call_cb(72, act, win);

    // 首帧非空：13 MB 缓冲抽样（每 4096 字节取一字节）求和。
    let bits: ptr = fake_bits();
    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < 1216 * 2688 * 4) {
        sum = sum + load_u8(bits + i);
        i = i + 4096;
    }
    if (sum == 0) { return 12; }
    if (aui_version() != 14806) { return 13; }

    let base: i64 = 5000000000;
    frame_at(base);
    let vpr: i32[4] = 0;
    let vpok: i32 = aui_debug_rect(100, vpr);
    let vp1: i32 = out_str("VP0 x=");
    let vp2: i32 = out_i32(vpr[0]);
    let vp3: i32 = out_str(" y=");
    let vp4: i32 = out_i32(vpr[1]);
    let vp5: i32 = out_str(" w=");
    let vp6: i32 = out_i32(vpr[2]);
    let vp7: i32 = out_str(" h=");
    let vp8: i32 = out_i32(vpr[3]);
    let vp9: i32 = out_str(" nodes=");
    let vpa: i32 = out_i32(aui_debug_node_count());
    let vpb: i32 = out_str(" build=");
    let vpc: i32 = out_i32(aui_debug_build_count());
    let vpd: i32 = out_str("\n");
    let mx0: i32 = aui_debug_scroll_max(100);
    let m0: i32 = out_str("SCROLLBIG max=");
    let m1: i32 = out_i32(mx0);
    let m2: i32 = out_str("\n");
    if (mx0 < 180) { return 20; }
    let d0: i32 = drag_round(100, base + 100000000);
    if (d0 != 0) { return d0; }
    let cs: i32 = cmd_stats();
    let rt: i32 = raw_timings();
    let e: i32 = eputs("PASS: scroll_split_probe\n");
    return 0;
}
