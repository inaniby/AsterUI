// chip_harness.ast — v1.31 ui_chip 的真实宿主路径冒烟测试（qemu-user）。
//
// 720×1280 / density 420 的假宿主，走 ANativeActivity 回调创建窗口，然后：
// 版本号 14806；筛选行三枚 Chip 同高、按 8 dp 间隔并排；首枚选中为主色；
// 点 New / Flag 切换选中（950）；点 Wi-Fi / NFC 切换多选位（951）；
// 列内 Chip 保持固有宽；深色主题下选中主色与未选 surface 一起换色。
//
// 返回码：0 通过；10 attach 失败；11 回调表没写；12 屏幕全黑；
// 13 版本号不是 14806；14 筛选行几何不对；15 初始状态不对；
// 16 点 New 没切换；17 点 Flag 没切换；18 点 Wi-Fi 没切位；
// 19 再点 Wi-Fi 没复位；20 点 NFC 没切位；21 列内 Chip 被拉伸；
// 22 深色背景没变暗；23 深色选中主色不对；24 深色未选 surface 不对；
// 90 内容超出 720×1280。
extern let g_fake_pixels: i32[921600];

extern fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_frame(now: i64) -> i32;
extern fn aui_state_get(key: i32) -> i32;
extern fn aui_set_dark(on: i32) -> i32;
extern fn aui_invalidate() -> i32;
extern fn aui_version() -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;

let g_act: i64[11] = 0;
let g_cb: i64[16] = 0;
let g_win: i64[4] = 0;
let g_assets: i64[1] = 0;
let g_ext_path: u8[32] = 0;
let g_harness_anchor: ptr = g_act;

fn call_cb(off: i32, a: ptr, b: ptr) -> i32 {
    let cb: ptr = load_ptr(g_act);
    let f: fn(ptr, ptr) -> i32 = load_ptr(cb + off);
    return f(a, b);
}

fn frame_at(t: i64) -> i32 {
    fake_set_clock(t);
    return aui_frame(t);
}

fn tap_at(t: i64, x: i32, y: i32) -> i32 {
    fake_set_clock(t);
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    fake_set_clock(t + 50000000);
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn px_off(x: i32, y: i32) -> i32 { return (y * 720 + x) * 4; }
fn chan(x: i32, y: i32, c: i32) -> i32 {
    return i32(load_u8(g_fake_pixels + px_off(x, y) + c));
}
fn lum(x: i32, y: i32) -> i32 {
    let r: i32 = chan(x, y, 0);
    let g: i32 = chan(x, y, 1);
    let b: i32 = chan(x, y, 2);
    return (r * 3 + g * 6 + b) / 10;
}
fn is_color(x: i32, y: i32, r: i32, g: i32, b: i32) -> i32 {
    if (chan(x, y, 0) != r) { return 0; }
    if (chan(x, y, 1) != g) { return 0; }
    if (chan(x, y, 2) != b) { return 0; }
    return 1;
}

fn main() -> i32 {
    let act: ptr = g_act;
    *(act + 0) = g_cb;
    let assets: ptr = g_assets;
    *(act + 64) = assets;
    store_u8(g_ext_path + 0, 47);
    store_u8(g_ext_path + 1, 116);
    store_u8(g_ext_path + 2, 109);
    store_u8(g_ext_path + 3, 112);
    store_u8(g_ext_path + 4, 47);
    store_u8(g_ext_path + 5, 97);
    store_u8(g_ext_path + 6, 115);
    store_u8(g_ext_path + 7, 116);
    store_u8(g_ext_path + 8, 101);
    store_u8(g_ext_path + 9, 114);
    store_u8(g_ext_path + 10, 117);
    store_u8(g_ext_path + 11, 105);
    store_u8(g_ext_path + 12, 45);
    store_u8(g_ext_path + 13, 116);
    store_u8(g_ext_path + 14, 114);
    store_u8(g_ext_path + 15, 97);
    store_u8(g_ext_path + 16, 99);
    store_u8(g_ext_path + 17, 101);
    store_u8(g_ext_path + 18, 0);
    let ep: ptr = g_ext_path;
    *(act + 40) = ep;

    if (g_harness_anchor == 0) { return 10; }
    let r: i32 = ANativeActivity_onCreate(act, 0, 0);
    if (r != 0) { return 10; }

    let cb: ptr = load_ptr(g_act);
    let f56: ptr = load_ptr(cb + 56);
    let f72: ptr = load_ptr(cb + 72);
    if (f56 == 0 || f72 == 0) { return 11; }

    let win: ptr = g_win;
    let s1: i32 = call_cb(0, act, 0);
    let s2: i32 = call_cb(8, act, 0);
    let s3: i32 = call_cb(56, act, win);
    let s4: i32 = call_cb(72, act, win);

    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < 720 * 1280 * 4) {
        sum = sum + load_u8(g_fake_pixels + i);
        i = i + 1;
    }
    if (sum == 0) { return 12; }
    if (aui_version() != 14806) { return 13; }

    let base: i64 = 4000000000;
    frame_at(base);

    // ---- A. 筛选行几何：同高、8 dp 间隔、从左到右 ----
    let a: i32[4] = 0;
    let b: i32[4] = 0;
    let c: i32[4] = 0;
    if (aui_debug_rect(100, a) != 0) { return 14; }
    if (aui_debug_rect(101, b) != 0) { return 14; }
    if (aui_debug_rect(102, c) != 0) { return 14; }
    if (a[0] != 42) { return 14; }
    if (a[1] != b[1] || a[1] != c[1]) { return 14; }
    if (a[3] != 81 || b[3] != 81 || c[3] != 81) { return 14; }
    if (a[2] < 84 || b[2] < 84) { return 14; }
    if (b[0] < a[0] + a[2]) { return 14; }
    if (c[0] < b[0] + b[2]) { return 14; }
    if (a[1] + a[3] > 1280) { return 90; }

    // ---- B. 初始：筛选 = 0（All 主色），多选位 = 0 ----
    if (aui_state_get(950) != 0 || aui_state_get(951) != 0) { return 15; }
    if (is_color(a[0] + 20, a[1] + a[3] / 2, 0x3A, 0x6D, 0xF0) == 0) { return 15; }
    if (is_color(b[0] + 20, b[1] + b[3] / 2, 0xFF, 0xFF, 0xFF) == 0) { return 15; }

    // ---- C. 点 Unread：筛选切到 1 ----
    tap_at(base + 200000000, b[0] + b[2] / 2, b[1] + b[3] / 2);
    frame_at(base + 300000000);
    if (aui_state_get(950) != 1) { return 16; }
    if (is_color(b[0] + 20, b[1] + b[3] / 2, 0x3A, 0x6D, 0xF0) == 0) { return 16; }
    if (is_color(a[0] + 20, a[1] + a[3] / 2, 0xFF, 0xFF, 0xFF) == 0) { return 16; }

    // ---- D. 点 Flagged：筛选切到 2 ----
    tap_at(base + 400000000, c[0] + c[2] / 2, c[1] + c[3] / 2);
    frame_at(base + 500000000);
    if (aui_state_get(950) != 2) { return 17; }

    // ---- E. 多选 Wi-Fi：开 -> 关 ----
    let w: i32[4] = 0;
    if (aui_debug_rect(120, w) != 0) { return 18; }
    tap_at(base + 600000000, w[0] + w[2] / 2, w[1] + w[3] / 2);
    frame_at(base + 700000000);
    if (aui_state_get(951) != 1) { return 18; }
    tap_at(base + 800000000, w[0] + w[2] / 2, w[1] + w[3] / 2);
    frame_at(base + 900000000);
    if (aui_state_get(951) != 0) { return 19; }

    // ---- F. NFC 位 = 4 ----
    let nf: i32[4] = 0;
    if (aui_debug_rect(121, nf) != 0) { return 20; }
    tap_at(base + 1000000000, nf[0] + nf[2] / 2, nf[1] + nf[3] / 2);
    frame_at(base + 1100000000);
    if (aui_state_get(951) != 4) { return 20; }
    if (is_color(nf[0] + 20, nf[1] + nf[3] / 2, 0x3A, 0x6D, 0xF0) == 0) { return 20; }

    // ---- G. 列里的 Chip 不拉伸 ----
    let s: i32[4] = 0;
    if (aui_debug_rect(130, s) != 0) { return 21; }
    if (s[0] != 42) { return 21; }
    if (s[2] >= 636) { return 21; }
    if (s[2] < 84) { return 21; }
    if (s[3] != 81) { return 21; }

    // ---- H. 深色：背景变暗；选中主色 / 未选 surface 换色 ----
    let light: i32 = lum(10, 10);
    aui_set_dark(1);
    aui_invalidate();
    frame_at(base + 1200000000);
    let dark: i32 = lum(10, 10);
    if (dark > light - 80) { return 22; }
    if (aui_debug_rect(102, c) != 0) { return 23; }
    if (is_color(c[0] + 20, c[1] + c[3] / 2, 0x6E, 0x96, 0xFF) == 0) { return 23; }
    if (aui_debug_rect(100, a) != 0) { return 24; }
    if (is_color(a[0] + 20, a[1] + a[3] / 2, 0x1E, 0x1E, 0x24) == 0) { return 24; }

    let s5: i32 = call_cb(24, act, 0);
    let s6: i32 = call_cb(32, act, 0);
    let s7: i32 = call_cb(40, act, 0);
    return 0;
}
