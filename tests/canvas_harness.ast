// canvas_harness.ast -- v2.6 ui_canvas fake-host smoke test (qemu-user).
//
// 720x1280 / density 420 fake host, ANativeActivity callbacks, like
// icon_harness.ast. The example is ui_canvas.ast (shared page in
// canvas_draw.ast; the same page is the Gallery Canvas tab).
//
// Covers: A. canvas rect (280 dp high, stretched to the card);
// B. Taiji tab pixels (dark top disc, light bottom disc, dark eye,
// primary outline ring; v2.6.2: dark left half + light right half --
// the true yin-yang S-curve); C. Orbit tab by tap (dark field,
// primary centre dot; v2.6.2: arc 1 present at the left point, absent
// at the top -- arcs, not full rings); D. Path tab by tap (primary
// panel, light ground strip, white text, blue icon; v2.6.2: the rule
// stops before the icon -- the point just inside the icon's left edge
// at the rule's height is blue, not white); D2. clip probe (test-only
// since v2.6.2: cv_set_probe enables it; dark tab inside the corner,
// clean card padding); E. dark theme follows the tokens (surface
// dark, TEXT light); F. drag starting on the Canvas scrolls the page,
// scroll back leaves the drawing undistorted; G. rotation (v2.6.2):
// rect-only and config-only both re-layout to the landscape width,
// reset returns to portrait; H. lag regression (v2.6.2): one tab
// switch runs the draw callback 1..4 times (measured 3).
// Pixel positions are computed from the canvas rect at runtime
// (dp * 21 / 8 = px at 420 dpi); only small regions are sampled, so
// +/-2 px layout rounding is tolerated. Luminance ranges: primary
// light 106 / dark 148 -> [60, 180]; TEXT light 26 / dark 239;
// SURFACE light 255 / dark ~30.
//
// Return codes: 0 pass; 10 attach failed; 11 callback table missing;
// 12 black screen; 13 version not 14806; 20 canvas rect; 21 Taiji
// pixels; 22 Orbit pixels; 23 Path pixels; 24 clip probe / padding;
// 25 dark theme; 26 scroll / redraw; 27 rotation rect-only;
// 28 rotation reset after rect-only; 29 rotation config-only;
// 30 rotation reset after config-only; 31 lag regression.
extern let g_fake_pixels: i32[921600];

extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_scroll(key: i32) -> i32;
extern fn aui_debug_scroll_max(key: i32) -> i32;
extern fn aui_debug_scroll_set(key: i32, px: i32) -> i32;
extern fn aui_invalidate_layout() -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_frame(now: i64) -> i32;
extern fn aui_invalidate() -> i32;
extern fn aui_version() -> i32;
extern fn aui_set_dark(dark: i32) -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;
extern fn canvas_tab() -> i32;
extern fn cv_draw_calls() -> i32;
extern fn cv_set_probe(v: i32) -> i32;
extern let g_fake_win_w: i32;
extern let g_fake_win_h: i32;

let g_act: i64[11] = 0;
let g_cb: i64[16] = 0;
let g_win: i64[4] = 0;
let g_assets: i64[1] = 0;
let g_ext_path: u8[32] = 0;
let g_harness_anchor: ptr = g_act;

fn call_cb(off: i32, a: ptr, b: ptr) -> i32 {
    let cb: ptr = load_ptr(g_act);
    let f: fn(ptr, ptr) -> i32 = load_ptr(cb + off);
    return f(a, b);
}

fn frame_at(t: i64) -> i32 {
    fake_set_clock(t);
    return aui_frame(t);
}

fn tap_at(t: i64, x: i32, y: i32) -> i32 {
    fake_set_clock(t);
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    fake_set_clock(t + 50000000);
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn tap_key(t: i64, k: i32) -> i32 {
    let r: i32[4] = 0;
    if (aui_debug_rect(k, r) != 0) { return -1; }
    return tap_at(t, r[0] + r[2] / 2, r[1] + r[3] / 2);
}

// Reset to portrait: fake window 720x1280 + win_resized + portrait
// rect + frame. Returns the canvas width after the reset.
fn rot_reset(t: i64) -> i32 {
    g_fake_win_w = 720;
    g_fake_win_h = 1280;
    let win: ptr = g_win;
    let n1: i32 = call_cb(64, g_act, win);
    let rc: i32[4] = 0;
    rc[0] = 0;
    rc[1] = 0;
    rc[2] = 720;
    rc[3] = 1280;
    let n2: i32 = call_cb(104, g_act, rc);
    frame_at(t);
    let r: i32[4] = 0;
    if (aui_debug_rect(730, r) != 0) { return -1; }
    return r[2];
}

fn px_off(x: i32, y: i32) -> i32 { return (y * 720 + x) * 4; }
fn chan(x: i32, y: i32, c: i32) -> i32 {
    return i32(load_u8(g_fake_pixels + px_off(x, y) + c));
}
fn lum(x: i32, y: i32) -> i32 {
    let r: i32 = chan(x, y, 0);
    let g: i32 = chan(x, y, 1);
    let b: i32 = chan(x, y, 2);
    return (r * 3 + g * 6 + b) / 10;
}
// Any pixel in the box with lum < lim.
fn dark_in(x0: i32, y0: i32, x1: i32, y1: i32, lim: i32) -> i32 {
    let y: i32 = y0;
    while (y < y1) {
        let x: i32 = x0;
        while (x < x1) {
            if (lum(x, y) < lim) { return 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}
// Any pixel in the box with lum > lim.
fn light_in(x0: i32, y0: i32, x1: i32, y1: i32, lim: i32) -> i32 {
    let y: i32 = y0;
    while (y < y1) {
        let x: i32 = x0;
        while (x < x1) {
            if (lum(x, y) > lim) { return 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}
// Any pixel in the box with lo <= lum <= hi.
fn lum_range_in(x0: i32, y0: i32, x1: i32, y1: i32, lo: i32, hi: i32) -> i32 {
    let y: i32 = y0;
    while (y < y1) {
        let x: i32 = x0;
        while (x < x1) {
            let l: i32 = lum(x, y);
            if (l >= lo && l <= hi) { return 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}
// Any pixel in the box with blue channel > 100 and red < 80
// (the icon48 main colour is (40, 53, 147)).
fn blue_in(x0: i32, y0: i32, x1: i32, y1: i32) -> i32 {
    let y: i32 = y0;
    while (y < y1) {
        let x: i32 = x0;
        while (x < x1) {
            if (chan(x, y, 2) > 100 && chan(x, y, 0) < 80) { return 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}
// Largest lum in the box.
fn max_lum(x0: i32, y0: i32, x1: i32, y1: i32) -> i32 {
    let m: i32 = 0;
    let y: i32 = y0;
    while (y < y1) {
        let x: i32 = x0;
        while (x < x1) {
            let l: i32 = lum(x, y);
            if (l > m) { m = l; }
            x = x + 1;
        }
        y = y + 1;
    }
    return m;
}

// Bring key into view (top at ty px); the page scroll key is 1000
// (canvas_page's aui_scroll). Returns 1 on success.
fn show_key(t: i64, k: i32, ty: i32) -> i32 {
    let r: i32[4] = 0;
    if (aui_debug_rect(k, r) != 0) { return 0; }
    let ny: i32 = aui_debug_scroll(1000) + r[1] - ty;
    if (ny < 0) { ny = 0; }
    let mx: i32 = aui_debug_scroll_max(1000);
    if (ny > mx) { ny = mx; }
    aui_debug_scroll_set(1000, ny);
    aui_invalidate_layout();
    frame_at(t);
    if (aui_debug_rect(k, r) != 0) { return 0; }
    if (r[1] < 0 || r[1] + r[3] > 1280) { return 0; }
    return 1;
}

fn main() -> i32 {
    let act: ptr = g_act;
    *(act + 0) = g_cb;
    let assets: ptr = g_assets;
    *(act + 64) = assets;
    let ep: ptr = g_ext_path;
    store_u8(ep + 0, 47);
    store_u8(ep + 1, 116);
    store_u8(ep + 2, 109);
    store_u8(ep + 3, 112);
    store_u8(ep + 4, 47);
    store_u8(ep + 5, 97);
    store_u8(ep + 6, 115);
    store_u8(ep + 7, 116);
    store_u8(ep + 8, 101);
    store_u8(ep + 9, 114);
    store_u8(ep + 10, 117);
    store_u8(ep + 11, 105);
    store_u8(ep + 12, 45);
    store_u8(ep + 13, 105);
    store_u8(ep + 14, 99);
    store_u8(ep + 15, 111);
    store_u8(ep + 16, 110);
    store_u8(ep + 17, 0);
    *(act + 40) = ep;

    if (g_harness_anchor == 0) { return 10; }
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    let r: i32 = ANativeActivity_onCreate(act, 0, 0);
    if (r != 0) { return 10; }

    let cb: ptr = load_ptr(g_act);
    let f56: ptr = load_ptr(cb + 56);
    let f72: ptr = load_ptr(cb + 72);
    if (f56 == 0 || f72 == 0) { return 11; }

    let win: ptr = g_win;
    let s1: i32 = call_cb(0, act, 0);
    let s2: i32 = call_cb(8, act, 0);
    let s3: i32 = call_cb(56, act, win);
    let s4: i32 = call_cb(72, act, win);

    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < 720 * 1280 * 4) {
        sum = sum + load_u8(g_fake_pixels + i);
        i = i + 1;
    }
    if (sum == 0) { return 12; }
    if (aui_version() != 14806) { return 13; }

    let base: i64 = 4000000000;
    frame_at(base);

    // ---- A. Canvas rect: 280 dp high, stretched to the card ----
    let cv: i32[4] = 0;
    if (aui_debug_rect(730, cv) != 0) { return 20; }
    // 280 dp * 2.625 = 735 px.
    if (cv[3] < 732 || cv[3] > 738) { return 20; }
    if (cv[2] < 400) { return 20; }
    if (cv[0] < 0 || cv[1] < 0 || cv[0] + cv[2] > 720) { return 20; }
    // Stretched to the card inner width: card (720) pad 16 dp = 42 px.
    let card: i32[4] = 0;
    if (aui_debug_rect(720, card) != 0) { return 20; }
    if (cv[0] < card[0] + 40 || cv[0] > card[0] + 44) { return 20; }
    if (cv[2] < card[2] - 86 || cv[2] > card[2] - 82) { return 20; }
    // Size labels exist.
    let lb: i32[4] = 0;
    if (aui_debug_rect(740, lb) != 0) { return 20; }
    if (aui_debug_rect(741, lb) != 0) { return 20; }
    // Canvas geometry in dp, from the rect (px * 8 / 21).
    let ox: i32 = cv[0];
    let oy: i32 = cv[1];
    let wdp: i32 = cv[2] * 8 / 21;
    let ext: i32 = wdp;
    if (ext > 280) { ext = 280; }
    let tr: i32 = ext * 34 / 100;
    let cx: i32 = wdp / 2;
    let cy: i32 = 140;
    // dp -> px relative to the canvas origin: px = dp * 21 / 8.
    // Taiji centres (dp): top disc (cx, cy - r/2), eye (cx, cy + r/2),
    // ring top (cx, cy - r), bottom-disc sample (cx, cy + r/2 + 20).

    // ---- B. Taiji: dark top disc, light bottom disc, dark eye, ring ----
    // NOTE: the eye dots sit exactly on the small-disc centres, so the
    // disc samples are offset 20 dp from the centres (disc radius 34,
    // eye radius 7) to miss the eyes.
    if (show_key(base + 50000000, 730, 300) == 0) { return 21; }
    if (aui_debug_rect(730, cv) != 0) { return 21; }
    ox = cv[0];
    oy = cv[1];
    let tdx: i32 = ox + cx * 21 / 8;
    let tdy: i32 = oy + (cy - tr / 2 - 20) * 21 / 8;
    if (dark_in(tdx - 8, tdy - 8, tdx + 8, tdy + 8, 110) == 0) { return 21; }
    let bdx: i32 = ox + cx * 21 / 8;
    let bdy: i32 = oy + (cy + tr / 2 + 20) * 21 / 8;
    if (light_in(bdx - 8, bdy - 8, bdx + 8, bdy + 8, 200) == 0) { return 21; }
    let edx: i32 = ox + cx * 21 / 8;
    let edy: i32 = oy + (cy + tr / 2) * 21 / 8;
    if (dark_in(edx - 6, edy - 6, edx + 6, edy + 6, 110) == 0) { return 21; }
    let rgx: i32 = ox + cx * 21 / 8;
    let rgy: i32 = oy + (cy - tr) * 21 / 8;
    if (lum_range_in(rgx - 4, rgy - 3, rgx + 4, rgy + 3, 60, 180) == 0) { return 21; }
    // v2.6.2: the true taiji has a dark LEFT half and a light RIGHT
    // half at the middle row (both 0.707r from the small-disc centres,
    // outside the eyes).
    let lmx: i32 = ox + (cx - tr / 2) * 21 / 8;
    let lmy: i32 = oy + cy * 21 / 8;
    if (dark_in(lmx - 8, lmy - 8, lmx + 8, lmy + 8, 110) == 0) { return 21; }
    let rmx: i32 = ox + (cx + tr / 2) * 21 / 8;
    let rmy: i32 = oy + cy * 21 / 8;
    if (light_in(rmx - 8, rmy - 8, rmx + 8, rmy + 8, 200) == 0) { return 21; }

    // ---- C. Orbit by tap: dark field, primary centre dot ----
    if (tap_key(base + 100000000, 712) != 0) { return 22; }
    frame_at(base + 130000000);
    if (canvas_tab() != 1) { return 22; }
    if (show_key(base + 150000000, 730, 300) == 0) { return 22; }
    if (aui_debug_rect(730, cv) != 0) { return 22; }
    ox = cv[0];
    oy = cv[1];
    // Field sample at 45 deg, radius 0.55 * orbit r (between ring 2
    // at 0.46r and ring 1 at 0.70r). Orbit r = 35% of extent.
    let orr: i32 = ext * 35 / 100;
    let fdx: i32 = ox + (cx + orr * 55 / 100 * 707 / 1000) * 21 / 8;
    let fdy: i32 = oy + (cy + orr * 55 / 100 * 707 / 1000) * 21 / 8;
    if (dark_in(fdx - 8, fdy - 8, fdx + 8, fdy + 8, 110) == 0) { return 22; }
    let cdx: i32 = ox + cx * 21 / 8;
    let cdy: i32 = oy + cy * 21 / 8;
    if (lum_range_in(cdx - 6, cdy - 6, cdx + 6, cdy + 6, 60, 180) == 0) { return 22; }
    // v2.6.2: arc 1 (0.70r, start 72 deg, span 248 deg) is present at
    // the left point (our 270 deg) but absent at the top (0 deg) --
    // this distinguishes arcs from the old full rings.
    let a1x: i32 = ox + (cx - orr * 70 / 100) * 21 / 8;
    let a1y: i32 = oy + cy * 21 / 8;
    if (lum_range_in(a1x - 6, a1y - 6, a1x + 6, a1y + 6, 60, 180) == 0) { return 22; }
    let tpx: i32 = ox + cx * 21 / 8;
    let tpy: i32 = oy + (cy - orr * 70 / 100) * 21 / 8;
    if (dark_in(tpx - 8, tpy - 8, tpx + 8, tpy + 8, 110) == 0) { return 22; }

    // ---- D. Path by tap: panel, strip, text, icon ----
    if (tap_key(base + 200000000, 713) != 0) { return 23; }
    frame_at(base + 230000000);
    if (canvas_tab() != 2) { return 23; }
    if (show_key(base + 250000000, 730, 300) == 0) { return 23; }
    if (aui_debug_rect(730, cv) != 0) { return 23; }
    ox = cv[0];
    oy = cv[1];
    // Panel interior (40, 160) dp; strip (32, 236) dp.
    let ppx: i32 = ox + 40 * 21 / 8;
    let ppy: i32 = oy + 160 * 21 / 8;
    if (lum_range_in(ppx - 8, ppy - 8, ppx + 8, ppy + 8, 60, 180) == 0) { return 23; }
    let spx: i32 = ox + 32 * 21 / 8;
    let spy: i32 = oy + 236 * 21 / 8;
    if (light_in(spx - 6, spy - 6, spx + 6, spy + 6, 200) == 0) { return 23; }
    // White "Path study" text, top-left of the panel.
    if (light_in(ox + 30 * 21 / 8, oy + 30 * 21 / 8,
                 ox + 110 * 21 / 8, oy + 48 * 21 / 8, 200) == 0) { return 23; }
    // Icon centre (150, 52) dp.
    let ipx: i32 = ox + 150 * 21 / 8;
    let ipy: i32 = oy + 52 * 21 / 8;
    if (blue_in(ipx - 6, ipy - 6, ipx + 6, ipy + 6) == 0) { return 23; }
    // v2.6.2: the rule stops 8 dp before the icon; the point just
    // inside the icon's left edge at the rule's height must be blue
    // (icon), not white (rule). The box is 2 px tall, thinner than
    // the 2 dp rule, so with the old rule it would be all white.
    // Panel: ix = ext*10/100, pw = wdp - ix*2, rule y = ix + ph*18/100.
    let ix: i32 = ext * 10 / 100;
    let pw: i32 = wdp - ix * 2;
    let ry: i32 = ix + (280 - ix * 2) * 18 / 100;
    let rx: i32 = ox + (ix + pw - 8 - 48 + 2) * 21 / 8;
    let ryy: i32 = oy + ry * 21 / 8;
    if (blue_in(rx - 2, ryy - 1, rx + 2, ryy + 1) == 0) { return 23; }
    // v2.6.2: the clip probe is off by default -- the canvas corner
    // (wdp-10, 270) dp is bare card background (light), not the dark
    // probe tab. (D2 below enables the probe and checks the tab.)
    let qx0: i32 = ox + (wdp - 10) * 21 / 8;
    let qy0: i32 = oy + 270 * 21 / 8;
    if (light_in(qx0 - 5, qy0 - 5, qx0 + 5, qy0 + 5, 200) == 0) { return 23; }

    // ---- D2. Clip probe: dark tab inside the corner, clean padding ----
    // v2.6.2: the probe is test-only (cv_set_probe); the shipped demo
    // no longer draws it.
    let pe: i32 = cv_set_probe(1);
    let pi: i32 = aui_invalidate();
    frame_at(base + 280000000);
    let qx: i32 = ox + (wdp - 10) * 21 / 8;
    let qy: i32 = oy + 270 * 21 / 8;
    if (dark_in(qx - 5, qy - 5, qx + 5, qy + 5, 110) == 0) { return 24; }
    if (light_in(cv[0] + cv[2] + 5, cv[1] + cv[3] + 5,
                 cv[0] + cv[2] + 15, cv[1] + cv[3] + 15, 200) == 0) { return 24; }
    let pe0: i32 = cv_set_probe(0);
    let pi0: i32 = aui_invalidate();
    frame_at(base + 290000000);

    // ---- E. Dark theme follows the tokens ----
    if (tap_key(base + 300000000, 711) != 0) { return 25; }
    frame_at(base + 330000000);
    if (canvas_tab() != 0) { return 25; }
    let ds: i32 = aui_set_dark(1);
    let di: i32 = aui_invalidate();
    frame_at(base + 360000000);
    // Card padding (surface) is dark now; Taiji top disc (TEXT) is light.
    if (max_lum(cv[0] + cv[2] + 5, cv[1] + cv[3] + 5,
                cv[0] + cv[2] + 15, cv[1] + cv[3] + 15) > 60) { return 25; }
    if (aui_debug_rect(730, cv) != 0) { return 25; }
    ox = cv[0];
    oy = cv[1];
    tdx = ox + cx * 21 / 8;
    tdy = oy + (cy - tr / 2 - 20) * 21 / 8;
    if (light_in(tdx - 8, tdy - 8, tdx + 8, tdy + 8, 200) == 0) { return 25; }
    let ds0: i32 = aui_set_dark(0);
    let di0: i32 = aui_invalidate();
    frame_at(base + 390000000);

    // ---- F. Drag starting on the Canvas scrolls the page ----
    if (show_key(base + 400000000, 730, 300) == 0) { return 26; }
    if (aui_debug_rect(730, cv) != 0) { return 26; }
    let ccx: i32 = cv[0] + cv[2] / 2;
    let ccy: i32 = cv[1] + cv[3] / 2;
    let before: i32 = aui_debug_scroll(1000);
    // All three motion events share one timestamp: spacing them 10 ms
    // apart makes the drag fast enough to fling (+30 px), so the
    // scroll would overshoot the 120 px drag. (list_harness never
    // advances the clock during a drag, for the same reason.)
    fake_set_clock(base + 420000000);
    fake_post_motion(0, ccx, ccy);
    aui_on_input(1, 0, 0);
    fake_post_motion(2, ccx, ccy - 120);
    aui_on_input(1, 0, 0);
    fake_post_motion(1, ccx, ccy - 120);
    aui_on_input(1, 0, 0);
    frame_at(base + 450000000);
    if (aui_debug_scroll(1000) != before + 120) { return 26; }
    // Scroll back: the drawing must be undistorted.
    aui_debug_scroll_set(1000, 0);
    aui_invalidate_layout();
    frame_at(base + 480000000);
    if (aui_debug_rect(730, cv) != 0) { return 26; }
    ox = cv[0];
    oy = cv[1];
    tdx = ox + cx * 21 / 8;
    tdy = oy + (cy - tr / 2 - 20) * 21 / 8;
    if (dark_in(tdx - 8, tdy - 8, tdx + 8, tdy + 8, 110) == 0) { return 26; }

    // ---- G. Rotation: rect-only and config-only both re-layout ----
    // (v2.6.2: aui_cb_rect re-reads the window and calc_insets
    // ignores a stored rect that no longer fits; before the fix both
    // stayed at the portrait width 531. Landscape canvas is 1091.)
    let rb: i64 = base + 500000000;
    // E1: rect-only (new landscape rect, window already landscape).
    g_fake_win_w = 1280;
    g_fake_win_h = 720;
    let rc1: i32[4] = 0;
    rc1[0] = 0;
    rc1[1] = 0;
    rc1[2] = 1280;
    rc1[3] = 720;
    let e1a: i32 = call_cb(104, act, rc1);
    frame_at(rb + 30000000);
    if (aui_debug_rect(730, cv) != 0) { return 27; }
    if (cv[2] < 1080 || cv[2] > 1100) { return 27; }
    // Reset to portrait.
    let rw1: i32 = rot_reset(rb + 60000000);
    if (rw1 < 520 || rw1 > 545) { return 28; }
    // E3: config-only.
    g_fake_win_w = 1280;
    g_fake_win_h = 720;
    let e3a: i32 = call_cb(112, act, 0);
    frame_at(rb + 150000000);
    if (aui_debug_rect(730, cv) != 0) { return 29; }
    if (cv[2] < 1080 || cv[2] > 1100) { return 29; }
    let rw3: i32 = rot_reset(rb + 180000000);
    if (rw3 < 520 || rw3 > 545) { return 30; }

    // ---- H. Lag regression: one tab switch runs draw_fn 1..4 times ----
    // (v2.6.2: measured 3 per switch after the fill_ring scanline;
    // before the rasterizer fix the same switch cost 1.3M isqrt calls.
    // The bound is on draw_fn calls, not on raster work.)
    let d0: i32 = cv_draw_calls();
    if (tap_key(base + 700000000, 712) != 0) { return 31; }
    frame_at(base + 730000000);
    if (canvas_tab() != 1) { return 31; }
    let dd: i32 = cv_draw_calls() - d0;
    if (dd < 1 || dd > 4) { return 31; }

    let s5: i32 = call_cb(24, act, 0);
    let s6: i32 = call_cb(32, act, 0);
    let s7: i32 = call_cb(40, act, 0);
    return 0;
}
