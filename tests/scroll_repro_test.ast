// scroll_repro_test.ast -- v2.7.4 clip 回归复现探针（qemu-user）。
//
// 目标：复现 v2.7.3 真机视频里的滚动画坏（行重叠 / 行消失）。
// 用户日志 aui_42_8j6m.log：300 帧，blit=1 占 287，c 中位 2ms，
// 帧间隔中位 16ms，但视频 2.37s 全行 "Item 16"、3.54s 行全消失。
// 本探针按用户日志的节奏驱动：快滑（每帧 150-250px 大跳变）+
// 惯性（UP 后 frame_at 推进）+ 换向快滑（向下拖回），并在每段
// 边界把直搬帧与强制全重画逐行对照。
//
// 对照方法（独立参照在第二步）：
//   (1) 段内直搬帧（chained blit，贴合真机流）vs 本树强制全重画
//       —— 若 clip bug 两边共用，此对照会盲过；
//   (2) 同序列在 v2.7.2 树（无 clip 跳过）上跑一遍，逐段哈希对照
//       —— v2.7.2 真机只慢不画坏，是已知正确的参照。
// 每段边界同时把直搬位图与全重画位图写成 .raw（1216x2688 RGBA），
// 供宿主 python 逐像素 diff 并转 PNG 肉眼确认。
//
// 返回码：0 四段全等（未复现）；2 某段直搬与全重画不等（复现）；
// 10 attach；11 回调；12 首帧空白；13 版本号；20 滚动上限不足；
// 21 窗口尺寸失败；90 字体加载失败；91 位图落盘失败。

include "../src/aui.ast";
include "../src/aster_std.ast";

extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_scroll(key: i32) -> i32;
extern fn aui_debug_scroll_max(key: i32) -> i32;
extern fn aui_debug_node_count() -> i32;
extern fn aui_debug_build_count() -> i32;
extern fn aui_debug_cmd_count() -> i32;
extern fn aui_debug_frame_blit() -> i32;
extern fn aui_debug_fbuf_ok() -> i32;
extern fn aui_debug_paint_gen() -> i32;
extern fn aui_debug_blit_diag(out: ptr) -> i32;
extern fn aui_debug_cmds_why(out: ptr) -> i32;
extern fn aui_debug_cmd_at(idx: i32, out: ptr) -> i32;
extern fn aui_debug_tt_cache(out: ptr) -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_frame(now: i64) -> i32;
extern fn aui_invalidate() -> i32;
extern fn aui_version() -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;
extern fn fake_set_win_size(w: i32, h: i32) -> i32;
extern fn fake_bits() -> ptr;

let g_act: i64[11] = 0;
let g_cb: i64[16] = 0;
let g_win: i64[4] = 0;
let g_assets: i64[1] = 0;
let g_ext_path: u8[32] = 0;
let g_harness_anchor: ptr = g_act;

let g_font: ptr = 0;

// 逐行 FNV-1a 哈希：直搬帧 [0] / 全重画帧 [1]。
let g_row_a: i32[2688] = 0;
let g_row_b: i32[2688] = 0;
let g_diag: i32[40] = 0;
let g_why: i32[6] = 0;
let g_cache: i32[6] = 0;
// MOVE 之后立刻拍下的直搬快照：[0] light [1] blit [2] fail [3] fbok。
let g_blit_mv: i32[4] = 0;
// 快滑累计 dy（手指相对 DOWN 点的位移，负 = 上滑）。
let g_dyd: i32[6] = 0;
// 换向快滑累计 dy（正 = 下滑，偏移减小）。
let g_dyu: i32[6] = 0;
let g_cx: i32 = 0;
let g_cy: i32 = 0;
// 诊断开关：0 只在段边界检查（链式直搬，贴合真机流）；1 每步都检查
// （每步直搬都以全重画为基线，隔离单步直搬是否正确）。
let g_check_each: i32 = 0;

fn call_cb(off: i32, a: ptr, b: ptr) -> i32 {
    let cb: ptr = load_ptr(g_act);
    let f: fn(ptr, ptr) -> i32 = load_ptr(cb + off);
    return f(a, b);
}

fn frame_at(t: i64) -> i32 {
    fake_set_clock(t);
    return aui_frame(t);
}

fn out_str(s: ptr) -> i32 { return write_all(1, s, strlen(s)); }

fn out_i32(v: i32) -> i32 {
    let buf: u8[16] = 0;
    let n: i32 = fmt_i32(buf, v);
    return write_all(1, buf, n);
}

// 逐行哈希：which 0 -> g_row_a，1 -> g_row_b。
fn row_hashes(which: i32) -> i32 {
    let bits: ptr = fake_bits();
    let y: i32 = 0;
    while (y < 2688) {
        let h: i32 = -2128831035;
        let x: i32 = 0;
        let row: ptr = bits + y * 4864;
        while (x < 1216) {
            h = (h ^ *(row + x * 4)) * 16777619;
            x = x + 1;
        }
        if (which == 0) { g_row_a[y] = h; } else { g_row_b[y] = h; }
        y = y + 1;
    }
    return 0;
}

// 位图落盘：1216x2688 RGBA8888 共 13074432 字节。
fn dump_bitmap(path: ptr) -> i32 {
    let fd: i32 = fd_open(path, 577, 420);
    if (fd < 0) { return -1; }
    let w: i32 = write_all(fd, fake_bits(), 13074432);
    fd_close(fd);
    return w;
}

fn snap_blit() -> i32 {
    let dg: i32 = aui_debug_blit_diag(g_diag);
    let wy: i32 = aui_debug_cmds_why(g_why);
    g_blit_mv[0] = g_diag[0];
    g_blit_mv[1] = aui_debug_frame_blit();
    g_blit_mv[2] = g_diag[23];
    g_blit_mv[3] = g_diag[21];
    return 0;
}

fn step_line(step: i32, tag: ptr, key: i32) -> i32 {
    let s1: i32 = out_str("REPROSTEP step=");
    let s2: i32 = out_i32(step);
    let s3: i32 = out_str(" ");
    let s4: i32 = out_str(tag);
    let s5: i32 = out_str(" off=");
    let s6: i32 = out_i32(aui_debug_scroll(key));
    let s7: i32 = out_str(" light=");
    let s8: i32 = out_i32(g_blit_mv[0]);
    let s9: i32 = out_str(" blit=");
    let sa: i32 = out_i32(g_blit_mv[1]);
    let sb: i32 = out_str(" fail=");
    let sc: i32 = out_i32(g_blit_mv[2]);
    let sd: i32 = out_str(" fboff=");
    let se: i32 = out_i32(g_diag[12] >> 16);
    let sf: i32 = out_str(" dif=");
    let sg: i32 = out_i32(g_diag[24] >> 16);
    let sh: i32 = out_str(" bd=");
    let si: i32 = out_i32(g_diag[25]);
    let sj: i32 = out_str(" fk=");
    let sk: i32 = out_i32(g_diag[10]);
    let sl: i32 = out_str(" fbk=");
    let sm: i32 = out_i32(g_diag[11]);
    let sn: i32 = out_str(" fbget=");
    let so: i32 = out_i32(g_diag[13] >> 16);
    let sp: i32 = out_str(" dif2=");
    let sq: i32 = out_i32(g_diag[22] >> 16);
    let sr: i32 = out_str("\n");
    return 0;
}

// 打印当前命令表（op/x/y/w/h，像素）：诊断直搬帧用的命令是否已按当前偏移定位。
fn dump_cmds(tag: ptr) -> i32 {
    let n: i32 = aui_debug_cmd_count();
    let i: i32 = 0;
    let c: i32[8] = 0;
    while (i < n) {
        let r: i32 = aui_debug_cmd_at(i, c);
        if (r == 0) {
            let s1: i32 = out_str("CMD ");
            let s2: i32 = out_str(tag);
            let s3: i32 = out_str(" idx=");
            let s4: i32 = out_i32(i);
            let s5: i32 = out_str(" op=");
            let s6: i32 = out_i32(c[0]);
            let s7: i32 = out_str(" x=");
            let s8: i32 = out_i32(c[1]);
            let s9: i32 = out_str(" y=");
            let sa: i32 = out_i32(c[2]);
            let sb: i32 = out_str(" w=");
            let sc: i32 = out_i32(c[3]);
            let sd: i32 = out_str(" h=");
            let se: i32 = out_i32(c[4]);
            let sf: i32 = out_str(" tl=");
            let sg: i32 = out_i32(c[7]);
            let sh: i32 = out_str("\n");
        }
        i = i + 1;
    }
    return 0;
}

// 段边界检查：直搬帧逐行哈希 vs 强制全重画逐行哈希。
// 返回 1 相等，0 不等（同时打印首/末不同行与行数）。
fn check_phase(phase: i32, key: i32, t: i64, pb: ptr, pf: ptr) -> i32 {
    let rh1: i32 = row_hashes(0);
    if (pb != 0) {
        let d1: i32 = dump_bitmap(pb);
        if (d1 != 13074432) { return -1; }
    }
    let iv: i32 = aui_invalidate();
    frame_at(t);
    let rh2: i32 = row_hashes(1);
    if (pf != 0) {
        let d2: i32 = dump_bitmap(pf);
        if (d2 != 13074432) { return -1; }
    }
    let first: i32 = -1;
    let last: i32 = -1;
    let n: i32 = 0;
    let y: i32 = 0;
    while (y < 2688) {
        if (g_row_a[y] != g_row_b[y]) {
            if (first < 0) { first = y; }
            last = y;
            n = n + 1;
        }
        y = y + 1;
    }
    let eq: i32 = 0;
    if (n == 0) { eq = 1; }
    let s1: i32 = out_str("REPRO phase=");
    let s2: i32 = out_i32(phase);
    let s3: i32 = out_str(" off=");
    let s4: i32 = out_i32(aui_debug_scroll(key));
    let s5: i32 = out_str(" eq=");
    let s6: i32 = out_i32(eq);
    let s7: i32 = out_str(" first=");
    let s8: i32 = out_i32(first);
    let s9: i32 = out_str(" last=");
    let sa: i32 = out_i32(last);
    let sb: i32 = out_str(" ndiff=");
    let sc: i32 = out_i32(n);
    let sd: i32 = out_str("\n");
    return eq;
}

fn build(user: ptr) -> i32 {
    aui_root();
    aui_column(1);
    aui_weight(1);
    // 页眉三行宽字母表（与 scroll_big_test 场景相同）。
    aui_label(2, "ABCDEFGHIJKLMNOPQRSTU");
    aui_label(3, "VWXYZabcdefghijklmno");
    aui_label(4, "pqrstuvwxyz0123456789");
    aui_scroll(100);
    aui_weight(1);
    aui_column(101);
    aui_pad(10);
    aui_gap(6);
    aui_bg(aui_theme_color(AUI_COLOR_SURFACE));
    aui_radius(14);
    // 60 行：与 scroll_big_test 同场景。
    let i: i32 = 0;
    while (i < 60) {
        aui_row(1100 + i);
        aui_pad(12);
        aui_gap(12);
        aui_bg(aui_theme_color(AUI_COLOR_TINT));
        aui_radius(10);
        aui_label(1400 + i, "Item");
        aui_text_i32(1450 + i, i);
        aui_end();
        i = i + 1;
    }
    aui_end();
    aui_end();
    aui_row(5);
    aui_pad(16);
    aui_gap(8);
    aui_label(6, "Footer");
    aui_end();
    aui_end();
    return 0;
}

fn app_init(user: ptr) -> i32 {
    aui_set_font(g_font, 1);
    return 0;
}

fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32 {
    return aui_android_attach(activity, saved, savedSize,
                              build, 0, app_init, 0);
}

// 一步 MOVE：dy 为累计位移（相对 DOWN 点）。
fn move_step(step: i32, dy: i32, t: i64, key: i32) -> i32 {
    fake_set_clock(t);
    fake_post_motion(2, g_cx, g_cy + dy);
    aui_on_input(1, 0, 0);
    let sb: i32 = snap_blit();
    frame_at(t);
    let sl: i32 = step_line(step, "move", key);
    if (g_check_each != 0) {
        let eq: i32 = check_phase(step, key, t, "repro_step_blit.raw", "repro_step_full.raw");
        if (eq == 0) { return 2; }
        if (eq < 0) { return 91; }
    }
    return 0;
}

// 惯性 tick：无输入，只推进帧泵。
fn fling_tick(step: i32, t: i64, key: i32) -> i32 {
    frame_at(t);
    let sb: i32 = snap_blit();
    let sl: i32 = step_line(step, "fling", key);
    if (step == 7) { let dc: i32 = dump_cmds("fling7"); }
    if (g_check_each != 0) {
        let eq: i32 = check_phase(step, key, t, "repro_step_blit.raw", "repro_step_full.raw");
        if (eq == 0) { return 2; }
        if (eq < 0) { return 91; }
    }
    return 0;
}

fn main() -> i32 {
    if (fake_set_win_size(1216, 2688) != 0) { return 21; }
    let act: ptr = g_act;
    *(act + 0) = g_cb;
    let assets: ptr = g_assets;
    *(act + 64) = assets;
    store_u8(g_ext_path + 0, 47);
    store_u8(g_ext_path + 1, 116);
    store_u8(g_ext_path + 2, 109);
    store_u8(g_ext_path + 3, 112);
    store_u8(g_ext_path + 4, 47);
    store_u8(g_ext_path + 5, 97);
    store_u8(g_ext_path + 6, 115);
    store_u8(g_ext_path + 7, 116);
    store_u8(g_ext_path + 8, 101);
    store_u8(g_ext_path + 9, 114);
    store_u8(g_ext_path + 10, 117);
    store_u8(g_ext_path + 11, 105);
    store_u8(g_ext_path + 12, 45);
    store_u8(g_ext_path + 13, 116);
    store_u8(g_ext_path + 14, 114);
    store_u8(g_ext_path + 15, 97);
    store_u8(g_ext_path + 16, 99);
    store_u8(g_ext_path + 17, 101);
    store_u8(g_ext_path + 18, 0);
    let ep: ptr = g_ext_path;
    *(act + 40) = ep;

    if (g_harness_anchor == 0) { return 10; }
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    if (font_ok != 1) { return 90; }
    let r: i32 = ANativeActivity_onCreate(act, 0, 0);
    if (r != 0) { return 10; }

    let cb: ptr = load_ptr(g_act);
    let f56: ptr = load_ptr(cb + 56);
    let f72: ptr = load_ptr(cb + 72);
    if (f56 == 0 || f72 == 0) { return 11; }

    let win: ptr = g_win;
    let s1: i32 = call_cb(0, act, 0);
    let s2: i32 = call_cb(8, act, 0);
    let s3: i32 = call_cb(56, act, win);
    let s4: i32 = call_cb(72, act, win);

    let bits: ptr = fake_bits();
    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < 1216 * 2688 * 4) {
        sum = sum + load_u8(bits + i);
        i = i + 4096;
    }
    if (sum == 0) { return 12; }
    if (aui_version() != 14806) { return 13; }

    let base: i64 = 5000000000;
    frame_at(base);
    let mx0: i32 = aui_debug_scroll_max(100);
    let m0: i32 = out_str("REPRO max=");
    let m1: i32 = out_i32(mx0);
    let m2: i32 = out_str("\n");
    if (mx0 < 2000) { return 20; }

    // 视口中心。
    let rr: i32[4] = 0;
    if (aui_debug_rect(100, rr) != 0) { return 1; }
    g_cx = rr[0] + rr[2] / 2;
    g_cy = rr[1] + rr[3] / 2;
    let c0: i32 = out_str("REPRO cx=");
    let c1: i32 = out_i32(g_cx);
    let c2: i32 = out_str(" cy=");
    let c3: i32 = out_i32(g_cy);
    let c4: i32 = out_str("\n");

    // 快滑累计 dy：每步 150-250px（用户日志最大单帧 294px）。
    g_dyd[0] = -150;
    g_dyd[1] = -350;
    g_dyd[2] = -600;
    g_dyd[3] = -850;
    g_dyd[4] = -1100;
    g_dyd[5] = -1300;
    // 换向快滑累计 dy（手指下滑，偏移减小）。
    g_dyu[0] = 100;
    g_dyu[1] = 250;
    g_dyu[2] = 450;
    g_dyu[3] = 650;
    g_dyu[4] = 850;
    g_dyu[5] = 1000;

    let key: i32 = 100;
    let t: i64 = base + 100000000;
    let step: i32 = 0;

    // ---- 阶段 1：快滑下（6 步 MOVE）----
    fake_set_clock(t);
    fake_post_motion(0, g_cx, g_cy);
    aui_on_input(1, 0, 0);
    frame_at(t);
    let k: i32 = 0;
    while (k < 6) {
        step = step + 1;
        t = t + 16000000;
        let ms: i32 = move_step(step, g_dyd[k], t, key);
        if (ms != 0) { return ms; }
        k = k + 1;
    }
    let dc6: i32 = dump_cmds("drag6");
    let p1: i32 = check_phase(1, key, t, "repro_blit_1.raw", "repro_full_1.raw");
    if (p1 < 0) { return 91; }
    if (p1 == 0) { return 2; }

    // ---- 阶段 2：松手惯性（14 tick）----
    fake_set_clock(t);
    fake_post_motion(1, g_cx, g_cy + g_dyd[5]);
    aui_on_input(1, 0, 0);
    let j: i32 = 0;
    while (j < 14) {
        step = step + 1;
        t = t + 16000000;
        let ft: i32 = fling_tick(step, t, key);
        if (ft != 0) { return ft; }
        if (step == 7) { let dc7: i32 = dump_cmds("fling7"); }
        j = j + 1;
    }
    let p2: i32 = check_phase(2, key, t, "repro_blit_2.raw", "repro_full_2.raw");
    if (p2 < 0) { return 91; }
    if (p2 == 0) { return 2; }

    // ---- 阶段 3：换向快滑上（6 步 MOVE）----
    fake_set_clock(t);
    fake_post_motion(0, g_cx, g_cy);
    aui_on_input(1, 0, 0);
    frame_at(t);
    k = 0;
    while (k < 6) {
        step = step + 1;
        t = t + 16000000;
        let ms2: i32 = move_step(step, g_dyu[k], t, key);
        if (ms2 != 0) { return ms2; }
        k = k + 1;
    }
    let p3: i32 = check_phase(3, key, t, "repro_blit_3.raw", "repro_full_3.raw");
    if (p3 < 0) { return 91; }
    if (p3 == 0) { return 2; }

    // ---- 阶段 4：松手惯性（10 tick）----
    fake_set_clock(t);
    fake_post_motion(1, g_cx, g_cy + g_dyu[5]);
    aui_on_input(1, 0, 0);
    j = 0;
    while (j < 10) {
        step = step + 1;
        t = t + 16000000;
        let ft2: i32 = fling_tick(step, t, key);
        if (ft2 != 0) { return ft2; }
        j = j + 1;
    }
    let p4: i32 = check_phase(4, key, t, "repro_blit_4.raw", "repro_full_4.raw");
    if (p4 < 0) { return 91; }
    if (p4 == 0) { return 2; }

    let e: i32 = eputs("PASS: scroll_repro (no mismatch)\n");
    return 0;
}
