// dropdown_test.ast — v1.26 下拉选择离屏自检（qemu-user）。
//
// W5 重定基线：先加载 VM 的 TrueType 字体（aui_rt_set_font_path），文本用
// 原生 48 px em（scale 1，与 examples/harness 一致；旧 scale 2 配已删
// .auf 8 px 图集）；SafeArea 上 24 px 猜测，内容区 y 从 24 起、高 192。
// 浮层说明：触发器底 112 + 4 = 116，浮层高 156，116+156=272 超出内容区底
// 边距（24+192-8=208），向上翻 32-156-4=-128 又不够高，故框架按设计夹到
// 内容区底（208-156=52），浮层与触发器下部重叠——这是 select_layout 的夹取
// 行为，不是锚定错误；触发器点按/命中改用浮层未覆盖的 y 32..52 一带（160,40）。
// 校验：触发器几何、浮层锚定/宽度/高度、选项命中、选中项底色、
// 点选项回调与下标、点浮层 padding 不关闭、外部点击/触发器/BACK 关闭、
// 展开时底层不穿透、关闭后底层恢复可点。
// 返回码：0 通过；1 渲染；2 节点数；3 触发器矩形；4 浮层矩形；
// 5 浮层/选项像素；6 命中；7 padding 误关；8 选项回调；
// 9 外部关闭；10 底层穿透；11 触发器二次点击；12 BACK；13 关闭后底层；
// 14 重开；15 版本；90 字体加载失败。
include "../aui.ast";

extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_hit(px: i32, py: i32) -> i32;
extern fn aui_debug_select_panel(out: ptr) -> i32;
extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_post_key(action: i32, code: i32) -> i32;

let g_buf: u8[307200] = 0;   // 320x240 RGBA
let g_font: ptr = 0; // W4: .auf removed (no font files in repo; runtime adapter, see font_runtime.ast)

struct T {
    sel: i32,
    open: i32,
    reason: i32,
    val: i32,
    hits: i32,
    under: i32
}

let g_t: T = T { 0, 0, 0, -1, 0, 0 };

fn on_select(user: ptr) -> i32 {
    let t: ptr<T> = user;
    t.hits = t.hits + 1;
    t.reason = aui_select_reason();
    if (t.reason == 0) {
        t.open = 1;
    } else if (t.reason == 1) {
        t.val = aui_select_value(20);
        if (t.val >= 0) { t.sel = t.val; }
        t.open = 0;
    } else {
        t.open = 0;
    }
    aui_invalidate();
    return 0;
}

fn on_under(user: ptr) -> i32 {
    let t: ptr<T> = user;
    t.under = t.under + 1;
    aui_invalidate();
    return 0;
}

fn build(user: ptr) -> i32 {
    let t: ptr<T> = user;
    aui_root();
    aui_column(1);
    aui_pad(8);
    aui_gap(8);
    aui_select(20, t.sel, t.open, "Pick one", on_select, user);
    aui_option(21, "Alpha");
    aui_option(22, "Beta");
    aui_option(23, "Gamma");
    aui_end();
    aui_button(30, "Under", on_under, user);
    aui_end();
    return 0;
}

fn off(x: i32, y: i32) -> i32 {
    return (y * 320 + x) * 4;
}

fn is_color(x: i32, y: i32, r: i32, g: i32, b: i32) -> i32 {
    let o: i32 = off(x, y);
    if (load_u8(g_buf + o + 0) != r) { return 0; }
    if (load_u8(g_buf + o + 1) != g) { return 0; }
    if (load_u8(g_buf + o + 2) != b) { return 0; }
    return 1;
}

fn render() -> i32 {
    let n: i32 = aui_headless_render(320, 240, g_buf);
    if (n <= 0) { return 0; }
    return n;
}

fn tap(x: i32, y: i32) -> i32 {
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn main() -> i32 {
    // W5 re-baseline: load the VM TrueType font first (same hook the
    // 11-14 harnesses use); scale 1 = native 48 px em as in every
    // example/harness app (old scale 2 belonged to the deleted .auf font).
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    if (font_ok != 1) { return 90; }
    aui_set_font(g_font, 1);
    aui_debug_set_density(160);
    aui_headless_init(build, &g_t);
    if (render() == 0) { return 1; }
    if (aui_debug_node_count() != 7) { return 2; }
    if (aui_version() != 14806) { return 15; }

    let r: i32[4] = 0;
    if (aui_debug_rect(20, r) != 0) { return 3; }
    // W5 re-baseline: y 8 -> 32（SafeArea 上 24 px + pad 8）；高 48 -> 80
    // （行高 60 + 20，探针实测关闭/展开态均为 80）。
    if (r[0] != 8 || r[1] != 32 || r[2] != 304 || r[3] != 80) { return 3; }

    // 点触发器：reason=0，应用展开。
    tap(160, 40);
    if (g_t.hits != 1 || g_t.reason != 0 || g_t.open != 1) { return 8; }
    if (render() == 0) { return 1; }

    // 浮层：宽 304，高 3*48+12=156；y 按文件头所述夹到 52（非 116），
    // 首项 y = 52+6 = 58。W5 re-baseline：探针实测浮层 (8,52,304,156)。
    let p: i32[4] = 0;
    if (aui_debug_select_panel(p) != 0) { return 4; }
    if ((p[0] >> 16) != 8 || (p[1] >> 16) != 52 ||
        (p[2] >> 16) != 304 || (p[3] >> 16) != 156) { return 4; }

    // 选项行高 48、左右各内缩 4；首项选中用 TINT 底。
    let o: i32[4] = 0;
    if (aui_debug_rect(21, o) != 0) { return 4; }
    if (o[0] != 12 || o[1] != 58 || o[2] != 296 || o[3] != 48) { return 4; }
    if (is_color(20, 82, 0xED, 0xF1, 0xFA) == 0) { return 5; }
    if (is_color(160, 240 - 1, 0xF6, 0xF6, 0xF8) == 0) { return 5; }

    // 命中：三个选项 + 触发器；外部与 padding 不返回节点。
    // W5 re-baseline: 选项中心 y 80/130/180 -> 82/130/178；触发器命中点
    // 改 (160,40)（浮层盖住触发器下半，y 32..52 一带才露得出触发器）。
    if (aui_debug_hit(100, 82) != 21) { return 6; }
    if (aui_debug_hit(100, 130) != 22) { return 6; }
    if (aui_debug_hit(100, 178) != 23) { return 6; }
    if (aui_debug_hit(160, 40) != 20) { return 6; }
    if (aui_debug_hit(5, 5) != -1) { return 6; }
    if (aui_debug_hit(10, 55) != -1) { return 6; }

    // 点浮层 padding：吞掉，不关闭。
    // W5 re-baseline: 浮层顶 pad 点 (10,62) -> (10,55)（浮层 y 52..208，顶 pad 52..58）。
    tap(10, 55);
    if (g_t.hits != 1 || g_t.open != 1) { return 7; }

    // 点第二项：reason=1，读数 1，应用更新并关闭。
    tap(100, 130);
    if (g_t.hits != 2 || g_t.reason != 1 || g_t.val != 1 ||
        g_t.sel != 1 || g_t.open != 0) { return 8; }
    if (render() == 0) { return 1; }
    if (aui_debug_select_panel(p) == 0) { return 8; }
    if (aui_debug_node_count() != 7) { return 2; }

    // 重开，点外部关闭：reason=2，底层按钮不触发。
    tap(160, 40);
    if (g_t.open != 1) { return 14; }
    if (render() == 0) { return 1; }
    tap(315, 230);
    if (g_t.hits != 4 || g_t.reason != 2 || g_t.open != 0 || g_t.under != 0) { return 9; }
    if (render() == 0) { return 1; }

    // 重开，再点触发器：reason=2 关闭。
    tap(160, 40);
    if (g_t.open != 1) { return 14; }
    if (render() == 0) { return 1; }
    tap(160, 40);
    if (g_t.hits != 6 || g_t.reason != 2 || g_t.open != 0) { return 11; }
    if (render() == 0) { return 1; }

    // 重开，BACK：reason=3，不触发底层。
    tap(160, 40);
    if (g_t.open != 1) { return 14; }
    if (render() == 0) { return 1; }
    fake_post_key(0, 4);
    aui_on_input(1, 0, 0);
    fake_post_key(1, 4);
    aui_on_input(1, 0, 0);
    if (g_t.reason != 3 || g_t.open != 0 || g_t.under != 0) { return 12; }

    // 关闭后底层恢复可点。
    if (render() == 0) { return 1; }
    if (aui_debug_rect(30, r) != 0) { return 13; }
    tap(r[0] + r[2] / 2, r[1] + r[3] / 2);
    if (g_t.under != 1) { return 13; }
    return 0;
}