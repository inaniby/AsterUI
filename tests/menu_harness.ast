// menu_harness.ast — v1.35 ui_menu 的真实宿主路径冒烟测试（qemu-user）。
//
// 720×1280 / density 420 的假宿主，走 ANativeActivity 回调创建窗口，然后：
// 版本号 14806；Actions 菜单贴在按钮下方、最小 180 dp 宽、白底深字；
// 勾选标记与禁用条目；点条目先关菜单再回调；点外部/BACK 原因正确；
// 屏幕点菜单定位；超长菜单内部滚动；深色主题下菜单改为深色表面。
//
// 返回码：0 通过；10 attach 失败；11 回调表没写；12 屏幕全黑；
// 13 版本号不是 14806；14 锚定几何不对；15 配色不对；16 勾选标记缺失；
// 17 点条目回调/顺序不对；18 禁用条目被激活；19 点外部原因不对；
// 20 BACK 原因不对；21 屏幕点菜单位置不对；22 长菜单没有溢出；
// 23 拖动滚动不对；24 深色菜单配色不对；25 底部菜单没有翻到上方；
// 90 内容超出 720×1280。
extern let g_fake_pixels: i32[921600];

extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_menu(out: ptr) -> i32;
extern fn aui_debug_menu_item(key: i32, out: ptr) -> i32;
extern fn aui_debug_menu_touch(out: ptr) -> i32;
extern fn aui_debug_scroll(key: i32) -> i32;
extern fn aui_debug_scroll_max(key: i32) -> i32;
extern fn aui_debug_scroll_set(key: i32, px: i32) -> i32;
extern fn aui_invalidate_layout() -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_frame(now: i64) -> i32;
extern fn aui_state_get(key: i32) -> i32;
extern fn aui_invalidate() -> i32;
extern fn aui_version() -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_post_key(action: i32, code: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;

let g_act: i64[11] = 0;
let g_cb: i64[16] = 0;
let g_win: i64[4] = 0;
let g_assets: i64[1] = 0;
let g_ext_path: u8[32] = 0;
let g_harness_anchor: ptr = g_act;

fn call_cb(off: i32, a: ptr, b: ptr) -> i32 {
    let cb: ptr = load_ptr(g_act);
    let f: fn(ptr, ptr) -> i32 = load_ptr(cb + off);
    return f(a, b);
}

fn frame_at(t: i64) -> i32 {
    fake_set_clock(t);
    return aui_frame(t);
}

fn tap_at(t: i64, x: i32, y: i32) -> i32 {
    fake_set_clock(t);
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    fake_set_clock(t + 50000000);
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn drag_at(t: i64, x0: i32, y0: i32, x1: i32, y1: i32) -> i32 {
    fake_set_clock(t);
    fake_post_motion(0, x0, y0);
    aui_on_input(1, 0, 0);
    fake_set_clock(t + 20000000);
    fake_post_motion(2, x1, y1);
    aui_on_input(1, 0, 0);
    fake_set_clock(t + 40000000);
    fake_post_motion(1, x1, y1);
    aui_on_input(1, 0, 0);
    return 0;
}

fn back_at(t: i64) -> i32 {
    fake_set_clock(t);
    fake_post_key(0, 4);
    aui_on_input(2, 0, 0);
    fake_set_clock(t + 50000000);
    fake_post_key(1, 4);
    aui_on_input(2, 0, 0);
    return 0;
}

fn px_off(x: i32, y: i32) -> i32 { return (y * 720 + x) * 4; }
fn chan(x: i32, y: i32, c: i32) -> i32 {
    return i32(load_u8(g_fake_pixels + px_off(x, y) + c));
}
fn lum(x: i32, y: i32) -> i32 {
    let r: i32 = chan(x, y, 0);
    let g: i32 = chan(x, y, 1);
    let b: i32 = chan(x, y, 2);
    return (r * 3 + g * 6 + b) / 10;
}
fn tap_key(k: i32, t: i64) -> i32 {
    let r: i32[4] = 0;
    if (aui_debug_rect(k, r) != 0) { return -1; }
    return tap_at(t, r[0] + r[2] / 2, r[1] + r[3] / 2);
}

fn show_key(t: i64, k: i32, ty: i32) -> i32 {
    let r: i32[4] = 0;
    if (aui_debug_rect(k, r) != 0) { return 0; }
    let ny: i32 = aui_debug_scroll(1) + r[1] - ty;
    if (ny < 0) { ny = 0; }
    let mx: i32 = aui_debug_scroll_max(1);
    if (ny > mx) { ny = mx; }
    aui_debug_scroll_set(1, ny);
    aui_invalidate_layout();
    frame_at(t);
    if (aui_debug_rect(k, r) != 0) { return 0; }
    if (r[1] < 0 || r[1] + r[3] > 1280) { return 0; }
    return 1;
}
fn rect_ok(r: ptr, w: i32, h: i32) -> i32 {
    let p: ptr<i32> = r;
    if (p[0] < 0 || p[1] < 0) { return 0; }
    if (p[0] + p[2] > w || p[1] + p[3] > h) { return 0; }
    return 1;
}
fn dark_in(x0: i32, y0: i32, x1: i32, y1: i32, lim: i32) -> i32 {
    let y: i32 = y0;
    while (y < y1) {
        let x: i32 = x0;
        while (x < x1) {
            if (lum(x, y) < lim) { return 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}
fn light_in(x0: i32, y0: i32, x1: i32, y1: i32) -> i32 {
    let y: i32 = y0;
    while (y < y1) {
        let x: i32 = x0;
        while (x < x1) {
            if (lum(x, y) > 235) { return 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

fn main() -> i32 {
    let act: ptr = g_act;
    *(act + 0) = g_cb;
    let assets: ptr = g_assets;
    *(act + 64) = assets;
    let ep: ptr = g_ext_path;
    store_u8(ep + 0, 47);
    store_u8(ep + 1, 116);
    store_u8(ep + 2, 109);
    store_u8(ep + 3, 112);
    store_u8(ep + 4, 47);
    store_u8(ep + 5, 97);
    store_u8(ep + 6, 115);
    store_u8(ep + 7, 116);
    store_u8(ep + 8, 101);
    store_u8(ep + 9, 114);
    store_u8(ep + 10, 117);
    store_u8(ep + 11, 105);
    store_u8(ep + 12, 45);
    store_u8(ep + 13, 109);
    store_u8(ep + 14, 101);
    store_u8(ep + 15, 110);
    store_u8(ep + 16, 117);
    store_u8(ep + 17, 0);
    *(act + 40) = ep;

    if (g_harness_anchor == 0) { return 10; }
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    let r: i32 = ANativeActivity_onCreate(act, 0, 0);
    if (r != 0) { return 10; }

    let cb: ptr = load_ptr(g_act);
    let f56: ptr = load_ptr(cb + 56);
    let f72: ptr = load_ptr(cb + 72);
    if (f56 == 0 || f72 == 0) { return 11; }

    let win: ptr = g_win;
    let s1: i32 = call_cb(0, act, 0);
    let s2: i32 = call_cb(8, act, 0);
    let s3: i32 = call_cb(56, act, win);
    let s4: i32 = call_cb(72, act, win);

    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < 720 * 1280 * 4) {
        sum = sum + load_u8(g_fake_pixels + i);
        i = i + 1;
    }
    if (sum == 0) { return 12; }
    if (aui_version() != 14806) { return 13; }

    let base: i64 = 4000000000;
    frame_at(base);
    let btn: i32[4] = 0;
    if (aui_debug_rect(10, btn) != 0) { return 90; }
    if (rect_ok(btn, 720, 1280) == 0) { return 90; }

    // ---- A. Actions 菜单：按钮下方 4 dp，最小 180 dp 宽 ----
    if (tap_key(10, base + 100000000) != 0) { return 14; }
    frame_at(base + 150000000);
    let m: i32[10] = 0;
    if (aui_debug_menu(m) != 0) { return 14; }
    if (m[4] != 20 || m[9] != 4) { return 14; }
    if (m[0] < 20 || m[0] + m[2] > 720 - 20) { return 14; }
    let gy: i32 = btn[1] + btn[3] + 10;          // 4 dp ≈ 10.5 px
    let dy: i32 = m[1] - gy;
    if (dy < -2 || dy > 2) { return 14; }
    if (m[2] < 472) { return 14; }
    if (m[1] + m[3] > 1280 - 20) { return 14; }

    // ---- B. 白底 + 深色文字 + 勾选标记 ----
    let mi: i32[8] = 0;
    if (aui_debug_menu_item(21, mi) != 0) { return 15; }
    if (mi[6] != 1) { return 16; }
    if (lum(m[0] + m[2] - 10, m[1] + m[3] - 10) < 235) { return 15; }
    if (dark_in(m[0] + 70, mi[1] + 10, m[0] + m[2] - 30, mi[1] + mi[3] - 10, 80) == 0) { return 15; }
    // 勾选标记在条目左侧、文字起点之前；两条描边都要有像素。
    let mcy: i32 = mi[1] + mi[3] / 2;
    if (dark_in(mi[0] + 10, mcy - 18, mi[0] + 66, mcy + 18, 130) == 0) { return 16; }
    if (dark_in(mi[0] + 42, mcy + 1, mi[0] + 58, mcy + 14, 130) == 0) { return 16; }
    if (dark_in(mi[0] + 53, mcy - 14, mi[0] + 70, mcy + 3, 130) == 0) { return 16; }

    // ---- C. 点条目：菜单先关、条目回调后到 ----
    let tx0: i32 = mi[0] + mi[2] / 2;
    let ty0: i32 = mi[1] + mi[3] / 2;
    fake_set_clock(base + 250000000);
    fake_post_motion(0, tx0, ty0);
    aui_on_input(1, 0, 0);
    let mt: i32[5] = 0;
    let tr: i32 = aui_debug_menu_touch(mt);
    if (mt[0] < 0) { return 17; }
    fake_set_clock(base + 300000000);
    fake_post_motion(1, tx0, ty0);
    aui_on_input(1, 0, 0);
    if (aui_state_get(971) != 21) { return 17; }
    if (aui_state_get(970) != 1) { return 17; }
    if (aui_state_get(974) != 1) { return 17; }   // 菜单回调先于条目回调
    if (aui_debug_menu(m) == 0) { return 17; }
    frame_at(base + 300000000);
    if (aui_debug_menu(m) == 0) { return 17; }

    // ---- D. 禁用条目：不回调、菜单保持打开 ----
    if (tap_key(10, base + 350000000) != 0) { return 18; }
    frame_at(base + 400000000);
    if (aui_debug_menu_item(24, mi) != 0) { return 18; }
    if (mi[7] != 1) { return 18; }
    let u0: i32 = aui_state_get(972);
    tap_at(base + 450000000, mi[0] + mi[2] / 2, mi[1] + mi[3] / 2);
    if (aui_state_get(971) != 21) { return 18; }
    if (aui_debug_menu(m) != 0) { return 18; }

    // ---- E. 点菜单外：reason 2 ----
    tap_at(base + 500000000, 700, 1270);
    if (aui_state_get(970) != 2) { return 19; }
    if (aui_debug_menu(m) == 0) { return 19; }
    frame_at(base + 550000000);
    if (aui_debug_menu(m) == 0) { return 19; }

    // ---- F. BACK：reason 3 ----
    if (tap_key(10, base + 600000000) != 0) { return 20; }
    frame_at(base + 650000000);
    if (aui_debug_menu(m) != 0) { return 20; }
    back_at(base + 700000000);
    if (aui_state_get(970) != 3) { return 20; }
    if (aui_debug_menu(m) == 0) { return 20; }
    frame_at(base + 750000000);
    if (aui_debug_menu(m) == 0) { return 20; }

    // ---- G. 屏幕点菜单 ----
    if (tap_key(11, base + 800000000) != 0) { return 21; }
    frame_at(base + 850000000);
    if (aui_debug_menu(m) != 0) { return 21; }
    if (m[0] != 60 || m[1] != 400) { return 21; }
    tap_at(base + 900000000, 700, 1270);
    frame_at(base + 950000000);

    // ---- H. 超长菜单：溢出并支持内部拖动 ----
    if (tap_key(12, base + 1000000000) != 0) { return 22; }
    frame_at(base + 1050000000);
    if (aui_debug_menu(m) != 0) { return 22; }
    if (m[8] <= 0) { return 22; }
    if (m[1] < 0 || m[1] + m[3] > 1280) { return 22; }
    let mx: i32 = m[0] + m[2] / 2;
    let my: i32 = m[1] + m[3] / 2;
    drag_at(base + 1100000000, mx, my + 120, mx, my - 40);
    frame_at(base + 1150000000);
    if (aui_debug_menu(m) != 0) { return 23; }
    if (m[7] < 100) { return 23; }
    if (aui_state_get(971) != 21) { return 23; }
    tap_at(base + 1200000000, 700, 1270);
    frame_at(base + 1250000000);

    // ---- I. 深色主题：菜单表面变深、文字变亮 ----
    if (show_key(base + 1290000000, 23, 300) == 0) { return 24; }
    if (tap_key(23, base + 1300000000) != 0) { return 24; }
    frame_at(base + 1370000000);
    // 滚去开暗色后，菜单锚点（key 10）被顶出屏（y=-154）；先把它滚回可见再点。
    if (show_key(base + 1390000000, 10, 300) == 0) { return 24; }
    if (tap_key(10, base + 1400000000) != 0) { return 24; }
    frame_at(base + 1440000000);
    if (aui_debug_menu(m) != 0) { return 24; }
    if (lum(m[0] + m[2] - 10, m[1] + m[3] - 10) > 90) { return 24; }
    if (dark_in(m[0] + 70, m[1] + 10, m[0] + m[2] - 30, m[1] + m[3] - 10, 40) == 0) {
        // 深色主题下文字应该比表面亮；用反向检查（表面近黑、文字更亮）。
        if (light_in(m[0] + 70, m[1] + 10, m[0] + m[2] - 30, m[1] + m[3] - 10) == 0) {
            return 24;
        }
    }
    tap_at(base + 1500000000, 700, 1270);

    // ---- J. 底部按钮：下方放不下，菜单翻到锚点上方 ----
    aui_debug_scroll_set(1, 9999);
    aui_invalidate_layout();
    frame_at(base + 1550000000);
    let bb: i32[4] = 0;
    if (aui_debug_rect(41, bb) != 0) { return 25; }
    if (rect_ok(bb, 720, 1280) == 0) { return 25; }
    if (tap_key(41, base + 1600000000) != 0) { return 25; }
    frame_at(base + 1650000000);
    if (aui_debug_menu(m) != 0) { return 25; }
    if (m[4] != 70 || m[9] != 3) { return 25; }
    if (m[1] + m[3] > bb[1]) { return 25; }        // 菜单底部在按钮上方
    if (m[1] < 20 || m[1] + m[3] > 1280 - 20) { return 25; }
    let bmi: i32[8] = 0;
    if (aui_debug_menu_item(71, bmi) != 0) { return 25; }
    tap_at(base + 1700000000, bmi[0] + bmi[2] / 2, bmi[1] + bmi[3] / 2);
    if (aui_state_get(971) != 71) { return 25; }
    if (aui_state_get(970) != 1) { return 25; }

    let s5: i32 = call_cb(24, act, 0);
    let s6: i32 = call_cb(32, act, 0);
    let s7: i32 = call_cb(40, act, 0);
    return 0;
}
