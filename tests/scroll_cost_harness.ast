// scroll_cost_harness.ast -- v2.7 滚动帧成本测试（断言式，假宿主路径）。
//
// 720x1280 / 420 dpi 假宿主（与 vlist_harness 同配方），走
// ANativeActivity 回调创建窗口。场景 0 是 ScrollView（aui_scroll，
// 30 行文本，照 Gallery 列表页：行内 label + 数字、tint 底、圆角）；
// 场景 1 是 vlist（100 行，64 dp）。
//
// 每步拖动 30 px（16 ms 节拍），断言每步成本有界：build 增量 0、
// paint 增量 1（拖动步）/<=1（惯性帧）、字形缓存未命中/逐出 0、
// 拖动步 3..7 全部直搬（第 1 步是 force_full 整屏帧，按设计）、
// 惯性帧至少 4/6 直搬；另断言直搬帧与强制整屏重画逐像素一致
// （PIXELCHECK eq=1），并打印 SCROLLHASH 行冻结进
// tests/baseline/scroll_cost.pixels（canvas.pixels 同款）。
//
// 读数时序（vlist G 的做法）：假宿主里泵线程是 stub（pthread_create
// 返回 -1），画全在输入线程同步做；所以拖动步的直搬标志必须在 MOVE
// 的 aui_on_input 之后立刻读，frame_at 之后读到的是空泵的 fail=1。
// 惯性帧由 frame_at 呈现，读数在 frame_at 之后。
// 场景 0 的页眉是三行宽字母表（62 个不同字形同时可见），字形缓存
// 128 项的压力测试：63 个存活字形必须全命中，miss/evict 必须为 0。
//
// v2.7 滚动修复的回归门：
// (1) fb_cmds_ok 倒查曾被页眉文本框的 6 px 空行高挡住（why=5），直搬
// 从不生效，每帧整屏重栅格化；现跳过墨迹没碰到视口的文本命令。
// (2) 字形缓存 32 项装不下单屏字形（探针 62、Fonts 页约 90），每帧
// 全量轮廓重栅格化；现 128 项。
// 修前基线（同一探针，qemu 下）：每步 miss=124、直搬 0/6、总耗时
// 约 8.6–9.1 s；只修直搬不扩缓存时 14.1 s（重放 4 次 staging 放大
// 了抖动）；两处都修后：每步 miss=0、直搬 5/6（拖动）+ 6/6（惯性）、
// 总耗时约 3.1–3.3 s。
//
// 返回码：0 通过；1 矩形失败；2 像素不等；3 UP 多画；4 UP 后多余帧
// 超 1；21/23 拖动轮失败（场景 0/1）；30 拖动直搬不足 5；31 惯性直
// 搬不足 4；32 字形缓存未命中/逐出；33 每步 build 非 0；34 每步
// paint 越界。
include "../src/aui.ast";
include "../src/aster_std.ast";

extern let g_fake_pixels: i32[921600];

extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_scroll(key: i32) -> i32;
extern fn aui_debug_scroll_max(key: i32) -> i32;
extern fn aui_debug_node_count() -> i32;
extern fn aui_debug_build_count() -> i32;
extern fn aui_debug_cmd_count() -> i32;
extern fn aui_debug_frame_blit() -> i32;
extern fn aui_debug_fbuf_ok() -> i32;
extern fn aui_debug_paint_gen() -> i32;
extern fn aui_debug_blit_diag(out: ptr) -> i32;
extern fn aui_debug_cmds_why(out: ptr) -> i32;
extern fn aui_debug_cmd_at(idx: i32, out: ptr) -> i32;
extern fn aui_debug_tt_cache(out: ptr) -> i32;
extern fn aui_vlist_scroll_to(key: i32, px: i32) -> i32;
extern fn aui_debug_vlist(key: i32, out: ptr) -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_frame(now: i64) -> i32;
extern fn aui_invalidate() -> i32;
extern fn aui_version() -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;

let g_act: i64[11] = 0;
let g_cb: i64[16] = 0;
let g_win: i64[4] = 0;
let g_assets: i64[1] = 0;
let g_ext_path: u8[32] = 0;
let g_harness_anchor: ptr = g_act;

let g_font: ptr = 0;
let g_scene: i32 = 0;
let g_sel: i32 = -1;

// 当前值：[0] build [1] paint [2] cmds [3] nodes [4] light
// [5] blit [6] fail [7] off [8] miss [9] evict [10] live
let g_snap: i32[11] = 0;
// 步前基线：[0] build [1] paint [2] miss [3] evict
let g_pre: i32[4] = 0;
// MOVE 之后立刻拍下的直搬快照：[0] light [1] blit [2] fail [3] fbok。
// 假宿主里泵线程是 stub，MOVE 同步画完；frame_at 之后再读是空泵的
// fail=1，不能覆盖这一份。
let g_blit_mv: i32[4] = 0;
let g_diag: i32[40] = 0;
let g_why: i32[6] = 0;
let g_cmd: i32[8] = 0;
let g_cache: i32[6] = 0;
// 本轮断言计数：直搬的拖动步数（k>=2 的 5 步）、直搬的惯性帧数。
let g_blit_moves: i32 = 0;
let g_blit_flings: i32 = 0;

fn call_cb(off: i32, a: ptr, b: ptr) -> i32 {
    let cb: ptr = load_ptr(g_act);
    let f: fn(ptr, ptr) -> i32 = load_ptr(cb + off);
    return f(a, b);
}

fn frame_at(t: i64) -> i32 {
    fake_set_clock(t);
    return aui_frame(t);
}

fn out_str(s: ptr) -> i32 { return write_all(1, s, strlen(s)); }

fn out_i32(v: i32) -> i32 {
    let buf: u8[16] = 0;
    let n: i32 = fmt_i32(buf, v);
    return write_all(1, buf, n);
}

// 读计数类状态（build/paint/cmds/nodes/缓存/off），不碰直搬标志。
fn snap_counts(key: i32) -> i32 {
    g_snap[0] = aui_debug_build_count();
    g_snap[1] = aui_debug_paint_gen();
    g_snap[2] = aui_debug_cmd_count();
    g_snap[3] = aui_debug_node_count();
    let tc: i32 = aui_debug_tt_cache(g_cache);
    g_snap[8] = g_cache[1];
    g_snap[9] = g_cache[2];
    g_snap[10] = g_cache[3];
    g_snap[7] = aui_debug_scroll(key);
    return 0;
}

// 读直搬标志（light/blit/fail）。必须在 MOVE 的 on_input 之后立刻读，
// 读完立即存进 g_blit_mv（frame_at 的空泵会把它们清成 fail=1）。
fn snap_blit() -> i32 {
    let dg: i32 = aui_debug_blit_diag(g_diag);
    let wy: i32 = aui_debug_cmds_why(g_why);
    g_snap[4] = g_diag[0];
    g_snap[5] = aui_debug_frame_blit();
    g_snap[6] = g_diag[23];
    g_blit_mv[0] = g_snap[4];
    g_blit_mv[1] = g_snap[5];
    g_blit_mv[2] = g_snap[6];
    g_blit_mv[3] = g_diag[21];
    return 0;
}

// MOVE 之后立刻打印直搬 verdict（在 frame_at 之前，值才可信）。
fn blit_line(scene: i32, step: i32, tag: ptr) -> i32 {
    let s1: i32 = out_str("SCROLLBLIT s=");
    let s2: i32 = out_i32(scene);
    let s3: i32 = out_str(" step=");
    let s4: i32 = out_i32(step);
    let s5: i32 = out_str(" ");
    let s6: i32 = out_str(tag);
    let s7: i32 = out_str(" light=");
    let s8: i32 = out_i32(g_blit_mv[0]);
    let s9: i32 = out_str(" blit=");
    let sa: i32 = out_i32(g_blit_mv[1]);
    let sb: i32 = out_str(" fail=");
    let sc: i32 = out_i32(g_blit_mv[2]);
    let sd: i32 = out_str(" fbok=");
    let se: i32 = out_i32(g_blit_mv[3]);
    let sg: i32 = out_str(" sg=");
    let sh: i32 = out_i32(g_diag[4]);
    let si: i32 = out_str("..");
    let sj: i32 = out_i32(g_diag[5]);
    let sk: i32 = out_str(" snap=");
    let sl: i32 = out_i32(g_diag[6]);
    let sm: i32 = out_str(" cmds=");
    let sn: i32 = out_i32(g_diag[7]);
    let so: i32 = out_str(" dif=");
    let sp: i32 = out_i32(g_diag[22]);
    let sq: i32 = out_str(" why=");
    let sr: i32 = out_i32(g_why[1]);
    let ss: i32 = out_str(" idx=");
    let st: i32 = out_i32(g_why[2]);
    let su: i32 = out_str(" w=");
    let sv: i32 = out_i32(g_why[3]);
    let sw: i32 = out_str(" cur=");
    let sx: i32 = out_i32(g_why[4]);
    let sy: i32 = out_str(" snap=");
    let sz: i32 = out_i32(g_why[5]);
    let sa2: i32 = out_str("\n");
    return 0;
}

fn mark_pre() -> i32 {
    g_pre[0] = aui_debug_build_count();
    g_pre[1] = aui_debug_paint_gen();
    let tc: i32 = aui_debug_tt_cache(g_cache);
    g_pre[2] = g_cache[1];
    g_pre[3] = g_cache[2];
    return 0;
}

// 打印一步成本：build/paint/miss/evict 是相对步前基线的增量，
// 其余是当前值；直搬标志取自最近一次 snap_blit。
fn cost_line(scene: i32, step: i32, tag: ptr, key: i32) -> i32 {
    let s0: i32 = snap_counts(key);
    let s1: i32 = out_str("SCROLLCOST s=");
    let s2: i32 = out_i32(scene);
    let s3: i32 = out_str(" step=");
    let s4: i32 = out_i32(step);
    let s5: i32 = out_str(" ");
    let s6: i32 = out_str(tag);
    let s7: i32 = out_str(" build=");
    let s8: i32 = out_i32(g_snap[0] - g_pre[0]);
    let s9: i32 = out_str(" paint=");
    let sa: i32 = out_i32(g_snap[1] - g_pre[1]);
    let sb: i32 = out_str(" cmds=");
    let sc: i32 = out_i32(g_snap[2]);
    let sd: i32 = out_str(" nodes=");
    let se: i32 = out_i32(g_snap[3]);
    let sf: i32 = out_str(" light=");
    let sg: i32 = out_i32(g_snap[4]);
    let sh: i32 = out_str(" blit=");
    let si: i32 = out_i32(g_snap[5]);
    let sj: i32 = out_str(" fail=");
    let sk: i32 = out_i32(g_snap[6]);
    let sl: i32 = out_str(" fbok=");
    let sm: i32 = out_i32(g_diag[21]);
    let sn: i32 = out_str(" miss=");
    let so: i32 = out_i32(g_snap[8] - g_pre[2]);
    let sp: i32 = out_str(" evict=");
    let sq: i32 = out_i32(g_snap[9] - g_pre[3]);
    let sr: i32 = out_str(" live=");
    let ss: i32 = out_i32(g_snap[10]);
    let st: i32 = out_str(" off=");
    let su: i32 = out_i32(g_snap[7]);
    let sv: i32 = out_str("\n");
    return 0;
}

fn on_row(user: ptr) -> i32 {
    g_sel = aui_vlist_tap_index();
    return 0;
}

fn bind_rows(user: ptr) -> i32 {
    let i: i32 = aui_vlist_first();
    let e: i32 = aui_vlist_last();
    while (i <= e) {
        aui_vlist_row(i);
        aui_row(0);
        aui_pad(12);
        aui_gap(12);
        aui_label(0, "Item");
        aui_text_i32(0, i);
        aui_end();
        aui_end();
        i = i + 1;
    }
    return 0;
}

fn build(user: ptr) -> i32 {
    aui_root();
    aui_column(1);
    aui_weight(1);
    // 页眉三行宽字母表：62 个不同字形同时可见（32 项缓存的压力测试）。
    aui_label(2, "ABCDEFGHIJKLMNOPQRSTU");
    aui_label(3, "VWXYZabcdefghijklmno");
    aui_label(4, "pqrstuvwxyz0123456789");
    if (g_scene == 0) {
        aui_scroll(100);
        aui_weight(1);
        aui_column(101);
        aui_pad(10);
        aui_gap(6);
        aui_bg(aui_theme_color(AUI_COLOR_SURFACE));
        aui_radius(14);
        let i: i32 = 0;
        while (i < 30) {
            aui_row(1100 + i);
            aui_pad(12);
            aui_gap(12);
            aui_bg(aui_theme_color(AUI_COLOR_TINT));
            aui_radius(10);
            aui_label(1400 + i, "Item");
            aui_text_i32(1450 + i, i);
            aui_end();
            i = i + 1;
        }
        aui_end();
        aui_end();
    } else {
        aui_vlist(200, 100, 64, bind_rows, on_row, user);
        aui_weight(1);
    }
    aui_row(5);
    aui_pad(16);
    aui_gap(8);
    aui_label(6, "Footer");
    aui_end();
    aui_end();
    return 0;
}

fn app_init(user: ptr) -> i32 {
    aui_set_font(g_font, 1);
    return 0;
}

fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32 {
    return aui_android_attach(activity, saved, savedSize,
                              build, 0, app_init, 0);
}

// 打印一条命令的字段（探针用）。
fn cmd_dump(scene: i32, idx: i32) -> i32 {
    if (aui_debug_cmd_at(idx, g_cmd) != 0) { return 1; }
    let s1: i32 = out_str("CMDDUMP s=");
    let s2: i32 = out_i32(scene);
    let s3: i32 = out_str(" idx=");
    let s4: i32 = out_i32(idx);
    let s5: i32 = out_str(" op=");
    let s6: i32 = out_i32(g_cmd[0]);
    let s7: i32 = out_str(" x=");
    let s8: i32 = out_i32(g_cmd[1]);
    let s9: i32 = out_str(" y=");
    let sa: i32 = out_i32(g_cmd[2]);
    let sb: i32 = out_str(" w=");
    let sc: i32 = out_i32(g_cmd[3]);
    let sd: i32 = out_str(" h=");
    let se: i32 = out_i32(g_cmd[4]);
    let sf: i32 = out_str(" rad=");
    let sg: i32 = out_i32(g_cmd[5]);
    let sh: i32 = out_str(" alpha=");
    let si: i32 = out_i32((g_cmd[6] >> 24) & 255);
    let sj: i32 = out_str(" tlen=");
    let sk: i32 = out_i32(g_cmd[7]);
    let sl: i32 = out_str("\n");
    return 0;
}

// FNV-1a 像素哈希（整帧 g_fake_pixels，921600 个 i32）。
fn pixel_hash() -> i32 {
    let h: i32 = -2128831035;
    let i: i32 = 0;
    while (i < 921600) {
        h = (h ^ g_fake_pixels[i]) * 16777619;
        i = i + 1;
    }
    return h;
}

// 像素等价：直搬帧与强制整屏重画必须逐像素一致，并打印冻结哈希。
fn pixel_check(scene: i32, key: i32, t: i64) -> i32 {
    let h1: i32 = pixel_hash();
    let iv: i32 = aui_invalidate();
    frame_at(t);
    let h2: i32 = pixel_hash();
    let eq: i32 = 0;
    if (h1 == h2) { eq = 1; }
    let h0: i32 = out_str("SCROLLHASH s=");
    let h3: i32 = out_i32(scene);
    let h4: i32 = out_str(" ");
    let h5: i32 = out_i32(h1);
    let h6: i32 = out_str("\n");
    let s1: i32 = out_str("PIXELCHECK s=");
    let s2: i32 = out_i32(scene);
    let s3: i32 = out_str(" blit=");
    let s4: i32 = out_i32(h1);
    let s5: i32 = out_str(" full=");
    let s6: i32 = out_i32(h2);
    let s7: i32 = out_str(" eq=");
    let s8: i32 = out_i32(eq);
    let s9: i32 = out_str(" off=");
    let sa: i32 = out_i32(aui_debug_scroll(key));
    let sb: i32 = out_str("\n");
    if (h1 != h2) { return 1; }
    return 0;
}

// 一轮拖动：DOWN 在容器中心，6 步各 30 px 上滑，UP，
// 再 6 帧惯性。key 是滚动容器 key。
fn drag_round(scene: i32, key: i32, base: i64) -> i32 {
    g_blit_moves = 0;
    g_blit_flings = 0;
    let r: i32[4] = 0;
    if (aui_debug_rect(key, r) != 0) { return 1; }
    let cx: i32 = r[0] + r[2] / 2;
    let cy: i32 = r[1] + r[3] / 2;
    let t0: i64 = base;
    let mp: i32 = mark_pre();
    let sb: i32 = snap_blit();
    let c0: i32 = cost_line(scene, 0, "base", key);
    // 基帧命令表：子树前的命令与子树尾的命令（定位 why=5 用）。
    let di: i32 = 0;
    while (di <= 7) {
        let dd: i32 = cmd_dump(scene, di);
        di = di + 1;
    }
    let dj: i32 = 95;
    while (dj <= 97) {
        let dk: i32 = cmd_dump(scene, dj);
        dj = dj + 1;
    }
    fake_set_clock(t0);
    fake_post_motion(0, cx, cy);
    aui_on_input(1, 0, 0);
    let mp1: i32 = mark_pre();
    let sb1: i32 = snap_blit();
    let c1: i32 = cost_line(scene, 1, "down", key);
    let k: i32 = 1;
    while (k <= 6) {
        let tt: i64 = t0 + i64(k) * 16000000;
        let mpk: i32 = mark_pre();
        fake_set_clock(tt);
        fake_post_motion(2, cx, cy - k * 30);
        aui_on_input(1, 0, 0);
        // 直搬 verdict 在 MOVE 之后立刻读并打印；frame_at 只推进
        // 计时器，不再重读（空泵会把标志清成 fail=1）。
        let sbk: i32 = snap_blit();
        let bk: i32 = blit_line(scene, 1 + k, "move");
        frame_at(tt);
        let ck: i32 = cost_line(scene, 1 + k, "move", key);
        // 每步成本有界：不重建、不重栅格化（缓存全命中）、只画一帧。
        if (g_snap[0] - g_pre[0] != 0) { return 33; }
        if (g_snap[1] - g_pre[1] != 1) { return 34; }
        if (g_snap[8] - g_pre[2] != 0) { return 32; }
        if (g_snap[9] - g_pre[3] != 0) { return 32; }
        // 第 1 步是 force_full 整屏帧（按设计）；其后 5 步必须直搬。
        if (k >= 2) {
            if (g_blit_mv[1] == 1) { g_blit_moves = g_blit_moves + 1; }
        }
        k = k + 1;
    }
    if (g_blit_moves < 5) { return 30; }
    // 像素等价：最后一步 MOVE 的直搬帧 vs 强制整屏重画（UP 之前，
    // 偏移静止在 180，惯性还没启动）。
    let pc: i32 = pixel_check(scene, key, t0 + 7 * 16000000);
    // UP 双画检查：UP 本身一画，随后无输入再出一帧，不应再画。
    // UP 紧跟最后一步 MOVE（+16 ms），落在 80 ms 惯性窗口内。
    let p0: i32 = aui_debug_paint_gen();
    let tt2: i64 = t0 + 7 * 16000000;
    fake_set_clock(tt2);
    fake_post_motion(1, cx, cy - 180);
    aui_on_input(1, 0, 0);
    let p1: i32 = aui_debug_paint_gen();
    frame_at(tt2 + 16000000);
    let p2: i32 = aui_debug_paint_gen();
    let t1: i32 = out_str("TAPPAINT s=");
    let t2: i32 = out_i32(scene);
    let t3: i32 = out_str(" up_paint=");
    let t4: i32 = out_i32(p1 - p0);
    let t5: i32 = out_str(" extra_frame=");
    let t6: i32 = out_i32(p2 - p1);
    let t7: i32 = out_str(" off=");
    let t8: i32 = out_i32(aui_debug_scroll(key));
    let t9: i32 = out_str("\n");
    // UP 只画一帧；随后一帧是惯性首帧（至多一帧，偏移只能向前）。
    if (p1 - p0 != 1) { return 3; }
    if (p2 - p1 > 1) { return 4; }
    if (aui_debug_scroll(key) < 180) { return 4; }
    // 惯性 6 帧：不重建、不重栅格化、至多一画；至少 4 帧直搬
    // （小数位移的帧允许退回整屏重画，见 scroll_blit_plan fail 11）。
    let f: i32 = 1;
    while (f <= 6) {
        let tf: i64 = tt2 + 16000000 + i64(f) * 16000000;
        let mpf: i32 = mark_pre();
        frame_at(tf);
        let sb2: i32 = snap_blit();
        let cf: i32 = cost_line(scene, 10 + f, "fling", key);
        if (g_snap[0] - g_pre[0] != 0) { return 33; }
        if (g_snap[1] - g_pre[1] > 1) { return 34; }
        if (g_snap[8] - g_pre[2] != 0) { return 32; }
        if (g_snap[9] - g_pre[3] != 0) { return 32; }
        if (g_snap[5] == 1) { g_blit_flings = g_blit_flings + 1; }
        f = f + 1;
    }
    if (g_blit_flings < 4) { return 31; }
    if (pc != 0) { return 2; }
    return 0;
}

fn main() -> i32 {
    let act: ptr = g_act;
    *(act + 0) = g_cb;
    let assets: ptr = g_assets;
    *(act + 64) = assets;
    store_u8(g_ext_path + 0, 47);
    store_u8(g_ext_path + 1, 116);
    store_u8(g_ext_path + 2, 109);
    store_u8(g_ext_path + 3, 112);
    store_u8(g_ext_path + 4, 47);
    store_u8(g_ext_path + 5, 97);
    store_u8(g_ext_path + 6, 115);
    store_u8(g_ext_path + 7, 116);
    store_u8(g_ext_path + 8, 101);
    store_u8(g_ext_path + 9, 114);
    store_u8(g_ext_path + 10, 117);
    store_u8(g_ext_path + 11, 105);
    store_u8(g_ext_path + 12, 45);
    store_u8(g_ext_path + 13, 116);
    store_u8(g_ext_path + 14, 114);
    store_u8(g_ext_path + 15, 97);
    store_u8(g_ext_path + 16, 99);
    store_u8(g_ext_path + 17, 101);
    store_u8(g_ext_path + 18, 0);
    let ep: ptr = g_ext_path;
    *(act + 40) = ep;

    if (g_harness_anchor == 0) { return 10; }
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    if (font_ok != 1) { return 90; }
    let r: i32 = ANativeActivity_onCreate(act, 0, 0);
    if (r != 0) { return 10; }

    let cb: ptr = load_ptr(g_act);
    let f56: ptr = load_ptr(cb + 56);
    let f72: ptr = load_ptr(cb + 72);
    if (f56 == 0 || f72 == 0) { return 11; }

    let win: ptr = g_win;
    let s1: i32 = call_cb(0, act, 0);
    let s2: i32 = call_cb(8, act, 0);
    let s3: i32 = call_cb(56, act, win);
    let s4: i32 = call_cb(72, act, win);

    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < 720 * 1280 * 4) {
        sum = sum + load_u8(g_fake_pixels + i);
        i = i + 1;
    }
    if (sum == 0) { return 12; }
    if (aui_version() != 14806) { return 13; }

    let base: i64 = 5000000000;
    frame_at(base);
    let mx0: i32 = aui_debug_scroll_max(100);
    let m0: i32 = out_str("SCROLLCOST s=0 max=");
    let m1: i32 = out_i32(mx0);
    let m2: i32 = out_str("\n");
    if (mx0 <= 0) { return 20; }
    let d0: i32 = drag_round(0, 100, base + 100000000);
    if (d0 != 0) { return d0; }
    // 场景 1：vlist。
    g_scene = 1;
    let iv: i32 = aui_invalidate();
    frame_at(base + 1000000000);
    let mx1: i32 = aui_debug_scroll_max(200);
    let n0: i32 = out_str("SCROLLCOST s=1 max=");
    let n1: i32 = out_i32(mx1);
    let n2: i32 = out_str("\n");
    if (mx1 <= 0) { return 22; }
    let d1: i32 = drag_round(1, 200, base + 1100000000);
    if (d1 != 0) { return d1; }
    let e: i32 = eputs("PASS: scroll_cost\n");
    return 0;
}
