// android_harness.ast — 模拟 Android 宿主的冒烟测试（qemu-user 上运行）。
//
// 依次调用 ANativeActivity_onCreate → onStart → onResume →
// onNativeWindowCreated → onNativeWindowRedrawNeeded，并检查回调表、
// 绘制结果和 onPause/onDestroy 是否存活。
//
// 返回码：0 通过；10 attach 失败；11 回调表没写；12 屏幕全黑；
//         13 销毁后崩溃（不应发生）；14 像素格式不对；
//         16 找不到 + 按钮；17 点 + 后计数没变；18 点 - 后计数没归零。
extern let g_fake_pixels: i32[921600];

extern fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_frame(now: i64) -> i32;
extern fn aui_state_get(key: i32) -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;

let g_act: i64[11] = 0;        // ANativeActivity：callbacks@0，assets@64
let g_cb: i64[16] = 0;         // ANativeActivityCallbacks
let g_win: i64[4] = 0;
let g_assets: i64[1] = 0;
let g_ext_path: u8[32] = 0;
let g_harness_anchor: ptr = g_act;

fn call_cb(off: i32, a: ptr, b: ptr) -> i32 {
    let cb: ptr = load_ptr(g_act);
    let f: fn(ptr, ptr) -> i32 = load_ptr(cb + off);
    return f(a, b);
}

fn main() -> i32 {
    let act: ptr = g_act;
    *(act + 0) = g_cb;
    let assets: ptr = g_assets;
    *(act + 64) = assets;
    // externalDataPath（偏移 40）：让 trace 代码跑真实 openat/write 路径。
    store_u8(g_ext_path + 0, 47);
    store_u8(g_ext_path + 1, 116);
    store_u8(g_ext_path + 2, 109);
    store_u8(g_ext_path + 3, 112);
    store_u8(g_ext_path + 4, 47);
    store_u8(g_ext_path + 5, 97);
    store_u8(g_ext_path + 6, 115);
    store_u8(g_ext_path + 7, 116);
    store_u8(g_ext_path + 8, 101);
    store_u8(g_ext_path + 9, 114);
    store_u8(g_ext_path + 10, 117);
    store_u8(g_ext_path + 11, 105);
    store_u8(g_ext_path + 12, 45);
    store_u8(g_ext_path + 13, 116);
    store_u8(g_ext_path + 14, 114);
    store_u8(g_ext_path + 15, 97);
    store_u8(g_ext_path + 16, 99);
    store_u8(g_ext_path + 17, 101);
    store_u8(g_ext_path + 18, 0);
    let ep: ptr = g_ext_path;
    *(act + 40) = ep;

    // 确保本对象带初始化链（link-obj 只从入口对象的 __aster_init 起链）。
    if (g_harness_anchor == 0) { return 15; }
    let r: i32 = ANativeActivity_onCreate(act, 0, 0);
    if (r != 0) { return 10; }

    // 回调表至少要有窗口创建、重绘、输入队列三个入口。
    let cb: ptr = load_ptr(g_act);
    let f56: ptr = load_ptr(cb + 56);
    let f72: ptr = load_ptr(cb + 72);
    let f88: ptr = load_ptr(cb + 88);
    if (f56 == 0 || f72 == 0 || f88 == 0) { return 11; }

    let win: ptr = g_win;
    let s1: i32 = call_cb(0, act, 0);           // onStart
    let s2: i32 = call_cb(8, act, 0);           // onResume
    let s3: i32 = call_cb(56, act, win);        // onNativeWindowCreated
    let s4: i32 = call_cb(72, act, win);        // onNativeWindowRedrawNeeded

    // 画面必须有内容。
    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < 720 * 1280 * 4) {
        sum = sum + load_u8(g_fake_pixels + i);
        i = i + 1;
    }
    if (sum == 0) { return 12; }

    // ---- 真实 ui_hello 点按回归：+ / - 按钮 ----
    // 中间主动 aui_frame 一次，模拟真机上 DOWN 与 UP 之间发生重建，
    // 确认按压状态不会被重建清掉。
    let rect: i32[4] = 0;
    if (aui_debug_rect(7, rect) != 0) { return 16; }
    let cx: i32 = rect[0] + rect[2] / 2;
    let cy: i32 = rect[1] + rect[3] / 2;
    fake_post_motion(0, cx, cy);                // ACTION_DOWN on "+"
    aui_on_input(1, 0, 0);
    let fr1: i32 = aui_frame(0);
    fake_post_motion(1, cx, cy);                // ACTION_UP on "+"
    aui_on_input(1, 0, 0);
    let fr2: i32 = aui_frame(0);
    if (aui_state_get(1) != 1) { return 17; }

    if (aui_debug_rect(5, rect) != 0) { return 16; }
    cx = rect[0] + rect[2] / 2;
    cy = rect[1] + rect[3] / 2;
    fake_post_motion(0, cx, cy);                // ACTION_DOWN on "-"
    aui_on_input(1, 0, 0);
    let fr3: i32 = aui_frame(0);
    fake_post_motion(1, cx, cy);                // ACTION_UP on "-"
    aui_on_input(1, 0, 0);
    let fr4: i32 = aui_frame(0);
    if (aui_state_get(1) != 0) { return 18; }

    let s5: i32 = call_cb(24, act, 0);          // onPause
    let s6: i32 = call_cb(32, act, 0);          // onStop
    let s7: i32 = call_cb(40, act, 0);          // onDestroy

    return 0;
}
