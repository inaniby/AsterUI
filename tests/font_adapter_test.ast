    let hcz: i32 = aui_rt_glyph(0x4E2D);
    if (check(hcz == 1, "FAIL: H U+4E2D glyph missing\n") == 0) { return 40; }
    if (check(aui_rt_bh() == 48, "FAIL: H U+4E2D bitmap h != 48\n") == 0) { return 40; }
    let h_zh_h: i64 = fnv_bytes(aui_rt_bm(), aui_rt_bw() * aui_rt_bh());
    if (check(h_zh_h == h_zh, "FAIL: H U+4E2D bitmap hash moved\n") == 0) { return 40; }
    // Bold (the device face): 'g' grows too.
    let hb: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc");
    if (check(hb == 1, "FAIL: H Bold load failed\n") == 0) { return 41; }
    let hbg: i32 = aui_rt_glyph(103);
    if (check(hbg == 1, "FAIL: H Bold 'g' glyph missing\n") == 0) { return 41; }
    if (check(aui_rt_src() == 1, "FAIL: H Bold 'g' src != TT\n") == 0) { return 41; }
