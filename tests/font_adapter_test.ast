    let h_q: i64 = out_glyph_hash("q", 113);
    // Controls: 'A' and U+4E2D keep 48-row bitmaps and their
    // section C hashes (the baseline row never moves).
    let hca: i32 = aui_rt_glyph(65);
    if (check(hca == 1, "FAIL: H 'A' glyph missing\n") == 0) { return 40; }
    if (check(aui_rt_bh() == 48, "FAIL: H 'A' bitmap h != 48\n") == 0) { return 40; }
