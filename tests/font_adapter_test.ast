// font_adapter_test.ast -- W2 font surgery, adapter-level headless proof.
//
// Same glyph-source proofs as font_runtime_test.ast, but WITHOUT the
// reference library (no aui_impl.ast): it exercises ONLY the adapter
// (stdlib/asterui/font_runtime.ast) + the TrueType engine +
// the hand-drawn fallback, so it links and runs TODAY.
//
// Why two tests: font_runtime_test.ast proves the full stack
// (reference layout + draw through aui_impl.ast), but link-obj
// currently refuses ANY program that links aui_impl.o -- the
// reference carries run-time global initializers
// (g_aui_nodes/g_aui_cmds/g_aui_page_cmds) in a non-_start object,
// which the linker rejects. That is compiler item C-1 (see
// ADOPTION-NOTES.md): the full-stack test is written and ready, and
// runs once C-1 lands. This file proves everything below it in the
// meantime, and its hashes are frozen in
// tests/baseline/font_adapter.pixels.
//
// Proves:
//   A. TTC SC face by name (face 2); cmap U+4E2D -> 9544,
//      U+6587 -> 20036, U+589E -> 13837.
//   B. hmtx advances: U+4E2D 48 px, U+6F22 48 px, 'A' proportional.
//   C. 8bpp AA bitmaps: U+4E2D / U+6587 / U+589E / U+6F22 / 'A' have
//      ink AND strictly-partial pixels; U+6F22 (outside the old
//      54-glyph hand-drawn set) renders from the system font.
//      Per-glyph bitmap hashes are printed as GLYPHHASH lines.
//   D. Fallback: a nonexistent font path fails (reason 1), logs the
//      fallback event, U+589E renders from the CJK atlas (src 3 --
//      it is one of the 56 hand-drawn glyphs; U+4E2D/U+6587 are NOT
//      in that set, see ADOPTION-NOTES.md),
//      'A' from the 8x8 font (src 2), U+6F22 misses (missing +1),
//      advances stay 48 / 24.
//   E. Reload: the TTC loads again and the U+6F22 bitmap hash is
//      byte-identical to the first TT run.
//   F. Discovery: the variable-TTC name
//      (NotoSansCJK-wght-400-900.ttf.ttc, Android 15+) is found by
//      ui_sysfont_scan_dir in an arbitrary directory, the probe
//      table records every attempt (all seven names, no early
//      return), and U+6F22 renders from the system font afterwards.
//      The suite prepares /tmp/aui-fontscan-test/ for this section.
//   G. Multi-curve + flex + font switch (v2.1 blob fix): the bowl
//      glyphs e/o/a/g/c/p/0/5/6 and U+5DF2 render from the system
//      font with frozen bitmap hashes (ops 26/27/30/31 now draw
//      every curve); U+8C99 (flex1) and U+585B (hflex) freeze the
//      flex fixes; switching Regular -> Bold -> Regular renders
//      'A' from each face (Bold hash differs, Regular hash returns
//      to the section C value) with zero decode failures.
//
//   H. Descenders (v2.3): g/p/y/j/q grow past the 48-row cell
//      (bh 55/54/54/54/54) with ink below row 48; 'A' and U+4E2D
//      keep 48-row bitmaps and their section C hashes; Bold 'g'
//      (the device face) grows too, and switching back to Regular
//      restores the section C 'A' hash.
//
//   I. CFF2 default instance (v2.4): the CFF2 subset fixture
//      (tests/fixtures/cff2_noto_sc.ttf -- the VM Regular TTC
//      subset to A/e/o/g/0/5/6 + U+4E2D/U+6587/U+5DF2/U+6F22,
//      converted CFF -> CFF2 with charstring widths stripped)
//      loads err 0 with is_cff2 == 1, and its bitmaps EQUAL the
//      CFF Regular hashes of sections C/G (same outlines, same
//      upm); 'g' keeps bh 55 (descender growth applies to CFF2
//      too). The blend fixture (cff2_blend.ttf -- a hand-built
//      5-glyph CFF2 font, one VarData with 1 region, fvar wght
//      400..900 default 400) loads with fvar wght 400, and B
//      (a blended copy of A) hashes EQUAL to A -- blend at the
//      default instance keeps the defaults and drops the deltas;
//      C (vsindex + blend) and D (blend n=2) render with ink.
//      A truncated CFF2 (cff2_broken.ttf) fails to load with
//      err 5 (its CFF2 table's claimed extent overruns the file,
//      so parse_sfnt marks the table absent -- err 6 is reserved
//      for a CFF2 table that is fully present but unparsable)
//      and Bold still loads afterwards; switching back to the
//      CFF2 subset restores the section C 'A' hash.
//      The broken load is a second fallback event, so the final
//      RTFB line is "2 5 1" (section D's event was the first).
//
//   J. Custom fonts (v2.5): a missing custom path fails with
//      reason 1 and restores the system face (no fallback event);
//      8-byte and 1024-byte truncations of HYZhengYuan-Regular
//      fail with err 3 and restore the system face (the parse
//      validates every table offset against the file size first,
//      so a truncation can no longer segfault the parser); all
//      four HYZhengYuan weights load and report 300/400/500/700
//      from the family name (OS/2 is 400 for all four), with 'A'
//      differing per weight; the Regular probe set freezes hashes
//      + ink; every distinct specimen glyph (Gallery Fonts tab
//      text) freezes a hyzy_spec hash; custom -> system -> custom
//      returns the same hashes. The suite prepares
//      /tmp/aui-hyzy-test/ for this section (symlinks to the four
//      reference weights + the two truncations).
//
//   K. Long paths (v2.5.1): the device folder is 72 chars but
//      the v2.5 text pool held 63, so the Fonts-tab prefill was
//      truncated to ".../gallery/fi" and every Load failed err=1
//      with the files in place (device-confirmed). The pool now
//      holds 255. Regular + Bold load through a 72-char folder
//      (96-char file path, exactly the device path) and Regular
//      through a 96-char folder (120-char file path); 'A' hashes
//      equal the section J Regular/Bold hashes. The suite prepares
//      the two long folders under /tmp/aui-hyzy-test/.
//
// Stdout is hash/stats-only; PASS goes to stderr. Run twice, diff
// stdout: byte-identical. Exit 0 on pass, distinct codes 2..58.
// ASCII-only source: no CJK literals anywhere.

include "../src/aster_std.ast";

extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_rt_active() -> i32;
extern fn aui_rt_advance(cp: i32) -> i32;
extern fn aui_rt_glyph(cp: i32) -> i32;
extern fn aui_rt_bm() -> ptr;
extern fn aui_rt_bw() -> i32;
extern fn aui_rt_bh() -> i32;
extern fn aui_rt_src() -> i32;
extern fn aui_rt_missing() -> i32;
extern fn aui_rt_fallback_events() -> i32;
extern fn aui_rt_fallback_reason() -> i32;
// Custom fonts (v2.5): load a font file from a device path,
// restore the previously active face, report custom state.
extern fn aui_rt_set_custom_font(path: ptr) -> i32;
extern fn aui_rt_restore_system_font() -> i32;
extern fn aui_rt_custom_active() -> i32;
extern fn aui_rt_custom_err() -> i32;
extern fn aui_rt_custom_load_ms() -> i32;
extern fn aui_rt_custom_path() -> ptr;
extern fn aui_rt_system_path() -> ptr;
extern fn aui_rt_font_weight() -> i32;
extern fn ui_sysfont_name_weight() -> i32;
extern fn ui_tt_cmap(cp: i32) -> i32;
extern fn ui_sysfont_face() -> i32;
extern fn ui_sysfont_is_cff() -> i32;
extern fn ui_sysfont_is_cff2() -> i32;
extern fn ui_sysfont_fvar_wght() -> i32;
extern fn ui_sysfont_err() -> i32;
extern fn ui_sysfont_scan_dir(dir: ptr) -> i32;
extern fn ui_sysfont_probe_n() -> i32;
extern fn ui_sysfont_probe_err(i: i32) -> i32;
extern fn ui_tt_decode_failures() -> i32;
extern fn ui_tt_scan_overflows() -> i32;

fn check(cond: bool, msg: ptr) -> i32 {
    if (cond == 0) {
        let e: i32 = eputs(msg);
        return 0;
    } else {
    }
    return 1;
}

// FNV-1a 64-bit over n bytes (same constants as pixel_test.ast).
fn fnv_bytes(buf: ptr, n: i32) -> i64 {
    let h: i64 = -3750763034362895579;
    let i: i32 = 0;
    while (i < n) {
        let b: i32 = load_u8(buf + i);
        h = (h ^ b) * 1099511628211;
        i = i + 1;
    }
    return h;
}

fn out_i64(v: i64) -> i32 {
    let buf: u8[32] = 0;
    let n: i32 = fmt_i64(buf, v);
    return write_all(1, buf, n);
}

fn out_i32(v: i32) -> i32 {
    let buf: u8[32] = 0;
    let n: i32 = fmt_i32(buf, v);
    return write_all(1, buf, n);
}

fn out_glyph_hash(name: ptr, cp: i32) -> i64 {
    let bm: ptr = aui_rt_bm();
    let bw: i32 = aui_rt_bw();
    let bh: i32 = aui_rt_bh();
    let h: i64 = fnv_bytes(bm, bw * bh);
    let s1: i32 = write_all(1, "GLYPHHASH ", 10);
    let n: i32 = strlen(name);
    let s2: i32 = write_all(1, name, n);
    let s3: i32 = write_all(1, " ", 1);
    let s4: i32 = out_i32(cp);
    let s5: i32 = write_all(1, " ", 1);
    let s6: i32 = out_i32(aui_rt_src());
    let s7: i32 = write_all(1, " ", 1);
    let s8: i32 = out_i64(h);
    let s9: i32 = write_all(1, "\n", 1);
    return h;
}

fn out_adv(name: ptr, v: i32) -> i32 {
    let s1: i32 = write_all(1, "RTADV ", 6);
    let n: i32 = strlen(name);
    let s2: i32 = write_all(1, name, n);
    let s3: i32 = write_all(1, " ", 1);
    let s4: i32 = out_i32(v);
    let s5: i32 = write_all(1, "\n", 1);
    return 0;
}

fn out_ink(name: ptr, v: i32) -> i32 {
    let s1: i32 = write_all(1, "INK ", 4);
    let n: i32 = strlen(name);
    let s2: i32 = write_all(1, name, n);
    let s3: i32 = write_all(1, " ", 1);
    let s4: i32 = out_i32(v);
    let s5: i32 = write_all(1, "\n", 1);
    return 0;
}

// Ink + strictly-partial counts of the staged glyph bitmap.
fn glyph_stats(ink: ptr, partial: ptr) -> i32 {
    let bm: ptr = aui_rt_bm();
    let bw: i32 = aui_rt_bw();
    let bh: i32 = aui_rt_bh();
    let n: i32 = 0;
    let p: i32 = 0;
    let i: i32 = 0;
    while (i < bw * bh) {
        let v: i32 = load_u8(bm + i);
        if (v > 0) {
            n = n + 1;
            if (v < 255) {
                p = p + 1;
            } else {
            }
        } else {
        }
        i = i + 1;
    }
    *(ink) = n;
    *(partial) = p;
    return 0;
}

// Ink in rows [r0, bh) of the staged glyph bitmap (the descender
// zone: rows below the old 48-row cell bottom when r0 == 48).
fn glyph_below(r0: i32) -> i32 {
    let bm: ptr = aui_rt_bm();
    let bw: i32 = aui_rt_bw();
    let bh: i32 = aui_rt_bh();
    let n: i32 = 0;
    let y: i32 = r0;
    while (y < bh) {
        let x: i32 = 0;
        while (x < bw) {
            if (load_u8(bm + y * bw + x) > 0) {
                n = n + 1;
            } else {
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return n;
}

// Stage cp in the active face, assert TT source + ink + AA, print
// its frozen hash, write the ink count to *ink_out, answer the
// hash (0 on any failure, message already printed). Shared by
// the probe set and the specimen loop (section J).
fn probe_glyph(cp: i32, name: ptr, ink_out: ptr) -> i64 {
    let ink: i32[2] = 0;
    let part: i32[2] = 0;
    let g: i32 = aui_rt_glyph(cp);
    if (check(g == 1, "FAIL: J probe glyph missing\n") == 0) { return 0; }
    if (check(aui_rt_src() == 1, "FAIL: J probe glyph src != TT\n") == 0) { return 0; }
    let st: i32 = glyph_stats(ink, part);
    if (check(ink[0] > 100, "FAIL: J probe glyph has no ink\n") == 0) { return 0; }
    if (check(part[0] > 0, "FAIL: J probe glyph has no AA\n") == 0) { return 0; }
    let h: i64 = out_glyph_hash(name, cp);
    *(ink_out) = ink[0];
    return h;
}

fn main() -> i32 {
    // ---- A. TTC SC face ----
    let lt: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    if (check(lt == 1, "FAIL: TTC load failed\n") == 0) { return 2; }
    if (check(aui_rt_active() == 1, "FAIL: TT not active after TTC load\n") == 0) { return 2; }
    if (check(ui_sysfont_face() == 2, "FAIL: TTC face != 2 (SC)\n") == 0) { return 3; }
    if (check(ui_tt_cmap(0x4E2D) == 9544, "FAIL: cmap U+4E2D != 9544\n") == 0) { return 4; }
    if (check(ui_tt_cmap(0x6587) == 20036, "FAIL: cmap U+6587 != 20036\n") == 0) { return 5; }
    if (check(ui_tt_cmap(0x589E) == 13837, "FAIL: cmap U+589E != 13837\n") == 0) { return 6; }

    // ---- B. hmtx advances ----
    let adv_zh: i32 = aui_rt_advance(0x4E2D);
    let pa: i32 = out_adv("zhong", adv_zh);
    if (check(adv_zh == 48, "FAIL: U+4E2D advance != 48\n") == 0) { return 7; }
    let adv_a: i32 = aui_rt_advance(65);
    let pb: i32 = out_adv("A", adv_a);
    if (check(adv_a > 0, "FAIL: 'A' advance <= 0\n") == 0) { return 8; }
    if (check(adv_a < 48, "FAIL: 'A' advance not proportional (< 48)\n") == 0) { return 8; }
    let adv_han: i32 = aui_rt_advance(0x6F22);
    let pc: i32 = out_adv("han", adv_han);
    if (check(adv_han == 48, "FAIL: U+6F22 advance != 48\n") == 0) { return 8; }

    // ---- C. 8bpp AA glyphs ----
    let ink: i32[1] = 0;
    let part: i32[1] = 0;
    let g1: i32 = aui_rt_glyph(0x4E2D);
    if (check(g1 == 1, "FAIL: U+4E2D glyph missing\n") == 0) { return 9; }
    if (check(aui_rt_src() == 1, "FAIL: U+4E2D src != TT\n") == 0) { return 9; }
    if (check(aui_rt_bw() == 48, "FAIL: U+4E2D bitmap w != 48\n") == 0) { return 9; }
    if (check(aui_rt_bh() == 48, "FAIL: U+4E2D bitmap h != 48\n") == 0) { return 9; }
    let st1: i32 = glyph_stats(ink, part);
    if (check(ink[0] > 100, "FAIL: U+4E2D bitmap has no ink\n") == 0) { return 10; }
    if (check(part[0] > 0, "FAIL: U+4E2D bitmap has no AA partial pixels\n") == 0) { return 11; }
    let h_zh: i64 = out_glyph_hash("zhong", 0x4E2D);
    let g2: i32 = aui_rt_glyph(0x6587);
    if (check(g2 == 1, "FAIL: U+6587 glyph missing\n") == 0) { return 12; }
    let st2: i32 = glyph_stats(ink, part);
    if (check(ink[0] > 100, "FAIL: U+6587 bitmap has no ink\n") == 0) { return 12; }
    if (check(part[0] > 0, "FAIL: U+6587 bitmap has no AA\n") == 0) { return 12; }
    let h_wen: i64 = out_glyph_hash("wen", 0x6587);
    let g3: i32 = aui_rt_glyph(0x589E);
    if (check(g3 == 1, "FAIL: U+589E glyph missing\n") == 0) { return 12; }
    let h_zeng: i64 = out_glyph_hash("zeng", 0x589E);
    let g4: i32 = aui_rt_glyph(0x6F22);
    if (check(g4 == 1, "FAIL: U+6F22 glyph missing (outside old 54)\n") == 0) { return 12; }
    if (check(aui_rt_src() == 1, "FAIL: U+6F22 src != TT\n") == 0) { return 12; }
    let st4: i32 = glyph_stats(ink, part);
    if (check(ink[0] > 100, "FAIL: U+6F22 bitmap has no ink\n") == 0) { return 12; }
    if (check(part[0] > 0, "FAIL: U+6F22 bitmap has no AA\n") == 0) { return 12; }
    let h_han: i64 = out_glyph_hash("han", 0x6F22);
    let g5: i32 = aui_rt_glyph(65);
    if (check(g5 == 1, "FAIL: 'A' glyph missing\n") == 0) { return 13; }
    if (check(aui_rt_src() == 1, "FAIL: 'A' src != TT\n") == 0) { return 13; }
    let st5: i32 = glyph_stats(ink, part);
    if (check(ink[0] > 10, "FAIL: 'A' bitmap has no ink\n") == 0) { return 13; }
    if (check(part[0] > 0, "FAIL: 'A' bitmap has no AA\n") == 0) { return 13; }
    let h_a: i64 = out_glyph_hash("A", 65);

    // ---- D. Fallback: no system font ----
    let m0: i32 = aui_rt_missing();
    let fb0: i32 = aui_rt_fallback_events();
    let lf: i32 = aui_rt_set_font_path("/nonexistent/no-such-font.ttf");
    if (check(lf == 0, "FAIL: nonexistent font path loaded\n") == 0) { return 17; }
    if (check(aui_rt_active() == 0, "FAIL: TT active after failed load\n") == 0) { return 18; }
    if (check(aui_rt_fallback_events() == fb0 + 1, "FAIL: fallback event not logged\n") == 0) { return 19; }
    if (check(aui_rt_fallback_reason() == 1, "FAIL: fallback reason != 1 (no file)\n") == 0) { return 19; }
    let g6: i32 = aui_rt_glyph(0x589E);
    if (check(g6 == 1, "FAIL: U+589E fallback glyph missing\n") == 0) { return 20; }
    if (check(aui_rt_src() == 3, "FAIL: U+589E fallback src != CJK atlas\n") == 0) { return 20; }
    let st6: i32 = glyph_stats(ink, part);
    if (check(ink[0] > 10, "FAIL: U+589E fallback bitmap has no ink\n") == 0) { return 20; }
    if (check(part[0] == 0, "FAIL: fallback bitmap is not 1bpp-upscaled (has partials)\n") == 0) { return 20; }
    let h_zeng_fb: i64 = out_glyph_hash("zeng_fb", 0x589E);
    let g7: i32 = aui_rt_glyph(65);
    if (check(g7 == 1, "FAIL: 'A' fallback glyph missing\n") == 0) { return 21; }
    if (check(aui_rt_src() == 2, "FAIL: 'A' fallback src != ASCII\n") == 0) { return 21; }
    let h_a_fb: i64 = out_glyph_hash("A_fb", 65);
    let g8: i32 = aui_rt_glyph(0x6F22);
    if (check(g8 == 0, "FAIL: U+6F22 unexpectedly has a fallback glyph\n") == 0) { return 22; }
    if (check(aui_rt_missing() == m0 + 1, "FAIL: missing counter did not move by 1\n") == 0) { return 23; }
    if (check(aui_rt_advance(0x4E2D) == 48, "FAIL: fallback U+4E2D advance != 48\n") == 0) { return 25; }
    if (check(aui_rt_advance(65) == 24, "FAIL: fallback 'A' advance != 24\n") == 0) { return 25; }

    // ---- E. Reload: deterministic again ----
    let lt2: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    if (check(lt2 == 1, "FAIL: TTC reload failed\n") == 0) { return 26; }
    let g9: i32 = aui_rt_glyph(0x6F22);
    if (check(g9 == 1, "FAIL: U+6F22 glyph missing after reload\n") == 0) { return 26; }
    if (check(aui_rt_src() == 1, "FAIL: U+6F22 src != TT after reload\n") == 0) { return 26; }
    let h_han2: i64 = out_glyph_hash("han2", 0x6F22);
    if (check(h_han2 == h_han, "FAIL: U+6F22 bitmap hash differs after reload\n") == 0) { return 27; }
    if (check(ui_tt_decode_failures() == 0, "FAIL: decode failures != 0\n") == 0) { return 28; }
    if (check(ui_tt_scan_overflows() == 0, "FAIL: scan overflows != 0\n") == 0) { return 29; }

    // ---- F. Discovery: renamed variable TTC in an arbitrary dir ----
    // The device failure (2026-11-14): ui_sysfont_init() only tried
    // three hardcoded /system/fonts names, so a device whose CJK
    // font is the Android 15+ variable TTC fell back forever. The
    // scan must find that name in ANY directory, and the probe table
    // must record every attempt. The suite prepares
    // /tmp/aui-fontscan-test/ with the variable name symlinked to
    // the VM TTC; sections A-E never call init(), so probe_n is 0
    // on entry here. The scan enumerates ALL seven names (no early
    // return, so the device log shows the full inventory): the
    // renamed TTC is row pn0+1 (err 0); the other six are missing
    // (err 1).
    let pn0: i32 = ui_sysfont_probe_n();
    let sc: i32 = ui_sysfont_scan_dir("/tmp/aui-fontscan-test");
    if (check(sc == 1, "FAIL: F scan_dir did not load renamed TTC\n") == 0) { return 30; }
    let fc: i32 = ui_sysfont_face();
    if (check(fc == 2, "FAIL: F scanned TTC face != 2\n") == 0) { return 30; }
    let pn1: i32 = ui_sysfont_probe_n();
    if (check(pn1 == pn0 + 7, "FAIL: F probe rows != +7 after scan\n") == 0) { return 31; }
    let pe0: i32 = ui_sysfont_probe_err(pn0);
    let pe1: i32 = ui_sysfont_probe_err(pn0 + 1);
    let pe2: i32 = ui_sysfont_probe_err(pn0 + 2);
    let pe3: i32 = ui_sysfont_probe_err(pn0 + 3);
    let pe4: i32 = ui_sysfont_probe_err(pn0 + 4);
    let pe5: i32 = ui_sysfont_probe_err(pn0 + 5);
    let pe6: i32 = ui_sysfont_probe_err(pn0 + 6);
    if (check(pe0 == 1, "FAIL: F probe row 0 err != 1 (missing first name)\n") == 0) { return 31; }
    if (check(pe1 == 0, "FAIL: F probe row 1 err != 0 (renamed TTC loaded)\n") == 0) { return 31; }
    if (check(pe2 == 1, "FAIL: F probe row 2 err != 1\n") == 0) { return 31; }
    if (check(pe3 == 1, "FAIL: F probe row 3 err != 1\n") == 0) { return 31; }
    if (check(pe4 == 1, "FAIL: F probe row 4 err != 1\n") == 0) { return 31; }
    if (check(pe5 == 1, "FAIL: F probe row 5 err != 1\n") == 0) { return 31; }
    if (check(pe6 == 1, "FAIL: F probe row 6 err != 1\n") == 0) { return 31; }
    let g10: i32 = aui_rt_glyph(0x6F22);
    if (check(g10 == 1, "FAIL: F U+6F22 glyph missing after scan\n") == 0) { return 32; }
    let src10: i32 = aui_rt_src();
    if (check(src10 == 1, "FAIL: F U+6F22 src != TT after scan\n") == 0) { return 32; }
    let q1: i32 = write_all(1, "SCAN ", 5);
    let q2: i32 = out_i32(sc);
    let q3: i32 = write_all(1, " ", 1);
    let q4: i32 = out_i32(pn1);
    let q5: i32 = write_all(1, " ", 1);
    let q6: i32 = out_i32(pe0);
    let q7: i32 = write_all(1, " ", 1);
    let q8: i32 = out_i32(pe1);
    let q9: i32 = write_all(1, " ", 1);
    let qa: i32 = out_i32(pe2);
    let qb: i32 = write_all(1, " ", 1);
    let qc: i32 = out_i32(pe3);
    let qd: i32 = write_all(1, " ", 1);
    let qe: i32 = out_i32(pe4);
    let qf: i32 = write_all(1, " ", 1);
    let qg: i32 = out_i32(pe5);
    let qh: i32 = write_all(1, " ", 1);
    let qi: i32 = out_i32(pe6);
    let qj: i32 = write_all(1, "\n", 1);

    // ---- G. Multi-curve + flex + font switch (v2.1 blob fix) ----
    // The v2.1 corruption: ops 26/27/30/31 (vv/hh/vh/hvcurveto)
    // drew one curve and dropped the rest, so every bowl glyph
    // using them with >5 args rendered as a blob (e, o, a, g, c,
    // p, 0, 5, 6, U+5DF2). The flex1/hflex1 labels were also
    // swapped, flex1 missed its dominant-axis negation, and hflex
    // ended its second curve one dy2 too high. These GLYPHHASH
    // lines freeze the corrected bitmaps; a regression changes a
    // hash. U+8C99 exercises flex1 (Regular fd-12 subr 21599);
    // U+5D67 exercises flex1 in Bold (fd-12 subr 14539);
    // U+585B exercises hflex (Regular fd-12 subr 14029;
    // U+6BAA also uses hflex, via subr 23650).
    let lg: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    if (check(lg == 1, "FAIL: G Regular load failed\n") == 0) { return 33; }
    let g11: i32 = aui_rt_glyph(101);
    if (check(g11 == 1, "FAIL: G 'e' glyph missing\n") == 0) { return 34; }
    if (check(aui_rt_src() == 1, "FAIL: G 'e' src != TT\n") == 0) { return 34; }
    let st11: i32 = glyph_stats(ink, part);
    if (check(ink[0] > 100, "FAIL: G 'e' bitmap has no ink\n") == 0) { return 34; }
    if (check(part[0] > 0, "FAIL: G 'e' bitmap has no AA\n") == 0) { return 34; }
