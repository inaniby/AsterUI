    if (check(ui_tt_decode_failures() == 0, "FAIL: G decode failures != 0\n") == 0) { return 38; }

    // ---- H. Descenders (v2.2 device bug, fixed v2.3) ----
    // The v2.2 cell was a fixed 48 rows mapping the typo em box
    // (asc 880 .. desc -120), but Latin descenders reach -250, so
    // the tails of g/p/y/j/q were cut flat at the cell bottom on
    // the device ("g" in Language / Toggle dark / Show log, "p" in
    // Promotions / Tap to type..., "y" in the System tab). The
    // bitmap now grows per glyph to hold the whole outline
    // (render/truetype.ast ui_tt_outline_rows); the baseline row
    // never moves, so non-descender glyphs are byte-identical.
    // FreeType cross-check at 48px, no hinting (Regular): g 516 vs
    // 542, p 424 vs 445, y 347 vs 357, j 239 vs 259, q 458 vs 468
    // (all within 8%; j is thinnest, its dot-tip row is a
    // pre-existing sampler difference -- identical before/after
    // this fix). Bold (the device face): g 697 vs 715, p 623 vs
    // 627, y 485 vs 488, j 376 vs 392, q 589 vs 629. The section G
    // g/p hashes move for exactly this reason (taller bitmaps);
    // e/o/a/c/0/5/6/yi3/flex1/hflex and the section C hashes do
    // not move (their bitmaps stay 48 rows), re-asserted below.
    let lh: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    if (check(lh == 1, "FAIL: H Regular load failed\n") == 0) { return 39; }
    let h1: i32 = aui_rt_glyph(103);
    if (check(h1 == 1, "FAIL: H 'g' glyph missing\n") == 0) { return 40; }
    if (check(aui_rt_src() == 1, "FAIL: H 'g' src != TT\n") == 0) { return 40; }
    if (check(aui_rt_bh() == 55, "FAIL: H 'g' bitmap h != 55\n") == 0) { return 40; }
    if (check(glyph_below(48) > 0, "FAIL: H 'g' has no ink below row 48\n") == 0) { return 40; }
    let st_h1: i32 = glyph_stats(ink, part);
    if (check(ink[0] > 100, "FAIL: H 'g' bitmap has no ink\n") == 0) { return 40; }
    if (check(part[0] > 0, "FAIL: H 'g' bitmap has no AA\n") == 0) { return 40; }
    let h2: i32 = aui_rt_glyph(112);
    if (check(h2 == 1, "FAIL: H 'p' glyph missing\n") == 0) { return 40; }
    if (check(aui_rt_src() == 1, "FAIL: H 'p' src != TT\n") == 0) { return 40; }
    if (check(aui_rt_bh() == 54, "FAIL: H 'p' bitmap h != 54\n") == 0) { return 40; }
    if (check(glyph_below(48) > 0, "FAIL: H 'p' has no ink below row 48\n") == 0) { return 40; }
    let st_h2: i32 = glyph_stats(ink, part);
    if (check(ink[0] > 100, "FAIL: H 'p' bitmap has no ink\n") == 0) { return 40; }
    if (check(part[0] > 0, "FAIL: H 'p' bitmap has no AA\n") == 0) { return 40; }
    let h3: i32 = aui_rt_glyph(121);
    if (check(h3 == 1, "FAIL: H 'y' glyph missing\n") == 0) { return 40; }
    if (check(aui_rt_src() == 1, "FAIL: H 'y' src != TT\n") == 0) { return 40; }
    if (check(aui_rt_bh() == 54, "FAIL: H 'y' bitmap h != 54\n") == 0) { return 40; }
    if (check(glyph_below(48) > 0, "FAIL: H 'y' has no ink below row 48\n") == 0) { return 40; }
    let st_h3: i32 = glyph_stats(ink, part);
    if (check(ink[0] > 100, "FAIL: H 'y' bitmap has no ink\n") == 0) { return 40; }
    if (check(part[0] > 0, "FAIL: H 'y' bitmap has no AA\n") == 0) { return 40; }
    let h_y: i64 = out_glyph_hash("y", 121);
    let h4: i32 = aui_rt_glyph(106);
    if (check(h4 == 1, "FAIL: H 'j' glyph missing\n") == 0) { return 40; }
