    // file; parse_sfnt marks it absent and the load fails with
    // err 5 (no usable outline table), not err 6 -- err 6 is
    // reserved for a CFF2 table that IS fully present but fails
    // to parse. Bold must still load afterwards, and switching
    // back to the CFF2 subset must restore the section C 'A' hash.
    let ibr: i32 = aui_rt_set_font_path("tests/fixtures/cff2_broken.ttf");
    // Fall back ONLY when the file was not found (err 1): a found-but-
    // broken file reports err 5, and a second attempt would overwrite
    // it with err 1 -- the check below requires err == 5.
    if (ibr == 0 && ui_sysfont_err() == 1) { ibr = aui_rt_set_font_path("stdlib/asterui/tests/fixtures/cff2_broken.ttf"); }
    if (check(ibr == 0, "FAIL: I broken CFF2 loaded (should fail)\n") == 0) { return 48; }
    if (check(ui_sysfont_err() == 5, "FAIL: I broken CFF2 err != 5\n") == 0) { return 48; }
