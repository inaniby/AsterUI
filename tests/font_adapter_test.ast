    if (check(jh_han != 0, "FAIL: J Regular U+6F22 probe failed\n") == 0) { return 54; }
    let oi_han: i32 = out_ink("han_hyzy", jink[0]);
    // Specimen glyphs (the Gallery Fonts tab text): every distinct
    // glyph of the three Chinese lines + two English lines,
    // frozen as hyzy_spec hashes in the Regular weight.
    let spec: i32[46] = 0;
    spec[0] = 0x4E0E;
    spec[1] = 0x4F60;
    spec[2] = 0x4E0D;
    spec[3] = 0x8C0B;
    spec[4] = 0x800C;
    spec[5] = 0x5408;
    spec[6] = 0x8BA9;
    spec[7] = 0x6C9F;
    spec[8] = 0x901A;
    spec[9] = 0x4FE1;
    spec[10] = 0x4EFB;
    spec[11] = 0x65E0;
    spec[12] = 0x5904;
    spec[13] = 0x5728;
    spec[14] = 0x7F51;
    spec[15] = 0x7EDC;
    spec[16] = 0x8054;
    spec[17] = 0x63A5;
    spec[18] = 0x4E16;
    spec[19] = 0x754C;
    spec[20] = 0x521B;
    spec[21] = 0x65B0;
    spec[22] = 0x5F15;
    spec[23] = 0x9886;
    spec[24] = 0x672A;
    spec[25] = 0x6765;
    spec[26] = 0x54;
    spec[27] = 0x6F;
    spec[28] = 0x65;
    spec[29] = 0x6E;
    spec[30] = 0x61;
    spec[31] = 0x62;
    spec[32] = 0x6C;
    spec[33] = 0x63;
    spec[34] = 0x69;
    spec[35] = 0x76;
    spec[36] = 0x79;
    spec[37] = 0x72;
    spec[38] = 0x75;
    spec[39] = 0x73;
    spec[40] = 0x68;
    spec[41] = 0x77;
    spec[42] = 0x66;
    spec[43] = 0x6D;
    spec[44] = 0x64;
    spec[45] = 0x74;
    let k: i32 = 0;
    while (k < 46) {
        let sh: i64 = probe_glyph(spec[k], "hyzy_spec", jink);
        if (check(sh != 0, "FAIL: J specimen glyph probe failed\n") == 0) { return 54; }
        k = k + 1;
    }
    // Switch determinism: custom -> system -> custom returns the
    // same hashes; restore reports the system path again.
    let js1: i32 = aui_rt_restore_system_font();
    if (check(js1 == 1, "FAIL: J restore to system failed\n") == 0) { return 55; }
    if (check(aui_rt_custom_active() == 0, "FAIL: J custom still active after restore\n") == 0) { return 55; }
    if (check(aui_rt_custom_path() == 0, "FAIL: J custom path set after restore\n") == 0) { return 55; }
    if (check(aui_rt_system_path() != 0, "FAIL: J system path is 0 after restore\n") == 0) { return 55; }
    let jsg: i32 = aui_rt_glyph(65);
    if (check(jsg == 1, "FAIL: J 'A' glyph missing after restore\n") == 0) { return 55; }
    let jsh: i64 = fnv_bytes(aui_rt_bm(), aui_rt_bw() * aui_rt_bh());
    if (check(jsh == h_a, "FAIL: J 'A' hash != system hash after restore\n") == 0) { return 55; }
    let js2: i32 = aui_rt_set_custom_font("/tmp/aui-hyzy-test/HYZhengYuan-Regular.ttf");
    if (check(js2 == 1, "FAIL: J Regular reload after restore failed\n") == 0) { return 55; }
    let jsh2: i64 = probe_glyph(65, "A_hyzy_again", jink);
    if (check(jsh2 == jrh, "FAIL: J 'A' hash differs after custom->system->custom\n") == 0) { return 55; }
    let js3: i32 = aui_rt_restore_system_font();
    if (check(js3 == 1, "FAIL: J second restore to system failed\n") == 0) { return 55; }
    let jsg3: i32 = aui_rt_glyph(65);
    if (check(jsg3 == 1, "FAIL: J 'A' glyph missing after second restore\n") == 0) { return 55; }
    let jsh3: i64 = fnv_bytes(aui_rt_bm(), aui_rt_bw() * aui_rt_bh());
    if (check(jsh3 == h_a, "FAIL: J 'A' hash != system hash after second restore\n") == 0) { return 55; }
    if (check(ui_tt_decode_failures() == 0, "FAIL: J decode failures != 0\n") == 0) { return 56; }

    // ---- K. Long paths (v2.5.1) ----
    // The device folder is 72 chars; the v2.5 text pool held 63,
    // so the Fonts-tab prefill was silently truncated to
    // ".../gallery/fi" and every Load failed err=1 (the user
    // confirmed the files were in place). The pool now holds 255.
    // These loads go through the full file path: 72-char folder +
    // 23-char file name = 96 (exactly the device Regular path),
    // and a 96-char folder = 120-char file path. 'A' must hash to
    // the section J Regular/Bold hashes -- the long path must not
    // change the face. The suite prepares the two long folders
    // under /tmp/aui-hyzy-test/ for this section.
    let kl72: i32 = strlen("/tmp/aui-hyzy-test/long-folder-name-for-path-capacity-test-0123456789abc");
    if (check(kl72 == 72, "FAIL: K long72 folder literal != 72\n") == 0) { return 57; }
    let kw0: i32 = aui_rt_set_custom_font("/tmp/aui-hyzy-test/long-folder-name-for-path-capacity-test-0123456789abc/HYZhengYuan-Regular.ttf");
    if (check(kw0 == 1, "FAIL: K long72 Regular load failed\n") == 0) { return 57; }
    if (check(aui_rt_custom_active() == 1, "FAIL: K long72 Regular custom not active\n") == 0) { return 57; }
    if (check(aui_rt_font_weight() == 400, "FAIL: K long72 Regular weight != 400\n") == 0) { return 57; }
    let kh_r: i64 = probe_glyph(65, "A_hyzy_long72", jink);
    if (check(kh_r != 0, "FAIL: K long72 'A' probe failed\n") == 0) { return 57; }
    if (check(kh_r == jrh, "FAIL: K long72 'A' hash != Regular hash\n") == 0) { return 57; }
    let kw1: i32 = aui_rt_set_custom_font("/tmp/aui-hyzy-test/long-folder-name-for-path-capacity-test-0123456789abc/HYZhengYuan-Bold.ttf");
    if (check(kw1 == 1, "FAIL: K long72 Bold load failed\n") == 0) { return 57; }
    if (check(aui_rt_font_weight() == 700, "FAIL: K long72 Bold weight != 700\n") == 0) { return 57; }
    let kh_b: i64 = probe_glyph(65, "A_hyzy_long72_bold", jink);
    if (check(kh_b != 0, "FAIL: K long72 Bold 'A' probe failed\n") == 0) { return 57; }
    if (check(kh_b == jbh, "FAIL: K long72 Bold 'A' hash != Bold hash\n") == 0) { return 57; }
    let kl120: i32 = strlen("/tmp/aui-hyzy-test/long-folder-name-for-path-capacity-test-0123456789abcdefghijklmnopqrstuvwxyz0");
    if (check(kl120 == 96, "FAIL: K long120 folder literal != 96\n") == 0) { return 58; }
    let kw2: i32 = aui_rt_set_custom_font("/tmp/aui-hyzy-test/long-folder-name-for-path-capacity-test-0123456789abcdefghijklmnopqrstuvwxyz0/HYZhengYuan-Regular.ttf");
    if (check(kw2 == 1, "FAIL: K long120 Regular load failed\n") == 0) { return 58; }
    if (check(aui_rt_font_weight() == 400, "FAIL: K long120 Regular weight != 400\n") == 0) { return 58; }
    let kh_120: i64 = probe_glyph(65, "A_hyzy_long120", jink);
    if (check(kh_120 != 0, "FAIL: K long120 'A' probe failed\n") == 0) { return 58; }
    if (check(kh_120 == jrh, "FAIL: K long120 'A' hash != Regular hash\n") == 0) { return 58; }
    if (check(ui_tt_decode_failures() == 0, "FAIL: K decode failures != 0\n") == 0) { return 58; }

    let s1: i32 = write_all(1, "RTFB ", 5);
    let s2: i32 = out_i32(aui_rt_fallback_events());
    let s3: i32 = write_all(1, " ", 1);
    let s4: i32 = out_i32(aui_rt_fallback_reason());
    let s5: i32 = write_all(1, " ", 1);
    let s6: i32 = out_i32(aui_rt_missing());
    let s7: i32 = write_all(1, "\n", 1);
    let e: i32 = eputs("PASS: font_adapter\n");
    return 0;
}
