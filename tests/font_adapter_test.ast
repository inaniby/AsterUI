    // ---- G3. Font switch: Regular -> Bold -> Regular ----
    // ui_sysfont_load_face must reset the lazy CFF parse flag, or
    // the second font decodes against the first font's CFF
    // offsets and every glyph fails. The 'A' hash after switching
    // back must equal the section C hash, and the Bold 'A' hash
    // must differ from the Regular one (the Bold face engaged).
    let lb: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc");
    if (check(lb == 1, "FAIL: G Bold load failed\n") == 0) { return 35; }
    let gb: i32 = aui_rt_glyph(65);
    if (check(gb == 1, "FAIL: G Bold 'A' glyph missing\n") == 0) { return 35; }
    if (check(aui_rt_src() == 1, "FAIL: G Bold 'A' src != TT\n") == 0) { return 35; }
    let h_a_bold: i64 = out_glyph_hash("A_bold", 65);
    if (check(h_a_bold != h_a, "FAIL: G Bold 'A' hash equals Regular (Bold did not engage)\n") == 0) { return 35; }
    let gb2: i32 = aui_rt_glyph(0x5D67);
    if (check(gb2 == 1, "FAIL: G Bold flex1 glyph missing\n") == 0) { return 35; }
    if (check(aui_rt_src() == 1, "FAIL: G Bold flex1 src != TT\n") == 0) { return 35; }
