    if (check(part[0] > 0, "FAIL: H Bold 'g' bitmap has no AA\n") == 0) { return 41; }
    let h_g_bold: i64 = out_glyph_hash("g_bold", 103);
    // Back to Regular: 'A' must equal the section C hash again.
    let hr: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    if (check(hr == 1, "FAIL: H Regular reload failed\n") == 0) { return 42; }
    let hra: i32 = aui_rt_glyph(65);
    if (check(hra == 1, "FAIL: H Regular 'A' glyph missing after switch\n") == 0) { return 42; }
    let h_a4: i64 = fnv_bytes(aui_rt_bm(), aui_rt_bw() * aui_rt_bh());
    if (check(h_a4 == h_a, "FAIL: H 'A' bitmap hash differs after font switch\n") == 0) { return 43; }
    if (check(ui_tt_decode_failures() == 0, "FAIL: H decode failures != 0\n") == 0) { return 44; }

    // ---- I. CFF2 default instance (v2.4) ----
    // The CFF2 subset fixture is the VM Regular TTC subset to the
    // 11 glyphs of the FreeType validation (A/e/o/g/0/5/6 + U+4E2D/
    // U+6587/U+5DF2/U+6F22), converted CFF -> CFF2 with charstring
    // widths stripped; the blend fixture is a hand-built 5-glyph
    // CFF2 font with one VarData (1 region) and fvar wght 400..900
    // default 400. The CFF2 bitmaps must EQUAL the CFF Regular
    // hashes of sections C/G (same outlines, same upm).
    // Split 2026-11-15: fixture path is cwd-relative; try the standalone
    // repo layout first, fall back to the mounted (submodule) layout.
    let li: i32 = aui_rt_set_font_path("tests/fixtures/cff2_noto_sc.ttf");
    if (li == 0) { li = aui_rt_set_font_path("stdlib/asterui/tests/fixtures/cff2_noto_sc.ttf"); }
    if (check(li == 1, "FAIL: I CFF2 subset load failed\n") == 0) { return 45; }
    if (check(aui_rt_active() == 1, "FAIL: I TT not active after CFF2 load\n") == 0) { return 45; }
    if (check(ui_sysfont_is_cff2() == 1, "FAIL: I is_cff2 != 1\n") == 0) { return 45; }
    if (check(ui_sysfont_is_cff() == 1, "FAIL: I is_cff != 1 (CFF2 rides the CFF branch)\n") == 0) { return 45; }
    if (check(ui_sysfont_fvar_wght() == -1, "FAIL: I subset fvar wght != -1 (no fvar)\n") == 0) { return 45; }
    let iadv1: i32 = aui_rt_advance(0x4E2D);
    let ip1: i32 = out_adv("zhong_cff2", iadv1);
    if (check(iadv1 == 48, "FAIL: I CFF2 U+4E2D advance != 48\n") == 0) { return 45; }
    let iadv2: i32 = aui_rt_advance(65);
    let ip2: i32 = out_adv("A_cff2", iadv2);
    if (check(iadv2 > 0, "FAIL: I CFF2 'A' advance <= 0\n") == 0) { return 45; }
    if (check(iadv2 < 48, "FAIL: I CFF2 'A' advance not proportional (< 48)\n") == 0) { return 45; }
    let i1: i32 = aui_rt_glyph(65);
    if (check(i1 == 1, "FAIL: I CFF2 'A' glyph missing\n") == 0) { return 46; }
    if (check(aui_rt_src() == 1, "FAIL: I CFF2 'A' src != TT\n") == 0) { return 46; }
    let ist1: i32 = glyph_stats(ink, part);
    if (check(ink[0] > 100, "FAIL: I CFF2 'A' bitmap has no ink\n") == 0) { return 46; }
    if (check(part[0] > 0, "FAIL: I CFF2 'A' bitmap has no AA\n") == 0) { return 46; }
    let ih_a: i64 = out_glyph_hash("A_cff2", 65);
    if (check(ih_a == h_a, "FAIL: I CFF2 'A' hash != CFF 'A' hash\n") == 0) { return 46; }
    let i2: i32 = aui_rt_glyph(101);
    if (check(i2 == 1, "FAIL: I CFF2 'e' glyph missing\n") == 0) { return 46; }
    if (check(aui_rt_src() == 1, "FAIL: I CFF2 'e' src != TT\n") == 0) { return 46; }
    let ist2: i32 = glyph_stats(ink, part);
    if (check(ink[0] > 100, "FAIL: I CFF2 'e' bitmap has no ink\n") == 0) { return 46; }
    if (check(part[0] > 0, "FAIL: I CFF2 'e' bitmap has no AA\n") == 0) { return 46; }
    let ih_e: i64 = out_glyph_hash("e_cff2", 101);
    if (check(ih_e == h_e, "FAIL: I CFF2 'e' hash != CFF 'e' hash\n") == 0) { return 46; }
    let i3: i32 = aui_rt_glyph(111);
    if (check(i3 == 1, "FAIL: I CFF2 'o' glyph missing\n") == 0) { return 46; }
    if (check(aui_rt_src() == 1, "FAIL: I CFF2 'o' src != TT\n") == 0) { return 46; }
    let ist3: i32 = glyph_stats(ink, part);
    if (check(ink[0] > 100, "FAIL: I CFF2 'o' bitmap has no ink\n") == 0) { return 46; }
