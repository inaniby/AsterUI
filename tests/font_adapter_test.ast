    if (check(gr == 1, "FAIL: G Regular 'A' glyph missing after switch\n") == 0) { return 36; }
    if (check(aui_rt_src() == 1, "FAIL: G Regular 'A' src != TT after switch\n") == 0) { return 36; }
    let h_a3: i64 = out_glyph_hash("A3", 65);
