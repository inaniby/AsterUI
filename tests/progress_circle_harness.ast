// progress_circle_harness.ast — v1.32 ui_progress_circle 的真实宿主路径
// 冒烟测试（qemu-user）。
//
// 720×1280 / density 420 的假宿主，走 ANativeActivity 回调创建窗口，然后：
// 三枚 48 dp 圈并排居中；25% 只铺到右上方、60% 铺到左下、100% 满圈；
// 点“+25%”把受控值从 600 加到 850（950），左侧轨道变主色；40 dp 不确定
// 圈随假时钟从顶部转到顶部变轨道；24 dp 默认尺寸是 63 px 方块；深色主题
// 主色换成 6E96FF。
//
// 返回码：0 通过；10 attach 失败；11 回调表没写；12 屏幕全黑；
// 13 版本号不是 14806；14 三圈几何不对；15 初始受控值不对；
// 16 25% 顶部不是主色；17 25% 底部出现主色；18 60% 底部不是主色；
// 19 60% 左侧出现主色；20 100% 左侧不是主色；21 +25% 没加值；
// 22 850 左侧仍不是主色；23 默认 24 dp 尺寸/右半不对；
// 24 不确定圈初始顶部不对；25 450 ms 后上下不对；
// 26 深色背景没变暗；27 深色主色不对；28 不确定节点状态不对；
// 29 初始相位不是 0；30 450 ms 后相位不是 180°；90 内容超出 720×1280。
extern let g_fake_pixels: i32[921600];

extern fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_progress_circle(key: i32, out: ptr) -> i32;
extern fn aui_debug_spin_phase() -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_frame(now: i64) -> i32;
extern fn aui_state_get(key: i32) -> i32;
extern fn aui_set_dark(on: i32) -> i32;
extern fn aui_invalidate() -> i32;
extern fn aui_version() -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;

let g_act: i64[11] = 0;
let g_cb: i64[16] = 0;
let g_win: i64[4] = 0;
let g_assets: i64[1] = 0;
let g_ext_path: u8[32] = 0;
let g_harness_anchor: ptr = g_act;

fn call_cb(off: i32, a: ptr, b: ptr) -> i32 {
    let cb: ptr = load_ptr(g_act);
    let f: fn(ptr, ptr) -> i32 = load_ptr(cb + off);
    return f(a, b);
}

fn frame_at(t: i64) -> i32 {
    fake_set_clock(t);
    return aui_frame(t);
}

fn tap_at(t: i64, x: i32, y: i32) -> i32 {
    fake_set_clock(t);
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    fake_set_clock(t + 50000000);
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn px_off(x: i32, y: i32) -> i32 { return (y * 720 + x) * 4; }
fn chan(x: i32, y: i32, c: i32) -> i32 {
    return i32(load_u8(g_fake_pixels + px_off(x, y) + c));
}
fn lum(x: i32, y: i32) -> i32 {
    let r: i32 = chan(x, y, 0);
    let g: i32 = chan(x, y, 1);
    let b: i32 = chan(x, y, 2);
    return (r * 3 + g * 6 + b) / 10;
}
fn is_color(x: i32, y: i32, r: i32, g: i32, b: i32) -> i32 {
    if (chan(x, y, 0) != r) { return 0; }
    if (chan(x, y, 1) != g) { return 0; }
    if (chan(x, y, 2) != b) { return 0; }
    return 1;
}
fn has_color(x0: i32, y0: i32, x1: i32, y1: i32,
             r: i32, g: i32, b: i32) -> i32 {
    let y: i32 = y0;
    while (y < y1) {
        let x: i32 = x0;
        while (x < x1) {
            if (is_color(x, y, r, g, b) != 0) { return 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return 0;
}

fn main() -> i32 {
    let act: ptr = g_act;
    *(act + 0) = g_cb;
    let assets: ptr = g_assets;
    *(act + 64) = assets;
    store_u8(g_ext_path + 0, 47);
    store_u8(g_ext_path + 1, 116);
    store_u8(g_ext_path + 2, 109);
    store_u8(g_ext_path + 3, 112);
    store_u8(g_ext_path + 4, 47);
    store_u8(g_ext_path + 5, 97);
    store_u8(g_ext_path + 6, 115);
    store_u8(g_ext_path + 7, 116);
    store_u8(g_ext_path + 8, 101);
    store_u8(g_ext_path + 9, 114);
    store_u8(g_ext_path + 10, 117);
    store_u8(g_ext_path + 11, 105);
    store_u8(g_ext_path + 12, 45);
    store_u8(g_ext_path + 13, 116);
    store_u8(g_ext_path + 14, 114);
    store_u8(g_ext_path + 15, 97);
    store_u8(g_ext_path + 16, 99);
    store_u8(g_ext_path + 17, 101);
    store_u8(g_ext_path + 18, 0);
    let ep: ptr = g_ext_path;
    *(act + 40) = ep;

    if (g_harness_anchor == 0) { return 10; }
    let r: i32 = ANativeActivity_onCreate(act, 0, 0);
    if (r != 0) { return 10; }

    let cb: ptr = load_ptr(g_act);
    let f56: ptr = load_ptr(cb + 56);
    let f72: ptr = load_ptr(cb + 72);
    if (f56 == 0 || f72 == 0) { return 11; }

    let win: ptr = g_win;
    let s1: i32 = call_cb(0, act, 0);
    let s2: i32 = call_cb(8, act, 0);
    let s3: i32 = call_cb(56, act, win);
    let s4: i32 = call_cb(72, act, win);

    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < 720 * 1280 * 4) {
        sum = sum + load_u8(g_fake_pixels + i);
        i = i + 1;
    }
    if (sum == 0) { return 12; }
    if (aui_version() != 14806) { return 13; }

    let base: i64 = 4500000000;   // 4500 ms = 900 的整数倍 → 相位 0
    frame_at(base);

    // ---- A. 三枚 56 dp 圈：同高、尺寸一致、并排居中 ----
    let a: i32[4] = 0;
    let b: i32[4] = 0;
    let c: i32[4] = 0;
    if (aui_debug_rect(100, a) != 0) { return 14; }
    if (aui_debug_rect(101, b) != 0) { return 14; }
    if (aui_debug_rect(102, c) != 0) { return 14; }
    if (a[2] != 126 || b[2] != 126 || c[2] != 126) { return 14; }
    if (a[3] != 126 || b[3] != 126 || c[3] != 126) { return 14; }
    if (a[1] != b[1] || a[1] != c[1]) { return 14; }
    if (b[0] < a[0] + a[2] + 30) { return 14; }
    if (c[0] < b[0] + b[2] + 30) { return 14; }
    if (a[0] < 40 || c[0] + c[2] > 680) { return 14; }
    if (a[1] < 0 || a[1] + a[3] > 1280) { return 90; }
    if (b[0] < 0 || b[0] + b[2] > 720) { return 90; }
    if (c[0] < 0 || c[0] + c[2] > 720) { return 90; }

    // ---- B. 初始受控值 600 ----
    if (aui_state_get(950) != 600) { return 15; }

    // ---- C. 25%：顶部/右上主色，底部轨道 ----
    let acx: i32 = a[0] + a[2] / 2;
    let acy: i32 = a[1] + a[3] / 2;
    if (has_color(acx - 8, acy - 55 - 8, acx + 8, acy - 55 + 8,
                  0x3A, 0x6D, 0xF0) == 0) { return 16; }
    if (has_color(acx - 8, acy + 55 - 8, acx + 8, acy + 55 + 8,
                  0x3A, 0x6D, 0xF0) != 0) { return 17; }

    // ---- D. 60%：底部主色，左侧仍是轨道 ----
    let bcx: i32 = b[0] + b[2] / 2;
    let bcy: i32 = b[1] + b[3] / 2;
    if (has_color(bcx - 8, bcy + 55 - 8, bcx + 8, bcy + 55 + 8,
                  0x3A, 0x6D, 0xF0) == 0) { return 18; }
    if (has_color(bcx - 55 - 8, bcy - 8, bcx - 55 + 8, bcy + 8,
                  0x3A, 0x6D, 0xF0) != 0) { return 19; }

    // ---- E. 100%：左侧也是主色 ----
    let ccx: i32 = c[0] + c[2] / 2;
    let ccy: i32 = c[1] + c[3] / 2;
    if (has_color(ccx - 55 - 8, ccy - 8, ccx - 55 + 8, ccy + 8,
                  0x3A, 0x6D, 0xF0) == 0) { return 20; }

    // ---- F. 受控圈 96 dp（252 px）：点 +25% 后 600 → 850 ----
    let v: i32[4] = 0;
    if (aui_debug_rect(110, v) != 0) { return 22; }
    if (v[2] != 189 || v[3] != 189) { return 22; }
    if (v[0] < 0 || v[0] + v[2] > 720) { return 90; }
    if (v[1] < 0 || v[1] + v[3] > 1280) { return 90; }
    let vcx: i32 = v[0] + v[2] / 2;
    let vcy: i32 = v[1] + v[3] / 2;
    if (has_color(vcx - 82 - 8, vcy - 8, vcx - 82 + 8, vcy + 8,
                  0x3A, 0x6D, 0xF0) != 0) { return 22; }
    let btn: i32[4] = 0;
    if (aui_debug_rect(120, btn) != 0) { return 21; }
    tap_at(base + 200000000, btn[0] + btn[2] / 2, btn[1] + btn[3] / 2);
    frame_at(base + 300000000);
    if (aui_state_get(950) != 850) { return 21; }
    if (has_color(vcx - 82 - 8, vcy - 8, vcx - 82 + 8, vcy + 8,
                  0x3A, 0x6D, 0xF0) == 0) { return 22; }

    // ---- G. 默认 24 dp → 63 px，50% 右半主色 ----
    let d: i32[4] = 0;
    if (aui_debug_rect(140, d) != 0) { return 23; }
    if (d[2] != 63 || d[3] != 63) { return 23; }
    if (d[0] < 0 || d[0] + d[2] > 720) { return 90; }
    if (d[1] < 0 || d[1] + d[3] > 1280) { return 90; }
    let dcx: i32 = d[0] + d[2] / 2;
    let dcy: i32 = d[1] + d[3] / 2;
    if (has_color(dcx + 27 - 6, dcy - 6, dcx + 27 + 6, dcy + 6,
                  0x3A, 0x6D, 0xF0) == 0) { return 23; }

    // ---- H. 不确定圈（40 dp / 105 px）：开始时顶部主色、底部轨道 ----
    let dbg: i32[2] = 0;
    if (aui_debug_progress_circle(130, dbg) != 0) { return 28; }
    if (dbg[0] != -1 || dbg[1] != 40) { return 28; }
    // 前面的点按把假时钟推到 4800 ms；回到 4500 ms 让相位归零。
    frame_at(base);
    if (aui_debug_spin_phase() != 0) { return 29; }
    let e: i32[4] = 0;
    if (aui_debug_rect(130, e) != 0) { return 24; }
    if (e[0] < 0 || e[0] + e[2] > 720) { return 90; }
    if (e[1] < 0 || e[1] + e[3] > 1280) { return 90; }
    let ecx: i32 = e[0] + e[2] / 2;
    let ecy: i32 = e[1] + e[3] / 2;
    if (has_color(ecx - 8, ecy - 45 - 8, ecx + 8, ecy - 45 + 8,
                  0x3A, 0x6D, 0xF0) == 0) { return 24; }
    if (has_color(ecx - 8, ecy + 45 - 8, ecx + 8, ecy + 45 + 8,
                  0x3A, 0x6D, 0xF0) != 0) { return 24; }

    // ---- I. 450 ms 后相位 180°：顶部变轨道、底部变主色 ----
    frame_at(base + 450000000);
    if (aui_debug_spin_phase() != 32768) { return 30; }
    if (has_color(ecx - 8, ecy - 45 - 8, ecx + 8, ecy - 45 + 8,
                  0x3A, 0x6D, 0xF0) != 0) { return 25; }
    if (has_color(ecx - 8, ecy + 45 - 8, ecx + 8, ecy + 45 + 8,
                  0x3A, 0x6D, 0xF0) == 0) { return 25; }

    // ---- J. 深色：背景变暗，主色换成 6E96FF ----
    let light: i32 = lum(10, 10);
    aui_set_dark(1);
    aui_invalidate();
    frame_at(base + 600000000);
    let dark: i32 = lum(10, 10);
    if (dark > light - 80) { return 26; }
    if (aui_debug_rect(102, c) != 0) { return 27; }
    if (has_color(ccx - 55 - 8, ccy - 8, ccx - 55 + 8, ccy + 8,
                  0x6E, 0x96, 0xFF) == 0) { return 27; }

    let s5: i32 = call_cb(24, act, 0);
    let s6: i32 = call_cb(32, act, 0);
    let s7: i32 = call_cb(40, act, 0);
    return 0;
}
