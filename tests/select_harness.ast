// select_harness.ast — v1.26 ui_select 的真实宿主路径冒烟测试（qemu-user）。
//
// 720×1280 / density 420 的假宿主，走 ANativeActivity 回调创建窗口，然后：
// 打开 Language 下拉（锚在触发器下方、宽度跟触发器）-> 点 German 关闭；
// 重开确认选中项换到第二行 -> 点外部关闭；打开 Theme 下拉 -> 系统 BACK 关闭；
// 切深色后打开，确认浮层与选中底色随主题变化；最后打开底部的 Sort 下拉，
// 确认空间不够时浮层翻到触发器上方。选项始终声明在树里，节点数应保持不变。
//
// 返回码：0 通过；10 attach 失败；11 回调表没写；12 屏幕全黑；
// 13 版本号不是 14806；14 找不到 Language 触发器；15 找不到 Theme 触发器；
// 16 找不到 Sort 触发器；17 浮层没打开；18 浮层几何不对（宽度/位置）；
// 19 选中项底色不是 TINT；20 点选项没有关闭浮层；21 选中项没有更新；
// 22 点外部没有关闭；23 BACK 没有关闭；24 深色主题下浮层颜色不对；
// 25 Sort 浮层没打开 / 节点数变化；31 240 dpi 下没有锚在下方；
// 32 420 dpi 下重开失败；33 空间不足时没有翻到上方；34 触发器 g 下伸部被裁剪；
// 35 选项间拖动误选；36 选项按下没有 PRESSED 底色；37 浮层外拖进选项误选。
extern let g_fake_pixels: i32[921600];

extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_node_count() -> i32;
extern fn aui_debug_select_panel(out: ptr) -> i32;
extern fn aui_debug_set_density(dpi: i32) -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_frame(now: i64) -> i32;
extern fn aui_version() -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_post_key(action: i32, code: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;

let g_act: i64[11] = 0;
let g_cb: i64[16] = 0;
let g_win: i64[4] = 0;
let g_assets: i64[1] = 0;
let g_ext_path: u8[32] = 0;
let g_harness_anchor: ptr = g_act;

fn call_cb(off: i32, a: ptr, b: ptr) -> i32 {
    let cb: ptr = load_ptr(g_act);
    let f: fn(ptr, ptr) -> i32 = load_ptr(cb + off);
    return f(a, b);
}

fn tap(x: i32, y: i32) -> i32 {
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

// v1.26.2：DOWN -> 4 段 MOVE -> UP，用来验证拖动不会误选。
fn drag(x0: i32, y0: i32, x1: i32, y1: i32) -> i32 {
    fake_post_motion(0, x0, y0);
    aui_on_input(1, 0, 0);
    let i: i32 = 1;
    while (i <= 4) {
        let mx: i32 = x0 + (x1 - x0) * i / 4;
        let my: i32 = y0 + (y1 - y0) * i / 4;
        fake_post_motion(2, mx, my);
        aui_on_input(1, 0, 0);
        i = i + 1;
    }
    fake_post_motion(1, x1, y1);
    aui_on_input(1, 0, 0);
    return 0;
}

fn press_back() -> i32 {
    fake_post_key(0, 4);
    aui_on_input(1, 0, 0);
    fake_post_key(1, 4);
    aui_on_input(1, 0, 0);
    return 0;
}

fn px_off(x: i32, y: i32) -> i32 {
    return (y * 720 + x) * 4;
}

fn is_color(x: i32, y: i32, r: i32, g: i32, b: i32) -> i32 {
    let o: i32 = px_off(x, y);
    if (load_u8(g_fake_pixels + o + 0) != r) { return 0; }
    if (load_u8(g_fake_pixels + o + 1) != g) { return 0; }
    if (load_u8(g_fake_pixels + o + 2) != b) { return 0; }
    return 1;
}

// v1.44：文本改成 8bpp 抗锯齿后，墨迹内部也不再是纯文字色，改用
// “luma 明显低于白底” 判断这里有没有字，3×3 邻域取最小值，避免
// 恰好落到一个覆盖度很低的边缘像素上。
fn ink_at(x: i32, y: i32) -> i32 {
    let best: i32 = 255;
    let dy: i32 = -1;
    while (dy <= 1) {
        let dx: i32 = -1;
        while (dx <= 1) {
            let o: i32 = px_off(x + dx, y + dy);
            let r: i32 = load_u8(g_fake_pixels + o + 0);
            let g: i32 = load_u8(g_fake_pixels + o + 1);
            let b: i32 = load_u8(g_fake_pixels + o + 2);
            let l: i32 = (r * 299 + g * 587 + b * 114) / 1000;
            if (l < best) { best = l; }
            dx = dx + 1;
        }
        dy = dy + 1;
    }
    if (best < 128) { return 1; }
    return 0;
}

fn tap_rect(key: i32, out: ptr) -> i32 {
    let r: ptr<i32> = out;
    if (aui_debug_rect(key, out) != 0) { return -1; }
    tap(r[0] + r[2] / 2, r[1] + r[3] / 2);
    return 0;
}

// 浮层里第 idx 行选中底色的采样点。密度 240 时：行高 48 dp = 72 px，
// 浮层内缩 6 dp = 9 px，选中底色再内缩 4 dp = 6 px；取行垂直中心、
// 底色左缘（+6）与文字（+24）之间。
fn tint_at(p: ptr, idx: i32, r: i32, g: i32, b: i32) -> i32 {
    let q: ptr<i32> = p;
    let px0: i32 = q[0] >> 16;
    let py0: i32 = q[1] >> 16;
    let x: i32 = px0 + 16;
    let y: i32 = py0 + 45 + idx * 72;
    return is_color(x, y, r, g, b);
}

let g_panel: i32[4] = 0;

fn main() -> i32 {
    let act: ptr = g_act;
    *(act + 0) = g_cb;
    let assets: ptr = g_assets;
    *(act + 64) = assets;
    store_u8(g_ext_path + 0, 47);
    store_u8(g_ext_path + 1, 116);
    store_u8(g_ext_path + 2, 109);
    store_u8(g_ext_path + 3, 112);
    store_u8(g_ext_path + 4, 47);
    store_u8(g_ext_path + 5, 97);
    store_u8(g_ext_path + 6, 115);
    store_u8(g_ext_path + 7, 116);
    store_u8(g_ext_path + 8, 101);
    store_u8(g_ext_path + 9, 114);
    store_u8(g_ext_path + 10, 117);
    store_u8(g_ext_path + 11, 105);
    store_u8(g_ext_path + 12, 45);
    store_u8(g_ext_path + 13, 116);
    store_u8(g_ext_path + 14, 114);
    store_u8(g_ext_path + 15, 97);
    store_u8(g_ext_path + 16, 99);
    store_u8(g_ext_path + 17, 101);
    store_u8(g_ext_path + 18, 0);
    let ep: ptr = g_ext_path;
    *(act + 40) = ep;

    if (g_harness_anchor == 0) { return 15; }
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    let r0: i32 = ANativeActivity_onCreate(act, 0, 0);
    if (r0 != 0) { return 10; }

    let cb: ptr = load_ptr(g_act);
    let f56: ptr = load_ptr(cb + 56);
    let f72: ptr = load_ptr(cb + 72);
    if (f56 == 0 || f72 == 0) { return 11; }

    let win: ptr = g_win;
    let s1: i32 = call_cb(0, act, 0);
    let s2: i32 = call_cb(8, act, 0);
    let s3: i32 = call_cb(56, act, win);
    let s4: i32 = call_cb(72, act, win);

    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < 720 * 1280 * 4) {
        sum = sum + load_u8(g_fake_pixels + i);
        i = i + 1;
    }
    if (sum == 0) { return 12; }
    if (aui_version() != 14806) { return 13; }

    // 假宿主只有 720×1280；把密度降到 240（480×853 dp）让整页都能放下。
    aui_debug_set_density(240);
    let base: i64 = 4000000000;
    fake_set_clock(base);
    aui_frame(base);
    let base_n: i32 = aui_debug_node_count();

    let r30: i32[4] = 0;
    let r40: i32[4] = 0;
    let r50: i32[4] = 0;
    if (aui_debug_rect(30, r30) != 0) { return 14; }
    if (aui_debug_rect(40, r40) != 0) { return 15; }
    if (aui_debug_rect(50, r50) != 0) { return 16; }

    // ---- v1.26.1 回归：触发器里 “English” 的 g 下伸部不能被裁掉 ----
    // 密度 240：字高 48 px、行高 90 px（60 dp），触发器高 120 px，文字顶
    // = 触发器顶 +36；g 的第 35 行墨迹在文字顶 +54（即老裁剪底 +48 之下），
    // x 在文字左 +67。
    let dx0: i32 = r30[0] + 24 + 67;
    let dy0: i32 = r30[1] + (r30[3] - 48) / 2 + 54;
    if (ink_at(dx0, dy0) == 0) { return 34; }

    // ---- 打开 Language：浮层锚在触发器下方，宽度跟触发器 ----
    if (tap_rect(30, r30) != 0) { return 14; }
    aui_frame(base + 50000000);
    if (aui_debug_select_panel(g_panel) != 0) { return 17; }
    if (aui_debug_node_count() != base_n) { return 25; }
    let px0: i32 = g_panel[0] >> 16;
    let py0: i32 = g_panel[1] >> 16;
    let pw0: i32 = g_panel[2] >> 16;
    let ph0: i32 = g_panel[3] >> 16;
    if (pw0 != r30[2]) { return 18; }
    if (py0 < r30[1] + r30[3]) { return 18; }
    if (px0 < 0 || px0 + pw0 > 720) { return 18; }
    if (ph0 <= 0 || py0 + ph0 > 1280) { return 18; }
    if (tint_at(g_panel, 0, 0xED, 0xF1, 0xFA) == 0) { return 19; }

    // ---- v1.26.2：按下选项要有 PRESSED 底色，且重建后仍然保留 ----
    let o32: i32[4] = 0;
    if (aui_debug_rect(32, o32) != 0) { return 20; }
    let gx: i32 = o32[0] + o32[2] / 2;
    let gy: i32 = o32[1] + o32[3] / 2;
    fake_post_motion(0, gx, gy);
    aui_on_input(1, 0, 0);
    aui_frame(base + 70000000);
    if (aui_debug_select_panel(g_panel) != 0) { return 36; }
    if (tint_at(g_panel, 1, 0xE8, 0xEE, 0xFF) == 0) { return 36; }

    // ---- 抬起 German（第 2 项）：关闭浮层，节点数不变 ----
    fake_post_motion(1, gx, gy);
    aui_on_input(1, 0, 0);
    aui_frame(base + 100000000);
    if (aui_debug_select_panel(g_panel) == 0) { return 20; }
    if (aui_debug_node_count() != base_n) { return 25; }

    // ---- 重开：选中项应在第 2 行（TINT），然后点外部关闭 ----
    if (tap_rect(30, r30) != 0) { return 14; }
    aui_frame(base + 150000000);
    if (aui_debug_select_panel(g_panel) != 0) { return 21; }
    if (tint_at(g_panel, 0, 0xED, 0xF1, 0xFA) != 0) { return 21; }
    if (tint_at(g_panel, 1, 0xED, 0xF1, 0xFA) == 0) { return 21; }

    // ---- v1.26.2：在选项间拖动不选中，浮层保持展开 ----
    let o31: i32[4] = 0;
    let o33: i32[4] = 0;
    if (aui_debug_rect(31, o31) != 0) { return 35; }
    if (aui_debug_rect(33, o33) != 0) { return 35; }
    drag(o31[0] + o31[2] / 2, o31[1] + o31[3] / 2,
         o33[0] + o33[2] / 2, o33[1] + o33[3] / 2);
    aui_frame(base + 175000000);
    if (aui_debug_select_panel(g_panel) != 0) { return 35; }
    if (tint_at(g_panel, 1, 0xED, 0xF1, 0xFA) == 0) { return 35; }
    if (tint_at(g_panel, 2, 0xED, 0xF1, 0xFA) != 0) { return 35; }

    tap(5, 5);
    aui_frame(base + 200000000);
    if (aui_debug_select_panel(g_panel) == 0) { return 22; }

    // ---- v1.26.2：从浮层外拖进选项也不选中 ----
    if (tap_rect(30, r30) != 0) { return 14; }
    aui_frame(base + 220000000);
    if (aui_debug_select_panel(g_panel) != 0) { return 37; }
    if (aui_debug_rect(33, o33) != 0) { return 37; }
    drag(5, 5, o33[0] + o33[2] / 2, o33[1] + o33[3] / 2);
    aui_frame(base + 235000000);
    if (aui_debug_select_panel(g_panel) != 0) { return 37; }
    if (tint_at(g_panel, 1, 0xED, 0xF1, 0xFA) == 0) { return 37; }
    if (tint_at(g_panel, 2, 0xED, 0xF1, 0xFA) != 0) { return 37; }
    tap(5, 5);
    aui_frame(base + 245000000);
    if (aui_debug_select_panel(g_panel) == 0) { return 22; }

    // ---- Theme 下拉：系统 BACK 关闭 ----
    if (tap_rect(40, r40) != 0) { return 15; }
    aui_frame(base + 250000000);
    if (aui_debug_select_panel(g_panel) != 0) { return 23; }
    press_back();
    aui_frame(base + 300000000);
    if (aui_debug_select_panel(g_panel) == 0) { return 23; }

    // ---- 切深色后打开：选中底色 / 浮层内边距都变深色 ----
    let rsw: i32[4] = 0;
    if (tap_rect(25, rsw) != 0) { return 26; }
    aui_frame(base + 350000000);
    if (tap_rect(30, r30) != 0) { return 14; }
    aui_frame(base + 400000000);
    if (aui_debug_select_panel(g_panel) != 0) { return 27; }
    if (is_color(5, 5, 0x12, 0x12, 0x16) == 0) { return 30; }
    if (tint_at(g_panel, 1, 0x23, 0x2A, 0x3D) == 0) { return 28; }
    let q0: i32 = g_panel[0] >> 16;
    let q1: i32 = g_panel[1] >> 16;
    if (is_color(q0 + 4, q1 + 4, 0x1E, 0x1E, 0x24) == 0) { return 29; }
    tap(5, 5);
    aui_frame(base + 450000000);
    if (aui_debug_select_panel(g_panel) == 0) { return 22; }

    // ---- Sort：240 dpi 下空间充足，浮层在触发器下方 ----
    if (tap_rect(50, r50) != 0) { return 16; }
    aui_frame(base + 500000000);
    if (aui_debug_select_panel(g_panel) != 0) { return 25; }
    let py5: i32 = g_panel[1] >> 16;
    let ph5: i32 = g_panel[3] >> 16;
    if (py5 < r50[1] + r50[3]) { return 31; }
    tap(5, 5);
    aui_frame(base + 550000000);
    if (aui_debug_select_panel(g_panel) == 0) { return 22; }

    // ---- 回到 420 dpi（Sort 贴近底部）：浮层翻到触发器上方 ----
    aui_debug_set_density(420);
    aui_frame(base + 600000000);
    let r50b: i32[4] = 0;
    if (aui_debug_rect(50, r50b) != 0) { return 32; }
    if (tap_rect(50, r50b) != 0) { return 32; }
    aui_frame(base + 650000000);
    if (aui_debug_select_panel(g_panel) != 0) { return 32; }
    let qy5: i32 = g_panel[1] >> 16;
    let qh5: i32 = g_panel[3] >> 16;
    if (qy5 + qh5 > r50b[1]) { return 33; }
    if (qy5 < 0) { return 33; }
    tap(5, 5);
    aui_frame(base + 700000000);
    if (aui_debug_select_panel(g_panel) == 0) { return 22; }
    if (aui_debug_node_count() != base_n) { return 25; }

    let s5: i32 = call_cb(24, act, 0);
    let s6: i32 = call_cb(32, act, 0);
    let s7: i32 = call_cb(40, act, 0);
    return 0;
}