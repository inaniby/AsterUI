// font24_test.ast — v1.18 的 24px 字体与 3 字节行自检（离屏）。
//
// W5 re-baseline: the 24 px .auf font is gone. The test now runs at
// scale 2 against the VM TrueType face (96 px em, 120 px line); the
// checks keep their intent (proportional Latin advance, full-em CJK,
// ink in the glyph's right half) with TrueType values, probe-verified
// 2026-11-15. The old "3 字节行" mechanism no longer exists -- check 7
// now asserts the true right half of the 96 px glyph has strokes.
// W7 (2026-11-15, Batch 3): scale 2 -> 1. Verdict: the scale-1 face
// measures the same thing -- A advance 29 (hmtx 605/1000 x 48 px em =
// 29.04, rounds to 29), CJK full em 48, line 60, rows pitch 66, right
// half of the 48 px glyph (x+24..x+48) ink 240, left 24 px strip 239
// (all re-probed at scale 1, probes-b3/probe_font24_s1.ast). The
// "96 px em / 120 line" numbers were never the intent, only the size
// at which the intent was sampled; no exception needed.
//
// 返回码：0 通过；1 没有命令；2 “A”尺寸不对；3 “中文”宽度不对；
// 4 “A中”宽度不对；5 “中文界面”宽度不对；6 汉字没有墨迹；
// 7 汉字右半没有墨迹（3 字节行被截断）；8 行高不对。

include "../aui.ast";

extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_rt_set_font_path(path: ptr) -> i32;

let g_buf: i32[921600] = 0;
let g_latin: ptr = 0; // W4: .auf removed (no font files in repo; runtime adapter, see font_runtime.ast)
let g_cjk: ptr = 0; // W4: .auf removed (no font files in repo; runtime adapter, see font_runtime.ast)

fn build(user: ptr) -> i32 {
    aui_root();
    aui_column(1);
    aui_pad(10);
    aui_gap(6);
    aui_label(2, "A");
    aui_label(3, "A中");
    aui_label(4, "中文");
    aui_label(5, "中文界面");
    aui_label(6, "中");
    aui_end();
    return 0;
}

fn ink_count(x: i32, y: i32, w: i32, h: i32) -> i32 {
    let n: i32 = 0;
    let j: i32 = 0;
    while (j < h) {
        let i: i32 = 0;
        while (i < w) {
            let off: i32 = ((y + j) * 720 + x + i) * 4;
            let r: i32 = load_u8(g_buf + off);
            let g: i32 = load_u8(g_buf + off + 1);
            let b: i32 = load_u8(g_buf + off + 2);
            if (r + g + b < 384) { n = n + 1; }
            i = i + 1;
        }
        j = j + 1;
    }
    return n;
}

fn main() -> i32 {
    // W7 re-baseline: load the VM TrueType face first (same hook as the
    // 16 re-baselined harnesses). All values below are TrueType metrics
    // at scale 1 (48 px em, 60 px line), probe-verified 2026-11-15:
    // A advance 29 (hmtx 605/1000 em), CJK full em 48; label y = 24
    // (SafeArea guess at 160 dpi) + 10 pad, rows pitch 66.
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    aui_headless_init(build, 0);
    aui_set_font(g_latin, 1);
    aui_set_fallback_font(g_cjk, 1);
    let n0: i32 = aui_headless_render(720, 1280, g_buf);
    if (n0 <= 0) { return 1; }

    // W7 re-baseline: A is 29 px (was 20..40 for the 24 px .auf at 2x);
    // line height is 60 (was 120 at scale 2), both TrueType at scale 1.
    let a: i32[4] = 0;
    if (aui_debug_rect(2, a) != 0) { return 2; }
    if (a[2] != 29) { return 2; }
    if (a[3] != 60) { return 8; }

    let r: i32[4] = 0;
    if (aui_debug_rect(4, r) != 0) { return 3; }
    if (r[2] != 96) { return 3; }            // W7: 2 × 48 px
    if (r[3] != 60) { return 8; }

    let m: i32[4] = 0;
    if (aui_debug_rect(3, m) != 0) { return 4; }
    if (m[2] != a[2] + 48) { return 4; }      // W7: A 的比例步进 + 中 48

    let q: i32[4] = 0;
    if (aui_debug_rect(5, q) != 0) { return 5; }
    if (q[2] != 192) { return 5; }            // W7: 4 × 48 px
    if (ink_count(q[0] + 1, q[1] + 2, 94, 26) < 120) { return 6; }

    // 单个“中”：48 px 字形，右半（x+24..x+48）也有笔画。
    // W7 re-baseline: the old 96 px glyph's right half was x+48..x+96;
    // the TrueType glyph is 48 px wide, so the true right half is
    // x+24..x+48 (probe: 240 ink px there; left 24 px strip: 239).
    let z: i32[4] = 0;
    if (aui_debug_rect(6, z) != 0) { return 7; }
    if (ink_count(z[0], z[1], 24, 60) < 20) { return 7; }
    if (ink_count(z[0] + 24, z[1], 24, 60) < 100) { return 7; }
    return 0;
}
