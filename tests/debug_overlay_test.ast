// debug_overlay_test.ast — v2.8 DEBUG overlay 离屏自检（qemu-user）。
//
// 校验（对照 HuxerUI AppOptions.show_debug_overlay / DebugOverlayInstaller
// / DebugRibbon / DebugPanel，机制逐项照搬，见 REPORT-v28.md）：
// A. headless 默认关：aui_debug_overlay_on() == 0，帧里没有缎带红
//    （#9B2634），不污染任何 harness 基线。
// B. 开关 API 开：aui_debug_overlay(1) 返回 1；缎带几何 cx=330 cy=30
//    w=104 h=16（360×480 @160dpi：中心 (W-30, 30)）；帧里缎带红 > 100 px。
// C. 点缎带展开面板：DOWN+UP 在缎带中心，expanded=1；面板几何
//    x=56 y=256 w=288 h=208（右下角 16 dp 边距）；面板区内暗像素 > 20000。
// D. 再点缎带收起：expanded=0，面板几何 -1；缎带红仍在。
// E. 点按穿透：缎带/面板之外的点按落到底层按钮（clicks=1）；点空白处
//    不改变 overlay 状态。
// F. 忽略 SafeArea：缎带中心 cy=30（不是 30 + safe_top），面板 y=256
//   （不是 H-16-208-safe_bottom）；safe_top 本身为 24 dp，说明几何
//    用的是窗口尺寸不是内容区。
// G. 旋转原语像素：缎带（op 9 旋转矩形）红像素 + DEBUG 文字（op 10
//    旋转定尺寸文本）+ 面板文字，全部由两行冻结哈希钉住。
// H. 开关 API 关/开：aui_debug_overlay(0) 后 on=0、expanded=0、帧里无
//    缎带红；再开回来 on=1、缎带红恢复。
// 帧哈希：缎带帧（开、收起）与面板帧（开、展开）各冻一行进
// tests/baseline/debug_overlay.pixels（canvas.pixels 同款）。
// 返回码：0 通过；1 渲染；2 版本号；3 状态指针；4 A 默认没关；
// 5 B 开关返回值；6 B 缎带几何；7 B 缎带红像素；8 C 没展开；
// 9 C 面板几何；10 C 面板暗像素；11 D 没收起；12 E 穿透点按；
// 13 F SafeArea；14 G 哈希不一致；15 H 开关；90 字体加载失败。
include "../src/aui.ast";
include "../src/aster_std.ast";

extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;

let g_buf: u8[691200] = 0;   // 360x480 RGBA
let g_font: ptr = 0;

struct T {
    clicks: i32
}

let g_t: T = T { 0 };

fn on_tap(user: ptr) -> i32 {
    let t: ptr<T> = user;
    t.clicks = t.clicks + 1;
    aui_invalidate();
    return 0;
}

fn build(user: ptr) -> i32 {
    let t: ptr<T> = user;
    aui_root();
    aui_column(1);
    aui_weight(1);
    aui_pad(8);
    aui_gap(8);
    aui_button(10, "Target", on_tap, user);
    aui_label(11, "Debug overlay test");
    aui_end();
    return 0;
}

fn off(x: i32, y: i32) -> i32 {
    return (y * 360 + x) * 4;
}

fn chan(x: i32, y: i32, c: i32) -> i32 {
    return i32(load_u8(g_buf + off(x, y) + c));
}

// 全帧中 (r,g,b) == (rr,gg,bb) 的像素数。
fn count_rgb(rr: i32, gg: i32, bb: i32) -> i32 {
    let n: i32 = 0;
    let y: i32 = 0;
    while (y < 480) {
        let x: i32 = 0;
        while (x < 360) {
            if (chan(x, y, 0) == rr && chan(x, y, 1) == gg && chan(x, y, 2) == bb) {
                n = n + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return n;
}

// 矩形内亮度 < lim 的像素数（面板底 #11161F 97% 混白底后亮度约 25）。
fn count_dark(x0: i32, y0: i32, x1: i32, y1: i32, lim: i32) -> i32 {
    let n: i32 = 0;
    let y: i32 = y0;
    while (y < y1) {
        let x: i32 = x0;
        while (x < x1) {
            let l: i32 = (chan(x, y, 0) * 3 + chan(x, y, 1) * 6 + chan(x, y, 2)) / 10;
            if (l < lim) { n = n + 1; }
            x = x + 1;
        }
        y = y + 1;
    }
    return n;
}

// FNV-1a 64-bit over n bytes (same constants as canvas_test.ast).
fn fnv_bytes(buf: ptr, n: i32) -> i64 {
    let h: i64 = -3750763034362895579;
    let i: i32 = 0;
    while (i < n) {
        let b: i32 = load_u8(buf + i);
        h = (h ^ b) * 1099511628211;
        i = i + 1;
    }
    return h;
}

fn out_i64(v: i64) -> i32 {
    let buf: u8[32] = 0;
    let n: i32 = fmt_i64(buf, v);
    return write_all(1, buf, n);
}

fn out_line_hash(name: ptr, h: i64) -> i32 {
    let s1: i32 = write_all(1, "DEBUGOVERLAYHASH ", 17);
    let n: i32 = strlen(name);
    let s2: i32 = write_all(1, name, n);
    let s3: i32 = write_all(1, " ", 1);
    let s4: i32 = out_i64(h);
    let s5: i32 = write_all(1, "\n", 1);
    return 0;
}

fn render_at(t: i64) -> i32 {
    fake_set_clock(t);
    return aui_headless_render(360, 480, g_buf);
}

fn down(x: i32, y: i32) -> i32 {
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn up(x: i32, y: i32) -> i32 {
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn main() -> i32 {
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    if (font_ok != 1) { return 90; }
    aui_set_font(g_font, 1);
    aui_debug_set_density(160);
    aui_headless_init(build, &g_t);
    let base: i64 = 2000000000;
    if (render_at(base) == 0) { return 1; }
    if (aui_version() != 14806) { return 2; }

    let st: i32[12] = 0;

    // ---- A. headless 默认关 ----
    if (aui_debug_overlay_on() != 0) { return 4; }
    if (count_rgb(155, 38, 52) != 0) { return 4; }

    // ---- B. 开关 API 开 + 缎带几何 + 缎带红 ----
    if (aui_debug_overlay(1) != 1) { return 5; }
    if (aui_debug_overlay_on() != 1) { return 5; }
    if (render_at(base + 100000000) == 0) { return 1; }
    let r0: i32 = aui_debug_overlay_state(st);
    if (st[0] != 1 || st[1] != 0) { return 3; }
    if (st[2] != 330 || st[3] != 30 || st[4] != 104 || st[5] != 16) { return 6; }
    if (st[6] != -1 || st[7] != -1 || st[8] != -1 || st[9] != -1) { return 6; }
    if (count_rgb(155, 38, 52) < 100) { return 7; }
    let h_ribbon: i64 = fnv_bytes(g_buf, 360 * 480 * 4);
    let l0: i32 = out_line_hash("ribbon", h_ribbon);

    // ---- C. 点缎带展开面板 ----
    let t1: i64 = base + 2000000000;
    fake_set_clock(t1);
    down(330, 30);
    up(330, 30);
    if (render_at(t1 + 100000000) == 0) { return 1; }
    let r1: i32 = aui_debug_overlay_state(st);
    if (st[1] != 1) { return 8; }
    if (st[6] != 56 || st[7] != 256 || st[8] != 288 || st[9] != 208) { return 9; }
    if (count_dark(56, 256, 344, 464, 40) < 20000) { return 10; }
    let h_panel: i64 = fnv_bytes(g_buf, 360 * 480 * 4);
    let l1: i32 = out_line_hash("panel", h_panel);

    // ---- D. 再点缎带收起 ----
    let t2: i64 = base + 4000000000;
    fake_set_clock(t2);
    down(330, 30);
    up(330, 30);
    if (render_at(t2 + 100000000) == 0) { return 1; }
    let r2: i32 = aui_debug_overlay_state(st);
    if (st[1] != 0) { return 11; }
    if (st[6] != -1) { return 11; }
    if (count_rgb(155, 38, 52) < 100) { return 7; }

    // ---- E. 点按穿透：按钮仍能点到，空白处不改 overlay ----
    let r10: i32[4] = 0;
    if (aui_debug_rect(10, r10) != 0) { return 12; }
    let bx: i32 = r10[0] + r10[2] / 2;
    let by: i32 = r10[1] + r10[3] / 2;
    let t3: i64 = base + 6000000000;
    fake_set_clock(t3);
    down(bx, by);
    up(bx, by);
    if (g_t.clicks != 1) { return 12; }
    let t4: i64 = base + 8000000000;
    fake_set_clock(t4);
    down(100, 400);
    up(100, 400);
    let r3: i32 = aui_debug_overlay_state(st);
    if (st[0] != 1 || st[1] != 0) { return 12; }

    // ---- F. 忽略 SafeArea：缎带/面板几何用窗口尺寸，不含内容区 inset ----
    if (aui_safe_top() != 24) { return 13; }
    if (st[2] != 330 || st[3] != 30) { return 13; }
    // 面板 y 是窗口高 - 16 - 208，不是内容区高 - 16 - 208。

    // ---- G. 旋转原语像素：两行冻结哈希钉住（缎带 op 9/10 + 面板文字）----
    let iv: i32 = aui_invalidate();
    if (render_at(t4 + 100000000) == 0) { return 1; }
    let h_ribbon2: i64 = fnv_bytes(g_buf, 360 * 480 * 4);
    let l2: i32 = out_line_hash("ribbon2", h_ribbon2);
    if (h_ribbon != h_ribbon2) { return 14; }

    // ---- H. 开关 API 关/开 ----
    if (aui_debug_overlay(0) != 0) { return 15; }
    if (aui_debug_overlay_on() != 0) { return 15; }
    if (render_at(base + 10000000000) == 0) { return 1; }
    let r4: i32 = aui_debug_overlay_state(st);
    if (st[0] != 0 || st[1] != 0) { return 15; }
    if (count_rgb(155, 38, 52) != 0) { return 15; }
    if (aui_debug_overlay(1) != 1) { return 15; }
    if (render_at(base + 11000000000) == 0) { return 1; }
    if (count_rgb(155, 38, 52) < 100) { return 15; }

    let e: i32 = eputs("PASS: debug_overlay\n");
    return 0;
}
