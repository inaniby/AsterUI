// insets_test.ast — v2.14 系统栏高度走 JNI（WindowInsets）离屏自检。
//
// headless 没有 JVM：测试在内存里搭一个假 JNIEnv 表（与 sysbar_test
// 同一做法），假 Window / DecorView / WindowInsets / Insets 对象。
// 校验：
// G.  初始状态：无内容区、无 JNI 时来源是估算（src=3），safe_top/bottom
//     均为 24dp（密度 520 时 78px）；实测值未测到（-1）。
// A.  sdk 35 + 注入假 env：量到 top=78 bottom=78，px/dp 均为
//     [78,78,24,24]；内容区是整窗时来源变 JNI（src=2），safe_top/bottom
//     仍为 24；GetMethodID 顺序 getWindow、getDecorView、
//     getRootWindowInsets、getInsets，GetStaticMethodID 顺序 statusBars、
//     navigationBars，getInsets 先后收到 type 1、2；成功一次删 11 个
//     局部引用。
// B.  getRootWindowInsets 返回空：量取失败（0），缓存不变（仍是 78/78），
//     来源仍是 JNI；恢复后下一次量取即自愈。
// C.  注入异常：ExceptionCheck 报 1 后框架调 ExceptionClear 清掉
//     并回落（0），缓存不变；异常清掉后下一次量取即自愈。
// D.  env 缺失：回落，不崩；恢复 env 后下一次量取即自愈。
// E.  SDK 29 以下：走 getSystemWindowInsetTop/Bottom 旧路（top=100
//     bottom=50，dp 30/15），不调 getInsets/FindClass；sdk 回 35 后
//     恢复新路。
// F.  内容区优先：有效非整窗内容区压过 JNI（src=1，safe 按内容区）；
//     内容区改回整窗后来源回 JNI（src=2）；内容区清空后仍是 JNI。
// H.  不对称栏高：top=120 bottom=40 时量到新值，safe_top/bottom 跟着变。
// 无像素冻结基线：校验的是栏高值/来源/回落状态，断言本身就是检查。
// 返回码：0 通过；2 版本号；10-19 G；20-39 A；40-49 B；50-59 C；
// 60-69 D；70-79 E；80-89 F；90-99 H。
include "../src/aui.ast";
include "../src/aster_std.ast";

extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_safe_top() -> i32;
extern fn aui_safe_bottom() -> i32;
extern fn aui_debug_set_sdk(v: i32) -> i32;
extern fn aui_debug_set_density(dpi: i32) -> i32;
extern fn aui_debug_set_content(l: i32, t: i32, r: i32, b: i32) -> i32;
extern fn aui_debug_set_jni_env(env: ptr) -> i32;
extern fn aui_debug_set_jni_act(act: ptr) -> i32;
extern fn aui_debug_measure_insets() -> i32;
extern fn aui_debug_insets_source() -> i32;
extern fn aui_debug_insets_px(out: ptr) -> i32;
extern fn aui_headless_init(build: fn(ptr) -> i32, user: ptr) -> i32;
extern fn aui_headless_render(w: i32, h: i32, out: ptr) -> i32;
extern fn aui_version() -> i32;

// ---- 假 JNI 表 + 假对象 + 记录桩 ----
// 表下标与框架一致（JNI 规范的 Interface Function Table：FindClass 6、
// CallIntMethodA 51、GetFieldID 94、GetIntField 100、
// GetStaticMethodID 113、CallStaticIntMethodA 131；v2.13 已有的
// ExceptionClear 17、DeleteLocalRef 23、GetObjectClass 31、
// GetMethodID 33、CallObjectMethodA 36、ExceptionCheck 228）。
let in_tbl: u8[2048] = 0;
let in_env: u8[8] = 0;
let in_act: u8[8] = 0;
let in_win: u8[8] = 0;
let in_view: u8[8] = 0;
let in_wi: u8[8] = 0;
let in_ins_st: u8[8] = 0;
let in_ins_nav: u8[8] = 0;
let in_cls: u8[8] = 0;
let in_tcls: u8[8] = 0;
let in_mid_getwin: u8[8] = 0;
let in_mid_getdecor: u8[8] = 0;
let in_mid_getroot: u8[8] = 0;
let in_mid_getinsets: u8[8] = 0;
let in_mid_gettop: u8[8] = 0;
let in_mid_getbot: u8[8] = 0;
let in_smid_status: u8[8] = 0;
let in_smid_nav: u8[8] = 0;
let in_fid_top: u8[8] = 0;
let in_fid_bot: u8[8] = 0;
let in_mock_top: i32 = 0;
let in_mock_bot: i32 = 0;
let in_null_wi: i32 = 0;
let in_exc_on: i32 = 0;
let in_getmid_names: u8[16] = 0;
let in_getmid_n: i32 = 0;
let in_gsmid_names: u8[8] = 0;
let in_gsmid_n: i32 = 0;
let in_delref_n: i32 = 0;
let in_clear_calls: i32 = 0;
let in_getinsets_n: i32 = 0;
let in_type_first: i32 = -1;
let in_type_second: i32 = -1;
let in_callint_top_n: i32 = 0;
let in_callint_bot_n: i32 = 0;
let in_find_n: i32 = 0;
let in_getint_n: i32 = 0;

let g_buf: i32[921600] = 0;   // 720x1280 RGBA

fn in_getclass(env: ptr, obj: ptr) -> ptr { return in_cls; }

fn in_find(env: ptr, name: ptr) -> ptr {
    in_find_n = in_find_n + 1;
    return in_tcls;
}

fn in_getmid(env: ptr, cls: ptr, name: ptr, sig: ptr) -> ptr {
    if (in_getmid_n < 16) {
        store_u8(in_getmid_names + in_getmid_n, load_u8(name + 3));
        in_getmid_n = in_getmid_n + 1;
    }
    let c3: i32 = load_u8(name + 3);
    if (c3 == 87) { return in_mid_getwin; }    // 'W' getWindow
    if (c3 == 68) { return in_mid_getdecor; }  // 'D' getDecorView
    if (c3 == 82) { return in_mid_getroot; }   // 'R' getRootWindowInsets
    if (c3 == 73) { return in_mid_getinsets; } // 'I' getInsets
    if (c3 == 83) {                            // 'S' getSystemWindowInset*
        if (load_u8(name + 20) == 84) { return in_mid_gettop; }  // 'T'
        return in_mid_getbot;
    }
    return 0;
}

fn in_getstaticmid(env: ptr, cls: ptr, name: ptr, sig: ptr) -> ptr {
    if (in_gsmid_n < 8) {
        store_u8(in_gsmid_names + in_gsmid_n, load_u8(name));
        in_gsmid_n = in_gsmid_n + 1;
    }
    if (load_u8(name) == 115) { return in_smid_status; }  // 's' statusBars
    return in_smid_nav;                                    // 'n' navigationBars
}

fn in_callobj(env: ptr, obj: ptr, mid: ptr, args: ptr) -> ptr {
    if (mid == in_mid_getwin) { return in_win; }
    if (mid == in_mid_getdecor) { return in_view; }
    if (mid == in_mid_getroot) {
        if (in_null_wi != 0) { return 0; }
        return in_wi;
    }
    if (mid == in_mid_getinsets) {
        if (in_getinsets_n == 0) {
            in_type_first = i32(load_i64(args));
            in_getinsets_n = 1;
            return in_ins_st;
        }
        in_type_second = i32(load_i64(args));
        in_getinsets_n = 2;
        return in_ins_nav;
    }
    return 0;
}

fn in_callint(env: ptr, obj: ptr, mid: ptr, args: ptr) -> i32 {
    if (mid == in_mid_gettop) {
        in_callint_top_n = in_callint_top_n + 1;
        return in_mock_top;
    }
    in_callint_bot_n = in_callint_bot_n + 1;
    return in_mock_bot;
}

fn in_callstaticint(env: ptr, cls: ptr, mid: ptr, args: ptr) -> i32 {
    if (mid == in_smid_status) { return 1; }
    return 2;
}

fn in_getfield(env: ptr, cls: ptr, name: ptr, sig: ptr) -> ptr {
    if (load_u8(name) == 116) { return in_fid_top; }  // 't' top
    return in_fid_bot;                                  // 'b' bottom
}

fn in_getint(env: ptr, obj: ptr, fid: ptr) -> i32 {
    in_getint_n = in_getint_n + 1;
    if (fid == in_fid_top) { return in_mock_top; }
    return in_mock_bot;
}

fn in_exc(env: ptr) -> i32 {
    if (in_exc_on != 0) { return 1; }
    return 0;
}

fn in_clear(env: ptr) -> i32 {
    in_clear_calls = in_clear_calls + 1;
    in_exc_on = 0;
    return 0;
}

fn in_delref(env: ptr, obj: ptr) -> i32 {
    in_delref_n = in_delref_n + 1;
    return 0;
}

fn build(user: ptr) -> i32 {
    aui_root();
    aui_column(1);
    aui_label(10, "Insets");
    aui_end();
    return 0;
}

fn main() -> i32 {
    if (aui_version() != 14806) { return 2; }
    *(in_tbl + 6 * 8) = in_find;
    *(in_tbl + 17 * 8) = in_clear;
    *(in_tbl + 23 * 8) = in_delref;
    *(in_tbl + 31 * 8) = in_getclass;
    *(in_tbl + 33 * 8) = in_getmid;
    *(in_tbl + 36 * 8) = in_callobj;
    *(in_tbl + 51 * 8) = in_callint;
    *(in_tbl + 94 * 8) = in_getfield;
    *(in_tbl + 100 * 8) = in_getint;
    *(in_tbl + 113 * 8) = in_getstaticmid;
    *(in_tbl + 131 * 8) = in_callstaticint;
    *(in_tbl + 228 * 8) = in_exc;
    *(in_env) = in_tbl;
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    aui_headless_init(build, 0);
    let sd: i32 = aui_debug_set_density(520);
    let s0: i32 = aui_debug_set_sdk(35);

    // ---- G. 初始：无内容区、无 JNI → 估算 ----
    let n0: i32 = aui_headless_render(720, 1280, g_buf);
    if (aui_debug_insets_source() != 3) { return 10; }
    if (aui_safe_top() != 24) { return 11; }
    if (aui_safe_bottom() != 24) { return 12; }
    let px0: i32[4] = 0;
    let ok0: i32 = aui_debug_insets_px(px0);
    if (ok0 != 0) { return 13; }
    if (px0[0] != -1 || px0[1] != -1 || px0[2] != -1 || px0[3] != -1) { return 14; }

    // ---- A. sdk 35 + 假 env：量到 78/78 ----
    in_mock_top = 78;
    in_mock_bot = 78;
    let e0: i32 = aui_debug_set_jni_env(in_env);
    let a0: i32 = aui_debug_set_jni_act(in_act);
    let m1: i32 = aui_debug_measure_insets();
    if (m1 != 1) { return 20; }
    let px1: i32[4] = 0;
    let ok1: i32 = aui_debug_insets_px(px1);
    if (ok1 != 1) { return 21; }
    if (px1[0] != 78 || px1[1] != 78 || px1[2] != 24 || px1[3] != 24) { return 22; }
    // GetMethodID 顺序：getWindow、getDecorView、getRootWindowInsets、getInsets。
    if (in_getmid_n != 4) { return 23; }
    if (load_u8(in_getmid_names + 0) != 87) { return 24; }
    if (load_u8(in_getmid_names + 1) != 68) { return 24; }
    if (load_u8(in_getmid_names + 2) != 82) { return 24; }
    if (load_u8(in_getmid_names + 3) != 73) { return 24; }
    // GetStaticMethodID 顺序：statusBars、navigationBars。
    if (in_gsmid_n != 2) { return 25; }
    if (load_u8(in_gsmid_names + 0) != 115) { return 26; }
    if (load_u8(in_gsmid_names + 1) != 110) { return 26; }
    // getInsets 先后收到 type 1、2。
    if (in_type_first != 1 || in_type_second != 2) { return 27; }
    // 局部引用：成功一次删 11 个。
    if (in_delref_n != 11) { return 28; }
    // 内容区是整窗（未设）→ 来源 JNI，safe 仍为 24。
    let n1: i32 = aui_headless_render(720, 1280, g_buf);
    if (aui_debug_insets_source() != 2) { return 29; }
    if (aui_safe_top() != 24) { return 30; }
    if (aui_safe_bottom() != 24) { return 31; }

    // ---- B. 空 WindowInsets 回落，缓存不变 ----
    in_null_wi = 1;
    let dr0: i32 = in_delref_n;
    let m2: i32 = aui_debug_measure_insets();
    if (m2 != 0) { return 40; }
    if (in_delref_n != dr0 + 5) { return 41; }
    let px2: i32[4] = 0;
    let ok2: i32 = aui_debug_insets_px(px2);
    if (ok2 != 1) { return 42; }
    if (px2[0] != 78 || px2[1] != 78) { return 43; }
    let n2: i32 = aui_headless_render(720, 1280, g_buf);
    if (aui_debug_insets_source() != 2) { return 44; }
    in_null_wi = 0;
    let m3: i32 = aui_debug_measure_insets();
    if (m3 != 1) { return 45; }

    // ---- C. 注入异常回落 + 自愈，缓存不变 ----
    in_exc_on = 1;
    let cc0: i32 = in_clear_calls;
    let m4: i32 = aui_debug_measure_insets();
    if (m4 != 0) { return 50; }
    if (in_clear_calls != cc0 + 1) { return 51; }
    let px3: i32[4] = 0;
    let ok3: i32 = aui_debug_insets_px(px3);
    if (ok3 != 1 || px3[0] != 78) { return 52; }
    let m5: i32 = aui_debug_measure_insets();
    if (m5 != 1) { return 53; }

    // ---- D. 无 env 回落 ----
    let e1: i32 = aui_debug_set_jni_env(0);
    let m6: i32 = aui_debug_measure_insets();
    if (m6 != 0) { return 60; }
    let e2: i32 = aui_debug_set_jni_env(in_env);
    let m7: i32 = aui_debug_measure_insets();
    if (m7 != 1) { return 61; }

    // ---- E. SDK 29 以下走旧路 ----
    in_mock_top = 100;
    in_mock_bot = 50;
    let gi0: i32 = in_getinsets_n;
    let fc0: i32 = in_find_n;
    let dr1: i32 = in_delref_n;
    let s1: i32 = aui_debug_set_sdk(29);
    let m8: i32 = aui_debug_measure_insets();
    if (m8 != 1) { return 70; }
    let px4: i32[4] = 0;
    let ok4: i32 = aui_debug_insets_px(px4);
    if (ok4 != 1) { return 71; }
    if (px4[0] != 100 || px4[1] != 50 || px4[2] != 30 || px4[3] != 15) { return 72; }
    if (in_callint_top_n != 1 || in_callint_bot_n != 1) { return 73; }
    if (in_getinsets_n != gi0) { return 74; }
    if (in_find_n != fc0) { return 75; }
    if (in_delref_n != dr1 + 7) { return 76; }
    let s2: i32 = aui_debug_set_sdk(35);
    in_mock_top = 78;
    in_mock_bot = 78;
    let m9: i32 = aui_debug_measure_insets();
    if (m9 != 1) { return 77; }

    // ---- F. 内容区优先 ----
    let c0: i32 = aui_debug_set_content(0, 100, 720, 1230);
    let n3: i32 = aui_headless_render(720, 1280, g_buf);
    if (aui_debug_insets_source() != 1) { return 80; }
    if (aui_safe_top() != 30) { return 81; }
    if (aui_safe_bottom() != 15) { return 82; }
    let c1: i32 = aui_debug_set_content(0, 0, 720, 1280);
    let n4: i32 = aui_headless_render(720, 1280, g_buf);
    if (aui_debug_insets_source() != 2) { return 83; }
    if (aui_safe_top() != 24) { return 84; }
    let c2: i32 = aui_debug_set_content(0, 0, 0, 0);
    let n5: i32 = aui_headless_render(720, 1280, g_buf);
    if (aui_debug_insets_source() != 2) { return 85; }

    // ---- H. 不对称栏高 ----
    in_mock_top = 120;
    in_mock_bot = 40;
    let m10: i32 = aui_debug_measure_insets();
    if (m10 != 1) { return 90; }
    let px5: i32[4] = 0;
    let ok5: i32 = aui_debug_insets_px(px5);
    if (px5[0] != 120 || px5[1] != 40 || px5[2] != 36 || px5[3] != 12) { return 91; }
    let n6: i32 = aui_headless_render(720, 1280, g_buf);
    if (aui_debug_insets_source() != 2) { return 92; }
    if (aui_safe_top() != 36) { return 93; }
    if (aui_safe_bottom() != 12) { return 94; }

    return 0;
}
