// gallery_smoke_test.ast -- W4: headless smoke test for the new Gallery
// app (stdlib/asterui/examples/ui_gallery.ast) on the adopted aui_* base.
//
// Covers every tab by rendering it, plus the device-verified behaviours
// that must survive the base change, through the real input path:
//   A. tabs 0-8 render (nodes > 0) at 160 dpi (Theme tab 9 in M);
//   B. tapping a tab switches it (Overlay tab via its own rect);
//   C. dialog open via "Delete draft", Cancel closes it, drafts stay 2;
//   D. menu open via "Actions", picking an item records its key;
//   E. scroll drag moves the list by exactly the drag distance, and the
//      "Tap after scroll" button counts once afterwards;
//   F. NavStack push/pop through the buttons (route 1 -> 2 -> 1);
//   G. Focus button focuses the text field (key 10).
//   H. Fonts tab (v2.5): renders, switches by tap, loads the Regular
//      weight through the TextField + Load button, restores the
//      system font through the "Use system font" button.
//   H2. Long folder (v2.5.1): the 72-char device folder through the
//      real field (round-trip, Load, Regular weight), and the
//      folder label wraps it so the full path is inspectable.
//      Restores the system font afterwards.
//   I. Canvas tab (v2.6): renders via gallery_set_tab(6) (the 8-tab
//      bar is ~1080 px wide at the headless fallback font, so the
//      Canvas tab itself is off-screen at 960 px; the tab-switch-by-
//      tap path is already covered by B and H), the canvas rect is
//      on-screen, and the effect tabs switch by tap (Taiji/Orbit/Path).
//   J. Tab bar scroll (v2.6.1): drag the bar left and an off-screen tab
//      scrolls on-screen, tap it to switch; drag back and the bar
//      returns, tap Input to switch back. (The device bug: 7 tabs,
//      bar 1492 px vs 1216 px viewport at 520 dpi, Canvas fully
//      off-screen, bar not draggable at all.)
//      (v2.18: the target at max scroll is now Table, not Canvas —
//      see the J section note.)
//   K. VarList tab (v2.10): renders via gallery_set_tab(7); the var
//      list rect has size with 120 items; row 0 has a rect; count-3
//      badge visible, count-0 badge hidden (zero size).
//   L. Split tab (v2.12): renders via gallery_set_tab(8); both splits
//      have size with ratio 500; panes sit on opposite sides of the
//      divider (same height / same width); dragging the horizontal
//      divider right raises the ratio and widens the left pane.
//   M. Theme tab (v2.15): renders via gallery_set_tab(9); the Title
//      specimen is 80 px tall (Title role), the nested teal card and
//      the global sibling card both have rects, and the LARGE shape
//      card has a rect.
//   N. Anim tab (v2.16): renders via gallery_set_tab(10); the spring
//      button, pulse card, scale preview and reduced-motion switch
//      all have rects; tapping the spring button starts a SCALE
//      spring, tapping Start pulse starts a TX keyframe (both read
//      via aui_anim_active, not sampled values — the headless clock
//      is real time, so a value read right after the tap is racy);
//      leaving the tab stops the pulse synchronously (TX back to 0).
//   O. Table tab (v2.17): renders via gallery_set_tab(11); the table
//      rect has size with 10000 rows x 100 cols and the window starts
//      at row 0 / col 0; tapping "Jump R5000 C50" scrolls the window
//      to first_row 4999 / first_col 48 (start-align + 1 overscan);
//      "Top-left" resets it to 0 / 0.
//   P. Pinch tab (v2.18): renders via gallery_set_tab(12); the canvas
//      rect has size and exactly one pinch node is registered on it;
//      a two-finger pinch on the canvas zooms to 1.50x (98304);
//      Reset restores 1.00x (65536).
// Geometry is always read at runtime via aui_debug_rect, never hard-coded.
// ASCII-only. Return codes: 0 pass; 1 no draw; 2 version; 3 no nodes;
// 10+t tab t did not render; 11 dialog did not open; 12 Cancel failed;
// 13 menu item missing; 14 menu pick not recorded; 15 drag did not
// scroll; 16 scroll tap did not count; 17 push failed; 18 pop failed;
// 19 focus failed; 20 tab tap did not switch; 21 Fonts tab did not
// render; 22 Fonts tab tap did not switch; 23 Fonts specimen/field
// missing; 24 custom font load failed or wrong weight; 25 restore
// failed; 26 long-folder load failed; 27 folder label did not wrap;
// 28 restore after long-folder load failed; 29 Canvas tab did not
// render; 30 Canvas rect missing or off-screen; 31 effect tab did
// not switch; 32 Canvas rect has no size; 33 tab-bar drag did not
// scroll; 34 target tab not on-screen after scroll; 35 tap on
// scrolled Canvas tab did not switch; 36 drag back did not reset
// scroll; 37 tap Input after scroll-back did not switch; 38 VarList
// tab did not render; 39 var-list rect missing or no size;
// 40 var-list count != 120; 41 row 0 rect missing or no size;
// 42 count-3 badge not visible; 43 count-0 badge not hidden;
// 44 Badge row rect missing; 45 Badge row overlaps list/row 0;
// 46 scroll-to-80 failed or rects missing; 47 Badge row overlaps
// after scroll; 48 Split tab did not render; 49 H split rect missing
// or no size; 50 H split ratio != 500 or not horizontal; 51 H panes
// missing or on the wrong side of the divider; 52 H panes differ in
// height; 53 V split rect missing or no size; 54 V split ratio != 500
// or not vertical; 55 V panes missing or on the wrong side of the
// divider; 56 V panes differ in width; 57 drag did not change the
// ratio; 58 left pane not wider after drag; 60 Theme tab did not
// render; 61 Title specimen not 80 px; 62 nested/sibling card rect
// missing or no size; 63 LARGE shape card rect missing or no size;
// 64 Anim tab did not render; 65 spring button / pulse card rect
// missing or no size; 66 scale preview / switch rect missing or no
// size; 67 spring tap did not start the animation; 68 pulse Start
// did not start the animation; 69 leaving the tab did not stop
// the pulse; 70 Table tab did not render; 71 table rect missing
// or no size, rows/cols wrong, or window not at 0/0; 72 Jump
// did not scroll the window to R5000 C50; 73 Top-left did not
// reset the window to 0/0.

include "../src/aui.ast";

extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_scroll(key: i32) -> i32;
extern fn aui_debug_scroll_max(key: i32) -> i32;
extern fn aui_debug_node_count() -> i32;
extern fn aui_debug_set_density(dpi: i32) -> i32;
extern fn aui_debug_menu_item(key: i32, out: ptr) -> i32;
extern fn aui_debug_split(key: i32, out: ptr) -> i32;
extern fn aui_debug_split_pane(key: i32, index: i32, out: ptr) -> i32;
extern fn aui_debug_vtable(key: i32, out: ptr) -> i32;
extern fn aui_split_ratio(key: i32) -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_post_motion2(action: i32, x0: i32, y0: i32, x1: i32, y1: i32) -> i32;
extern fn gallery_headless_init() -> i32;
extern fn gallery_set_tab(t: i32) -> i32;
extern fn gallery_tab() -> i32;
extern fn gallery_pn_zoom() -> i32;
extern fn gallery_sem_len() -> i32;
extern fn gallery_drafts() -> i32;
extern fn gallery_menu_item() -> i32;
extern fn gallery_dialog_last() -> i32;
extern fn gallery_scroll_taps() -> i32;
extern fn gallery_font_active() -> i32;
extern fn gallery_font_weight() -> i32;
extern fn cv_tab() -> i32;

// Rendered 960x1024: the 6-tab bar is 912px wide at the headless fallback
// font's 24px/char advance (Fonts tab starts x=768), so 720px clipped it
// entirely off-screen (section H tapped (0,0) and never switched). 960px
// fits the bar with margin and is still narrower than the device (1216px);
// on the device the proportional system font makes the bar ~77% of width.
// Height is 1024, not 1280: one array is capped at 1048576 elements
// (960x1280 = 1228800), and 1024 still leaves the Overlay tab's buttons
// above the fold (640 px height would leave "Delete draft" below it).
let g_buf: i32[983040] = 0;   // 960x1024 RGBA, one i32 per pixel
let g_sem: u8[16384] = 0;      // v2.19: semantic export scratch (Q section)
let g_anchor: ptr = g_buf;

fn render() -> i32 {
    return aui_headless_render(960, 1024, g_buf);
}

fn tap(x: i32, y: i32) -> i32 {
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn tap_key(key: i32) -> i32 {
    let r: i32[4] = 0;
    if (aui_debug_rect(key, r) != 0) { return -1; }
    let t: i32 = tap(r[0] + r[2] / 2, r[1] + r[3] / 2);
    return 0;
}

fn down(x: i32, y: i32) -> i32 {
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn move_to(x: i32, y: i32) -> i32 {
    fake_post_motion(2, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn up(x: i32, y: i32) -> i32 {
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

// v2.18: two-finger helpers (261 POINTER_DOWN finger 1, 262 POINTER_UP).
fn down2(x0: i32, y0: i32, x1: i32, y1: i32) -> i32 {
    fake_post_motion(0, x0, y0);
    aui_on_input(1, 0, 0);
    fake_post_motion2(261, x0, y0, x1, y1);
    aui_on_input(1, 0, 0);
    return 0;
}

fn move2(x0: i32, y0: i32, x1: i32, y1: i32) -> i32 {
    fake_post_motion2(2, x0, y0, x1, y1);
    aui_on_input(1, 0, 0);
    return 0;
}

fn up2(x0: i32, y0: i32, x1: i32, y1: i32) -> i32 {
    fake_post_motion2(262, x0, y0, x1, y1);
    aui_on_input(1, 0, 0);
    fake_post_motion(1, x0, y0);
    aui_on_input(1, 0, 0);
    return 0;
}

// v2.19: substring search (Q section export content checks).
fn contains(hay: ptr, needle: ptr) -> i32 {
    let hn: i32 = 0;
    while (load_u8(hay + hn) != 0) { hn = hn + 1; }
    let nn: i32 = 0;
    while (load_u8(needle + nn) != 0) { nn = nn + 1; }
    if (nn == 0) { return 1; }
    let i: i32 = 0;
    while (i + nn <= hn) {
        let j: i32 = 0;
        while (j < nn && load_u8(hay + i + j) == load_u8(needle + j)) { j = j + 1; }
        if (j == nn) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn main() -> i32 {
    aui_debug_set_density(160);
    gallery_headless_init();
    // Headless mode never runs app_init (the Android attach callback),
    // so the test must set the font scale itself, exactly as the W3
    // tests do. Without this the default scale 2 doubles every advance
    // and the dialog card measures ~3x too tall (labels wrap to ~4
    // chars/line: 251 h=600, 252 h=1800, buttons pushed to y=2496).
    aui_set_font(0, 1);
    aui_set_fallback_font(0, 1);
    if (render() <= 0) { return 1; }
    if (aui_version() != 14806) { return 2; }
    if (aui_debug_node_count() <= 0) { return 3; }

    // A. every tab renders.
    let t: i32 = 0;
    while (t < 9) {
        let s: i32 = gallery_set_tab(t);
        if (render() <= 0) { return 10 + t; }
        if (aui_debug_node_count() <= 0) { return 10 + t; }
        t = t + 1;
    }

    // B. tapping the Overlay tab switches to it.
    let s0: i32 = gallery_set_tab(0);
    if (render() <= 0) { return 1; }
    if (tap_key(12) != 0) { return 20; }
    if (render() <= 0) { return 1; }
    if (gallery_tab() != 1) { return 20; }

    // C. dialog: open, Cancel, drafts unchanged, reason 3.
    if (tap_key(210) != 0) { return 11; }
    if (render() <= 0) { return 1; }
    let r: i32[4] = 0;
    if (aui_debug_rect(256, r) != 0) { return 11; }
    if (tap_key(256) != 0) { return 12; }
    if (render() <= 0) { return 1; }
    if (gallery_drafts() != 2) { return 12; }
    if (gallery_dialog_last() != 3) { return 12; }
    if (aui_debug_rect(256, r) == 0) { return 12; }

    // D. menu: open, pick first item (key 241).
    if (tap_key(220) != 0) { return 13; }
    if (render() <= 0) { return 1; }
    let mi: i32[8] = 0;
    if (aui_debug_menu_item(241, mi) != 0) { return 13; }
    let t2: i32 = tap(mi[0] + mi[2] / 2, mi[1] + mi[3] / 2);
    if (render() <= 0) { return 1; }
    if (gallery_menu_item() != 241) { return 14; }

    // E. scroll drag + tap after scroll.
    let s2: i32 = gallery_set_tab(2);
    if (render() <= 0) { return 1; }
    if (aui_debug_rect(1322, r) != 0) { return 15; }
    let cx: i32 = r[0] + r[2] / 2;
    let cy: i32 = r[1] + r[3] / 2;
    let d: i32 = down(cx, cy);
    let m: i32 = move_to(cx, cy - 120);
    let u: i32 = up(cx, cy - 120);
    if (render() <= 0) { return 1; }
    if (aui_debug_scroll(1310) != 120) { return 15; }
    if (tap_key(1390) != 0) { return 16; }
    if (render() <= 0) { return 1; }
    if (gallery_scroll_taps() != 1) { return 16; }

    // F. nav push/pop.
    let s3: i32 = gallery_set_tab(3);
    if (render() <= 0) { return 1; }
    if (tap_key(403) != 0) { return 17; }
    if (render() <= 0) { return 1; }
    if (aui_route() != 2) { return 17; }
    if (tap_key(420) != 0) { return 18; }
    if (render() <= 0) { return 1; }
    if (aui_route() != 1) { return 18; }

    // G. focus the text field.
    let s4: i32 = gallery_set_tab(0);
    if (render() <= 0) { return 1; }
    if (tap_key(116) != 0) { return 19; }
    if (render() <= 0) { return 1; }
    if (aui_focus_get() != 110) { return 19; }

    // H. Fonts tab: renders, switches by tap, loads a custom font
    // through the TextField + Load button, restores the system font.
    let s5: i32 = gallery_set_tab(0);
    if (render() <= 0) { return 1; }
    if (tap_key(16) != 0) { return 22; }
    if (render() <= 0) { return 1; }
    if (gallery_tab() != 5) { return 22; }
    let rf: i32[4] = 0;
    if (aui_debug_rect(681, rf) != 0) { return 23; }
    if (aui_debug_rect(610, rf) != 0) { return 23; }
    // Prefill the folder headlessly (the device prefills it from
    // the ext dir) and tap Load: the Regular weight must load.
    let ts: i32 = aui_text_set(610, "/tmp/aui-hyzy-test", 18);
    if (render() <= 0) { return 1; }
    if (tap_key(611) != 0) { return 24; }
    if (render() <= 0) { return 1; }
    if (gallery_font_active() != 1) { return 24; }
    if (gallery_font_weight() != 400) { return 24; }
    // Specimen still renders in the custom face.
    if (aui_debug_rect(681, rf) != 0) { return 24; }
    // "Use system font" restores the pre-custom face.
    if (tap_key(640) != 0) { return 25; }
    if (render() <= 0) { return 1; }
    if (gallery_font_active() != 0) { return 25; }

    // H2. Long folder (v2.5.1): the device folder is 72 chars;
    // the v2.5 pool held 63, so the prefill truncated to
    // ".../gallery/fi" and Load always failed err=1 with the
    // files in place. Set the 72-char folder through the real
    // field, check the round-trip, Load, and check the folder
    // label wraps it (label 603 taller than the single-line
    // label 601) so the full path is inspectable on screen.
    let lf: i32 = aui_text_set(610, "/tmp/aui-hyzy-test/long-folder-name-for-path-capacity-test-0123456789abc", 72);
    if (render() <= 0) { return 1; }
    if (aui_text_len(610) != 72) { return 26; }
    if (tap_key(611) != 0) { return 26; }
    if (render() <= 0) { return 1; }
    if (gallery_font_active() != 1) { return 26; }
    if (gallery_font_weight() != 400) { return 26; }
    let r601: i32[4] = 0;
    let r603: i32[4] = 0;
    if (aui_debug_rect(601, r601) != 0) { return 27; }
    if (aui_debug_rect(603, r603) != 0) { return 27; }
    if (r603[3] <= r601[3]) { return 27; }
    if (tap_key(640) != 0) { return 28; }
    if (render() <= 0) { return 1; }
    if (gallery_font_active() != 0) { return 28; }

    // I. Canvas tab (v2.6): renders, canvas on-screen, effect tabs
    // switch by tap. The Gallery tab itself is reached via
    // gallery_set_tab (see the header note on the 1080 px bar).
    let s6: i32 = gallery_set_tab(6);
    if (render() <= 0) { return 29; }
    if (aui_debug_node_count() <= 0) { return 29; }
    let cr: i32[4] = 0;
    if (aui_debug_rect(730, cr) != 0) { return 30; }
    if (cr[2] <= 0 || cr[3] <= 0) { return 32; }
    if (cr[0] < 0 || cr[1] < 0 || cr[0] + cr[2] > 960 || cr[1] + cr[3] > 1024) { return 30; }
    if (cv_tab() != 0) { return 31; }
    if (tap_key(712) != 0) { return 31; }
    if (render() <= 0) { return 1; }
    if (cv_tab() != 1) { return 31; }
    if (tap_key(713) != 0) { return 31; }
    if (render() <= 0) { return 1; }
    if (cv_tab() != 2) { return 31; }
    if (tap_key(711) != 0) { return 31; }
    if (render() <= 0) { return 1; }
    if (cv_tab() != 0) { return 31; }

    // J. Tab bar scroll (v2.6.1): drag the bar left, the Canvas tab
    // scrolls on-screen, tap it to switch; drag back, tap Input.
    // Offsets are read via aui_debug_scroll_max, never hard-coded.
    // v2.12：9 个标签后内容更宽（max 200 px）。400 px 单步拖动落在
    // 框架的短响应带（只滚 144 px，见 REPORT-v212.md），改用 600 px
    // 拖动才到 max；断言本身（滚到 max）不变。
    // v2.15：10 个标签后登记 max 344 px（真值约 600 px，仍短 256 px）；
    // 600 px 拖动恰好到登记 max（600-256=344），断言不变。
    // v2.16：11 个标签后登记 max 约 488 px（真值约 744 px，仍短 256 px，
    // 旧缺陷不修）；拖动须 ≥ 744 px 才到 max，改用 850 px 拖动
    // （850-256=594，夹到 max）；断言本身（滚到 max、回到 0）不变。
    // v2.17：12 个标签后登记 max 2400 px（真值约 2656 px，仍短 256 px，
    // 旧缺陷不修）；单次 850 px 拖动 + 惯性只到约 2136 px（11 标签时的
    // max），恰好差一个标签宽 264 px；去程与回程各拖两次，断言不变。
    // v2.18：13 个标签后登记 max 1066 px（960 px 视口，headless 回退
    // 字体）；两次拖动到 max 后 Canvas（key 17）x=-136，已滚出左沿——
    // 标签栏多了一个标签，Canvas 不再是 max 处在屏内的标签。实测
    // （jprobe，临时探针）：Table（key 22）[664,811]、Pinch（key 23）
    // [811,960] 在屏内；取 Table 为目标（Pinch 右沿恰好 960，无余量）。
    // 拖动量、max 断言、点按切换、回拖断言一律不变，只换目标标签。
    let s7: i32 = gallery_set_tab(0);
    if (render() <= 0) { return 1; }
    let tb: i32[4] = 0;
    if (aui_debug_rect(10, tb) != 0) { return 33; }
    let tby: i32 = tb[1] + tb[3] / 2;
    let dj: i32 = down(950, tby);
    let mj: i32 = move_to(100, tby);
    let uj: i32 = up(100, tby);
    if (render() <= 0) { return 1; }
    let djb: i32 = down(950, tby);
    let mjb: i32 = move_to(100, tby);
    let ujb: i32 = up(100, tby);
    if (render() <= 0) { return 1; }
    let mx: i32 = aui_debug_scroll_max(10);
    if (mx <= 0) { return 33; }
    if (aui_debug_scroll(10) != mx) { return 33; }
    let rct: i32[4] = 0;
    if (aui_debug_rect(22, rct) != 0) { return 34; }
    if (rct[0] < 0 || rct[0] + rct[2] > 960) { return 34; }
    if (tap_key(22) != 0) { return 35; }
    if (render() <= 0) { return 1; }
    if (gallery_tab() != 11) { return 35; }
    // Drag back: the bar returns to offset 0, Input is tappable.
    // v2.12：回拖同样用 600 px（400 px 只回 144 px，停在 56）。
    // v2.16：回拖改用 850 px（与去程一致，回到 0）。
    // v2.17：回程同样拖两次（与去程一致，回到 0）。
    let dj2: i32 = down(100, tby);
    let mj2: i32 = move_to(950, tby);
    let uj2: i32 = up(950, tby);
    if (render() <= 0) { return 1; }
    let dj2b: i32 = down(100, tby);
    let mj2b: i32 = move_to(950, tby);
    let uj2b: i32 = up(950, tby);
    if (render() <= 0) { return 1; }
    if (aui_debug_scroll(10) != 0) { return 36; }
    if (tap_key(11) != 0) { return 37; }
    if (render() <= 0) { return 1; }
    if (gallery_tab() != 0) { return 37; }

    // K. VarList tab (v2.10): renders, list + row rects exist, badges
    // follow the count rule (3 visible, 0 hidden).
    let sv: i32 = gallery_set_tab(7);
    if (render() <= 0) { return 38; }
    if (aui_debug_node_count() <= 0) { return 38; }
    let vl: i32[8] = 0;
    if (aui_debug_vlist_var(2000, vl) != 0) { return 39; }
    if (vl[2] <= 0 || vl[3] <= 0) { return 39; }
    if (vl[4] != 120) { return 40; }
    let vr: i32[6] = 0;
    if (aui_debug_vlist_var_row(2000, 0, vr) != 0) { return 41; }
    if (vr[2] <= 0 || vr[3] <= 0) { return 41; }
    let b3: i32[5] = 0;
    let b0: i32[5] = 0;
    if (aui_debug_badge(2033, b3) != 0) { return 42; }
    if (aui_debug_badge(2035, b0) != 0) { return 42; }
    if (b3[4] != 1 || b3[2] <= 0) { return 42; }
    if (b0[4] != 0 || b0[2] != 0) { return 43; }
    // v2.11：Badge 行（key 2030）必须在列表下方、不与首个可见行重叠
    // （漏 aui_end 的回归：行嵌进列表内、与第 0 行同 y）。
    let br: i32[4] = 0;
    if (aui_debug_rect(2030, br) != 0) { return 44; }
    if (br[1] < vl[1] + vl[3]) { return 45; }
    if (br[1] < vr[1] + vr[3]) { return 45; }
    // 滚几行后仍不重叠：跳到 #80，首个可见行变了，Badge 行仍在列表下方。
    // scroll_to_item 返回新偏移（>= 0），负数才是失败。
    let sc: i32 = aui_vlist_var_scroll_to_item(2000, 80, 1);
    if (sc < 0) { return 46; }
    if (render() <= 0) { return 38; }
    if (aui_debug_vlist_var(2000, vl) != 0) { return 46; }
    let vr2: i32[6] = 0;
    if (aui_debug_vlist_var_row(2000, vl[5], vr2) != 0) { return 46; }
    if (aui_debug_rect(2030, br) != 0) { return 46; }
    if (br[1] < vl[1] + vl[3]) { return 47; }
    if (br[1] < vr2[1] + vr2[3]) { return 47; }

    // L. Split tab (v2.12): renders, both splits have size at ratio
    // 500, panes sit on opposite sides of the divider; dragging the
    // horizontal divider right raises the ratio and widens the left pane.
    let ss: i32 = gallery_set_tab(8);
    if (render() <= 0) { return 48; }
    if (aui_debug_node_count() <= 0) { return 48; }
    let hs: i32[8] = 0;
    if (aui_debug_split(2111, hs) != 0) { return 49; }
    if (hs[2] <= 0 || hs[3] <= 0) { return 49; }
    if (hs[4] != 1 || hs[5] != 500) { return 50; }
    let hp0: i32[4] = 0;
    let hp1: i32[4] = 0;
    if (aui_debug_split_pane(2111, 0, hp0) != 0) { return 51; }
    if (aui_debug_split_pane(2111, 1, hp1) != 0) { return 51; }
    if (hp0[0] + hp0[2] > hs[7]) { return 51; }
    if (hp1[0] < hs[7]) { return 51; }
    if (hp0[3] != hp1[3]) { return 52; }
    let w0: i32 = hp0[2];
    let vs: i32[8] = 0;
    if (aui_debug_split(2118, vs) != 0) { return 53; }
    if (vs[2] <= 0 || vs[3] <= 0) { return 53; }
    if (vs[4] != 0 || vs[5] != 500) { return 54; }
    let vp0: i32[4] = 0;
    let vp1: i32[4] = 0;
    if (aui_debug_split_pane(2118, 0, vp0) != 0) { return 55; }
    if (aui_debug_split_pane(2118, 1, vp1) != 0) { return 55; }
    if (vp0[1] + vp0[3] > vs[7]) { return 55; }
    if (vp1[1] < vs[7]) { return 55; }
    if (vp0[2] != vp1[2]) { return 56; }
    // 拖横向分隔条：DOWN 在条中心、MOVE +50 px、UP，比例变大、左窗格变宽。
    let dcx: i32 = hs[7];
    let dcy: i32 = hs[1] + hs[3] / 2;
    let dl: i32 = down(dcx, dcy);
    let ml: i32 = move_to(dcx + 50, dcy);
    let ul: i32 = up(dcx + 50, dcy);
    if (render() <= 0) { return 48; }
    if (aui_split_ratio(2111) <= 500) { return 57; }
    if (aui_debug_split_pane(2111, 0, hp0) != 0) { return 58; }
    if (hp0[2] <= w0) { return 58; }

    // M. Theme tab (v2.15): renders via gallery_set_tab(9); the Title
    // specimen is 80 px tall, the nested teal card and the global
    // sibling card both have rects, the LARGE shape card has a rect.
    let st: i32 = gallery_set_tab(9);
    if (render() <= 0) { return 60; }
    if (aui_debug_node_count() <= 0) { return 60; }
    if (gallery_tab() != 9) { return 60; }
    let rt: i32[4] = 0;
    if (aui_debug_rect(2260, rt) != 0) { return 61; }
    if (rt[3] != 80) { return 61; }
    let rn: i32[4] = 0;
    if (aui_debug_rect(2311, rn) != 0) { return 62; }
    if (rn[2] <= 0 || rn[3] <= 0) { return 62; }
    let rs: i32[4] = 0;
    if (aui_debug_rect(2315, rs) != 0) { return 62; }
    if (rs[2] <= 0 || rs[3] <= 0) { return 62; }
    let rl: i32[4] = 0;
    if (aui_debug_rect(2273, rl) != 0) { return 63; }
    if (rl[2] <= 0 || rl[3] <= 0) { return 63; }

    // N. Anim tab (v2.16): renders via gallery_set_tab(10); the spring
    // button, pulse card, scale slider + preview, replay button and
    // reduced-motion switch all have rects; tapping the spring button
    // starts a SCALE spring, the pulse Start button starts a TX
    // keyframe (both read via aui_anim_active — a sampled value right
    // after the tap is racy on the real headless clock); leaving the
    // tab stops the pulse (TX back to 0, synchronous in on_tab).
    let sa: i32 = gallery_set_tab(10);
    if (render() <= 0) { return 64; }
    if (aui_debug_node_count() <= 0) { return 64; }
    if (gallery_tab() != 10) { return 64; }
    let rb: i32[4] = 0;
    if (aui_debug_rect(2410, rb) != 0) { return 65; }
    if (rb[2] <= 0 || rb[3] <= 0) { return 65; }
    let rp: i32[4] = 0;
    if (aui_debug_rect(2420, rp) != 0) { return 65; }
    if (rp[2] <= 0 || rp[3] <= 0) { return 65; }
    let rv: i32[4] = 0;
    if (aui_debug_rect(2440, rv) != 0) { return 66; }
    if (rv[2] <= 0 || rv[3] <= 0) { return 66; }
    let rw: i32[4] = 0;
    if (aui_debug_rect(2450, rw) != 0) { return 66; }
    if (rw[2] <= 0 || rw[3] <= 0) { return 66; }
    // 点弹簧卡片：SCALE 弹簧启动（active 计数 > 0）。
    if (tap_key(2410) != 0) { return 67; }
    if (render() <= 0) { return 64; }
    if (aui_anim_active() == 0) { return 67; }
    // 点 Start pulse：TX 关键帧启动（无限往返，active 保持 > 0）。
    if (tap_key(2413) != 0) { return 68; }
    if (render() <= 0) { return 64; }
    if (aui_anim_active() == 0) { return 68; }
    // 离开 Anim 标签：脉冲停掉（TX 回 0）。
    let sb: i32 = gallery_set_tab(9);
    if (render() <= 0) { return 69; }
    if (aui_anim_value(2420, AUI_ANIM_TX) != 0) { return 69; }

    // O. Table tab (v2.17): renders via gallery_set_tab(11); the table
    // rect has size with 10000 rows x 100 cols and the window starts at
    // row 0 / col 0; "Jump R5000 C50" scrolls the window to first_row
    // 4999 / first_col 48 (start-align + 1 overscan); "Top-left" resets
    // it to 0 / 0.
    let svt: i32 = gallery_set_tab(11);
    if (render() <= 0) { return 70; }
    if (aui_debug_node_count() <= 0) { return 70; }
    if (gallery_tab() != 11) { return 70; }
    let vt: i32[12] = 0;
    if (aui_debug_vtable(3000, vt) != 0) { return 71; }
    if (vt[2] <= 0 || vt[3] <= 0) { return 71; }
    if (vt[4] != 10000 || vt[5] != 100) { return 71; }
    if (vt[6] != 0 || vt[8] != 0) { return 71; }
    if (tap_key(3010) != 0) { return 72; }
    if (render() <= 0) { return 70; }
    if (aui_debug_vtable(3000, vt) != 0) { return 72; }
    if (vt[6] != 4999 || vt[8] != 48) { return 72; }
    if (tap_key(3011) != 0) { return 73; }
    if (render() <= 0) { return 70; }
    if (aui_debug_vtable(3000, vt) != 0) { return 73; }
    if (vt[6] != 0 || vt[8] != 0) { return 73; }

    // P. Pinch tab (v2.18): renders via gallery_set_tab(12); the canvas
    // rect has size and exactly one pinch node is registered on it;
    // a two-finger pinch on the canvas zooms to 1.50x (98304);
    // Reset restores 1.00x (65536).
    let spn: i32 = gallery_set_tab(12);
    if (render() <= 0) { return 74; }
    if (aui_debug_node_count() <= 0) { return 74; }
    if (gallery_tab() != 12) { return 74; }
    let pc: i32[4] = 0;
    if (aui_debug_rect(3100, pc) != 0) { return 75; }
    if (pc[2] <= 0 || pc[3] <= 0) { return 75; }
    if (aui_pinch_n() != 1) { return 75; }
    if (gallery_pn_zoom() != 65536) { return 75; }
    let pcx: i32 = pc[0] + pc[2] / 2;
    let pcy: i32 = pc[1] + pc[3] / 2;
    let q1: i32 = down2(pcx - 100, pcy, pcx + 100, pcy);
    if (aui_pinch_active() != 1) { return 76; }
    let q2: i32 = move2(pcx - 150, pcy, pcx + 150, pcy);
    if (render() <= 0) { return 74; }
    if (gallery_pn_zoom() != 98304) { return 76; }
    if (aui_pinch_scale() != 98304) { return 76; }
    let q3: i32 = up2(pcx - 150, pcy, pcx + 150, pcy);
    if (aui_pinch_active() != 0) { return 76; }
    if (tap_key(3109) != 0) { return 77; }
    if (render() <= 0) { return 74; }
    if (gallery_pn_zoom() != 65536) { return 77; }

    // Q. Semantics tab (v2.19): renders via gallery_set_tab(13); Refresh
    // exports the live tree (gallery_sem_len() > 0). The export reaches
    // a fixed point: the first capture predates the dump display (the
    // column grows when the dump lines appear), so stability is asserted
    // between the 2nd and 3rd Refresh (same length = the dump does not
    // grow; the dump container is hidden from the export); a fresh
    // export right after equals the last capture, and the export text
    // contains the sample button's explicit label and heading.
    let sq: i32 = gallery_set_tab(13);
    if (render() <= 0) { return 78; }
    if (aui_debug_node_count() <= 0) { return 78; }
    if (gallery_tab() != 13) { return 78; }
    if (gallery_sem_len() != 0) { return 79; }
    if (tap_key(3231) != 0) { return 80; }
    if (render() <= 0) { return 78; }
    let sl1: i32 = gallery_sem_len();
    if (sl1 <= 0) { return 80; }
    if (tap_key(3231) != 0) { return 80; }
    if (render() <= 0) { return 78; }
    let sl2: i32 = gallery_sem_len();
    if (sl2 <= 0) { return 80; }
    if (tap_key(3231) != 0) { return 80; }
    if (render() <= 0) { return 78; }
    let sl3: i32 = gallery_sem_len();
    if (sl3 != sl2) { return 81; }
    let sqn: i32 = aui_sem_export(g_sem, 16384);
    if (sqn != sl3) { return 80; }
    if (contains(g_sem, "Button \"Open settings\"") == 0) { return 82; }
    if (contains(g_sem, "Heading \"Sample controls\"") == 0) { return 82; }

    return 0;
}
