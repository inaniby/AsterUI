// select_test.ast — v1.20 复选框 / 单选框 / 滑块离屏自检（qemu-user）。
//
// W5 重定基线：视口 320x240 -> 320x360。60 px 行高下五行的总高 308 px
// （60/60/60/32/32 + 间隙/边距），240 高视口内容区只有 192 px：两滑块
// 在 y=244/284，完全在屏外、点按无响应；360 高视口内容区 312 px，
// 滑块 244..276 / 284..316 都在屏内。另先加载 VM 的 TrueType 字体
// （aui_rt_set_font_path），文本用原生 48 px em（scale 1，与
// examples/harness 一致；旧 scale 2 配已删 .auf 8 px 图集）；SafeArea
// 上 24 px 猜测，内容区 y 从 24 起。复选框/单选圆仍是 20 px，在 60 px
// 行内垂直居中（方框 y=行 y+20，圆心 y=行 y+30）。
// 密度 160（dp == px），320x360。布局：column pad 16 gap 8，
// 五行依次为 Check / Radio A / Radio B / Slider(500,step100) / Slider(0,free)。
// 校验：整行宽度、20px 控件、勾选/描边/圆环/圆点像素、点按回调、
// 滑块点按跳值 + 吸附、拖动实时值、松手回写、两端夹紧。
// 返回码：0 通过；1 首次绘制；2 节点数；3 复选框矩形；4 勾选底色；
// 5 对勾白色；6 单选 A 矩形；7 A 圆环；8 A 内圈；9 A 圆点；
// 10 B 圆环；11 B 内圈；12 滑块矩形；13 滑块已选；14 滑块未选；
// 15 滑块拇指；16 复选框点击状态；17 复选框点击次数；18 重绘；
// 19 未选描边；20 未选内圈；21 滑块点按值；22 滑块点按次数；23 点按后重绘；
// 24 点按后已选；25 点按后未选；26 拖动实时值；27 拖动回调值；28 拖动次数；
// 29 松手重绘；30 松手后拇指；31 松手后未选；32 第二滑块右端值；
// 33 第二滑块右端次数；34 右端重绘；35 右端已选；36 第二滑块左端值；
// 37 第二滑块左端次数；38 左端重绘；39 左端未选；40 左端拇指；
// 41 单选 B 点击状态；42 单选 B 次数；43 单选重绘；44 B 圆点；45 A 复位；
// 90 字体加载失败。

include "../aui.ast";

extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;

let g_buf: u8[460800] = 0;   // 320x360 RGBA
let g_font: ptr = 0; // W4: .auf removed (no font files in repo; runtime adapter, see font_runtime.ast)

struct T {
    check: i32,
    chk_taps: i32,
    radio: i32,      // 0 = A, 1 = B
    rad_taps: i32,
    v1: i32,
    s1_taps: i32,
    v2: i32,
    s2_taps: i32
}

let g_t: T = T { 1, 0, 0, 0, 500, 0, 0, 0 };

fn on_check(user: ptr) -> i32 {
    let t: ptr<T> = user;
    t.check = 1 - t.check;
    t.chk_taps = t.chk_taps + 1;
    aui_invalidate();
    return 0;
}

fn on_ra(user: ptr) -> i32 {
    let t: ptr<T> = user;
    t.radio = 0;
    t.rad_taps = t.rad_taps + 1;
    aui_invalidate();
    return 0;
}

fn on_rb(user: ptr) -> i32 {
    let t: ptr<T> = user;
    t.radio = 1;
    t.rad_taps = t.rad_taps + 1;
    aui_invalidate();
    return 0;
}

fn on_v1(user: ptr) -> i32 {
    let t: ptr<T> = user;
    t.v1 = aui_slider_value(5);
    t.s1_taps = t.s1_taps + 1;
    aui_invalidate();
    return 0;
}

fn on_v2(user: ptr) -> i32 {
    let t: ptr<T> = user;
    t.v2 = aui_slider_value(6);
    t.s2_taps = t.s2_taps + 1;
    aui_invalidate();
    return 0;
}

fn build(user: ptr) -> i32 {
    let t: ptr<T> = user;
    let ra: i32 = 0;
    if (t.radio == 0) { ra = 1; }
    let rb: i32 = 0;
    if (t.radio == 1) { rb = 1; }
    aui_root();
    aui_column(1);
    aui_pad(16);
    aui_gap(8);
    aui_checkbox(2, "Check", t.check, on_check, user);
    aui_radio(3, "Radio A", ra, on_ra, user);
    aui_radio(4, "Radio B", rb, on_rb, user);
    aui_slider(5, t.v1, 100, on_v1, user);
    aui_slider(6, t.v2, 0, on_v2, user);
    aui_end();
    return 0;
}

fn off(x: i32, y: i32) -> i32 {
    return (y * 320 + x) * 4;
}

fn is_color(x: i32, y: i32, r: i32, g: i32, b: i32) -> i32 {
    let o: i32 = off(x, y);
    if (load_u8(g_buf + o + 0) != r) { return 0; }
    if (load_u8(g_buf + o + 1) != g) { return 0; }
    if (load_u8(g_buf + o + 2) != b) { return 0; }
    return 1;
}

fn render() -> i32 {
    let n: i32 = aui_headless_render(320, 360, g_buf);
    if (n <= 0) { return 0; }
    return n;
}

fn tap(x: i32, y: i32) -> i32 {
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn main() -> i32 {
    // W5 re-baseline: load the VM TrueType font first (same hook the
    // 11-14 harnesses use); scale 1 = native 48 px em as in every
    // example/harness app (old scale 2 belonged to the deleted .auf font).
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    if (font_ok != 1) { return 90; }
    aui_set_font(g_font, 1);
    aui_debug_set_density(160);
    aui_headless_init(build, &g_t);
    if (render() == 0) { return 1; }
    if (aui_debug_node_count() != 7) { return 2; }

    let ck: i32[4] = 0;
    if (aui_debug_rect(2, ck) != 0) { return 3; }
    // W5 re-baseline: 行 (16,40,288,60)；方框 20x20 在行内居中 y=60..80
    // （探针：x=26 列首个主色 y=60）。
    if (ck[0] != 16 || ck[1] != 40 || ck[2] != 288 || ck[3] != 60) { return 3; }
    if (is_color(26, 62, 0x3A, 0x6D, 0xF0) == 0) { return 4; }
    // 对勾第一段从 (20,70) 起（方框 + (4,10)，与旧相对位置相同）。
    if (is_color(20, 70, 0xFF, 0xFF, 0xFF) == 0) { return 5; }

    let ra: i32[4] = 0;
    if (aui_debug_rect(3, ra) != 0) { return 6; }
    // W5 re-baseline: 行 (16,108,288,60)；圆 20 px 在行内居中 y=128..148，
    // 圆心 (26,138)（探针：环顶 y=128）。
    if (ra[0] != 16 || ra[1] != 108 || ra[2] != 288 || ra[3] != 60) { return 6; }
    if (is_color(26, 129, 0x3A, 0x6D, 0xF0) == 0) { return 7; }
    if (is_color(26, 132, 0xF6, 0xF6, 0xF8) == 0) { return 8; }
    if (is_color(26, 138, 0x3A, 0x6D, 0xF0) == 0) { return 9; }

    let rb: i32[4] = 0;
    if (aui_debug_rect(4, rb) != 0) { return 6; }
    // W5 re-baseline: B 行 (16,176,288,60)；圆 y=196..216，圆心 (26,206)。
    if (is_color(26, 197, 0x8A, 0x8A, 0x93) == 0) { return 10; }
    if (is_color(26, 206, 0xF6, 0xF6, 0xF8) == 0) { return 11; }

    let s1: i32[4] = 0;
    if (aui_debug_rect(5, s1) != 0) { return 12; }
    // W5 re-baseline: 滑块 (16,244,288,32)，轨道中心行 y=260（探针实测）。
    if (s1[0] != 16 || s1[1] != 244 || s1[2] != 288 || s1[3] != 32) { return 12; }
    // 轨道 x=25..294（两端各缩 9），500 → 填充到 160，拇指在 160。
    if (is_color(30, 260, 0x3A, 0x6D, 0xF0) == 0) { return 13; }
    if (is_color(280, 260, 0xAE, 0xB8, 0xCC) == 0) { return 14; }
    if (is_color(160, 260, 0x3A, 0x6D, 0xF0) == 0) { return 15; }

    // 点复选框整行中部：状态翻转，重新绘制成未选。
    tap(200, 70);   // W5 re-baseline: 行中心 y=70。
    if (g_t.check != 0) { return 16; }
    if (g_t.chk_taps != 1) { return 17; }
    if (render() == 0) { return 18; }
    // 未选：2px hint 描边，内部回到页面底色。
    if (is_color(17, 70, 0x8A, 0x8A, 0x93) == 0) { return 19; }
    if (is_color(26, 70, 0xF6, 0xF6, 0xF8) == 0) { return 20; }

    // 滑块点按在 1/4 处：raw=248 → 吸附到 200。
    tap(92, 260);   // W5 re-baseline: 轨道中心行 y=260。
    if (g_t.v1 != 200) { return 21; }
    if (g_t.s1_taps != 1) { return 22; }
    if (render() == 0) { return 23; }
    if (is_color(40, 260, 0x3A, 0x6D, 0xF0) == 0) { return 24; }
    if (is_color(280, 260, 0xAE, 0xB8, 0xCC) == 0) { return 25; }

    // 从拇指拖动到 80%：raw=788 → 800；未松手时 aui_slider_value 就是实时值。
    fake_post_motion(0, 79, 260);
    aui_on_input(1, 0, 0);
    fake_post_motion(2, 238, 260);
    aui_on_input(1, 0, 0);
    if (aui_slider_value(5) != 800) { return 26; }
    if (g_t.v1 != 800) { return 27; }
    if (g_t.s1_taps != 2) { return 28; }
    fake_post_motion(1, 238, 260);
    aui_on_input(1, 0, 0);
    if (render() == 0) { return 29; }
    if (is_color(236, 260, 0x3A, 0x6D, 0xF0) == 0) { return 30; }
    if (is_color(258, 260, 0xAE, 0xB8, 0xCC) == 0) { return 31; }

    // 第二个滑块不吸附：点最右端 → 1000，点最左端 → 0。
    tap(300, 300);   // W5 re-baseline: 第二滑块轨道中心行 y=300。
    if (g_t.v2 != 1000) { return 32; }
    if (g_t.s2_taps != 1) { return 33; }
    if (render() == 0) { return 34; }
    if (is_color(280, 300, 0x3A, 0x6D, 0xF0) == 0) { return 35; }
    tap(20, 300);
    if (g_t.v2 != 0) { return 36; }
    if (g_t.s2_taps != 2) { return 37; }
    if (render() == 0) { return 38; }
    if (is_color(280, 300, 0xAE, 0xB8, 0xCC) == 0) { return 39; }
    if (is_color(25, 300, 0x3A, 0x6D, 0xF0) == 0) { return 40; }

    // 点 B：应用维护互斥，A 自动复位。
    tap(200, 206);   // W5 re-baseline: B 行中心 y=206。
    if (g_t.radio != 1) { return 41; }
    if (g_t.rad_taps != 1) { return 42; }
    if (render() == 0) { return 43; }
    if (is_color(26, 206, 0x3A, 0x6D, 0xF0) == 0) { return 44; }
    if (is_color(26, 138, 0xF6, 0xF6, 0xF8) == 0) { return 45; }
    return 0;
}
