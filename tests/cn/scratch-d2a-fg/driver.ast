// driver.ast — D-2a 探针：通用前景色 aui_fg。
// label 红字 / button 绿字 / checkbox 红字；对照 label 无红像素。
// 像素断言：矩形内按通道统计（红：R>200,G<100,B<100,R-G>100；
// 绿：G>200,R<100,B<100,G-R>100）。退出码：0 通过；1 渲染失败；
// 2 label 红像素为 0；3 对照 label 有红像素；4 button 绿像素为 0；
// 5 checkbox 红像素为 0；6 aui_debug_d2a 读回错；90 字体缺失。
extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_set_font(font: ptr, scale: i32) -> i32;
extern fn aui_headless_init(build: fn(ptr) -> i32, user: ptr) -> i32;
extern fn aui_headless_render(w: i32, h: i32, out: ptr) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_d2a(key: i32, out: ptr) -> i32;
extern fn aui_root() -> i32;
extern fn aui_end() -> i32;
extern fn aui_column(key: i32) -> i32;
extern fn aui_pad(dp: i32) -> i32;
extern fn aui_gap(dp: i32) -> i32;
extern fn aui_label(key: i32, text: ptr) -> i32;
extern fn aui_button(key: i32, text: ptr, cb: fn(ptr) -> i32, user: ptr) -> i32;
extern fn aui_checkbox(key: i32, text: ptr, checked: i32, cb: fn(ptr) -> i32, user: ptr) -> i32;
extern fn aui_fg(color: u32) -> i32;
extern fn write_all(fd: i32, buf: ptr, n: i32) -> i32;
extern fn fmt_i32(buf: ptr, v: i32) -> i32;
extern fn strlen(s: ptr) -> i32;
let W: i32 = 480;
let H: i32 = 880;
let g_buf: i32[422400] = 0;
let g_font: ptr = 0;
let g_rect: i32[4] = 0;
let g_d2a: i32[6] = 0;
let g_num: u8[32] = 0;
fn out_str(s: ptr) -> i32 {
    return write_all(1, s, strlen(s));
}
fn out_i32(v: i32) -> i32 {
    let n: i32 = fmt_i32(g_num, v);
    return write_all(1, g_num, n);
}
fn out_sp() -> i32 {
    return write_all(1, ptr(" "), 1);
}
fn out_nl() -> i32 {
    return write_all(1, ptr("\n"), 1);
}
fn emit_count(name: ptr, v: i32) -> i32 {
    let s1: i32 = out_str(name);
    let s2: i32 = out_sp();
    let s3: i32 = out_i32(v);
    let s4: i32 = out_nl();
    return 0;
}
// 矩形内按通道计数：mode 0 = 红，1 = 绿。
fn count_chan(key: i32, mode: i32) -> i32 {
    if (aui_debug_rect(key, g_rect) != 0) {
        return -1;
    }
    let x0: i32 = g_rect[0];
    let y0: i32 = g_rect[1];
    let w: i32 = g_rect[2];
    let h: i32 = g_rect[3];
    let n: i32 = 0;
    let y: i32 = y0;
    while (y < y0 + h && y < H) {
        let x: i32 = x0;
        while (x < x0 + w && x < W) {
            let off: i32 = (y * W + x) * 4;
            let r: i32 = load_u8(g_buf + off);
            let g: i32 = load_u8(g_buf + off + 1);
            let b: i32 = load_u8(g_buf + off + 2);
            if (mode == 0) {
                if (r > 200 && g < 100 && b < 100 && r - g > 100) { n = n + 1; }
            } else {
                if (g > 200 && r < 100 && b < 100 && g - r > 100) { n = n + 1; }
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return n;
}
fn cb_noop(user: ptr) -> i32 {
    return 0;
}
fn build(user: ptr) -> i32 {
    aui_root();
    aui_column(1);
    aui_pad(16);
    aui_gap(8);
    aui_label(10, "Red text here");
    aui_fg(0xFFFF0000);
    aui_label(11, "Normal text here");
    aui_button(12, "GreenBtn", cb_noop, 0);
    aui_fg(0xFF00FF00);
    aui_checkbox(13, "CheckRed", 0, cb_noop, 0);
    aui_fg(0xFFFF0000);
    aui_end();
    return 0;
}
fn main() -> i32 {
    let font_ok: i32 = aui_rt_set_font_path(ptr("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"));
    if (font_ok != 1) {
        return 90;
    }
    aui_set_font(g_font, 1);
    aui_headless_init(build, 0);
    let n0: i32 = aui_headless_render(W, H, g_buf);
    if (n0 <= 0) {
        return 1;
    }
    let red10: i32 = count_chan(10, 0);
    let e1: i32 = emit_count(ptr("RED10"), red10);
    if (red10 <= 0) { return 2; }
    let red11: i32 = count_chan(11, 0);
    let e2: i32 = emit_count(ptr("RED11"), red11);
    if (red11 != 0) { return 3; }
    let grn12: i32 = count_chan(12, 1);
    let e3: i32 = emit_count(ptr("GRN12"), grn12);
    if (grn12 <= 0) { return 4; }
    let red13: i32 = count_chan(13, 0);
    let e4: i32 = emit_count(ptr("RED13"), red13);
    if (red13 <= 0) { return 5; }
    if (aui_debug_d2a(10, g_d2a) != 0) { return 6; }
    if (g_d2a[3] != -65536 || g_d2a[4] != 1) { return 6; }
    if (aui_debug_d2a(11, g_d2a) != 0) { return 6; }
    if (g_d2a[4] != 0) { return 6; }
    return 0;
}
