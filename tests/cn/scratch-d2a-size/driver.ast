// driver.ast — D-2a 探针：通用宽高 aui_size。
// 断言：固定宽/高进 RECT；-1 维走自然尺寸；固定宽驱动文本换行；
// 父容器总量按固定尺寸算。退出码：0 通过；1 渲染失败；2 RECT 10 错；
// 3 RECT 11 错；4 RECT 12 错；5 RECT 13 错；6 RECT 14（换行）错；
// 7 scroll 定高/根总量错；8 aui_debug_d2a 读回错；90 字体缺失。
extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_set_font(font: ptr, scale: i32) -> i32;
extern fn aui_headless_init(build: fn(ptr) -> i32, user: ptr) -> i32;
extern fn aui_headless_render(w: i32, h: i32, out: ptr) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_d2a(key: i32, out: ptr) -> i32;
extern fn aui_root() -> i32;
extern fn aui_end() -> i32;
extern fn aui_column(key: i32) -> i32;
extern fn aui_row(key: i32) -> i32;
extern fn aui_scroll(key: i32) -> i32;
extern fn aui_pad(dp: i32) -> i32;
extern fn aui_gap(dp: i32) -> i32;
extern fn aui_label(key: i32, text: ptr) -> i32;
extern fn aui_button(key: i32, text: ptr, cb: fn(ptr) -> i32, user: ptr) -> i32;
extern fn aui_size(w: i32, h: i32) -> i32;
extern fn write_all(fd: i32, buf: ptr, n: i32) -> i32;
extern fn fmt_i32(buf: ptr, v: i32) -> i32;
extern fn strlen(s: ptr) -> i32;
let W: i32 = 480;
let H: i32 = 880;
let g_buf: i32[422400] = 0;
let g_font: ptr = 0;
let g_rect: i32[4] = 0;
let g_d2a: i32[6] = 0;
let g_num: u8[32] = 0;
fn out_str(s: ptr) -> i32 {
    return write_all(1, s, strlen(s));
}
fn out_i32(v: i32) -> i32 {
    let n: i32 = fmt_i32(g_num, v);
    return write_all(1, g_num, n);
}
fn out_sp() -> i32 {
    return write_all(1, ptr(" "), 1);
}
fn out_nl() -> i32 {
    return write_all(1, ptr("\n"), 1);
}
fn emit_rect(key: i32) -> i32 {
    if (aui_debug_rect(key, g_rect) != 0) {
        return 1;
    }
    let s1: i32 = out_str(ptr("RECT "));
    let s2: i32 = out_i32(key);
    let s3: i32 = out_sp();
    let s4: i32 = out_i32(g_rect[0]);
    let s5: i32 = out_sp();
    let s6: i32 = out_i32(g_rect[1]);
    let s7: i32 = out_sp();
    let s8: i32 = out_i32(g_rect[2]);
    let s9: i32 = out_sp();
    let sa: i32 = out_i32(g_rect[3]);
    let sb: i32 = out_nl();
    return 0;
}
fn cb_noop(user: ptr) -> i32 {
    return 0;
}
fn build(user: ptr) -> i32 {
    aui_root();
    aui_column(1);
    aui_pad(16);
    aui_gap(8);
    aui_label(10, "Short");
    aui_size(120, 40);
    aui_label(11, "Hi");
    aui_size(100, -1);
    aui_button(12, "Go", cb_noop, 0);
    aui_size(-1, 80);
    aui_row(13);
    aui_size(300, 50);
    aui_label(20, "R1");
    aui_label(21, "R2");
    aui_end();
    aui_label(14, "Wrap wrap wrap wrap wrap");
    aui_size(100, -1);
    aui_scroll(15);
    aui_size(200, 100);
    aui_label(30, "Tall one");
    aui_label(31, "Tall two");
    aui_label(32, "Tall three");
    aui_end();
    aui_end();
    return 0;
}
fn main() -> i32 {
    let font_ok: i32 = aui_rt_set_font_path(ptr("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"));
    if (font_ok != 1) {
        return 90;
    }
    aui_set_font(g_font, 1);
    aui_headless_init(build, 0);
    let n0: i32 = aui_headless_render(W, H, g_buf);
    if (n0 <= 0) {
        return 1;
    }
    let a: i32 = emit_rect(1);
    let b: i32 = emit_rect(10);
    let c: i32 = emit_rect(11);
    let d: i32 = emit_rect(12);
    let e: i32 = emit_rect(13);
    let f: i32 = emit_rect(14);
    let g: i32 = emit_rect(15);
    if (aui_debug_rect(10, g_rect) != 0) { return 2; }
    if (g_rect[2] != 120 || g_rect[3] != 40) { return 2; }
    if (aui_debug_rect(11, g_rect) != 0) { return 3; }
    if (g_rect[2] != 100 || g_rect[3] != 60) { return 3; }
    if (aui_debug_rect(12, g_rect) != 0) { return 4; }
    if (g_rect[3] != 80 || g_rect[2] <= 0 || g_rect[2] >= 108) { return 4; }
    if (aui_debug_rect(13, g_rect) != 0) { return 5; }
    if (g_rect[2] != 300 || g_rect[3] != 50) { return 5; }
    if (aui_debug_rect(14, g_rect) != 0) { return 6; }
    if (g_rect[2] != 100 || g_rect[3] <= 60 || g_rect[3] % 60 != 0) { return 6; }
    let h14: i32 = g_rect[3];
    if (aui_debug_rect(15, g_rect) != 0) { return 7; }
    if (g_rect[2] != 200 || g_rect[3] != 100) { return 7; }
    if (aui_debug_rect(1, g_rect) != 0) { return 7; }
    if (g_rect[3] != 402 + h14) { return 7; }
    if (aui_debug_d2a(10, g_d2a) != 0) { return 8; }
    if (g_d2a[0] != 120 || g_d2a[1] != 40 || g_d2a[2] != -1) { return 8; }
    if (aui_debug_d2a(11, g_d2a) != 0) { return 8; }
    if (g_d2a[0] != 100 || g_d2a[1] != -1) { return 8; }
    return 0;
}
