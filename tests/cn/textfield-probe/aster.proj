# aster.proj — P6 cn-textfield-checks 探针工程（只供 tests/cn/cn-textfield-checks.sh
# 用 build-cn-obj + link-obj 建 headless 探针二进制；不参与 `aster build` 出包）。
# 驱动必须列进工程：P0-1 机理只在同工程文件间零声明可见——驱动若
# 不在工程内，g_text_field 裸引用报 [A-099]。列进工程后驱动不得再
# extern 声明 std 的 write_all/strlen/fmt_i32/fmt_i64（std 定义是
# ptr<u8> 参数，须一字不差，见驱动头注释）。
# textfield.ast 列在 aui_spec.ast 之后（视图/文本参数 定义在 aui_spec.ast
# 内，顺序规则 P5 §6.2：后文件可见前文件定义，反之 A-060）。
kind exe
[language]
default = "en"
