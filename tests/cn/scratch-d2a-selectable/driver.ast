// driver.ast — D-2a 探针：长按选中 aui_selectable。
// 流程：短按 label 10（200ms）→ 无选区；长按 label 10（700ms）→
// 选中全文（key 10，选区 0..20，帧校验和变化）；点 label 11 → 选区清除；
// 长按 label 12（有回调登记）→ 回调触发、无选区。
// 退出码：0 通过；1 渲染失败；2 短按误选中；3 长按未选中；4 key 错；
// 5 选区终点错；6 视觉校验和未变；7 点别处未清除；8 回调未触发；
// 9 回调节点误选中；90 字体缺失。
extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_set_font(font: ptr, scale: i32) -> i32;
extern fn aui_headless_init(build: fn(ptr) -> i32, user: ptr) -> i32;
extern fn aui_headless_render(w: i32, h: i32, out: ptr) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_selection(out: ptr) -> i32;
extern fn aui_selection_key() -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_root() -> i32;
extern fn aui_end() -> i32;
extern fn aui_column(key: i32) -> i32;
extern fn aui_pad(dp: i32) -> i32;
extern fn aui_gap(dp: i32) -> i32;
extern fn aui_label(key: i32, text: ptr) -> i32;
extern fn aui_selectable(flag: i32) -> i32;
extern fn aui_long_press(cb: fn(ptr) -> i32, user: ptr) -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;
extern fn write_all(fd: i32, buf: ptr, n: i32) -> i32;
extern fn fmt_i32(buf: ptr, v: i32) -> i32;
extern fn fmt_i64(buf: ptr, v: i64) -> i32;
extern fn strlen(s: ptr) -> i32;
let W: i32 = 480;
let H: i32 = 880;
let g_buf: i32[422400] = 0;
let g_font: ptr = 0;
let g_rect: i32[4] = 0;
let g_sel: i32[4] = 0;
let g_num: u8[32] = 0;
let g_lp_fired: i32 = 0;
fn out_str(s: ptr) -> i32 {
    return write_all(1, s, strlen(s));
}
fn out_i32(v: i32) -> i32 {
    let n: i32 = fmt_i32(g_num, v);
    return write_all(1, g_num, n);
}
fn out_i64(v: i64) -> i32 {
    let n: i32 = fmt_i64(g_num, v);
    return write_all(1, g_num, n);
}
fn out_sp() -> i32 {
    return write_all(1, ptr(" "), 1);
}
fn out_nl() -> i32 {
    return write_all(1, ptr("\n"), 1);
}
fn emit_sel() -> i32 {
    if (aui_debug_selection(g_sel) != 0) {
        let s1: i32 = out_str(ptr("SEL none"));
        let s2: i32 = out_nl();
        return 1;
    }
    let s1: i32 = out_str(ptr("SEL "));
    let s2: i32 = out_i32(g_sel[0]);
    let s3: i32 = out_sp();
    let s4: i32 = out_i32(g_sel[1]);
    let s5: i32 = out_sp();
    let s6: i32 = out_i32(g_sel[2]);
    let s7: i32 = out_sp();
    let s8: i32 = out_i32(g_sel[3]);
    let s9: i32 = out_nl();
    return 0;
}
// 矩形内全部字节和（i64），作视觉变化校验。
fn rect_sum(key: i32) -> i64 {
    if (aui_debug_rect(key, g_rect) != 0) {
        return -1;
    }
    let x0: i32 = g_rect[0];
    let y0: i32 = g_rect[1];
    let w: i32 = g_rect[2];
    let h: i32 = g_rect[3];
    let sum: i64 = 0;
    let y: i32 = y0;
    while (y < y0 + h && y < H) {
        let x: i32 = x0;
        while (x < x0 + w && x < W) {
            let off: i32 = (y * W + x) * 4;
            sum = sum + i64(load_u8(g_buf + off)) + i64(load_u8(g_buf + off + 1)) + i64(load_u8(g_buf + off + 2)) + i64(load_u8(g_buf + off + 3));
            x = x + 1;
        }
        y = y + 1;
    }
    return sum;
}
fn key_cx(key: i32) -> i32 {
    if (aui_debug_rect(key, g_rect) != 0) { return -1; }
    return g_rect[0] + g_rect[2] / 2;
}
fn key_cy(key: i32) -> i32 {
    if (aui_debug_rect(key, g_rect) != 0) { return -1; }
    return g_rect[1] + g_rect[3] / 2;
}
fn down(key: i32) -> i32 {
    let cx: i32 = key_cx(key);
    let cy: i32 = key_cy(key);
    fake_post_motion(0, cx, cy);
    aui_on_input(1, 0, 0);
    return 0;
}
fn up(key: i32) -> i32 {
    let cx: i32 = key_cx(key);
    let cy: i32 = key_cy(key);
    fake_post_motion(1, cx, cy);
    aui_on_input(1, 0, 0);
    return 0;
}
// 从 t0 起以 16ms 步长推进到 t0+ms，每步渲染一帧（泵推进长按计时）。
fn hold_render(t0: i64, ms: i64) -> i32 {
    let t: i64 = t0;
    let end: i64 = t0 + ms * 1000000;
    while (t < end) {
        t = t + 16000000;
        if (t > end) { t = end; }
        fake_set_clock(t);
        let n: i32 = aui_headless_render(W, H, g_buf);
        if (n <= 0) { return -1; }
    }
    return 0;
}
fn cb_lp(user: ptr) -> i32 {
    g_lp_fired = 1;
    return 0;
}
fn build(user: ptr) -> i32 {
    aui_root();
    aui_column(1);
    aui_pad(16);
    aui_gap(8);
    aui_label(10, "Selectable text here");
    aui_selectable(1);
    aui_label(11, "Plain text here");
    aui_label(12, "Callback text");
    aui_selectable(1);
    aui_long_press(cb_lp, 0);
    aui_end();
    return 0;
}
fn main() -> i32 {
    let font_ok: i32 = aui_rt_set_font_path(ptr("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"));
    if (font_ok != 1) {
        return 90;
    }
    aui_set_font(g_font, 1);
    aui_headless_init(build, 0);
    let n0: i32 = aui_headless_render(W, H, g_buf);
    if (n0 <= 0) {
        return 1;
    }
    let sum_before: i64 = rect_sum(10);
    // 短按 label 10（200ms）：不应选中。
    let t0: i64 = 1000000000;
    fake_set_clock(t0);
    let d1: i32 = down(10);
    if (hold_render(t0, 200) != 0) { return 1; }
    let u1: i32 = up(10);
    let n1: i32 = aui_headless_render(W, H, g_buf);
    if (n1 <= 0) { return 1; }
    if (aui_selection_key() != 0) { return 2; }
    // 长按 label 10（700ms）：选中全文。
    let t1: i64 = 2000000000;
    fake_set_clock(t1);
    let d2: i32 = down(10);
    if (hold_render(t1, 700) != 0) { return 1; }
    let u2: i32 = up(10);
    let n2: i32 = aui_headless_render(W, H, g_buf);
    if (n2 <= 0) { return 1; }
    let e1: i32 = emit_sel();
    if (aui_debug_selection(g_sel) != 0) { return 3; }
    if (g_sel[1] != 10) { return 4; }
    if (g_sel[2] != 0 || g_sel[3] != 20) { return 5; }
    if (aui_selection_key() != 10) { return 4; }
    let sum_after: i64 = rect_sum(10);
    let e2: i32 = out_str(ptr("SUM "));
    let e3: i32 = out_i64(sum_before);
    let e4: i32 = out_sp();
    let e5: i32 = out_i64(sum_after);
    let e6: i32 = out_nl();
    if (sum_after == sum_before) { return 6; }
    // 点 label 11：选区清除。
    let d3: i32 = down(11);
    let u3: i32 = up(11);
    let n3: i32 = aui_headless_render(W, H, g_buf);
    if (n3 <= 0) { return 1; }
    if (aui_selection_key() != 0) { return 7; }
    // 长按 label 12（有回调）：回调触发、无选区。
    let t2: i64 = 4000000000;
    fake_set_clock(t2);
    let d4: i32 = down(12);
    if (hold_render(t2, 700) != 0) { return 1; }
    let u4: i32 = up(12);
    let n4: i32 = aui_headless_render(W, H, g_buf);
    if (n4 <= 0) { return 1; }
    if (g_lp_fired != 1) { return 8; }
    if (aui_selection_key() != 0) { return 9; }
    return 0;
}
