// driver.ast — P-FRAME 探针：帧序号/封存读写点核对。
// 断言：启动时 seq=0、sealed=0；一次 headless 渲染后 sealed=1 且 seq
// 递增；再调一次 aui_root() 后 sealed=0 且 seq 恰 +1（aui_build.ast
// :369-370；aui_frame.ast :2011/:3777）。退出码：0 通过；1 渲染失败；
// 2 提交后未封存；3 渲染后 seq 未递增；4 下一 build 未清封存；
// 5 下一 build seq 未恰 +1；6 启动初值不符；90 字体缺失。
extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_set_font(font: ptr, scale: i32) -> i32;
extern fn aui_headless_init(build: fn(ptr) -> i32, user: ptr) -> i32;
extern fn aui_headless_render(w: i32, h: i32, out: ptr) -> i32;
extern fn aui_debug_frame_seq() -> i32;
extern fn aui_debug_frame_sealed() -> i32;
extern fn aui_root() -> i32;
extern fn aui_end() -> i32;
extern fn aui_column(key: i32) -> i32;
extern fn aui_label(key: i32, text: ptr) -> i32;
extern fn write_all(fd: i32, buf: ptr, n: i32) -> i32;
extern fn fmt_i32(buf: ptr, v: i32) -> i32;
extern fn strlen(s: ptr) -> i32;
let W: i32 = 480;
let H: i32 = 880;
let g_buf: i32[422400] = 0;
let g_font: ptr = 0;
let g_num: u8[32] = 0;
fn out_str(s: ptr) -> i32 {
    return write_all(1, s, strlen(s));
}
fn out_i32(v: i32) -> i32 {
    let n: i32 = fmt_i32(g_num, v);
    return write_all(1, g_num, n);
}
fn out_nl() -> i32 {
    return write_all(1, ptr("\n"), 1);
}
fn build(user: ptr) -> i32 {
    aui_root();
    aui_column(1);
    aui_label(10, "Hi");
    aui_end();
    return 0;
}
fn main() -> i32 {
    let font_ok: i32 = aui_rt_set_font_path(ptr("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"));
    if (font_ok != 1) {
        return 90;
    }
    aui_set_font(g_font, 1);
    let s0: i32 = aui_debug_frame_seq();
    let f0: i32 = aui_debug_frame_sealed();
    if (s0 != 0 || f0 != 0) { return 6; }
    aui_headless_init(build, 0);
    let n0: i32 = aui_headless_render(W, H, g_buf);
    if (n0 <= 0) { return 1; }
    let s1: i32 = aui_debug_frame_seq();
    let f1: i32 = aui_debug_frame_sealed();
    if (f1 != 1) { return 2; }
    if (s1 <= s0) { return 3; }
    aui_root();
    let s2: i32 = aui_debug_frame_seq();
    let f2: i32 = aui_debug_frame_sealed();
    if (f2 != 0) { return 4; }
    if (s2 != s1 + 1) { return 5; }
    let s1a: i32 = out_str(ptr("P-FRAME OK seq="));
    let s1b: i32 = out_i32(s1);
    let s1c: i32 = out_str(ptr(" sealed="));
    let s1d: i32 = out_i32(f1);
    let s1e: i32 = out_nl();
    return 0;
}
