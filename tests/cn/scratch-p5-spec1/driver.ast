// driver.ast — P5 step-1 smoke v2: hand-built Select spec via the
// frame-pool allocators; dump x2, mount x2, node counts, stale, grow,
// validation failures, pool exhaustion.
// Exit 0 = all pass; other codes = step (see comments).
extern fn aui_root() -> i32;
extern fn aui_debug_node_count() -> i32;
extern fn aui_last_error() -> i32;
extern fn aui_spec_sizeof_view() -> i32;
extern fn aui_spec_new_views(n: i32) -> ptr;
extern fn aui_spec_new_view() -> ptr;
extern fn aui_spec_new_head(data: ptr, n: i32) -> ptr;
extern fn aui_spec_new_kidptrs(n: i32) -> i32;
extern fn aui_spec_kidptr_set(base: i32, i: i32, p: ptr) -> i32;
extern fn aui_spec_kidptr_addr(base: i32) -> ptr;
extern fn aui_spec_new_mod() -> ptr;
extern fn aui_spec_new_lay() -> ptr;
extern fn aui_spec_new_evt() -> ptr;
extern fn aui_spec_new_selparam() -> ptr;
extern fn aui_spec_new_optparam() -> ptr;
extern fn aui_spec_new_size() -> ptr;
extern fn aui_mount(spec: 视图, user: ptr) -> i32;
extern fn aui_spec_dump(spec: 视图) -> i32;
extern fn write_all(fd: i32, buf: ptr<u8>, n: i32) -> i32;
extern fn fmt_i32(buf: ptr<u8>, v: i32) -> i32;
extern fn strlen(s: ptr<u8>) -> i32;
let g_num: u8[32] = 0;
fn out_str(s: ptr<u8>) -> i32 {
    return write_all(1, s, strlen(s));
}
fn out_i32(v: i32) -> i32 {
    let n: i32 = fmt_i32(g_num, v);
    return write_all(1, g_num, n);
}
fn out_nl() -> i32 {
    return write_all(1, ptr("\n"), 1);
}
fn on_smoke(user: ptr) -> i32 {
    return 0;
}
fn main() -> i32 {
    let a0: i32 = out_str(ptr("SIZEOF view="));
    let a1: i32 = out_i32(aui_spec_sizeof_view());
    let a2: i32 = out_nl();
    aui_root();
    let kp: ptr<视图> = aui_spec_new_views(3);
    if (kp == 0) {
        return 10;
    }
    let o0: ptr<视图> = kp;
    let o1: ptr<视图> = kp + sizeof(视图);
    let o2: ptr<视图> = kp + 2 * sizeof(视图);
    let op0: ptr<选项参数> = aui_spec_new_optparam();
    if (op0 == 0) {
        return 10;
    }
    op0.文本 = ptr("English");
    let op1: ptr<选项参数> = aui_spec_new_optparam();
    if (op1 == 0) {
        return 10;
    }
    op1.文本 = ptr("Deutsch");
    let op2: ptr<选项参数> = aui_spec_new_optparam();
    if (op2 == 0) {
        return 10;
    }
    op2.文本 = ptr("中文");
    o0.种 = 26;
    o0.名 = ptr("选项0");
    o0.键 = 131;
    o0.修饰 = 0;
    o0.布局值 = 0;
    o0.事件 = 0;
    o0.子 = 0;
    o0.参数 = op0;
    o1.种 = 26;
    o1.名 = ptr("选项1");
    o1.键 = 132;
    o1.修饰 = 0;
    o1.布局值 = 0;
    o1.事件 = 0;
    o1.子 = 0;
    o1.参数 = op1;
    o2.种 = 26;
    o2.名 = ptr("选项2");
    o2.键 = 133;
    o2.修饰 = 0;
    o2.布局值 = 0;
    o2.事件 = 0;
    o2.子 = 0;
    o2.参数 = op2;
    let kb: i32 = aui_spec_new_kidptrs(3);
    if (kb < 0) {
        return 11;
    }
    let p0: ptr = o0;
    let p1: ptr = o1;
    let p2: ptr = o2;
    let s0: i32 = aui_spec_kidptr_set(kb, 0, p0);
    let s1: i32 = aui_spec_kidptr_set(kb, 1, p1);
    let s2: i32 = aui_spec_kidptr_set(kb, 2, p2);
    let hd: ptr = aui_spec_kidptr_addr(kb);
    let h: ptr<VecPtr> = aui_spec_new_head(hd, 3);
    if (h == 0) {
        return 11;
    }
    let ev: ptr<事件组> = aui_spec_new_evt();
    if (ev == 0) {
        return 11;
    }
    ev.种 = 2;
    ev.闭包 = on_smoke;
    ev.链 = 0;
    let sp: ptr<选择参数> = aui_spec_new_selparam();
    if (sp == 0) {
        return 11;
    }
    sp.选中 = 0;
    sp.打开 = 0;
    sp.占位 = ptr("Choose a language");
    let v: 视图;
    v.种 = 25;
    v.名 = ptr("语言");
    v.键 = 130;
    v.修饰 = 0;
    v.布局值 = 0;
    v.事件 = ev;
    v.子 = h;
    v.参数 = sp;
    let n0: i32 = aui_debug_node_count();
    let d1: i32 = aui_spec_dump(v);
    if (d1 != 4) {
        return 12;
    }
    let r1: i32 = aui_mount(v, 0);
    if (r1 != 0) {
        return 13;
    }
    let n1: i32 = aui_debug_node_count();
    if (n1 - n0 != 4) {
        return 14;
    }
    let d2: i32 = aui_spec_dump(v);
    if (d2 != 4) {
        return 12;
    }
    let r2: i32 = aui_mount(v, 0);
    if (r2 != 0) {
        return 13;
    }
    let n2: i32 = aui_debug_node_count();
    if (n2 - n1 != 4) {
        return 15;
    }
    aui_root();
    let r3: i32 = aui_mount(v, 0);
    if (r3 == 0) {
        return 16;
    }
    if (aui_last_error() != 115) {
        return 17;
    }
    let g1: ptr<视图> = aui_spec_new_view();
    if (g1 == 0) {
        return 18;
    }
    let gl: ptr<布局值> = aui_spec_new_lay();
    if (gl == 0) {
        return 18;
    }
    gl.权重 = -1;
    gl.对齐 = -1;
    gl.生长 = 1;
    let gp: ptr<选项参数> = aui_spec_new_optparam();
    if (gp == 0) {
        return 18;
    }
    gp.文本 = ptr("GrowOpt");
    g1.种 = 26;
    g1.名 = ptr("生长项");
    g1.键 = 141;
    g1.修饰 = 0;
    g1.布局值 = gl;
    g1.事件 = 0;
    g1.子 = 0;
    g1.参数 = gp;
    let gv: 视图;
    gv.种 = g1.种;
    gv.名 = g1.名;
    gv.键 = g1.键;
    gv.修饰 = g1.修饰;
    gv.布局值 = g1.布局值;
    gv.事件 = g1.事件;
    gv.子 = g1.子;
    gv.参数 = g1.参数;
    let dg: i32 = aui_spec_dump(gv);
    if (dg != 1) {
        return 18;
    }
    let rg: i32 = aui_mount(gv, 0);
    if (rg == 0) {
        return 18;
    }
    if (aui_last_error() != 114) {
        return 19;
    }
    let n3: i32 = aui_debug_node_count();
    g1.种 = 0;
    gv.种 = 0;
    let rk: i32 = aui_mount(gv, 0);
    if (rk == 0) {
        return 20;
    }
    if (aui_last_error() != 110) {
        return 20;
    }
    g1.种 = 26;
    gv.种 = 26;
    g1.键 = 0;
    gv.键 = 0;
    let rkey: i32 = aui_mount(gv, 0);
    if (rkey == 0) {
        return 21;
    }
    if (aui_last_error() != 111) {
        return 21;
    }
    g1.键 = 141;
    gv.键 = 141;
    let ev2: ptr<事件组> = aui_spec_new_evt();
    if (ev2 == 0) {
        return 22;
    }
    ev2.种 = 2;
    ev2.闭包 = on_smoke;
    ev2.链 = 0;
    g1.事件 = ev2;
    gv.事件 = ev2;
    let rev: i32 = aui_mount(gv, 0);
    if (rev == 0) {
        return 22;
    }
    if (aui_last_error() != 113) {
        return 22;
    }
    g1.事件 = 0;
    gv.事件 = 0;
    let sp2: ptr<选择参数> = aui_spec_new_selparam();
    if (sp2 == 0) {
        return 23;
    }
    sp2.选中 = 1;
    sp2.打开 = 0;
    sp2.占位 = ptr("Pick one");
    let v25: 视图;
    v25.种 = 25;
    v25.名 = ptr("语言");
    v25.键 = 130;
    v25.修饰 = 0;
    v25.布局值 = 0;
    v25.事件 = 0;
    v25.子 = 0;
    v25.参数 = sp2;
    let r25: i32 = aui_mount(v25, 0);
    if (r25 == 0) {
        return 23;
    }
    if (aui_last_error() != 113) {
        return 23;
    }
    let n4: i32 = aui_debug_node_count();
    if (n4 != n3) {
        return 24;
    }
    let got: i32 = 0;
    let t: i32 = 0;
    while (t < 20) {
        let q: ptr = aui_spec_new_view();
        if (q == 0) {
            break;
        }
        got = got + 1;
        t = t + 1;
    }
    if (got != 11) {
        return 25;
    }
    if (aui_last_error() != 116) {
        return 26;
    }
    let b0: i32 = out_str(ptr("SMOKE OK"));
    let b1: i32 = out_nl();
    return 0;
}
