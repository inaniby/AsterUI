// aster:language=en
// driver.ast — P6 step-0 T-MOUNT probe driver (scratch only).
//
// Proves the kind-10 mount extension (in the scratch aui_spec10.ast)
// emits a node identical to the direct aui_text_field(110, hint) call,
// and that the TextField class reads the framework text pool.
//
// Exit codes: 0 pass; 90 font; 91 render fail; 11 dump lines;
// 12 mount fail (main frame / mode 1 build); 13 node delta after
// mount-in-main; 14 node count / rect readback mismatch between the
// two render modes; 15 rect mismatch; 16 text-slot ptr mismatch;
// 17 pixelhash mismatch; 20 event!=0 not 113; 21 param==0 not 112;
// 22 child!=0 not 112; 23 node count changed on failed mounts;
// 24 stale mount not 115; 30 value() readback mismatch.
// stdout: the 1-line spec dump ([2/3]-style compare) + RECT/HASH/VALUE
// lines. Note the driver is built --language en (a zh build would fail
// on `extern fn`, same as the P5 spec_probe).
extern fn aui_root() -> i32;
extern fn aui_column(key: i32) -> i32;
extern fn aui_label(key: i32, text: ptr) -> i32;
extern fn aui_end() -> i32;
extern fn aui_weight(w: i32) -> i32;
extern fn aui_text_field(key: i32, hint: ptr) -> i32;
extern fn aui_text_value(key: i32) -> ptr;
extern fn aui_text_append(key: i32, ch: i32) -> i32;
extern fn aui_text_clear(key: i32) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_node_count() -> i32;
extern fn aui_last_error() -> i32;
extern fn aui_headless_init(build: fn(ptr) -> i32, user: ptr) -> i32;
extern fn aui_headless_render(w: i32, h: i32, out: ptr) -> i32;
extern fn aui_invalidate() -> i32;
extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_set_font(font: ptr, scale: i32) -> i32;
extern fn aui_mount(spec: 视图, user: ptr) -> i32;
extern fn aui_spec_dump(spec: 视图) -> i32;
extern fn aui_spec_new_view() -> ptr;
extern fn aui_spec_new_textparam() -> ptr;
extern fn aui_spec_new_evt() -> ptr;
extern fn aui_spec_new_kidptrs(n: i32) -> i32;
extern fn aui_spec_kidptr_set(base: i32, i: i32, p: ptr) -> i32;
extern fn aui_spec_kidptr_addr(base: i32) -> ptr;
extern fn aui_spec_new_head(data: ptr, n: i32) -> ptr;
extern fn write_all(fd: i32, buf: ptr<u8>, n: i32) -> i32;
extern fn fmt_i32(buf: ptr<u8>, v: i32) -> i32;
extern fn fmt_i64(buf: ptr<u8>, v: i64) -> i32;
extern fn strlen(s: ptr<u8>) -> i32;
let W: i32 = 480;
let H: i32 = 880;
let g_buf: i32[422400] = 0;
let g_font: ptr = 0;
let g_rect: i32[4] = 0;
let g_rect0: i32[4] = 0;
let g_num: u8[32] = 0;
let g_mode: i32 = 0;
let g_build_err: i32 = 0;
fn out_str(s: ptr<u8>) -> i32 {
    return write_all(1, s, strlen(s));
}
fn out_i32(v: i32) -> i32 {
    let n: i32 = fmt_i32(g_num, v);
    return write_all(1, g_num, n);
}
fn out_i64(v: i64) -> i32 {
    let n: i32 = fmt_i64(g_num, v);
    return write_all(1, g_num, n);
}
fn out_sp() -> i32 {
    return write_all(1, ptr(" "), 1);
}
fn out_nl() -> i32 {
    return write_all(1, ptr("\n"), 1);
}
fn view_of(p: ptr<视图>) -> 视图 {
    let v: 视图;
    v.种 = p.种;
    v.名 = p.名;
    v.键 = p.键;
    v.修饰 = p.修饰;
    v.布局值 = p.布局值;
    v.事件 = p.事件;
    v.子 = p.子;
    v.参数 = p.参数;
    return v;
}
fn pixelhash() -> i64 {
    let h: i64 = -3750763034362895579;
    let i: i32 = 0;
    while (i < W * H * 4) {
        let b: i32 = load_u8(g_buf + i);
        h = (h ^ b) * 1099511628211;
        i = i + 1;
    }
    return h;
}
fn build(user: ptr) -> i32 {
    aui_root();
    aui_column(1);
    aui_weight(1);
    aui_label(10, ptr("Hi"));
    if (g_mode == 0) {
        aui_text_field(110, ptr("Tap to type..."));
    } else {
        let m: i32 = aui_mount(g_text_field.build(user), user);
        if (m != 0) {
            g_build_err = m;
        }
    }
    aui_end();
    return 0;
}
fn render() -> i32 {
    let iv: i32 = aui_invalidate();
    return aui_headless_render(W, H, g_buf);
}
fn main() -> i32 {
    let font_ok: i32 = aui_rt_set_font_path(ptr("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"));
    if (font_ok != 1) {
        return 90;
    }
    aui_set_font(g_font, 1);
    aui_root();
    g_text_field.initialize(110, ptr("Tap to type..."));
    let spec: 视图 = g_text_field.build(0);
    let d1: i32 = aui_spec_dump(spec);
    if (d1 != 1) {
        return 11;
    }
    let n0: i32 = aui_debug_node_count();
    let r1: i32 = aui_mount(spec, 0);
    if (r1 != 0) {
        return 12;
    }
    let n1: i32 = aui_debug_node_count();
    if (n1 - n0 != 1) {
        return 13;
    }
    aui_headless_init(build, 0);
    g_mode = 0;
    if (render() <= 0) {
        return 91;
    }
    let nc0: i32 = aui_debug_node_count();
    if (aui_debug_rect(110, g_rect) != 0) {
        return 14;
    }
    g_rect0[0] = g_rect[0];
    g_rect0[1] = g_rect[1];
    g_rect0[2] = g_rect[2];
    g_rect0[3] = g_rect[3];
    let p0: ptr = aui_text_value(110);
    let h0: i64 = pixelhash();
    let a0: i32 = out_str(ptr("RECT0 "));
    let a1: i32 = out_i32(g_rect0[0]);
    let a2: i32 = out_sp();
    let a3: i32 = out_i32(g_rect0[1]);
    let a4: i32 = out_sp();
    let a5: i32 = out_i32(g_rect0[2]);
    let a6: i32 = out_sp();
    let a7: i32 = out_i32(g_rect0[3]);
    let a8: i32 = out_nl();
    let b0: i32 = out_str(ptr("HASH0 "));
    let b1: i32 = out_i64(h0);
    let b2: i32 = out_nl();
    g_mode = 1;
    if (render() <= 0) {
        return 91;
    }
    if (g_build_err != 0) {
        return 12;
    }
    let nc1: i32 = aui_debug_node_count();
    if (aui_debug_rect(110, g_rect) != 0) {
        return 14;
    }
    let p1: ptr = aui_text_value(110);
    let h1: i64 = pixelhash();
    let c0: i32 = out_str(ptr("RECT1 "));
    let c1: i32 = out_i32(g_rect[0]);
    let c2: i32 = out_sp();
    let c3: i32 = out_i32(g_rect[1]);
    let c4: i32 = out_sp();
    let c5: i32 = out_i32(g_rect[2]);
    let c6: i32 = out_sp();
    let c7: i32 = out_i32(g_rect[3]);
    let c8: i32 = out_nl();
    let d0: i32 = out_str(ptr("HASH1 "));
    let d1b: i32 = out_i64(h1);
    let d2: i32 = out_nl();
    if (nc0 != nc1) {
        return 14;
    }
    if (g_rect[0] != g_rect0[0] || g_rect[1] != g_rect0[1] || g_rect[2] != g_rect0[2] || g_rect[3] != g_rect0[3]) {
        return 15;
    }
    if (p0 != p1) {
        return 16;
    }
    if (h0 != h1) {
        return 17;
    }
    let ap0: i32 = aui_text_append(110, 65);
    let ap1: i32 = aui_text_append(110, 98);
    let v: ptr = g_text_field.value();
    if (load_u8(v) != 65 || load_u8(v + 1) != 98 || load_u8(v + 2) != 0) {
        return 30;
    }
    let e0: i32 = out_str(ptr("VALUE AB"));
    let e1: i32 = out_nl();
    let cl: i32 = aui_text_clear(110);
    let v2: ptr = g_text_field.value();
    if (load_u8(v2) != 0) {
        return 30;
    }
    aui_root();
    let q: ptr<视图> = aui_spec_new_view();
    if (q == 0) {
        return 20;
    }
    let tp: ptr<文本参数> = aui_spec_new_textparam();
    if (tp == 0) {
        return 20;
    }
    tp.提示 = ptr("Tap to type...");
    q.种 = 10;
    q.名 = ptr("文本框");
    q.键 = 110;
    q.修饰 = 0;
    q.布局值 = 0;
    q.事件 = 0;
    q.子 = 0;
    q.参数 = tp;
    let n5: i32 = aui_debug_node_count();
    let ev: ptr<事件组> = aui_spec_new_evt();
    if (ev == 0) {
        return 20;
    }
    ev.种 = 2;
    ev.闭包 = 0;
    ev.链 = 0;
    q.事件 = ev;
    let qv: 视图 = view_of(q);
    if (aui_mount(qv, 0) == 0) {
        return 20;
    }
    if (aui_last_error() != 113) {
        return 20;
    }
    q.事件 = 0;
    q.参数 = 0;
    let qv2: 视图 = view_of(q);
    if (aui_mount(qv2, 0) == 0) {
        return 21;
    }
    if (aui_last_error() != 112) {
        return 21;
    }
    q.参数 = tp;
    let c: ptr<视图> = aui_spec_new_view();
    if (c == 0) {
        return 22;
    }
    c.种 = 10;
    c.名 = ptr("文本框");
    c.键 = 111;
    c.修饰 = 0;
    c.布局值 = 0;
    c.事件 = 0;
    c.子 = 0;
    c.参数 = tp;
    let kb: i32 = aui_spec_new_kidptrs(1);
    let cp: ptr = c;
    aui_spec_kidptr_set(kb, 0, cp);
    let hd: ptr = aui_spec_kidptr_addr(kb);
    let h: ptr<VecPtr> = aui_spec_new_head(hd, 1);
    q.子 = h;
    let qv3: 视图 = view_of(q);
    if (aui_mount(qv3, 0) == 0) {
        return 22;
    }
    if (aui_last_error() != 112) {
        return 22;
    }
    let n6: i32 = aui_debug_node_count();
    if (n6 != n5) {
        return 23;
    }
    aui_root();
    if (aui_mount(spec, 0) == 0) {
        return 24;
    }
    if (aui_last_error() != 115) {
        return 24;
    }
    let w0: i32 = out_str(ptr("TEXTFIELD PROBE OK"));
    let w1: i32 = out_nl();
    return 0;
}
