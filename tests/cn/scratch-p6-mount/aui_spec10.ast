// ---- slot seq lookup (-1 = not a pool slot of this frame's pool) ----
fn spec_view_seq(p: ptr) -> i32 {
    let cur: i32 = aui_debug_frame_seq();
    let i: i32 = 0;
    while (i < AUI_SPEC_VIEW_CAP) {
        let q: ptr = spec_view_at(i);
        if (p == q) {
            if (g_spec_view_seq[i] == cur) {
                return cur;
            }
            return -2;
        }
        i = i + 1;
    }
    return -1;
}
fn spec_head_seq(p: ptr) -> i32 {
    let cur: i32 = aui_debug_frame_seq();
    let i: i32 = 0;
    while (i < AUI_SPEC_HEAD_CAP) {
        let q: ptr = spec_head_at(i);
        if (p == q) {
            if (g_spec_head_seq[i] == cur) {
