// aster:language=en
// SCRATCH COPY (P6 step-0 probe only): src/aui_spec.ast + kind-10
// (text field) branch. NOT the real file; do not ship.
// aui_spec.ast — ViewSpec (D-2b, P5). Narrow spec + mount + dump.
//
// Shape: phase1-p5-spec.md §0 (evaluation §9.2 verbatim field order).
// Frame pool: fixed-capacity pools + bump indices, same discipline as
// the node pool (aui_core.ast): reset lazily when g_aui_frame_seq
// changes (equivalent to resetting in aui_root; avoids touching
// aui_build.ast), sealed frames refuse mount (aui_frame.ast:2011/3777),
// every pool slot records its creation frame seq, mount/dump refuse
// stale slots (A-10x) instead of reading dirty data. Capacity
// exhaustion returns a diagnosable error, never silently drops.
// Children: `子` is ptr<VecPtr> to a frame-pool head; the head's data
// points at a run of child pointers in the kidptr pool; children are
// read with read-only vecptr_get. vecptr_init/push/free are NEVER
// used (grow-only arena, one leak per build).
// Grow (decision (c)): mount returns AUI_ERR_SPEC_GROW ("框架未提供
// aui_grow", same wording as the D-2a compiler rejection) whenever
// 布局值.生长 != -1; spec shape and dump still record the value.
// Mount wires only kind 25 (select) / 26 (option) this round (W-O3);
// any other kind fails the 参数块与种匹配 check (AUI_ERR_SPEC_PARAM).
// Strict build: every struct field is assigned explicitly (locals and
// pool slots alike); no warnings allowed.
//
// Error codes (A-10x; 100-104 and 120-122 already taken):
//   110 kind out of range, 111 key == 0, 112 param/kind mismatch,
//   113 event mismatch, 114 grow not wired, 115 stale slot / sealed
//   frame, 116 pool full, 117 bad child pointer, 118 nesting too deep.
struct 视图 {
    种: i32,
    名: ptr,
    键: i32,
    修饰: ptr,
    布局值: ptr,
    事件: ptr,
    子: ptr<VecPtr>,
    参数: ptr
}
struct 修饰 {
    内边距: i32,
    间隙: i32,
    背景: i32,
    圆角: i32,
    字号: i32,
    前景色: i32,
    长按选中: i32,
    尺寸: ptr
}
struct 布局值 {
    权重: i32,
    对齐: i32,
    生长: i32
}
struct 事件组 {
    种: i32,
    闭包: ptr,
    链: ptr
}
struct 尺寸值 {
    宽: i32,
    高: i32
}
struct 选择参数 {
    选中: i32,
    打开: i32,
    占位: ptr
}
struct 选项参数 {
    文本: ptr
}
struct 文本参数 {
    提示: ptr
}
let AUI_ERR_SPEC_KIND: i32 = 110;
let AUI_ERR_SPEC_KEY: i32 = 111;
let AUI_ERR_SPEC_PARAM: i32 = 112;
let AUI_ERR_SPEC_EVENT: i32 = 113;
let AUI_ERR_SPEC_GROW: i32 = 114;
