// ---- freshness (0 = ok, else error code; no semantic checks) ----
fn spec_fresh_evt(e: ptr) -> i32 {
    if (e == 0) {
        return 0;
    }
    if (spec_evt_seq(e) < 0) {
        return AUI_ERR_SPEC_STALE;
    }
    let ep: ptr<事件组> = e;
    if (ep.链 != 0) {
        return spec_fresh_evt(ep.链);
    }
    return 0;
}
fn spec_fresh_at(v: ptr<视图>, depth: i32) -> i32 {
    if (depth > AUI_SPEC_MAX_DEPTH) {
        return AUI_ERR_SPEC_DEPTH;
    }
    if (v.修饰 != 0) {
        if (spec_mod_seq(v.修饰) < 0) {
            return AUI_ERR_SPEC_STALE;
        }
        let m: ptr<修饰> = v.修饰;
        if (m.尺寸 != 0) {
            if (spec_size_seq(m.尺寸) < 0) {
                return AUI_ERR_SPEC_STALE;
            }
        }
    }
    if (v.布局值 != 0) {
        if (spec_lay_seq(v.布局值) < 0) {
            return AUI_ERR_SPEC_STALE;
        }
    }
    let fe: i32 = spec_fresh_evt(v.事件);
    if (fe != 0) {
        return fe;
    }
    if (v.参数 != 0) {
        if (v.种 == 25) {
            if (spec_selparam_seq(v.参数) < 0) {
                return AUI_ERR_SPEC_STALE;
            }
        } else if (v.种 == 26) {
            if (spec_optparam_seq(v.参数) < 0) {
                return AUI_ERR_SPEC_STALE;
            }
        } else if (v.种 == 10) {
            if (spec_txtparam_seq(v.参数) < 0) {
                return AUI_ERR_SPEC_STALE;
            }
        }
    }
    if (v.子 != 0) {
        if (spec_head_seq(v.子) < 0) {
            return AUI_ERR_SPEC_STALE;
        }
        let h: ptr<VecPtr> = v.子;
        let i: i32 = 0;
        while (i < h.count) {
            let cp: ptr = vecptr_get(v.子, i);
            if (cp == 0) {
                return AUI_ERR_SPEC_CHILD;
            }
            if (spec_view_seq(cp) < 0) {
                return AUI_ERR_SPEC_CHILD;
            }
            let cv: ptr<视图> = cp;
            let r: i32 = spec_fresh_at(cv, depth + 1);
            if (r != 0) {
                return r;
            }
            i = i + 1;
        }
    }
    return 0;
}
// ---- validation (freshness + semantics; 0 = ok, else error code) ----
fn spec_validate_at(v: ptr<视图>, depth: i32) -> i32 {
    let f: i32 = spec_fresh_at(v, depth);
    if (f != 0) {
        return f;
    }
    let kind: i32 = v.种;
    if (kind < 1 || kind > 64) {
        return AUI_ERR_SPEC_KIND;
    }
    if (v.键 == 0) {
        return AUI_ERR_SPEC_KEY;
    }
    if (kind == 25) {
        if (v.参数 == 0) {
            return AUI_ERR_SPEC_PARAM;
        }
        if (v.事件 == 0) {
            return AUI_ERR_SPEC_EVENT;
        }
        let ev: ptr<事件组> = v.事件;
        if (ev.种 != 2) {
            return AUI_ERR_SPEC_EVENT;
        }
    } else if (kind == 26) {
        if (v.参数 == 0) {
            return AUI_ERR_SPEC_PARAM;
        }
        if (v.事件 != 0) {
            return AUI_ERR_SPEC_EVENT;
        }
    } else if (kind == 10) {
        if (v.参数 == 0) {
            return AUI_ERR_SPEC_PARAM;
        }
        if (v.事件 != 0) {
            return AUI_ERR_SPEC_EVENT;
        }
        if (v.子 != 0) {
            return AUI_ERR_SPEC_PARAM;
        }
    } else {
        return AUI_ERR_SPEC_PARAM;
    }
    if (v.布局值 != 0) {
        let l: ptr<布局值> = v.布局值;
        if (l.生长 != -1) {
            return AUI_ERR_SPEC_GROW;
        }
    }
    if (v.子 != 0) {
        let h: ptr<VecPtr> = v.子;
        let i: i32 = 0;
        while (i < h.count) {
            let cp: ptr = vecptr_get(v.子, i);
            let cv: ptr<视图> = cp;
            let r: i32 = spec_validate_at(cv, depth + 1);
            if (r != 0) {
                return r;
            }
            i = i + 1;
        }
    }
    return 0;
}
// ---- emission helpers (only called after full validation) ----
fn spec_apply_mod(m: ptr, kind: i32) -> i32 {
    let mp: ptr<修饰> = m;
    if (mp.内边距 != 0) {
        aui_pad(mp.内边距);
    }
    if (mp.间隙 != 0) {
        aui_gap(mp.间隙);
    }
    if (mp.背景 >= 0) {
        let c: u32 = aui_theme_color(mp.背景);
        aui_bg(c);
    }
    if (mp.圆角 != -1) {
        aui_radius(mp.圆角);
    }
    if (mp.字号 != -1) {
        if (kind == 5 || kind == 6) {
            aui_text_size(mp.字号);
        }
    }
    if (mp.前景色 != -1) {
        aui_fg(u32(mp.前景色));
    }
    if (mp.长按选中 != 0) {
        aui_selectable(1);
    }
    if (mp.尺寸 != 0) {
        let z: ptr<尺寸值> = mp.尺寸;
        aui_size(z.宽, z.高);
    }
    return 0;
}
fn spec_apply_lay(l: ptr) -> i32 {
    let lp: ptr<布局值> = l;
    if (lp.权重 > 0) {
        aui_weight(lp.权重);
    }
    if (lp.对齐 != -1) {
        aui_align(lp.对齐);
    }
    return 0;
}
fn spec_emit_at(v: ptr<视图>, user: ptr, depth: i32) -> i32 {
    let kind: i32 = v.种;
    if (kind == 25) {
        let sp: ptr<选择参数> = v.参数;
        let ev: ptr<事件组> = v.事件;
        let r: i32 = aui_select(v.键, sp.选中, sp.打开, sp.占位, ev.闭包, user);
        if (r < 0) {
            return -1;
        }
    } else if (kind == 26) {
        let op: ptr<选项参数> = v.参数;
        let r2: i32 = aui_option(v.键, op.文本);
        if (r2 < 0) {
            return -1;
        }
    } else if (kind == 10) {
        let tp: ptr<文本参数> = v.参数;
        let r3: i32 = aui_text_field(v.键, tp.提示);
        if (r3 < 0) {
            return -1;
        }
    } else {
        return AUI_ERR_SPEC_PARAM;
    }
    if (v.修饰 != 0) {
        let rm: i32 = spec_apply_mod(v.修饰, kind);
    }
    if (v.布局值 != 0) {
        let rl: i32 = spec_apply_lay(v.布局值);
    }
    if (v.子 != 0) {
        let h: ptr<VecPtr> = v.子;
        let i: i32 = 0;
        while (i < h.count) {
            let cp: ptr = vecptr_get(v.子, i);
            let cv: ptr<视图> = cp;
            let rc: i32 = spec_emit_at(cv, user, depth + 1);
            if (rc != 0) {
                return rc;
            }
            i = i + 1;
        }
        let re: i32 = aui_end();
    }
    return 0;
}
// ---- mount: validate first, emit nothing on failure ----
fn aui_mount(spec: 视图, user: ptr) -> i32 {
    if (aui_debug_frame_sealed() != 0) {
        return aui_set_err(AUI_ERR_SPEC_STALE);
    }
    let root: 视图;
    root.种 = spec.种;
    root.名 = spec.名;
    root.键 = spec.键;
    root.修饰 = spec.修饰;
    root.布局值 = spec.布局值;
    root.事件 = spec.事件;
    root.子 = spec.子;
    root.参数 = spec.参数;
    let rv: i32 = spec_validate_at(&root, 0);
    if (rv != 0) {
        return aui_set_err(rv);
    }
    let re: i32 = spec_emit_at(&root, user, 0);
    if (re != 0) {
        if (re > 0) {
            return aui_set_err(re);
        }
        return re;
    }
    return 0;
}
// ---- dump line builders (single write_all per line) ----
fn spec_put_ch(at: i32, ch: i32) -> i32 {
    if (at >= 1020) {
        return 1020;
    }
    store_u8(g_spec_line_ptr + at, ch);
    return at + 1;
}
fn spec_put_str(at: i32, s: ptr) -> i32 {
    if (s == 0) {
        return at;
    }
    let i: i32 = 0;
    while (1) {
        let c: i32 = load_u8(s + i);
        if (c == 0) {
            break;
        }
        at = spec_put_ch(at, c);
        i = i + 1;
    }
    return at;
}
fn spec_put_i32(at: i32, v: i32) -> i32 {
    if (at >= 1020) {
        return 1020;
    }
    let n: i32 = fmt_i32(g_spec_line_ptr + at, v);
    at = at + n;
    if (at > 1020) {
        return 1020;
    }
    return at;
}
fn spec_dump_evt(at: i32, e: ptr) -> i32 {
    if (e == 0) {
        at = spec_put_ch(at, 45);
        return at;
    }
    let ep: ptr<事件组> = e;
    at = spec_put_ch(at, 91);
    at = spec_put_str(at, ptr("种="));
    at = spec_put_i32(at, ep.种);
    at = spec_put_ch(at, 32);
    at = spec_put_str(at, ptr("闭包="));
    if (ep.闭包 == 0) {
        at = spec_put_i32(at, 0);
    } else {
        at = spec_put_i32(at, 1);
    }
    if (ep.链 != 0) {
        at = spec_put_ch(at, 32);
        at = spec_put_str(at, ptr("链="));
        at = spec_dump_evt(at, ep.链);
    }
    at = spec_put_ch(at, 93);
    return at;
}
fn spec_dump_at(v: ptr<视图>, depth: i32) -> i32 {
    let at: i32 = 0;
    at = spec_put_str(at, ptr("SPEC "));
    at = spec_put_i32(at, depth);
    at = spec_put_ch(at, 32);
    at = spec_put_str(at, ptr("种="));
    at = spec_put_i32(at, v.种);
    at = spec_put_ch(at, 32);
    at = spec_put_str(at, ptr("名="));
    at = spec_put_str(at, v.名);
    at = spec_put_ch(at, 32);
    at = spec_put_str(at, ptr("键="));
    at = spec_put_i32(at, v.键);
    at = spec_put_ch(at, 32);
    at = spec_put_str(at, ptr("修饰="));
    if (v.修饰 == 0) {
        at = spec_put_ch(at, 45);
    } else {
        let m: ptr<修饰> = v.修饰;
        at = spec_put_ch(at, 91);
        at = spec_put_str(at, ptr("内边距="));
        at = spec_put_i32(at, m.内边距);
        at = spec_put_ch(at, 32);
        at = spec_put_str(at, ptr("间隙="));
        at = spec_put_i32(at, m.间隙);
        at = spec_put_ch(at, 32);
        at = spec_put_str(at, ptr("背景="));
        at = spec_put_i32(at, m.背景);
        at = spec_put_ch(at, 32);
        at = spec_put_str(at, ptr("圆角="));
        at = spec_put_i32(at, m.圆角);
        at = spec_put_ch(at, 32);
        at = spec_put_str(at, ptr("字号="));
        at = spec_put_i32(at, m.字号);
        at = spec_put_ch(at, 32);
        at = spec_put_str(at, ptr("前景色="));
        at = spec_put_i32(at, m.前景色);
        at = spec_put_ch(at, 32);
        at = spec_put_str(at, ptr("长按选中="));
        at = spec_put_i32(at, m.长按选中);
        at = spec_put_ch(at, 32);
        at = spec_put_str(at, ptr("尺寸="));
        if (m.尺寸 == 0) {
            at = spec_put_ch(at, 45);
        } else {
            let z: ptr<尺寸值> = m.尺寸;
            at = spec_put_i32(at, z.宽);
            at = spec_put_ch(at, 120);
            at = spec_put_i32(at, z.高);
        }
        at = spec_put_ch(at, 93);
    }
    at = spec_put_ch(at, 32);
    at = spec_put_str(at, ptr("布局值="));
    if (v.布局值 == 0) {
        at = spec_put_ch(at, 45);
    } else {
        let l: ptr<布局值> = v.布局值;
        at = spec_put_ch(at, 91);
        at = spec_put_str(at, ptr("权重="));
        at = spec_put_i32(at, l.权重);
        at = spec_put_ch(at, 32);
        at = spec_put_str(at, ptr("对齐="));
        at = spec_put_i32(at, l.对齐);
        at = spec_put_ch(at, 32);
        at = spec_put_str(at, ptr("生长="));
        at = spec_put_i32(at, l.生长);
        at = spec_put_ch(at, 93);
    }
    at = spec_put_ch(at, 32);
    at = spec_put_str(at, ptr("事件="));
    at = spec_dump_evt(at, v.事件);
    at = spec_put_ch(at, 32);
    at = spec_put_str(at, ptr("参数="));
    if (v.参数 == 0) {
        at = spec_put_ch(at, 45);
    } else if (v.种 == 25) {
        let s: ptr<选择参数> = v.参数;
        at = spec_put_ch(at, 91);
        at = spec_put_str(at, ptr("选中="));
        at = spec_put_i32(at, s.选中);
        at = spec_put_ch(at, 32);
        at = spec_put_str(at, ptr("打开="));
        at = spec_put_i32(at, s.打开);
        at = spec_put_ch(at, 32);
        at = spec_put_str(at, ptr("占位="));
        at = spec_put_str(at, s.占位);
        at = spec_put_ch(at, 93);
    } else if (v.种 == 26) {
        let o: ptr<选项参数> = v.参数;
        at = spec_put_ch(at, 91);
        at = spec_put_str(at, ptr("文本="));
        at = spec_put_str(at, o.文本);
        at = spec_put_ch(at, 93);
    } else if (v.种 == 10) {
        let t: ptr<文本参数> = v.参数;
        at = spec_put_ch(at, 91);
        at = spec_put_str(at, ptr("提示="));
        at = spec_put_str(at, t.提示);
        at = spec_put_ch(at, 93);
    } else {
        at = spec_put_ch(at, 91);
        at = spec_put_ch(at, 63);
        at = spec_put_ch(at, 93);
    }
    at = spec_put_ch(at, 32);
    at = spec_put_str(at, ptr("子="));
    let n: i32 = 0;
    if (v.子 != 0) {
        let h: ptr<VecPtr> = v.子;
        n = h.count;
    }
    at = spec_put_i32(at, n);
    at = spec_put_ch(at, 10);
    let w: i32 = write_all(1, g_spec_line_ptr, at);
    let lines: i32 = 1;
    if (v.子 != 0) {
        let h2: ptr<VecPtr> = v.子;
        let i: i32 = 0;
        while (i < h2.count) {
            let cp: ptr = vecptr_get(v.子, i);
            let cv: ptr<视图> = cp;
            let r: i32 = spec_dump_at(cv, depth + 1);
            if (r < 0) {
                return r;
            }
            lines = lines + r;
            i = i + 1;
        }
    }
    return lines;
}
// ---- dump: freshness-checked only (prints any kind, even a spec
// mount would reject); returns lines printed, -1 + last error if stale ----
fn aui_spec_dump(spec: 视图) -> i32 {
    let root: 视图;
    root.种 = spec.种;
    root.名 = spec.名;
    root.键 = spec.键;
    root.修饰 = spec.修饰;
    root.布局值 = spec.布局值;
    root.事件 = spec.事件;
    root.子 = spec.子;
    root.参数 = spec.参数;
    let rv: i32 = spec_fresh_at(&root, 0);
    if (rv != 0) {
        return aui_set_err(rv);
    }
    return spec_dump_at(&root, 0);
}
// ---- debug: struct size (capacity accounting; suite scratch only) ----
fn aui_spec_sizeof_view() -> i32 {
    return sizeof(视图);
}
