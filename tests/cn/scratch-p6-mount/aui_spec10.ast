let AUI_SPEC_HEAD_CAP: i32 = 6;
let AUI_SPEC_KID_CAP: i32 = 32;
let AUI_SPEC_MOD_CAP: i32 = 8;
let AUI_SPEC_LAY_CAP: i32 = 6;
let AUI_SPEC_EVT_CAP: i32 = 8;
let AUI_SPEC_SEL_CAP: i32 = 6;
let AUI_SPEC_OPT_CAP: i32 = 8;
let AUI_SPEC_TXT_CAP: i32 = 6;
let AUI_SPEC_SIZE_CAP: i32 = 8;
let AUI_SPEC_MAX_DEPTH: i32 = 32;
extern fn aui_set_err(code: i32) -> i32;
extern fn aui_debug_frame_seq() -> i32;
extern fn aui_debug_frame_sealed() -> i32;
extern fn vecptr_get(v: ptr<VecPtr>, i: i32) -> ptr;
extern fn aui_theme_color(role: i32) -> u32;
