extern fn aui_selectable(flag: i32) -> i32;
extern fn aui_size(w: i32, h: i32) -> i32;
extern fn aui_weight(w: i32) -> i32;
extern fn aui_align(a: i32) -> i32;
extern fn aui_select(key: i32, selected: i32, open: i32, placeholder: ptr, cb: fn(ptr) -> i32, user: ptr) -> i32;
extern fn aui_option(key: i32, text: ptr) -> i32;
extern fn aui_text_field(key: i32, hint: ptr) -> i32;
extern fn aui_end() -> i32;
extern fn fmt_i32(buf: ptr<u8>, v: i32) -> i32;
extern fn write_all(fd: i32, buf: ptr<u8>, n: i32) -> i32;
// ---- frame pools (node-pool pattern: i64 backing + typed alias) ----
let g_spec_frame: i32 = -1;
let g_spec_view_pool: i64[128] = 0;
let g_spec_views: ptr<视图> = g_spec_view_pool;
let g_spec_view_next: i32 = 0;
let g_spec_view_seq: i32[12] = 0;
let g_spec_head_pool: i64[16] = 0;
let g_spec_heads: ptr<VecPtr> = g_spec_head_pool;
let g_spec_head_next: i32 = 0;
let g_spec_head_seq: i32[6] = 0;
let g_spec_kid_pool: i64[32] = 0;
let g_spec_kids: ptr = g_spec_kid_pool;
let g_spec_kid_next: i32 = 0;
let g_spec_mod_pool: i64[64] = 0;
let g_spec_mods: ptr<修饰> = g_spec_mod_pool;
let g_spec_mod_next: i32 = 0;
let g_spec_mod_seq: i32[8] = 0;
let g_spec_lay_pool: i64[16] = 0;
let g_spec_lays: ptr<布局值> = g_spec_lay_pool;
let g_spec_lay_next: i32 = 0;
let g_spec_lay_seq: i32[6] = 0;
let g_spec_evt_pool: i64[32] = 0;
let g_spec_evts: ptr<事件组> = g_spec_evt_pool;
let g_spec_evt_next: i32 = 0;
let g_spec_evt_seq: i32[8] = 0;
let g_spec_sel_pool: i64[16] = 0;
let g_spec_sels: ptr<选择参数> = g_spec_sel_pool;
let g_spec_sel_next: i32 = 0;
let g_spec_sel_seq: i32[6] = 0;
let g_spec_opt_pool: i64[16] = 0;
let g_spec_opts: ptr<选项参数> = g_spec_opt_pool;
let g_spec_opt_next: i32 = 0;
let g_spec_opt_seq: i32[8] = 0;
let g_spec_txt_pool: i64[8] = 0;
let g_spec_txts: ptr<文本参数> = g_spec_txt_pool;
let g_spec_txt_next: i32 = 0;
let g_spec_txt_seq: i32[6] = 0;
let g_spec_size_pool: i64[16] = 0;
let g_spec_sizes: ptr<尺寸值> = g_spec_size_pool;
let g_spec_size_next: i32 = 0;
let g_spec_size_seq: i32[8] = 0;
let g_spec_line: u8[1024] = 0;
let g_spec_line_ptr: ptr<u8> = g_spec_line;
// ---- slot access (node_at pattern: pointer + is byte-wise, scale by
// sizeof explicitly; a bare +1 would land one byte past the slot) ----
fn spec_view_at(i: i32) -> ptr<视图> {
    return g_spec_views + i * sizeof(视图);
}
fn spec_head_at(i: i32) -> ptr<VecPtr> {
    return g_spec_heads + i * sizeof(VecPtr);
}
fn spec_mod_at(i: i32) -> ptr<修饰> {
    return g_spec_mods + i * sizeof(修饰);
}
fn spec_lay_at(i: i32) -> ptr<布局值> {
    return g_spec_lays + i * sizeof(布局值);
}
fn spec_evt_at(i: i32) -> ptr<事件组> {
    return g_spec_evts + i * sizeof(事件组);
}
fn spec_sel_at(i: i32) -> ptr<选择参数> {
    return g_spec_sels + i * sizeof(选择参数);
}
fn spec_opt_at(i: i32) -> ptr<选项参数> {
    return g_spec_opts + i * sizeof(选项参数);
}
fn spec_txt_at(i: i32) -> ptr<文本参数> {
    return g_spec_txts + i * sizeof(文本参数);
}
fn spec_size_at(i: i32) -> ptr<尺寸值> {
    return g_spec_sizes + i * sizeof(尺寸值);
}
// ---- frame begin (lazy reset on seq change; see header) ----
fn aui_spec_frame_begin() -> i32 {
    let cur: i32 = aui_debug_frame_seq();
    if (g_spec_frame != cur) {
        g_spec_frame = cur;
        g_spec_view_next = 0;
        g_spec_head_next = 0;
        g_spec_kid_next = 0;
        g_spec_mod_next = 0;
        g_spec_lay_next = 0;
        g_spec_evt_next = 0;
        g_spec_sel_next = 0;
        g_spec_opt_next = 0;
        g_spec_txt_next = 0;
        g_spec_size_next = 0;
    }
    return cur;
}
// ---- allocators (0 = full + aui_last_error set; slots fully init) ----
fn aui_spec_new_view() -> ptr {
    let cur: i32 = aui_spec_frame_begin();
    if (g_spec_view_next >= AUI_SPEC_VIEW_CAP) {
        let e: i32 = aui_set_err(AUI_ERR_SPEC_FULL);
        return 0;
    }
    let v: ptr<视图> = spec_view_at(g_spec_view_next);
    v.种 = 0;
    v.名 = 0;
    v.键 = 0;
    v.修饰 = 0;
    v.布局值 = 0;
    v.事件 = 0;
    v.子 = 0;
    v.参数 = 0;
    g_spec_view_seq[g_spec_view_next] = cur;
    g_spec_view_next = g_spec_view_next + 1;
    let r: ptr = v;
    return r;
}
fn aui_spec_new_views(n: i32) -> ptr {
    let cur: i32 = aui_spec_frame_begin();
    if (n <= 0) {
        return 0;
    }
    if (g_spec_view_next + n > AUI_SPEC_VIEW_CAP) {
        let e: i32 = aui_set_err(AUI_ERR_SPEC_FULL);
        return 0;
    }
    let base: ptr<视图> = spec_view_at(g_spec_view_next);
    let i: i32 = 0;
    while (i < n) {
        let v: ptr<视图> = spec_view_at(g_spec_view_next + i);
        v.种 = 0;
        v.名 = 0;
        v.键 = 0;
        v.修饰 = 0;
        v.布局值 = 0;
        v.事件 = 0;
        v.子 = 0;
        v.参数 = 0;
        g_spec_view_seq[g_spec_view_next + i] = cur;
        i = i + 1;
    }
    g_spec_view_next = g_spec_view_next + n;
    let r: ptr = base;
    return r;
}
fn aui_spec_new_head(data: ptr, n: i32) -> ptr {
    let cur: i32 = aui_spec_frame_begin();
    if (g_spec_head_next >= AUI_SPEC_HEAD_CAP) {
        let e: i32 = aui_set_err(AUI_ERR_SPEC_FULL);
        return 0;
    }
    let h: ptr<VecPtr> = spec_head_at(g_spec_head_next);
    h.data = data;
    h.count = n;
    h.cap = n;
    g_spec_head_seq[g_spec_head_next] = cur;
    g_spec_head_next = g_spec_head_next + 1;
    let r: ptr = h;
    return r;
}
fn aui_spec_new_kidptrs(n: i32) -> i32 {
    let cur: i32 = aui_spec_frame_begin();
    if (n <= 0) {
        return -1;
    }
    if (g_spec_kid_next + n > AUI_SPEC_KID_CAP) {
        let e: i32 = aui_set_err(AUI_ERR_SPEC_FULL);
        return -1;
    }
    let base: i32 = g_spec_kid_next;
    g_spec_kid_next = g_spec_kid_next + n;
    return base;
}
fn aui_spec_kidptr_set(base: i32, i: i32, p: ptr) -> i32 {
    store_i64(g_spec_kids + (base + i) * 8, i64(p));
    return 0;
}
fn aui_spec_kidptr_addr(base: i32) -> ptr {
    return g_spec_kids + base * 8;
}
fn aui_spec_new_mod() -> ptr {
    let cur: i32 = aui_spec_frame_begin();
    if (g_spec_mod_next >= AUI_SPEC_MOD_CAP) {
        let e: i32 = aui_set_err(AUI_ERR_SPEC_FULL);
        return 0;
