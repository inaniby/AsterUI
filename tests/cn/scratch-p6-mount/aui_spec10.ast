    let m: ptr<修饰> = spec_mod_at(g_spec_mod_next);
    m.内边距 = 0;
    m.间隙 = 0;
    m.背景 = -1;
    m.圆角 = -1;
    m.字号 = -1;
    m.前景色 = -1;
    m.长按选中 = 0;
    m.尺寸 = 0;
    g_spec_mod_seq[g_spec_mod_next] = cur;
    g_spec_mod_next = g_spec_mod_next + 1;
    let r: ptr = m;
    return r;
}
