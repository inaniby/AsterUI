// driver.ast — D-2a A 轨回归探针：只用旧 API 的树。
// 用途：证明未用新 API 时，框架改动前后的快照逐字节不变。
// 基线（改动前框架跑出）见 baseline.snapshot；run.sh 逐字节 diff。
// 退出码：0 通过（由 run.sh 按快照判定）；1 渲染失败；90 字体缺失。
extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_set_font(font: ptr, scale: i32) -> i32;
extern fn aui_headless_init(build: fn(ptr) -> i32, user: ptr) -> i32;
extern fn aui_headless_render(w: i32, h: i32, out: ptr) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_root() -> i32;
extern fn aui_end() -> i32;
extern fn aui_column(key: i32) -> i32;
extern fn aui_row(key: i32) -> i32;
extern fn aui_pad(dp: i32) -> i32;
extern fn aui_gap(dp: i32) -> i32;
extern fn aui_bg(color: u32) -> i32;
extern fn aui_label(key: i32, text: ptr) -> i32;
extern fn aui_text_role(role: i32) -> i32;
extern fn aui_button(key: i32, text: ptr, cb: fn(ptr) -> i32, user: ptr) -> i32;
extern fn aui_checkbox(key: i32, text: ptr, checked: i32, cb: fn(ptr) -> i32, user: ptr) -> i32;
extern fn write_all(fd: i32, buf: ptr, n: i32) -> i32;
extern fn fmt_i32(buf: ptr, v: i32) -> i32;
extern fn fmt_i64(buf: ptr, v: i64) -> i32;
extern fn strlen(s: ptr) -> i32;
let W: i32 = 480;
let H: i32 = 880;
let g_buf: i32[422400] = 0;
let g_font: ptr = 0;
let g_rect: i32[4] = 0;
let g_num: u8[32] = 0;
fn out_str(s: ptr) -> i32 {
    return write_all(1, s, strlen(s));
}
fn out_i32(v: i32) -> i32 {
    let n: i32 = fmt_i32(g_num, v);
    return write_all(1, g_num, n);
}
fn out_i64(v: i64) -> i32 {
    let n: i32 = fmt_i64(g_num, v);
    return write_all(1, g_num, n);
}
fn out_sp() -> i32 {
    return write_all(1, ptr(" "), 1);
}
fn out_nl() -> i32 {
    return write_all(1, ptr("\n"), 1);
}
fn emit_rect(key: i32) -> i32 {
    if (aui_debug_rect(key, g_rect) != 0) {
        return 1;
    }
    let s1: i32 = out_str(ptr("RECT "));
    let s2: i32 = out_i32(key);
    let s3: i32 = out_sp();
    let s4: i32 = out_i32(g_rect[0]);
    let s5: i32 = out_sp();
    let s6: i32 = out_i32(g_rect[1]);
    let s7: i32 = out_sp();
    let s8: i32 = out_i32(g_rect[2]);
    let s9: i32 = out_sp();
    let sa: i32 = out_i32(g_rect[3]);
    let sb: i32 = out_nl();
    return 0;
}
fn emit_pixelhash(name: ptr) -> i32 {
    let h: i64 = -3750763034362895579;
    let i: i32 = 0;
    while (i < W * H * 4) {
        let b: i32 = load_u8(g_buf + i);
        h = (h ^ b) * 1099511628211;
        i = i + 1;
    }
    let s1: i32 = out_str(ptr("PIXELHASH "));
    let s2: i32 = out_str(name);
    let s3: i32 = out_sp();
    let s4: i32 = out_i64(h);
    let s5: i32 = out_nl();
    return 0;
}
fn cb_noop(user: ptr) -> i32 {
    return 0;
}
fn build(user: ptr) -> i32 {
    aui_root();
    aui_column(1);
    aui_pad(16);
    aui_gap(8);
    aui_bg(0xFF202124);
    aui_label(10, "Hello D2A");
    aui_label(11, "Second line");
    aui_text_role(2);
    aui_button(12, "Tap", cb_noop, 0);
    aui_row(13);
    aui_label(14, "A");
    aui_label(15, "B");
    aui_end();
    aui_checkbox(16, "Check", 0, cb_noop, 0);
    aui_end();
    return 0;
}
fn main() -> i32 {
    let font_ok: i32 = aui_rt_set_font_path(ptr("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"));
    if (font_ok != 1) {
        return 90;
    }
    aui_set_font(g_font, 1);
    aui_headless_init(build, 0);
    let n0: i32 = aui_headless_render(W, H, g_buf);
    if (n0 <= 0) {
        return 1;
    }
    let a: i32 = emit_rect(1);
    let b: i32 = emit_rect(10);
    let c: i32 = emit_rect(11);
    let d: i32 = emit_rect(12);
    let e: i32 = emit_rect(13);
    let f: i32 = emit_rect(14);
    let g: i32 = emit_rect(15);
    let h: i32 = emit_rect(16);
    let p: i32 = emit_pixelhash(ptr("main"));
    return 0;
}
