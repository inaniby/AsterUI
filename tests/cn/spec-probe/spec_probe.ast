// spec_probe.ast — P5 cn-spec-checks 探针驱动（英文）。
//
// 退出码：0 通过；90 字体；91 渲染失败；12 dump 行数；13 mount 失败；
// 14/15 节点数；16/17 过期；18/19 生长；30-35 修饰/布局挂载；
// 40-43 校验失败；50/51 背景哈希。
// stdout：dump 行（[2/3] 比对用）+ RECT/D2A/HASH 行（[3/3] 记录用）。
// 注意：本驱动列进探针工程，故 std 的 write_all/fmt_i32/fmt_i64/
// strlen 须按 stdlib 定义一字不差（ptr<u8> 参数）声明；aui_* 按
// aui.ast / select_probe 的写法声明。
extern fn aui_root() : i32;
extern fn aui_column(key: i32) : i32;
extern fn aui_row(key: i32) : i32;
extern fn aui_label(key: i32, text: ptr) : i32;
extern fn aui_end() : i32;
extern fn aui_select(key: i32, selected: i32, open: i32, placeholder: ptr, cb: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_option(key: i32, text: ptr) : i32;
extern fn aui_bg(color: u32) : i32;
extern fn aui_size(w: i32, h: i32) : i32;
extern fn aui_weight(w: i32) : i32;
extern fn aui_theme_color(role: i32) : u32;
extern fn aui_debug_rect(key: i32, out: ptr) : i32;
extern fn aui_debug_d2a(key: i32, out: ptr) : i32;
extern fn aui_debug_node_count() : i32;
extern fn aui_last_error() : i32;
extern fn aui_headless_init(build: fn(ptr) : i32, user: ptr) : i32;
extern fn aui_headless_render(w: i32, h: i32, out: ptr) : i32;
extern fn aui_invalidate() : i32;
extern fn aui_rt_set_font_path(path: ptr) : i32;
extern fn aui_set_font(font: ptr, scale: i32) : i32;
extern fn aui_spec_new_views(n: i32) : ptr;
extern fn aui_spec_new_view() : ptr;
extern fn aui_spec_new_head(data: ptr, n: i32) : ptr;
extern fn aui_spec_new_kidptrs(n: i32) : i32;
extern fn aui_spec_kidptr_set(base: i32, i: i32, p: ptr) : i32;
extern fn aui_spec_kidptr_addr(base: i32) : ptr;
extern fn aui_spec_new_mod() : ptr;
extern fn aui_spec_new_lay() : ptr;
extern fn aui_spec_new_evt() : ptr;
extern fn aui_spec_new_selparam() : ptr;
extern fn aui_spec_new_optparam() : ptr;
extern fn aui_spec_new_size() : ptr;
extern fn aui_mount(spec: 视图, user: ptr) : i32;
extern fn aui_spec_dump(spec: 视图) : i32;
extern fn write_all(fd: i32, buf: ptr<u8>, n: i32) : i32;
extern fn fmt_i32(buf: ptr<u8>, v: i32) : i32;
extern fn fmt_i64(buf: ptr<u8>, v: i64) : i32;
extern fn strlen(s: ptr<u8>) : i32;
let W: i32 = 480;
let H: i32 = 880;
let g_buf: i32[422400] = 0;
let g_font: ptr = 0;
let g_rect: i32[4] = 0;
let g_d2a: i32[6] = 0;
let g_num: u8[32] = 0;
let g_mode: i32 = 0;
fn out_str(s: ptr<u8>) : i32 {
    return write_all(1, s, strlen(s));
}
fn out_i32(v: i32) : i32 {
    let n: i32 = fmt_i32(g_num, v);
    return write_all(1, g_num, n);
}
fn out_i64(v: i64) : i32 {
    let n: i32 = fmt_i64(g_num, v);
    return write_all(1, g_num, n);
}
fn out_sp() : i32 {
    return write_all(1, ptr(" "), 1);
}
fn out_nl() : i32 {
    return write_all(1, ptr("\n"), 1);
}
fn on_spec_event(user: ptr) : i32 {
    return 0;
}
fn view_of(p: ptr<视图>) : 视图 {
    let v: 视图;
    v.种 = p.种;
    v.名 = p.名;
    v.键 = p.键;
    v.修饰 = p.修饰;
    v.布局值 = p.布局值;
    v.事件 = p.事件;
    v.子 = p.子;
    v.参数 = p.参数;
    return v;
}
fn mk_mod(bg: i32, fg: i32, fontsize: i32, sel: i32, w: i32, h: i32) : ptr {
    let m: ptr<修饰> = aui_spec_new_mod();
    m.内边距 = 0;
    m.间隙 = 0;
    m.背景 = bg;
    m.圆角 = -1;
    m.字号 = fontsize;
    m.前景色 = fg;
    m.长按选中 = sel;
    m.尺寸 = 0;
    if (w != -1) {
        let z: ptr<尺寸值> = aui_spec_new_size();
        z.宽 = w;
        z.高 = h;
        m.尺寸 = z;
    }
    let r: ptr = m;
    return r;
}
fn mk_lay(weight: i32, align: i32, grow: i32) : ptr {
    let l: ptr<布局值> = aui_spec_new_lay();
    l.权重 = weight;
    l.对齐 = align;
    l.生长 = grow;
    let r: ptr = l;
    return r;
}
fn mk_select(m: ptr, l: ptr) : 视图 {
    let kp: ptr<视图> = aui_spec_new_views(3);
    let o0: ptr<视图> = kp;
    let o1: ptr<视图> = kp + sizeof(视图);
    let o2: ptr<视图> = kp + 2 * sizeof(视图);
    let op0: ptr<选项参数> = aui_spec_new_optparam();
    op0.文本 = ptr("English");
    let op1: ptr<选项参数> = aui_spec_new_optparam();
    op1.文本 = ptr("German");
    let op2: ptr<选项参数> = aui_spec_new_optparam();
    op2.文本 = ptr("Chinese");
    o0.种 = 26;
    o0.名 = ptr("选项0");
    o0.键 = 131;
    o0.修饰 = 0;
    o0.布局值 = 0;
    o0.事件 = 0;
    o0.子 = 0;
    o0.参数 = op0;
    o1.种 = 26;
    o1.名 = ptr("选项1");
    o1.键 = 132;
    o1.修饰 = 0;
    o1.布局值 = 0;
    o1.事件 = 0;
    o1.子 = 0;
    o1.参数 = op1;
    o2.种 = 26;
    o2.名 = ptr("选项2");
    o2.键 = 133;
    o2.修饰 = 0;
    o2.布局值 = 0;
    o2.事件 = 0;
    o2.子 = 0;
    o2.参数 = op2;
    let kb: i32 = aui_spec_new_kidptrs(3);
    let p0: ptr = o0;
    let p1: ptr = o1;
    let p2: ptr = o2;
    aui_spec_kidptr_set(kb, 0, p0);
    aui_spec_kidptr_set(kb, 1, p1);
    aui_spec_kidptr_set(kb, 2, p2);
    let hd: ptr = aui_spec_kidptr_addr(kb);
    let h: ptr<VecPtr> = aui_spec_new_head(hd, 3);
    let ev: ptr<事件组> = aui_spec_new_evt();
    ev.种 = 2;
    ev.闭包 = on_spec_event;
    ev.链 = 0;
    let sp: ptr<选择参数> = aui_spec_new_selparam();
    sp.选中 = 0;
    sp.打开 = 0;
    sp.占位 = ptr("Choose a language");
    let v: 视图;
    v.种 = 25;
    v.名 = ptr("语言");
    v.键 = 130;
    v.修饰 = m;
    v.布局值 = l;
    v.事件 = ev;
    v.子 = h;
    v.参数 = sp;
    return v;
}
fn pixelhash() : i64 {
    let h: i64 = -3750763034362895579;
    let i: i32 = 0;
    while (i < W * H * 4) {
        let b: i32 = load_u8(g_buf + i);
        h = (h ^ b) * 1099511628211;
        i = i + 1;
    }
    return h;
}
fn build(user: ptr) : i32 {
    aui_root();
    if (g_mode == 10) {
        aui_column(1);
        aui_weight(1);
        aui_label(10, ptr("Hi"));
        let m: ptr = mk_mod(2, -65536, 12, 1, 120, 40);
        let l: ptr = mk_lay(1, -1, -1);
        let s: 视图 = mk_select(m, l);
        aui_mount(s, 0);
        aui_end();
    } else if (g_mode == 11) {
        aui_column(1);
        aui_weight(1);
        aui_label(10, ptr("Hi"));
        let s2: 视图 = mk_select(0, 0);
        aui_mount(s2, 0);
        aui_end();
    } else if (g_mode == 12) {
        aui_row(2);
        aui_label(10, ptr("Hi"));
        aui_size(-1, 120);
        let m3: ptr = mk_mod(-1, -1, -1, 0, 120, 40);
        let l3: ptr = mk_lay(-1, 1, -1);
        let s3: 视图 = mk_select(m3, l3);
        aui_mount(s3, 0);
        aui_end();
    } else if (g_mode == 13) {
        aui_row(2);
        aui_label(10, ptr("Hi"));
        aui_size(-1, 120);
        let m4: ptr = mk_mod(-1, -1, -1, 0, 120, 40);
        let s4: 视图 = mk_select(m4, 0);
        aui_mount(s4, 0);
        aui_end();
    } else if (g_mode == 20) {
        aui_column(1);
        let m5: ptr = mk_mod(2, -1, -1, 0, -1, -1);
        let s5: 视图 = mk_select(m5, 0);
        aui_mount(s5, 0);
        aui_end();
    } else if (g_mode == 21) {
        aui_column(1);
        aui_select(130, 0, 0, ptr("Choose a language"), on_spec_event, 0);
        let c: u32 = aui_theme_color(2);
        aui_bg(c);
        aui_option(131, ptr("English"));
        aui_option(132, ptr("German"));
        aui_option(133, ptr("Chinese"));
        aui_end();
        aui_end();
    }
    return 0;
}
fn render() : i32 {
    let iv: i32 = aui_invalidate();
    return aui_headless_render(W, H, g_buf);
}
fn main() : i32 {
    let font_ok: i32 = aui_rt_set_font_path(ptr("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"));
    if (font_ok != 1) {
        return 90;
    }
    aui_set_font(g_font, 1);
    aui_root();
    g_lang_select.initialize(130, ptr("Choose a language"));
    let spec: 视图 = g_lang_select.build(0, ptr("English"), ptr("German"), ptr("Chinese"));
    let n0: i32 = aui_debug_node_count();
    let d1: i32 = aui_spec_dump(spec);
    if (d1 != 4) {
        return 12;
    }
    let r1: i32 = aui_mount(spec, 0);
    if (r1 != 0) {
        return 13;
    }
    let n1: i32 = aui_debug_node_count();
    if (n1 - n0 != 4) {
        return 14;
    }
    let d2: i32 = aui_spec_dump(spec);
    if (d2 != 4) {
        return 12;
    }
    let r2: i32 = aui_mount(spec, 0);
    if (r2 != 0) {
        return 13;
    }
    let n2: i32 = aui_debug_node_count();
    if (n2 - n1 != 4) {
        return 15;
    }
    aui_root();
    let g1: ptr<视图> = aui_spec_new_view();
    if (g1 == 0) {
        return 18;
    }
    let gl: ptr<布局值> = aui_spec_new_lay();
    if (gl == 0) {
        return 18;
    }
    gl.权重 = -1;
    gl.对齐 = -1;
    gl.生长 = 1;
    let gp: ptr<选项参数> = aui_spec_new_optparam();
    if (gp == 0) {
        return 18;
    }
    gp.文本 = ptr("GrowOpt");
    g1.种 = 26;
    g1.名 = ptr("生长项");
    g1.键 = 141;
    g1.修饰 = 0;
    g1.布局值 = gl;
    g1.事件 = 0;
    g1.子 = 0;
    g1.参数 = gp;
    let gv: 视图 = view_of(g1);
    let dg: i32 = aui_spec_dump(gv);
    if (dg != 1) {
        return 18;
    }
    let n3: i32 = aui_debug_node_count();
    let rg: i32 = aui_mount(gv, 0);
    if (rg == 0) {
        return 18;
    }
    if (aui_last_error() != 114) {
        return 19;
    }
    let n4: i32 = aui_debug_node_count();
    if (n4 != n3) {
        return 15;
    }
    aui_headless_init(build, 0);
    g_mode = 10;
    if (render() <= 0) {
        return 91;
    }
    if (aui_debug_d2a(130, g_d2a) != 0) {
        return 30;
    }
    let p0: i32 = out_str(ptr("D2A10 "));
    let p1: i32 = out_i32(g_d2a[0]);
    let p2: i32 = out_sp();
    let p3: i32 = out_i32(g_d2a[1]);
    let p4: i32 = out_sp();
    let p5: i32 = out_i32(g_d2a[2]);
    let p6: i32 = out_sp();
    let p7: i32 = out_i32(g_d2a[3]);
    let p8: i32 = out_sp();
    let p9: i32 = out_i32(g_d2a[4]);
    let pa: i32 = out_sp();
    let pb: i32 = out_i32(g_d2a[5]);
    let pc: i32 = out_nl();
    if (g_d2a[0] != 120 || g_d2a[1] != 40 || g_d2a[2] != -1 || g_d2a[3] != -65536 || g_d2a[4] != 1 || g_d2a[5] != 1) {
        return 30;
    }
    if (aui_debug_rect(130, g_rect) != 0) {
        return 31;
    }
    let q0: i32 = out_str(ptr("RECT10 h="));
    let q1: i32 = out_i32(g_rect[3]);
    let q2: i32 = out_nl();
    if (g_rect[3] <= 400) {
        return 31;
    }
    g_mode = 11;
    if (render() <= 0) {
        return 91;
    }
    if (aui_debug_rect(130, g_rect) != 0) {
        return 32;
    }
    let rr0: i32 = out_str(ptr("RECT11 h="));
    let rr1: i32 = out_i32(g_rect[3]);
    let rr2: i32 = out_nl();
    if (g_rect[3] >= 200) {
        return 32;
    }
    if (aui_debug_d2a(130, g_d2a) != 0) {
        return 33;
    }
    if (g_d2a[0] != -1 || g_d2a[1] != -1 || g_d2a[2] != -1 || g_d2a[3] != 0 || g_d2a[4] != 0 || g_d2a[5] != 0) {
        return 33;
    }
    g_mode = 12;
    if (render() <= 0) {
        return 91;
    }
    if (aui_debug_rect(130, g_rect) != 0) {
        return 34;
    }
    let y12: i32 = g_rect[1];
    if (aui_debug_rect(10, g_rect) != 0) {
        return 34;
    }
    let y10a: i32 = g_rect[1];
    let s0: i32 = out_str(ptr("Y12 sel="));
    let s1: i32 = out_i32(y12);
    let s2: i32 = out_str(ptr(" label="));
    let s3: i32 = out_i32(y10a);
    let s4: i32 = out_nl();
    if (y12 <= y10a) {
        return 34;
    }
    g_mode = 13;
    if (render() <= 0) {
        return 91;
    }
    if (aui_debug_rect(130, g_rect) != 0) {
        return 35;
    }
    let y13: i32 = g_rect[1];
    if (aui_debug_rect(10, g_rect) != 0) {
        return 35;
    }
    let y10b: i32 = g_rect[1];
    let t0: i32 = out_str(ptr("Y13 sel="));
    let t1: i32 = out_i32(y13);
    let t2: i32 = out_str(ptr(" label="));
    let t3: i32 = out_i32(y10b);
    let t4: i32 = out_nl();
    if (y13 != y10b) {
        return 35;
    }
    g_mode = 20;
    if (render() <= 0) {
        return 91;
    }
    let h20: i64 = pixelhash();
    let u0: i32 = out_str(ptr("HASH20 "));
    let u1: i32 = out_i64(h20);
    let u2: i32 = out_nl();
    g_mode = 21;
    if (render() <= 0) {
        return 91;
    }
    let h21: i64 = pixelhash();
    let v0: i32 = out_str(ptr("HASH21 "));
    let v1: i32 = out_i64(h21);
    let v2: i32 = out_nl();
    if (h20 != h21) {
        return 50;
    }
    aui_root();
    let q: ptr<视图> = aui_spec_new_view();
    if (q == 0) {
        return 40;
    }
    let qp: ptr<选项参数> = aui_spec_new_optparam();
    if (qp == 0) {
        return 40;
    }
    qp.文本 = ptr("ProbeOpt");
    q.种 = 26;
    q.名 = ptr("探针项");
    q.键 = 141;
    q.修饰 = 0;
    q.布局值 = 0;
    q.事件 = 0;
    q.子 = 0;
    q.参数 = qp;
    let n5: i32 = aui_debug_node_count();
    q.种 = 0;
    let qv0: 视图 = view_of(q);
    if (aui_mount(qv0, 0) == 0) {
        return 40;
    }
    if (aui_last_error() != 110) {
        return 40;
    }
    q.种 = 26;
    q.键 = 0;
    let qv1: 视图 = view_of(q);
    if (aui_mount(qv1, 0) == 0) {
        return 41;
    }
    if (aui_last_error() != 111) {
        return 41;
    }
    q.键 = 141;
    let ev2: ptr<事件组> = aui_spec_new_evt();
    if (ev2 == 0) {
        return 42;
    }
    ev2.种 = 2;
    ev2.闭包 = on_spec_event;
    ev2.链 = 0;
    q.事件 = ev2;
    let qv2: 视图 = view_of(q);
    if (aui_mount(qv2, 0) == 0) {
        return 42;
    }
    if (aui_last_error() != 113) {
        return 42;
    }
    q.事件 = 0;
    let sp2: ptr<选择参数> = aui_spec_new_selparam();
    if (sp2 == 0) {
        return 43;
    }
    sp2.选中 = 1;
    sp2.打开 = 0;
    sp2.占位 = ptr("Pick one");
    let v25: 视图;
    v25.种 = 25;
    v25.名 = ptr("语言");
    v25.键 = 130;
    v25.修饰 = 0;
    v25.布局值 = 0;
    v25.事件 = 0;
    v25.子 = 0;
    v25.参数 = sp2;
    if (aui_mount(v25, 0) == 0) {
        return 43;
    }
    if (aui_last_error() != 113) {
        return 43;
    }
    let n6: i32 = aui_debug_node_count();
    if (n6 != n5) {
        return 15;
    }
    if (aui_mount(spec, 0) == 0) {
        return 16;
    }
    if (aui_last_error() != 115) {
        return 17;
    }
    let w0: i32 = out_str(ptr("SPEC PROBE OK"));
    let w1: i32 = out_nl();
    return 0;
}
