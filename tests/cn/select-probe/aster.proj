# aster.proj — Select 类试点探针工程（只供 tests/cn/cn-select-component-checks.sh
# 用 build-cn-obj + link-obj 建 headless 探针二进制；不参与 `aster build` 出包）。
#
# 探针驱动必须列进工程：P0-1 机理只在同工程文件间零声明可见——驱动若
# 不在工程内，g_lang_select 裸引用报 [A-099] unknown variable；若写
# extern let g_lang_select: Select，又报 [A-060]（后端不支持类类型
# 的 extern let）。列进工程后驱动可直接调类方法，无需声明。
kind exe
[language]
default = "en"
