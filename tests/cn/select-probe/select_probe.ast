// select_probe.ast — Select 类试点探针驱动（英文；P3 恢复轮套件用）。
//
// 与 gallery headless 驱动同配方：字体 + gallery_headless_init +
// aui_headless_render + fake_post_motion DOWN/UP + aui_on_input。
// 观测的是类本身的状态（g_lang_select.is_open()/value()），不是框架
// 的 aui_select_value——类接线断了时框架状态仍可能正常，故必须直接
// 调类方法。驱动不在 aster.proj 内，但与 --project 合并解析，类与
// 全局单例零声明可见（P0-1 同机理）；若解析拒绝，套件会报构建失败。
//
// 退出码：0 通过；1/2/3/4 三分支探针四步；5 初始值；11/12/13 sync
// 探针三步；90 字体；91 渲染失败；92 点按无矩形。
extern fn aui_rt_set_font_path(path: ptr) : i32;
extern fn aui_set_font(font: ptr, scale: i32) : i32;
extern fn aui_headless_render(w: i32, h: i32, out: ptr) : i32;
extern fn aui_debug_rect(key: i32, out: ptr) : i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) : i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) : i32;
extern fn gallery_headless_init() : i32;
extern fn gallery_set_tab(t: i32) : i32;
let W: i32 = 480;
let H: i32 = 880;
let g_buf: i32[422400] = 0;
let g_font: ptr = 0;
let g_rect: i32[4] = 0;
// Real tap on a node key: DOWN + aui_on_input, UP + aui_on_input,
// at the rect centre read at runtime. Returns 0 on dispatch,
// -1 when the key has no rect.
fn tap_key(key: i32) : i32 {
    if (aui_debug_rect(key, g_rect) != 0) {
        return -1;
    }
    let cx: i32 = g_rect[0] + g_rect[2] / 2;
    let cy: i32 = g_rect[1] + g_rect[3] / 2;
    fake_post_motion(0, cx, cy);
    aui_on_input(1, 0, 0);
    fake_post_motion(1, cx, cy);
    aui_on_input(1, 0, 0);
    return 0;
}
// Tap at raw coordinates (no node): used for the outside-tap step.
// (240, 870) is below the input scroll (ends ~856): empty background.
fn tap_at(x: i32, y: i32) : i32 {
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}
fn render() : i32 {
    return aui_headless_render(W, H, g_buf);
}
fn main() : i32 {
    let font_ok: i32 = aui_rt_set_font_path(ptr("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"));
    if (font_ok != 1) {
        return 90;
    }
    aui_set_font(g_font, 1);
    gallery_headless_init();
    if (render() <= 0) {
        return 91;
    }
    gallery_set_tab(1);
    if (render() <= 0) {
        return 91;
    }
    // Initial state: closed, value 0 (English).
    if (g_lang_select.value() != 0) {
        return 5;
    }
    if (g_lang_select.is_open() != 0) {
        return 5;
    }
    // Branch probe, step 1: tap trigger 130 -> open.
    if (tap_key(130) != 0) {
        return 92;
    }
    if (render() <= 0) {
        return 91;
    }
    if (g_lang_select.is_open() != 1) {
        return 1;
    }
    // Step 2: tap option 133 ("Chinese") -> value 2, closed.
    if (tap_key(133) != 0) {
        return 92;
    }
    if (render() <= 0) {
        return 91;
    }
    if (g_lang_select.value() != 2) {
        return 2;
    }
    if (g_lang_select.is_open() != 0) {
        return 2;
    }
    // Step 3: tap trigger again -> open.
    if (tap_key(130) != 0) {
        return 92;
    }
    if (render() <= 0) {
        return 91;
    }
    if (g_lang_select.is_open() != 1) {
        return 3;
    }
    // Step 4: tap outside -> closed (why==2).
    let t4: i32 = tap_at(240, 870);
    if (render() <= 0) {
        return 91;
    }
    if (g_lang_select.is_open() != 0) {
        return 4;
    }
    // Sync probe: sync(1) -> 1; sync(2) -> 2; open, sync(0) -> 0
    // with open untouched.
    g_lang_select.sync(1);
    if (g_lang_select.value() != 1) {
        return 11;
    }
    g_lang_select.sync(2);
    if (g_lang_select.value() != 2) {
        return 12;
    }
    if (tap_key(130) != 0) {
        return 92;
    }
    if (render() <= 0) {
        return 91;
    }
    if (g_lang_select.is_open() != 1) {
        return 13;
    }
    g_lang_select.sync(0);
    if (g_lang_select.value() != 0) {
        return 13;
    }
    if (g_lang_select.is_open() != 1) {
        return 13;
    }
    // Exit code is the verdict (no stdout: the std write_all/strlen
    // take ptr<u8>, and a listed TU may not redeclare them as ptr).
    return 0;
}
