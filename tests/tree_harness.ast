// tree_harness.ast — v1.33 ui_tree 的真实宿主路径冒烟测试（qemu-user）。
//
// 720×1280 / density 420 的假宿主，走 ANativeActivity 回调创建窗口，然后：
// 版本号 14806；树占满剩余宽度、行高 32 dp；20 行按深度缩进；
// 选中行（aui.ast）铺 14% 主色底；点 stdlib 收起两个子行、点 generated
// 收起 8 个 chunk 行；禁用行不派发点击；滚动后首行上移；深色主题下
// 选中底色换主色。
//
// 返回码：0 通过；10 attach 失败；11 回调表没写；12 屏幕全黑；
// 13 版本号不是 14806；14 树矩形不对；15 行几何/缩进不对；
// 16 选中底色不对；17 点 stdlib 没收起；18 点 generated 没收起；
// 19 禁用行仍回调；20 滚动高度为 0；21 滚动后位置不对；
// 22 深色背景没变暗；23 深色选中底色不对；90 内容超出 720×1280。
extern let g_fake_pixels: i32[921600];

extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn ANativeActivity_onCreate(activity: ptr, saved: ptr, savedSize: i64) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_scroll(key: i32) -> i32;
extern fn aui_debug_scroll_max(key: i32) -> i32;
extern fn aui_debug_scroll_set(key: i32, px: i32) -> i32;
extern fn aui_debug_tree_item(key: i32, out: ptr) -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_frame(now: i64) -> i32;
extern fn aui_state_get(key: i32) -> i32;
extern fn aui_set_dark(on: i32) -> i32;
extern fn aui_invalidate() -> i32;
extern fn aui_invalidate_layout() -> i32;
extern fn aui_version() -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;

let g_act: i64[11] = 0;
let g_cb: i64[16] = 0;
let g_win: i64[4] = 0;
let g_assets: i64[1] = 0;
let g_ext_path: u8[32] = 0;
let g_harness_anchor: ptr = g_act;

fn call_cb(off: i32, a: ptr, b: ptr) -> i32 {
    let cb: ptr = load_ptr(g_act);
    let f: fn(ptr, ptr) -> i32 = load_ptr(cb + off);
    return f(a, b);
}

fn frame_at(t: i64) -> i32 {
    fake_set_clock(t);
    return aui_frame(t);
}

fn tap_at(t: i64, x: i32, y: i32) -> i32 {
    fake_set_clock(t);
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    fake_set_clock(t + 50000000);
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn px_off(x: i32, y: i32) -> i32 { return (y * 720 + x) * 4; }
fn chan(x: i32, y: i32, c: i32) -> i32 {
    return i32(load_u8(g_fake_pixels + px_off(x, y) + c));
}
fn lum(x: i32, y: i32) -> i32 {
    let r: i32 = chan(x, y, 0);
    let g: i32 = chan(x, y, 1);
    let b: i32 = chan(x, y, 2);
    return (r * 3 + g * 6 + b) / 10;
}
fn is_color(x: i32, y: i32, r: i32, g: i32, b: i32) -> i32 {
    if (chan(x, y, 0) != r) { return 0; }
    if (chan(x, y, 1) != g) { return 0; }
    if (chan(x, y, 2) != b) { return 0; }
    return 1;
}
fn tap_row(k: i32, t: i64) -> i32 {
    let r: i32[4] = 0;
    if (aui_debug_rect(k, r) != 0) { return -1; }
    return tap_at(t, r[0] + r[2] / 2, r[1] + r[3] / 2);
}

fn main() -> i32 {
    let act: ptr = g_act;
    *(act + 0) = g_cb;
    let assets: ptr = g_assets;
    *(act + 64) = assets;
    store_u8(g_ext_path + 0, 47);
    store_u8(g_ext_path + 1, 116);
    store_u8(g_ext_path + 2, 109);
    store_u8(g_ext_path + 3, 112);
    store_u8(g_ext_path + 4, 47);
    store_u8(g_ext_path + 5, 97);
    store_u8(g_ext_path + 6, 115);
    store_u8(g_ext_path + 7, 116);
    store_u8(g_ext_path + 8, 101);
    store_u8(g_ext_path + 9, 114);
    store_u8(g_ext_path + 10, 117);
    store_u8(g_ext_path + 11, 105);
    store_u8(g_ext_path + 12, 45);
    store_u8(g_ext_path + 13, 116);
    store_u8(g_ext_path + 14, 114);
    store_u8(g_ext_path + 15, 97);
    store_u8(g_ext_path + 16, 99);
    store_u8(g_ext_path + 17, 101);
    store_u8(g_ext_path + 18, 0);
    let ep: ptr = g_ext_path;
    *(act + 40) = ep;

    if (g_harness_anchor == 0) { return 10; }
    let font_ok: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    let r: i32 = ANativeActivity_onCreate(act, 0, 0);
    if (r != 0) { return 10; }

    let cb: ptr = load_ptr(g_act);
    let f56: ptr = load_ptr(cb + 56);
    let f72: ptr = load_ptr(cb + 72);
    if (f56 == 0 || f72 == 0) { return 11; }

    let win: ptr = g_win;
    let s1: i32 = call_cb(0, act, 0);
    let s2: i32 = call_cb(8, act, 0);
    let s3: i32 = call_cb(56, act, win);
    let s4: i32 = call_cb(72, act, win);

    let sum: i32 = 0;
    let i: i32 = 0;
    while (i < 720 * 1280 * 4) {
        sum = sum + load_u8(g_fake_pixels + i);
        i = i + 1;
    }
    if (sum == 0) { return 12; }
    if (aui_version() != 14806) { return 13; }

    let base: i64 = 4000000000;
    frame_at(base);
    // ---- A. 树占满剩余宽度；行高 32 dp = 84 px ----
    let tr: i32[4] = 0;
    if (aui_debug_rect(10, tr) != 0) { return 14; }
    if (tr[0] != 42) { return 14; }
    if (tr[2] != 636) { return 14; }
    if (tr[1] < 100) { return 14; }
    if (tr[1] + tr[3] > 1280) { return 90; }
    if (tr[3] < 200) { return 14; }
    let a: i32[4] = 0;
    let b: i32[4] = 0;
    let c: i32[4] = 0;
    if (aui_debug_rect(100, a) != 0) { return 15; }
    if (aui_debug_rect(101, b) != 0) { return 15; }
    if (aui_debug_rect(102, c) != 0) { return 15; }
    if (a[2] < 612 || a[2] > 620) { return 15; }
    if (a[3] != 84 || b[3] != 84 || c[3] != 84) { return 15; }
    if (b[1] != a[1] + 84 || c[1] != a[1] + 168) { return 15; }
    if (a[0] != tr[0] + 10) { return 15; }
    let t1: i32[2] = 0;
    let t2: i32[2] = 0;
    if (aui_debug_tree_item(100, t1) != 0) { return 15; }
    if (aui_debug_tree_item(102, t2) != 0) { return 15; }
    if (t1[0] != 0 || t2[0] != 2) { return 15; }
    if ((t1[1] & 1) == 0) { return 15; }
    if ((t2[1] & 4) == 0) { return 15; }

    // ---- B. 选中行（aui.ast）铺 14% 主色底 ----
    let sx: i32 = c[0] + 300;
    let sy: i32 = c[1] + c[3] / 2;
    if (chan(sx, sy, 0) < 212 || chan(sx, sy, 0) > 228) { return 16; }
    if (chan(sx, sy, 2) < 240) { return 16; }
    if (is_color(a[0] + 300, a[1] + a[3] / 2, 0xF6, 0xF6, 0xF8) == 0) { return 16; }

    // ---- C. 点 stdlib：收起 aui.ast / aui_impl.ast ----
    let e0: i32 = aui_state_get(961);
    if (tap_row(101, base + 150000000) != 0) { return 17; }
    frame_at(base + 200000000);
    if (aui_state_get(961) != (e0 ^ 4)) { return 17; }
    if (aui_state_get(960) != 2) { return 17; }
    let z: i32[4] = 0;
    if (aui_debug_rect(102, z) == 0) { return 17; }

    // ---- D. 点 generated：收起 8 个 chunk 行 ----
    let e1: i32 = aui_state_get(961);
    // generated 行在视口下 16 px（偏移 767，视口 751），先滚到可见再点，点完滚回。
    aui_debug_scroll_set(10, 150);
    aui_invalidate_layout();
    frame_at(base + 340000000);
    if (tap_row(111, base + 350000000) != 0) { return 18; }
    aui_debug_scroll_set(10, 0);
    aui_invalidate_layout();
    frame_at(base + 400000000);
    if (aui_state_get(961) != (e1 ^ 4096)) { return 18; }
    let z2: i32[4] = 0;
    if (aui_debug_rect(112, z2) == 0) { return 18; }

    // ---- E. 禁用行不派发点击 ----
    let d: i32[4] = 0;
    if (aui_debug_rect(110, d) != 0) { return 19; }
    let s0: i32 = aui_state_get(960);
    tap_at(base + 600000000, d[0] + d[2] / 2, d[1] + d[3] / 2);
    frame_at(base + 700000000);
    if (aui_state_get(960) != s0) { return 19; }

    // ---- F. 重新展开 generated 后滚动 ----
    // 同 D 节：generated 行在折叠线下，先滚到可见再点，点完滚回（否则
    // scrollmax 缩到 110，滚动测试设 200 会被夹住）。
    aui_debug_scroll_set(10, 150);
    aui_invalidate_layout();
    frame_at(base + 740000000);
    if (tap_row(111, base + 750000000) != 0) { return 20; }
    aui_debug_scroll_set(10, 0);
    aui_invalidate_layout();
    frame_at(base + 800000000);
    let mx: i32 = aui_debug_scroll_max(10);
    if (mx <= 0) { return 20; }
    let before: i32[4] = 0;
    if (aui_debug_rect(100, before) != 0) { return 21; }
    aui_debug_scroll_set(10, 200);
    aui_invalidate_layout();
    frame_at(base + 900000000);
    let after: i32[4] = 0;
    if (aui_debug_rect(100, after) != 0) { return 21; }
    if (after[1] != before[1] - 200) { return 21; }
    if (aui_debug_scroll(10) != 200) { return 21; }

    // ---- G. 深色：背景变暗；选中主色换成 6E96FF ----
    let light: i32 = lum(10, 10);
    aui_set_dark(1);
    aui_invalidate();
    frame_at(base + 1100000000);
    let dark: i32 = lum(10, 10);
    if (dark > light - 80) { return 22; }
    // 滚回顶部；当前选中的是 generated（F 里点过）。
    aui_debug_scroll_set(10, 0);
    aui_invalidate_layout();
    frame_at(base + 1200000000);
    let sd: i32[4] = 0;
    if (aui_debug_rect(111, sd) != 0) { return 23; }
    let dx: i32 = sd[0] + 300;
    let dy: i32 = sd[1] + sd[3] / 2;
    if (chan(dx, dy, 2) <= chan(dx, dy, 0)) { return 23; }
    if (chan(dx, dy, 2) < 45) { return 23; }

    let s5: i32 = call_cb(24, act, 0);
    let s6: i32 = call_cb(32, act, 0);
    let s7: i32 = call_cb(40, act, 0);
    return 0;
}
