// anim_replay_test.ast -- v2.16.2 滑入重播回归（qemu-user / 假宿主）。
//
// 场景照抄 Gallery 的 Anim 标签（同 keys 2400-2450、同回调），只测滑入
// 2435：点 Replay 三次，每次 15 帧 x 16 ms（> 200 ms 时长），断言：
//   R1 每次点按都重启动画（TX 从 40 起、ALPHA 从 0 起，活动帧里值在变）；
//   R2 每次完成后卡片仍可见（TX 0、ALPHA 255，卡片矩形内墨迹与基线相当）；
//   R3 第三次点按同样重播。
// 断言以退出码区分：41 重播未启动（值全程不动），42/43/44 第 1/2/3 次
// 完成后墨迹不足基线一半（卡片消失）。
//
// 根因（v2.16.2 修）：anim_begin 的“补间目标没变：保持进度”支路不看槽
// 是否已结束（anim_find 命中已结束槽），第一次滑入结束后每次点 Replay
// 都直接 return 0，什么都不重启动；关键帧 begin 无条件从当前值改道，
// 已结束槽重播时 from==旧终值==to，直接落点不播放——同修。
// 弹簧 begin 的同目标支路本来就要求 on!=0，不受影响。
//
// TDD：本文件在旧框架（e89f4ed）上退出 41（第二次点按值全程不动）；
// 修复后退出 0。消失一半在头测未复现（完成后 TX 0 / ALPHA 255、墨迹与
// 基线相等，见 REPORT-v2162.md）：框架另加 anim replay/done 诊断行
// 供下次真机日志确认，真机消失的根因待日志判定。
// 场景与若干辅助函数（frame_line / pixel_check / spill_check）与
// anim_perf_test.ast 共享，未用到的留作以后扩展。
//
// 返回码：0 通过；1 矩形/点按失败；21 窗口尺寸失败；41 重播未启动；
// 42/43/44 第 1/2/3 次完成后卡片墨迹不足；90 字体加载失败。

include "../src/aui.ast";
include "../src/aster_std.ast";

extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_scroll(key: i32) -> i32;
extern fn aui_debug_node_count() -> i32;
extern fn aui_debug_build_count() -> i32;
extern fn aui_debug_cmd_count() -> i32;
extern fn aui_debug_frame_blit() -> i32;
extern fn aui_debug_frame_dmg() -> i32;
extern fn aui_debug_dmg_rect(out: ptr) -> i32;
extern fn aui_debug_fbuf_ok() -> i32;
extern fn aui_debug_paint_gen() -> i32;
extern fn aui_debug_blit_diag(out: ptr) -> i32;
extern fn aui_debug_tt_cache(out: ptr) -> i32;
extern fn aui_debug_frame_split(out: ptr) -> i32;
extern fn aui_debug_set_density(dpi: i32) -> i32;
extern fn aui_debug_set_time(t: i64) -> i32;
extern fn aui_anim_value(key: i32, prop: i32) -> i32;
extern fn aui_debug_anim(key: i32, prop: i32, out: ptr) -> i32;
