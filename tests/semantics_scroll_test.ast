// semantics_scroll_test.ast -- v2.20.2 第 71 门：Semantics 标签导出容器
// 滚动必须走直搬（blit=1），不是全屏重画。
//
// 背景：v2.19 真机日志 ~/workspace/user/files/aui_71_8l08.log 里，
// Semantics 标签导出文本（key 3250，Refresh 后显示）滚动时每帧
// c=26-78ms、全屏重画（blit=0）。探针（tests/sem_probe.ast，诊断
// 用，不进套件）在当前框架（v2.20.1）上复现：1216x2688 @520dpi、
// 真机字体（NotoSansCJK）、内容区 (0,107,1216,2516)——进 Semantics
// 标签、点 Refresh、拖动导出容器，10 步里第 1 步 fail=1（首动强制
// 重画，按设计），其余 9 步 blit=1 fail=0，命令数 145 全程稳定
// （文本未逐帧重建），sem_len=1491（与真机一致）。同一探针在
// v2.19 框架上也是 blit=1：v2.19 的真机卡顿在无头下复现不出来，
// 且 v2.19.2/v2.19.3 真机日志里 fail=13 已归零（239/266、583/633
// 帧 blit=1），说明直搬通路本身是通的。
//
// 本测试是回归守卫，不是 TDD 证明：它锁住“导出容器滚动走直搬”
// 这一行为，防住两个已知嫌疑——(a) 导出文本逐帧重建（命令数会变），
// (b) 容器 kind 不在直搬集合（blit 会是 0）。它在旧框架上也过；
// v2.19 真机卡顿的最终闭环仍需用户在真机上确认（Semantics 标签
// 拖动导出文本，看日志 blit=1/fail=0、c 0-3ms）。见
// ~/workspace/canvas/REPORT-v2202-semantics-repaint.md。
//
// 断言：三次 Refresh，第 2、3 次 sem_len 稳定（首个导出在展示列出现
// 之前，列为空，长度不同是预期的）；拖动 10 步，
// 第 2-10 步 blit=1 且 fail=0；命令数全程不变；拖后像素与强制
// 全新重画像素一致（fb_sum）；每步墙钟 < 1000ms（qemu 宽松
// 上限，探针实测 33-110ms；防挂，不作性能断言）。
// 退出码：0 通过；20 标签，21 Refresh 按钮，22 导出为空，
// 23 导出不稳定，24 容器矩形，25 命令数，30 直搬，31 fail 码，
// 32 命令数变了，33 墙钟，34 像素，35 偏移。

include "../src/aui.ast";
include "../src/aster_std.ast";

extern fn aui_debug_rect(key: i32, out: ptr) -> i32;
extern fn aui_debug_scroll(key: i32) -> i32;
extern fn aui_debug_scroll_max(key: i32) -> i32;
extern fn aui_debug_cmd_count() -> i32;
extern fn aui_debug_frame_blit() -> i32;
extern fn aui_debug_blit_fail() -> i32;
extern fn aui_debug_set_density(dpi: i32) -> i32;
extern fn aui_debug_overlay(on: i32) -> i32;
extern fn aui_debug_set_content(l: i32, t: i32, r: i32, b: i32) -> i32;
extern fn aui_debug_set_time(t: i64) -> i32;
extern fn aui_debug_full_repaint() -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn aui_frame(now: i64) -> i32;
extern fn aui_rt_set_font_path(p: ptr) -> i32;
extern fn fake_post_motion(action: i32, x: i32, y: i32) -> i32;
extern fn fake_set_clock(t: i64) -> i32;
extern fn fake_set_win_size(w: i32, h: i32) -> i32;
extern fn fake_bits() -> ptr;
extern fn gallery_headless_init() -> i32;
extern fn gallery_set_tab(t: i32) -> i32;
extern fn gallery_tab() -> i32;
extern fn gallery_sem_len() -> i32;
extern fn gallery_user() -> ptr;

let g_act: i64[11] = 0;
let g_cb: i64[16] = 0;
let g_win: i64[4] = 0;
let g_assets: i64[1] = 0;
let g_ext_path: u8[32] = 0;
let g_harness_anchor: ptr = g_act;
let g_t: i64 = 1000000000;

fn call_cb(off: i32, a: ptr, b: ptr) -> i32 {
    let cb: ptr = load_ptr(g_act);
    let f: fn(ptr, ptr) -> i32 = load_ptr(cb + off);
    return f(a, b);
}

fn frame_at(t: i64) -> i32 {
    fake_set_clock(t);
    return aui_frame(t);
}

fn out_str(s: ptr) -> i32 { return write_all(1, s, strlen(s)); }

fn out_i32(v: i32) -> i32 {
    let buf: u8[16] = 0;
    let n: i32 = fmt_i32(buf, v);
    return write_all(1, buf, n);
}

// 真墙钟毫秒（内建 clock_gettime，MONOTONIC；本文件不定义不声明它，
// 走编译器内建，与 fake_ndk 的假时钟无关）。
fn wall_ms() -> i64 {
    let ts: i64[2] = 0;
    let r: i32 = clock_gettime(1, ts);
    if (r != 0) { return 0; }
    let s: i64 = *(ts);
    let n: i64 = *(ts + 8);
    return s * 1000 + n / 1000000;
}

fn dummy_build(user: ptr) -> i32 {
    return 0;
}

fn pump(n: i32) -> i32 {
    let i: i32 = 0;
    while (i < n) {
        g_t = g_t + 16000000;
        let fr: i32 = frame_at(g_t);
        i = i + 1;
    }
    return 0;
}

fn tap(x: i32, y: i32) -> i32 {
    fake_post_motion(0, x, y);
    aui_on_input(1, 0, 0);
    fake_post_motion(1, x, y);
    aui_on_input(1, 0, 0);
    return 0;
}

fn tap_key(key: i32) -> i32 {
    let r: i32[4] = 0;
    if (aui_debug_rect(key, r) != 0) { return -1; }
    let t: i32 = tap(r[0] + r[2] / 2, r[1] + r[3] / 2);
    return 0;
}

// 区域像素校验和（每像素 4 字节加权求和，自然溢出；1216x2688 窗口）。
fn fb_sum(x: i32, y: i32, w: i32, h: i32) -> i32 {
    let bits: ptr = fake_bits();
    let s: i32 = 0;
    let yy: i32 = y;
    while (yy < y + h && yy < 2688) {
        if (yy >= 0) {
            let xx: i32 = x;
            while (xx < x + w && xx < 1216) {
                if (xx >= 0) {
                    let base: ptr = bits + (yy * 1216 + xx) * 4;
                    let b0: i32 = load_u8(base + 0);
                    let b1: i32 = load_u8(base + 1);
                    let b2: i32 = load_u8(base + 2);
                    s = s * 33 + b0 + b1 * 3 + b2 * 7;
                }
                xx = xx + 1;
            }
        }
        yy = yy + 1;
    }
    return s;
}

fn main() -> i32 {
    // 真机尺寸：1216x2688 @520dpi，内容区 (0,107,1216,2516)。
    if (fake_set_win_size(1216, 2688) != 0) { return 10; }
    let act: ptr = g_act;
    *(act + 0) = g_cb;
    let assets: ptr = g_assets;
    *(act + 64) = assets;
    store_u8(g_ext_path + 0, 47);
    store_u8(g_ext_path + 1, 116);
    store_u8(g_ext_path + 2, 109);
    store_u8(g_ext_path + 3, 112);
    store_u8(g_ext_path + 4, 47);
    store_u8(g_ext_path + 5, 97);
    store_u8(g_ext_path + 6, 115);
    store_u8(g_ext_path + 7, 116);
    store_u8(g_ext_path + 8, 101);
    store_u8(g_ext_path + 9, 114);
    store_u8(g_ext_path + 10, 117);
    store_u8(g_ext_path + 11, 105);
    store_u8(g_ext_path + 12, 45);
    store_u8(g_ext_path + 13, 116);
    store_u8(g_ext_path + 14, 114);
    store_u8(g_ext_path + 15, 97);
    store_u8(g_ext_path + 16, 99);
    store_u8(g_ext_path + 17, 101);
    store_u8(g_ext_path + 18, 0);
    let ep: ptr = g_ext_path;
    *(act + 40) = ep;

    if (g_harness_anchor == 0) { return 10; }
    // glyph_cache_test 同款：dummy_build 接 activity/窗口回调，再由
    // gallery_headless_init() 装真正的 Gallery build。
    let at: i32 = aui_android_attach(act, 0, 0, dummy_build, gallery_user(), 0, 0);
    let gi: i32 = gallery_headless_init();
    let win: ptr = g_win;
    let s1: i32 = call_cb(0, act, 0);
    let s2: i32 = call_cb(8, act, 0);
    let s3: i32 = call_cb(56, act, win);
    let s4: i32 = call_cb(72, act, win);
    // 真机字体（glyph_cache_test 同款路径）；没有也不失败，回退字体
    // 下 Refresh 按钮仍在视口内（y=2051 < 2516），几何用实时矩形。
    let ff: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
    let sd: i32 = aui_debug_set_density(520);
    let sc: i32 = aui_debug_set_content(0, 107, 1216, 2516);
    let ov: i32 = aui_debug_overlay(1);
    let f0: i32 = frame_at(g_t);
    let pp: i32 = pump(3);

    // ---- 进 Semantics 标签（index 13），点三次 Refresh ----
    // 首个导出在展示列出现之前（列为空），第二、第三次才是不动点：
    // sl3==sl2（展示容器已 hidden，不参与导出，长度不再涨）。
    let st: i32 = gallery_set_tab(13);
    let pp2: i32 = pump(3);
    if (gallery_tab() != 13) { return 20; }
    if (tap_key(3231) != 0) { return 21; }
    let pp3: i32 = pump(3);
    let sl1: i32 = gallery_sem_len();
    if (sl1 <= 0) { return 22; }
    if (tap_key(3231) != 0) { return 21; }
    let pp4: i32 = pump(3);
    let sl2: i32 = gallery_sem_len();
    if (sl2 <= 0) { return 22; }
    if (tap_key(3231) != 0) { return 21; }
    let pp5: i32 = pump(3);
    let sl3: i32 = gallery_sem_len();
    if (sl3 != sl2) { return 23; }

    // ---- 几何：滚动容器 3204 与展示列 3250 ----
    let r3204: i32[4] = 0;
    let r3250: i32[4] = 0;
    if (aui_debug_rect(3204, r3204) != 0) { return 24; }
    if (aui_debug_rect(3250, r3250) != 0) { return 24; }
    if (aui_debug_scroll_max(3204) < 300) { return 24; }
    let dx: i32 = r3250[0] + r3250[2] / 2;
    let dy: i32 = r3250[1] + r3250[3] / 2;
    if (dy < r3204[1] + 100) { dy = r3204[1] + 100; }
    if (dy > r3204[1] + r3204[3] - 100) { dy = r3204[1] + r3204[3] - 100; }
    let c0: i32 = aui_debug_cmd_count();
    if (c0 <= 0) { return 25; }

    // ---- 拖动：down + 10 步 MOVE（每步 -30px，16ms 假时钟）----
    fake_post_motion(0, dx, dy);
    aui_on_input(1, 0, 0);
    let y: i32 = dy;
    let step: i32 = 1;
    while (step <= 10) {
        g_t = g_t + 16000000;
        fake_set_clock(g_t);
        y = y - 30;
        let w0: i64 = wall_ms();
        fake_post_motion(2, dx, y);
        aui_on_input(1, 0, 0);
        let w1: i64 = wall_ms();
        let wms: i64 = w1 - w0;
        // 第 1 步是首动强制重画（fail=1，按设计），不计入直搬断言，
        // 但偏移必须已经前进（30px 已越过 8dp 容差）。
        if (step == 1) {
            if (aui_debug_scroll(3204) != 30) { return 35; }
        } else {
            if (aui_debug_frame_blit() != 1) { return 30; }
            if (aui_debug_blit_fail() != 0) { return 31; }
            if (aui_debug_cmd_count() != c0) { return 32; }
            if (aui_debug_scroll(3204) != 30 * step) { return 35; }
        }
        if (wms < 0 || wms >= 1000) { return 33; }
        step = step + 1;
    }
    if (aui_debug_scroll(3204) != 300) { return 35; }

    // ---- 直搬帧的像素必须等于同一状态的强制全新重画 ----
    let sum_blit: i32 = fb_sum(0, 1000, 1216, 200);
    let fr: i32 = aui_debug_full_repaint();
    let sum_fresh: i32 = fb_sum(0, 1000, 1216, 200);
    if (sum_blit != sum_fresh) { return 34; }
    if (aui_debug_cmd_count() != c0) { return 32; }
    fake_post_motion(1, dx, y);
    aui_on_input(1, 0, 0);

    let ok0: i32 = out_str("SEMANTICS_SCROLL PASS sem_len=");
    let ok1: i32 = out_i32(sl3);
    let ok2: i32 = out_str(" cmds=");
    let ok3: i32 = out_i32(c0);
    let ok4: i32 = out_str(" off=");
    let ok5: i32 = out_i32(aui_debug_scroll(3204));
    let ok6: i32 = out_str("\n");
    return 0;
}
