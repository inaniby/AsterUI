// v2.12：分栏分隔条。两个窗格时在窗格之间画 4 dp 竖/横条（文字色 12%，
// 与 aui_divider 同色）；少于两个窗格时不画。
fn paint_split_divider(n: ptr<AuiNode>) : i32 {
    let c1: i32 = n.first_child;
    if (c1 < 0) { return 0; }
    let c2: i32 = node_at(c1).next_sibling;
    if (c2 < 0) { return 0; }
    let t: i32 = i32(theme_text());
    let col: i32 = (31 << 24) | (t & 0x00FFFFFF);
    let divq: i32 = dp2q(AUI_SPLIT_DIV_DP);
    let n1: ptr<AuiNode> = node_at(c1);
    if (n.aux == 1) {
        let x: i32 = n1.x + n1.w;
        let lh: i32 = n.h - n.pad * 2;
        if (lh > 0) {
            let rv: i32 = cmd_add(1, x, n.y + n.pad, divq, lh, col, 0, g_aui_null, 0, 0);
        }
        return 0;
    }
    let y: i32 = n1.y + n1.h;
    let lw: i32 = n.w - n.pad * 2;
    if (lw > 0) {
        let rv: i32 = cmd_add(1, n.x + n.pad, y, lw, divq, col, 0, g_aui_null, 0, 0);
    }
    return 0;
}

// v1.33：树视图（对照 HuxerUI TreeView / TreeViewStyle）。容器 kind 32
// 是固定行高的纵向滚动区（行为与 aui_scroll 相同：拖动、fling、滚动条、
// 裁剪），行 kind 33 由应用按可见顺序逐个声明 —— 与 Chip/Switch 一样
// 是受控组件：展开/选中状态都在应用侧，点按行只调 cb(user)，应用改完
// 自己的状态再 aui_invalidate()。
let AUI_TREE_BRANCH: i32 = 1;

let AUI_TREE_EXPANDED: i32 = 2;

let AUI_TREE_SELECTED: i32 = 4;

// ---- Toast / SnackBar（v1.34）----
// 对照 HuxerUI presentation.h：Toast 是被动反馈（pointer pass-through，
// 多个并存），SnackBar 是窗口内唯一、带一个动作按钮的提示（内容层拦截
// 触摸）。二者都不进节点树：记录放在固定池里，布局与绘制是根树之后的
// 独立浮层，不参与页面/滚动/对话框布局。文本指针需在显示期间有效。
let AUI_TOAST_CAP: i32 = 4;

let g_aui_toast_on: i32[4] = 0;

let g_aui_toast_text: ptr[4] = 0;

let g_aui_toast_dur: i64[4] = 0;

let g_aui_toast_x: i32[4] = 0;

let g_aui_toast_y: i32[4] = 0;

let g_aui_toast_w: i32[4] = 0;

let g_aui_toast_h: i32[4] = 0;

let g_aui_snack_on: i32 = 0;

let g_aui_snack_text: ptr = 0;

let g_aui_snack_action: ptr = 0;

let g_aui_snack_rem: i64 = 0;

let g_aui_snack_paused: i32 = 0;

let g_aui_snack_press: i32 = 0;

let g_aui_snack_x: i32 = 0;

let g_aui_snack_y: i32 = 0;

let g_aui_snack_w: i32 = 0;

let g_aui_snack_h: i32 = 0;

let g_aui_snack_ax: i32 = 0;

let g_aui_snack_ay: i32 = 0;

