// aster:language=en
// aui_drawprim.ast — S6 command core / theme / shape / space / safe-area / sysbar
// P4 split of src/aui_impl.ast (pure move; see phase1-p4-split.md).

// ---- extern 声明（gen_split.py 从定义处逐字抽取；定义唯一，声明随调用方）----
extern fn paint_scale_x(p: i32) : i32;
extern fn paint_scale_y(p: i32) : i32;
extern fn paint_scale_w(w: i32) : i32;
extern fn fx_px(v: i32) : i32;
extern fn dp2q(dp: i32) : i32;
extern fn str_len(s: ptr) : i32;
extern fn text_line_h() : i32;
extern fn text_glyph_h() : i32;
