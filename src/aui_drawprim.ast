extern let g_aui_jni_env: ptr;
extern let g_aui_jni_act: ptr;
extern let g_aui_sysbar_icons: i32;
extern let g_aui_sysbar_jni: i32;
extern let g_aui_sysbar_fb: i32;
extern let g_aui_insets_jni_t: i32;
extern let g_aui_insets_jni_b: i32;
extern let g_aui_insets_jni_ok: i32;
extern let JNI_TBL_EXCEPTION_CLEAR: i32;
extern let JNI_TBL_DELETE_LOCAL_REF: i32;
extern let JNI_TBL_GET_OBJECT_CLASS: i32;
extern let JNI_TBL_GET_METHOD_ID: i32;
extern let JNI_TBL_CALL_OBJECT_METHOD_A: i32;
extern let JNI_TBL_CALL_VOID_METHOD_A: i32;
extern let JNI_TBL_EXCEPTION_CHECK: i32;
extern let JNI_APPEARANCE_LIGHT_STATUS_BARS: i32;
extern let JNI_TBL_FIND_CLASS: i32;
extern let JNI_TBL_CALL_INT_METHOD_A: i32;
extern let JNI_TBL_GET_FIELD_ID: i32;
extern let JNI_TBL_GET_INT_FIELD: i32;
extern let JNI_TBL_GET_STATIC_METHOD_ID: i32;
extern let JNI_TBL_CALL_STATIC_INT_METHOD_A: i32;
extern let g_aui_clip_x: i32;
extern let g_aui_clip_y: i32;
extern let g_aui_clip_w: i32;
extern let g_aui_clip_h: i32;
