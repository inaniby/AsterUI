extern let g_aui_need_layout: i32;
extern let g_aui_fb_w: i32;
extern let g_aui_fb_h: i32;
extern let g_aui_snap_pool: i64[32768];
extern let g_aui_snap_cmds: ptr<AuiCmd>;
extern let g_aui_snap_count: i32;
extern let g_aui_snap_rs: i32;
extern let g_aui_snap_re: i32;
extern let g_aui_rip_cs: i32;
extern let g_aui_rip_ce: i32;
extern let g_aui_dmg_why: i32;
extern let g_aui_dmg_diffn: i32;
extern let g_aui_dmg_first: i32;
extern let g_aui_dmg_firstop: i32;
extern let g_aui_dmg_word: i32;
extern let g_aui_dmg_old: i64;
extern let g_aui_dmg_new: i64;
extern let g_aui_dmg_try_l: i32;
extern let g_aui_dmg_try_t: i32;
extern let g_aui_dmg_try_r: i32;
extern let g_aui_dmg_try_b: i32;
extern let g_aui_dark: i32;
extern let g_aui_inset_l: i32;
extern let g_aui_inset_t: i32;
extern let g_aui_inset_r: i32;
extern let g_aui_inset_b: i32;
