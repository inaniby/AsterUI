        if (cn.aux2 == index) {
            *(out + 0) = cn.x >> 16;
            *(out + 4) = cn.y >> 16;
            *(out + 8) = cn.w >> 16;
            *(out + 12) = cn.h >> 16;
            return 0;
        }
        c = cn.next_sibling;
    }
    return -1;
}

