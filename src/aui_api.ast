    return v;
}

// 测试辅助：out = [x,y,w,h,count,first,last,offset_px]。
fn aui_debug_hlist(key: i32, out: ptr) : i32 {
    let i: i32 = hlist_node(key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    *(out + 0) = n.x >> 16;
    *(out + 4) = n.y >> 16;
    *(out + 8) = n.w >> 16;
    *(out + 12) = n.h >> 16;
    *(out + 16) = n.aux;
    *(out + 20) = 0;
    *(out + 24) = 0;
    let s: i32 = hlist_find(key);
    if (s >= 0) {
        *(out + 20) = g_aui_hlist_first[s];
        *(out + 24) = g_aui_hlist_last[s];
        *(out + 28) = g_aui_hlist_off[s];
    } else {
        *(out + 28) = scroll_get(key);
    }
    return 0;
}

// 测试辅助：当前窗口内某项的矩形；out = [x,y,w,h]。
fn aui_debug_hlist_item(key: i32, index: i32, out: ptr) : i32 {
    let i: i32 = hlist_node(key);
    if (i < 0) { return -1; }
    let vn: ptr<AuiNode> = node_at(i);
    let c: i32 = vn.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        if (cn.aux2 == index) {
            *(out + 0) = cn.x >> 16;
            *(out + 4) = cn.y >> 16;
            *(out + 8) = cn.w >> 16;
            *(out + 12) = cn.h >> 16;
            return 0;
        }
        c = cn.next_sibling;
    }
    return -1;
}

// 测试辅助：按 key 取分页偏移（像素，四舍五入）。
fn aui_debug_pager(key: i32) : i32 {    return fx_px(pager_get(key));
}

fn aui_debug_pager_anim() : i32 { return pager_anim_count(); }

// 测试辅助：启动惯性（速度单位 px/s；now 单位 ns）。
fn aui_debug_fling_start(key: i32, px_per_s: i32, now_ns: i64) : i32 {
    return fling_start(key, px_per_s << 16, now_ns);
}

fn aui_debug_fling() : i32 { return g_aui_fling_active; }

fn aui_debug_fling_vel() : i32 { return fx_px(g_aui_fling_vel); }

