fn aui_debug_set_time(t: i64) : i32 {
    g_aui_anim_fake = 1;
    g_aui_anim_now = t;
    return 0;
}

// 测试辅助：当前拖动会话的滚动 key（0 = 未在拖动）。
fn aui_debug_drag() : i32 { return g_aui_drag_key; }

// 测试辅助：累计 build 次数。滚动帧若仍逐帧重建，这个计数会随帧数增长。
fn aui_debug_build_count() : i32 { return g_aui_build_count; }

// v2.6.2：已画帧数（g_aui_paint_gen，pump_ui 每画一帧 +1）。测试用。
fn aui_debug_paint_gen() : i32 { return g_aui_paint_gen; }

// v1.48.6 测试辅助：最近一帧是否走了纯滚动直搬（1 = 是），以及帧缓冲
// 当前是否可用（几何一致、内容等于屏上这一帧）。
fn aui_debug_frame_blit() : i32 { return g_aui_frame_blit; }

fn aui_debug_fbuf_ok() : i32 { return g_aui_fbuf_ok; }

// v2.20.2 测试辅助：最近一次直搬判定的 fail 码（与真机 scroll frame
// 日志的 fail= 同一值；0 = 直搬成功）。
fn aui_debug_blit_fail() : i32 { return g_aui_blit_fail; }

// v2.16.1 测试辅助：最近一帧是否走了动画损伤重画（1 = 是），以及损伤
// 矩形（像素；没有损伤帧时四值均为 -1）。
fn aui_debug_frame_dmg() : i32 { return g_aui_frame_dmg; }

// v2.16.1 诊断：上次 cmd_anim_damage 拒绝的原因（0=通过，1=无快照，
// 2=无命令，3=条数不等，4=旋转命令变了，5=无变化，6=夹后为空，7=面积超限）、
// 变化条数、首条变化命令的下标与 op、旋转命令首个不同字的下标与新旧值
// （高 32 位），以及最近一次算出的损伤矩形（含被面积上限拒掉的）。
// out 须是 i32[11]：out[0]=why，out[1]=diffn，out[2]=first_idx，
// out[3]=first_op，out[4]=word，out[5]=old，out[6]=new，
// out[7..10]=try_l/try_t/try_r/try_b。
fn aui_debug_dmg_why(out: ptr) : i32 {
    if (out == 0) { return -1; }
    *(out + 0) = g_aui_dmg_why;
    *(out + 4) = g_aui_dmg_diffn;
    *(out + 8) = g_aui_dmg_first;
    *(out + 12) = g_aui_dmg_firstop;
    *(out + 16) = g_aui_dmg_word;
    *(out + 20) = i32(g_aui_dmg_old >> 32);
    *(out + 24) = i32(g_aui_dmg_new >> 32);
    *(out + 28) = g_aui_dmg_try_l;
    *(out + 32) = g_aui_dmg_try_t;
    *(out + 36) = g_aui_dmg_try_r;
    *(out + 40) = g_aui_dmg_try_b;
    return 0;
}

fn aui_debug_dmg_rect(out: ptr) : i32 {
    if (out == 0) { return -1; }
    *(out + 0) = g_aui_frame_dmg_l;
    *(out + 4) = g_aui_frame_dmg_t;
    *(out + 8) = g_aui_frame_dmg_r;
    *(out + 12) = g_aui_frame_dmg_b;
    return 0;
}

// 测试辅助：同一命令表强制整屏重画一次（不重建、不重排），用于比较
// 直搬帧与整屏光栅的像素是否一致。
fn aui_debug_blit_off(v: i32) : i32 { g_aui_blit_off = v; return 0; }

// 测试辅助：打开帧缓冲阶段扫描；out 读回某阶段 [坏点数, x, y, rgba]。
fn aui_debug_full_repaint() : i32 {
    g_aui_force_full = 1;
    g_aui_need_paint = 1;
    if (g_aui_attached == 0) { return 0; }
    if (draw_defer_to_pump() != 0) { return 0; }
    let c: i32 = pump_ui();
    let p: i32 = present_now();
    return 0;
}

// 测试辅助：拷出帧缓冲的一段（字节偏移/长度），用于逐帧比对。
fn aui_debug_fb_copy(dst: ptr, off: i32, n: i32) : i32 {
    if (g_aui_fbuf_ok == 0 || off < 0 || n <= 0) { return -1; }
    let bpp: i32 = fb_bpp(g_aui_fbuf_fmt);
    let lim: i32 = g_aui_fbuf_stride * g_aui_fbuf_h * bpp;
    if (off + n > lim) { return -1; }
    let i: i32 = 0;
    while (i < n) {
        // v2.7.1：字节偏移按 4 MiB 块翻译（分块帧缓冲）。
        store_u8(dst + i, load_u8(fb_byte_ptr(off + i)));
        i = i + 1;
    }
    return 0;
}

// 测试辅助：扫描帧缓冲里 alpha != 255 的像素（正常光栅不会产生这种
// 像素）。out = [个数, 首个 x, 首个 y, rgba]。
fn aui_debug_fb_bad(out: ptr) : i32 {
    if (out == 0) { return -1; }
    *(out + 0) = 0;
    if (g_aui_fbuf_ok == 0) { return -1; }
    let bpp: i32 = fb_bpp(g_aui_fbuf_fmt);
    if (bpp != 4) { return -1; }
    let y: i32 = 0;
    let n: i32 = 0;
    while (y < g_aui_fbuf_h) {
        let x: i32 = 0;
        // v2.7.1：行首按分块翻译（fb_row_ptr），行内再加 x*4。
        let row: ptr = fb_row_ptr(g_aui_fbuf0, g_aui_fbuf_stride, 4, y);
        while (x < g_aui_fbuf_w) {
            let off: i32 = x * 4;
            if (((*(row + off) >> 24) & 255) != 255) {
                if (n == 0) {
                    *(out + 4) = x;
                    *(out + 8) = y;
                    *(out + 12) = *(row + off);
                }
                n = n + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    *(out + 0) = n;
    return 0;
}

// 测试辅助：直搬判定相关的内部状态，出错时定位用。
fn aui_debug_blit_diag(out: ptr) : i32 {
    if (out == 0) { return -1; }
    *(out + 0) = g_aui_frame_light;
    *(out + 4) = g_aui_fbuf_ok;
    *(out + 8) = g_aui_fb_vp_ok;
    *(out + 12) = g_aui_scroll_vp_ok;
    *(out + 16) = g_aui_sg_start;
    *(out + 20) = g_aui_sg_end;
    *(out + 24) = g_aui_snap_count;
    *(out + 28) = g_aui_cmd_count;
    *(out + 32) = g_aui_fb_w;
    *(out + 36) = g_aui_fb_h;
    *(out + 40) = g_aui_frame_scroll_key;
    *(out + 44) = g_aui_fb_key;
    *(out + 48) = g_aui_fb_off;
    *(out + 52) = scroll_get(g_aui_fb_key);
    *(out + 56) = g_aui_dragging;
    *(out + 60) = g_aui_drag_key;
    *(out + 64) = g_aui_scroll_vp_l;
    *(out + 68) = g_aui_scroll_vp_t;
    *(out + 72) = g_aui_scroll_vp_r;
    *(out + 76) = g_aui_scroll_vp_b;
    *(out + 80) = g_aui_fb_horiz;
    if (g_aui_scroll_vp_ok != 0) {
        *(out + 84) = fb_cmds_ok(g_aui_scroll_vp_l, g_aui_scroll_vp_t,
                                 g_aui_scroll_vp_r, g_aui_scroll_vp_b);
    } else {
        *(out + 84) = -1;
    }
    *(out + 88) = scroll_get(g_aui_frame_scroll_key) - g_aui_fb_off;
    *(out + 92) = g_aui_blit_fail;
    *(out + 96) = g_aui_blit_dif;
    *(out + 100) = g_aui_blit_bd;
    let i: i32 = 0;
    while (i < 8) {
        *(out + 104 + i * 4) = g_aui_blit_dbg[i];
        i = i + 1;
    }
    return 0;
}

// v2.7：测试辅助：字形缓存统计。
// out = [命中, 未命中, 逐出, 存活, 累计光栅化 ms, 光栅化次数]。
fn aui_debug_tt_cache(out: ptr) : i32 {
    if (out == 0) { return -1; }
    *(out + 0) = ui_tt_cache_hits();
    *(out + 4) = ui_tt_cache_misses();
    *(out + 8) = ui_tt_cache_evictions();
    *(out + 12) = ui_tt_cache_live();
    *(out + 16) = i32(ui_tt_raster_ms());
    *(out + 20) = ui_tt_raster_n();
    return 0;
}

// 测试辅助：命中测试返回节点 key（-1 = 没命中）。
fn aui_debug_hit(px: i32, py: i32) : i32 {    let i: i32 = hit_test(g_aui_root, px, py);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    return n.key;
}

// 测试辅助：最近一帧的节点数 / 绘制命令数。
fn aui_debug_node_count() : i32 { return g_aui_node_count; }

fn aui_debug_cmd_count() : i32 { return g_aui_cmd_count; }

// 测试辅助：展开中的下拉浮层矩形（Q16.16）；没有展开时返回 -1。
// v1.44：组合框状态 out = [x,y,w,h,open,count,pad,focused]（像素）。
fn aui_debug_combo(key: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 49 && n.key == key) {
            let p: ptr<i32> = out;
            p[0] = n.x >> 16;
            p[1] = n.y >> 16;
            p[2] = n.w >> 16;
            p[3] = n.h >> 16;
            p[4] = n.aux2;
            p[5] = combo_sug_count(n);
            p[6] = n.pad >> 16;
            p[7] = 0;
            if (n.key != 0 && n.key == g_aui_focus_key) { p[7] = 1; }
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

// v1.44：建议项 out = [x,y,w,h,index,visible,pressed,0]（像素）。
fn aui_debug_combo_suggestion(key: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 50 && n.key == key) {
            let p: ptr<i32> = out;
            p[0] = n.x >> 16;
            p[1] = n.y >> 16;
            p[2] = n.w >> 16;
            p[3] = n.h >> 16;
            p[4] = n.aux2;
            p[5] = 0;
            if (g_aui_combo_open >= 0 && n.parent == g_aui_combo_open &&
                n.aux2 >= 0 && n.aux2 < g_aui_combo_vis) {
                p[5] = 1;
            }
            p[6] = 0;
            if (g_aui_combo_press >= 0 && g_aui_combo_press == n.aux2) { p[6] = 1; }
            p[7] = 0;
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

