    return -1;
}

// v1.40：顶部应用栏。out = [x,y,w,h,align,leading_key,actions,divider,
// title_x0,title_x1,leading_x,leading_w,title_w,title_len,title_x,title_y]（像素）。
// v1.41/v1.42：回调里读取刚点中的导航项下标（底部栏或侧边栏）；
// 没有待处理值时回退到该容器当前的选中值。
fn aui_nav_value(key: i32) : i32 {
    if (g_aui_nav_key != 0 && g_aui_nav_key == key) { return g_aui_nav_val; }
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if ((n.kind == 45 || n.kind == 47) && n.key == key) { return n.aux; }
        i = i + 1;
    }
    return -1;
}

// 测试辅助：导航栏 out = [x,y,w,h,selected,count,show_labels,pad]，像素单位。
fn aui_debug_nav_bar(key: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 45 && n.key == key) {
            let p: ptr<i32> = out;
            let cnt: i32 = 0;
            let c: i32 = n.first_child;
            while (c >= 0) {
                let cn: ptr<AuiNode> = node_at(c);
                cnt = cnt + 1;
                c = cn.next_sibling;
            }
            p[0] = n.x >> 16;
            p[1] = n.y >> 16;
            p[2] = n.w >> 16;
            p[3] = n.h >> 16;
            p[4] = n.aux;
            p[5] = cnt;
            p[6] = 1;
            if ((n.flags & AUI_NAV_HIDE_UNSELECTED) != 0) { p[6] = 0; }
            p[7] = n.pad >> 16;
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

// v1.42：侧边导航栏 out = [x,y,w,h,selected,count,expanded,pad]。
fn aui_debug_nav_pane(key: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 47 && n.key == key) {
            let p: ptr<i32> = out;
            let cnt: i32 = 0;
            let c: i32 = n.first_child;
            while (c >= 0) {
                let cn: ptr<AuiNode> = node_at(c);
                cnt = cnt + 1;
                c = cn.next_sibling;
            }
            p[0] = n.x >> 16;
            p[1] = n.y >> 16;
            p[2] = n.w >> 16;
            p[3] = n.h >> 16;
            p[4] = n.aux;
            p[5] = cnt;
            p[6] = 0;
            if ((n.flags & AUI_NAV_PANE_EXPANDED) != 0) { p[6] = 1; }
            p[7] = nav_pane_hp(n) >> 16;
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

// v1.42：侧边导航项 out = [x,y,w,h,index,flags,selected,disabled]。
fn aui_debug_nav_pane_item(key: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 48 && n.key == key) {
            let p: ptr<i32> = out;
            p[0] = n.x >> 16;
            p[1] = n.y >> 16;
            p[2] = n.w >> 16;
            p[3] = n.h >> 16;
            p[4] = n.aux2;
            p[5] = n.flags;
            p[6] = 0;
            p[7] = 0;
            if (n.parent >= 0) {
                let pn: ptr<AuiNode> = node_at(n.parent);
                if (pn.kind == 47 && pn.aux == n.aux2) { p[6] = 1; }
            }
            if ((n.flags & AUI_NAV_ITEM_DISABLED) != 0) { p[7] = 1; }
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

// 测试辅助：导航项 out = [x,y,w,h,index,flags,selected,disabled]，像素单位。
fn aui_debug_nav_item(key: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 46 && n.key == key) {
            let p: ptr<i32> = out;
            p[0] = n.x >> 16;
            p[1] = n.y >> 16;
            p[2] = n.w >> 16;
            p[3] = n.h >> 16;
            p[4] = n.aux2;
            p[5] = n.flags;
            p[6] = 0;
            p[7] = 0;
            if (n.parent >= 0) {
                let pn: ptr<AuiNode> = node_at(n.parent);
                if (pn.kind == 45 && pn.aux == n.aux2) { p[6] = 1; }
            }
            if ((n.flags & AUI_NAV_ITEM_DISABLED) != 0) { p[7] = 1; }
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

fn aui_debug_top_bar(key: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 44 && n.key == key) {
            let lead: i32 = top_bar_leading(n);
            let p: ptr<i32> = out;
            let rect: i32[4] = 0;
            let rr: i32 = top_bar_title_rect(n, rect);
            p[0] = n.x >> 16;
            p[1] = n.y >> 16;
            p[2] = n.w >> 16;
            p[3] = n.h >> 16;
            p[4] = n.aux2;
            p[5] = 0;
            p[6] = top_bar_action_count(n);
            p[7] = 0;
            if ((n.flags & AUI_TB_DIVIDER) != 0) { p[7] = 1; }
            p[8] = rect[0] >> 16;
            p[9] = rect[1] >> 16;
            p[10] = 0;
            p[11] = 0;
            let tlen: i32 = top_bar_title_len(n);
            let tw: i32 = text_measure(n.text, tlen, 0) + top_bar_bold_off();
            let xs2: i32 = rect[0];
            let xe2: i32 = rect[1];
            let tx2: i32 = xs2;
            if (n.aux2 == AUI_TOP_BAR_CENTER) {
                tx2 = xs2 + (xe2 - xs2 - tw) / 2;
                if (tx2 < xs2) { tx2 = xs2; }
            }
            p[12] = tw >> 16;
            p[13] = tlen;
            p[14] = tx2 >> 16;
            p[15] = (n.y + (n.h - text_glyph_h()) / 2) >> 16;
            if (lead >= 0) {
                let ln: ptr<AuiNode> = node_at(lead);
                p[5] = ln.key;
                p[10] = ln.x >> 16;
                p[11] = ln.w >> 16;
            }
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

// 测试辅助：工具提示状态（0 无 / 1 待定长按 / 2 按住显示 / 3 松手停留）。
fn aui_debug_tooltip_state() : i32 {
    if (g_aui_tip_pend != 0) { return 1; }
    if (g_aui_tip_on != 0) {
        if (g_aui_tip_hold != 0) { return 2; }
        return 3;
    }
    return 0;
}

// v2.7：测试辅助：长按状态（0 空闲 / 1 待定 / 2 已触发待抬起）。
fn aui_debug_long_press_state() : i32 {
    if (g_aui_lp_pend != 0) { return 1; }
    if (g_aui_lp_fired != 0) { return 2; }
    return 0;
}

// 测试辅助：长按登记数量。
fn aui_debug_long_press_n() : i32 {
    return g_aui_lp_used;
}

// 测试辅助：触发节点的 key（触发后、抬起前读到；其余时间为 0）。
fn aui_debug_long_press_key() : i32 {
    return g_aui_lp_key;
}

// 测试辅助：待定/已触发时，(px, py) 是否仍在按下点的 8 dp 容差内；
// 无待定/已触发时返回 0。用于断言 slop 边界（8 dp 内 1，超了 0）。
fn aui_debug_long_press_at(px: i32, py: i32) : i32 {
    if (g_aui_lp_pend == 0 && g_aui_lp_fired == 0) { return 0; }
    let dx: i32 = px - g_aui_lp_downx;
    let dy: i32 = py - g_aui_lp_downy;
    let slop: i32 = dp2q(8) >> 16;
    if (iabs(dx) <= slop && iabs(dy) <= slop) { return 1; }
    return 0;
}

// 测试辅助：可见气泡矩形（Q16.16）；不可见返回 0。
fn aui_debug_tooltip(out: ptr) : i32 {
    if (g_aui_tip_on == 0) { return 0; }
    let p: ptr<i32> = out;
    p[0] = g_aui_tip_x;
    p[1] = g_aui_tip_y;
    p[2] = g_aui_tip_w;
    p[3] = g_aui_tip_h;
    return 1;
}

// 测试辅助：本帧登记的提示数量。
fn aui_debug_tooltip_n() : i32 { return g_aui_tip_used; }

// 测试辅助：当前气泡文本的行数（最近一次布局/绘制）。
fn aui_debug_tooltip_lines() : i32 {
    if (g_aui_tip_on == 0) { return 0; }
    return g_aui_mlines;
}

// 测试辅助：第 i 个提示登记的节点下标。
fn aui_debug_tooltip_node(i: i32) : i32 {
    if (i < 0 || i >= g_aui_tip_used) { return -1; }
    return g_aui_tips_node[i];
}

// ---- 日期选择调试（v1.28）----
// part: 0..2 选中 y/m/d；3..4 可见 y/m；5 模式；6..8 min y/m/d；
// 9..11 max y/m/d；12 周起始；13..15 选中/min/max 天数；16 网格首日天数。
fn aui_debug_date_part(key: i32, part: i32, out: ptr) : i32 {
    let slot: i32 = date_find(key);
    if (slot < 0) { return -1; }
    date_prepare(slot);
    let sel: i32 = g_aui_date_sel[slot];
    let v: i32 = -1;
    if (part == 0) { v = date_y(sel); }
    else if (part == 1) { v = date_m(sel); }
    else if (part == 2) { v = date_d(sel); }
    else if (part == 3) { v = g_aui_date_vy[slot]; }
    else if (part == 4) { v = g_aui_date_vm[slot]; }
    else if (part == 5) { v = g_aui_date_mode[slot]; }
    else if (part == 6) { v = date_y(g_aui_date_min[slot]); }
    else if (part == 7) { v = date_m(g_aui_date_min[slot]); }
    else if (part == 8) { v = date_d(g_aui_date_min[slot]); }
    else if (part == 9) { v = date_y(g_aui_date_max[slot]); }
    else if (part == 10) { v = date_m(g_aui_date_max[slot]); }
    else if (part == 11) { v = date_d(g_aui_date_max[slot]); }
    else if (part == 12) { v = g_aui_date_ws[slot]; }
    else if (part == 13) { v = sel; }
    else if (part == 14) { v = g_aui_date_min[slot]; }
    else if (part == 15) { v = g_aui_date_max[slot]; }
    else if (part == 16) { v = date_grid_start(slot); }
    if (out != 0) {
        let p: ptr<i32> = out;
        p[0] = v;
    }
    return v;
}

// out 写 [x, y, w, h, 单元边长, 网格 x, 日网格 y, 头部高]，单位像素。
fn aui_debug_date_view(key: i32, out: ptr) : i32 {
    let ni: i32 = date_node(key);
    if (ni < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(ni);
    date_geom(n);
    let p: ptr<i32> = out;
    p[0] = n.x >> 16;
    p[1] = n.y >> 16;
    p[2] = n.w >> 16;
    p[3] = n.h >> 16;
    p[4] = g_aui_dg_cell >> 16;
    p[5] = g_aui_dg_gx >> 16;
    p[6] = g_aui_dg_day_y >> 16;
    p[7] = g_aui_dg_header >> 16;
    return 0;
}

// 日网格第 index 格（0..41）：out 写 [y, m, d, enabled, selected, adjacent]。
fn aui_debug_date_cell(key: i32, index: i32, out: ptr) : i32 {
    let ni: i32 = date_node(key);
    if (ni < 0) { return -1; }
    if (index < 0 || index >= 42) { return -1; }
    let n: ptr<AuiNode> = node_at(ni);
    let slot: i32 = n.aux;
    if (slot < 0) { return -1; }
    date_prepare(slot);
    let days: i32 = date_grid_start(slot) + index;
    let yy: i32 = date_y(days);
    let mm: i32 = date_m(days);
    let dd: i32 = date_d(days);
    let en: i32 = date_in_range(slot, days);
    let sl: i32 = 0;
    if (days == g_aui_date_sel[slot]) { sl = 1; }
    let adj: i32 = 0;
    if (yy != g_aui_date_vy[slot] || mm != g_aui_date_vm[slot]) { adj = 1; }
    let p: ptr<i32> = out;
    p[0] = yy;
    p[1] = mm;
    p[2] = dd;
    p[3] = en;
    p[4] = sl;
    p[5] = adj;
    return 0;
}

// 年网格第 index 格（0..19）：out 写 [year, enabled, selected]。
fn aui_debug_date_year(key: i32, index: i32, out: ptr) : i32 {
    let ni: i32 = date_node(key);
    if (ni < 0) { return -1; }
    if (index < 0 || index >= 20) { return -1; }
    let n: ptr<AuiNode> = node_at(ni);
    let slot: i32 = n.aux;
    if (slot < 0) { return -1; }
    let yy: i32 = date_page_start(g_aui_date_vy[slot]) + index;
    let en: i32 = date_year_allowed(slot, yy);
    let sl: i32 = 0;
    if (yy == g_aui_date_vy[slot]) { sl = 1; }
    let p: ptr<i32> = out;
    p[0] = yy;
    p[1] = en;
    p[2] = sl;
    return 0;
}

// ---- 时间选择调试（v1.29）----
// part: 0 时、1 分、2 模式（0 时/1 分）、3 十二小时制、4 步长、
// 5 当天总分钟数。
fn aui_debug_time_part(key: i32, part: i32, out: ptr) : i32 {
    let slot: i32 = time_find(key);
    if (slot < 0) { return -1; }
    time_prepare(slot);
    let sel: i32 = g_aui_time_sel[slot];
    let v: i32 = -1;
    if (part == 0) { v = sel / 60; }
    else if (part == 1) { v = sel % 60; }
    else if (part == 2) { v = g_aui_time_mode[slot]; }
    else if (part == 3) { v = g_aui_time_h12[slot]; }
    else if (part == 4) { v = g_aui_time_step[slot]; }
    else if (part == 5) { v = sel; }
    if (out != 0) {
        let p: ptr<i32> = out;
        p[0] = v;
    }
    return v;
}

// out 写 [x, y, w, h, 表心 x, 表心 y, 表半径, 头部高]，单位像素。
fn aui_debug_time_view(key: i32, out: ptr) : i32 {
    let ni: i32 = time_node(key);
    if (ni < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(ni);
    time_geom(n);
    let p: ptr<i32> = out;
    p[0] = n.x >> 16;
    p[1] = n.y >> 16;
    p[2] = n.w >> 16;
    p[3] = n.h >> 16;
    p[4] = g_aui_tg_dcx >> 16;
    p[5] = g_aui_tg_dcy >> 16;
    p[6] = g_aui_tg_dr >> 16;
    p[7] = g_aui_tg_hh >> 16;
    return 0;
}

// v1.30：下拉刷新测试辅助。位移按像素四舍五入，状态见 aui.ast。
fn aui_debug_refresh(key: i32) : i32 {
    let s: i32 = ref_find(key);
    if (s < 0) { return 0; }
    return fx_px(g_aui_ref_disp[s]);
}

fn aui_debug_refresh_state(key: i32) : i32 {
    return ref_state(key);
}

fn aui_debug_refresh_phase(key: i32) : i32 {
    let s: i32 = ref_find(key);
    if (s < 0) { return 0; }
    return g_aui_ref_phase[s];
}
