// v1.21：刚点的分段下标（同一帧重建后仍可读）；否则回读容器节点的 aux。
fn aui_segmented_value(key: i32) : i32 {
    if (g_aui_seg_key != 0 && g_aui_seg_key == key) { return g_aui_seg_val; }
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 17 && n.key == key) { return n.aux; }
        i = i + 1;
    }
    return -1;
}

// v1.22：刚点的标签页下标（同一帧重建后仍可读）；否则回读容器 aux。
fn aui_tabs_value(key: i32) : i32 {
    if (g_aui_tab_key != 0 && g_aui_tab_key == key) { return g_aui_tab_val; }
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 19 && n.key == key) { return n.aux; }
        i = i + 1;
    }
    return -1;
}

// v1.24：刚松手提议的分页下标（同一帧重建后仍可读）；否则回读容器 aux。
fn aui_pager_value(key: i32) : i32 {
    if (g_aui_pager_prop_key != 0 && g_aui_pager_prop_key == key) {
        return g_aui_pager_prop_val;
    }
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 21 && n.key == key) { return n.aux; }
        i = i + 1;
    }
    return -1;
}

// v1.25：对话框关闭原因，只在 aui_dialog 的 cb 里有效：
// 1 = 点遮罩，2 = 系统 BACK，0 = 其他（按钮回调）。
fn aui_dialog_reason() : i32 { return g_aui_dialog_reason; }

// v1.38：底部弹出层关闭原因，只在 aui_sheet 的 cb 里有效：
// 1 = 点遮罩，2 = 系统 BACK，3 = 下拉越过阈值，0 = 其他（按钮回调）。
fn aui_sheet_reason() : i32 { return g_aui_sheet_reason; }

// ---- 页面栈（v1.8）----
// 路由值由应用解释（通常 >0）。push/pop/reset 都会清焦点并同步重建，
// 所以在按钮回调里直接调用即可，不需要再 aui_invalidate。
fn nav_ready() : i32 {
    if (g_aui_nav_ready == 0) {
        g_aui_nav_stack[0] = 1;
        g_aui_nav_depth = 1;
        g_aui_route_key = 1;
        g_aui_nav_ready = 1;
    }
    return 0;
}

fn nav_changed(dir: i32) : i32 {
    // v1.27：换页时收起工具提示（旧页的锚点已失效）。
    let th: i32 = tip_dismiss();
    if (g_aui_nav_ms > 0) {
        let pb: i32 = page_begin(dir, g_aui_nav_ms);
    }
    g_aui_focus_key = 0;
    let tn: i32 = trace_hex(110, g_aui_route_key);   // n + 当前路由
    let r: i32 = aui_invalidate();
    return 0;
}

fn aui_route() : i32 {
    nav_ready();
    return g_aui_route_key;
}

fn aui_nav_depth() : i32 {
    nav_ready();
    return g_aui_nav_depth;
}

// 页面转场时长（毫秒），0 = 关闭（默认）。只在 push/pop/reset 时生效；
// 旧页用命令快照保留，新页由正常 build 产生。
fn aui_nav_transition(ms: i32) : i32 {
    if (ms < 0) { ms = 0; }
    if (ms > 1000) { ms = 1000; }
    g_aui_nav_ms = ms;
    if (ms == 0) {
        let was: i32 = g_aui_page_on;
        let c: i32 = page_cancel();
        if (was != 0) {
            let r: i32 = aui_invalidate();
        }
    }
    return 0;
}

fn aui_nav_busy() : i32 {
    let pr: i32 = page_refresh();
    return g_aui_page_on;
}

fn aui_nav_push(route: i32) : i32 {
    nav_ready();
    if (g_aui_nav_depth >= AUI_NAV_MAX) { return -1; }
    g_aui_nav_stack[g_aui_nav_depth] = route;
    g_aui_nav_depth = g_aui_nav_depth + 1;
    g_aui_route_key = route;
    nav_changed(1);
    return 0;
}

fn aui_nav_pop() : i32 {
    nav_ready();
    if (g_aui_nav_depth <= 1) { return -1; }
    g_aui_nav_depth = g_aui_nav_depth - 1;
    g_aui_route_key = g_aui_nav_stack[g_aui_nav_depth - 1];
    nav_changed(-1);
    return 0;
}

fn aui_nav_reset(route: i32) : i32 {
    nav_ready();
    g_aui_nav_depth = 1;
    g_aui_nav_stack[0] = route;
    g_aui_route_key = route;
    nav_changed(0);
    return 0;
}

// 根页面按返回键时调用。先置位防止重复 finish，再交给 NativeActivity。
fn aui_finish() : i32 {
    if (g_aui_finished != 0) { return 0; }
    g_aui_finished = 1;
    let tb: i32 = trace_mark(98);        // b = 请求结束 Activity
    if (g_aui_activity == 0) { return -1; }
    return ANativeActivity_finish(g_aui_activity);
}

fn aui_text_value(key: i32) : ptr {
    let idx: i32 = text_slot(key, 0);
    if (idx < 0) { return g_aui_empty; }
    return g_aui_text_pool + idx * AUI_TEXT_SLOT;
}

fn aui_text_len(key: i32) : i32 { return text_len_of(key); }

fn aui_text_append(key: i32, ch: i32) : i32 {
    let r: i32 = text_append(key, ch);
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return r;
}

fn aui_text_backspace(key: i32) : i32 {
    let r: i32 = text_backspace(key);
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return r;
}

fn aui_text_clear(key: i32) : i32 {
    let r: i32 = text_clear(key);
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return r;
}

fn aui_text_set(key: i32, src: ptr, count: i32) : i32 {
    let r: i32 = text_set(key, src, count);
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return r;
}

// W2: the font pointer is ignored -- there is no .auf blob in the
// repo to inject. Glyphs come from the runtime adapter
// (font_runtime.ast): the device system font, else the hand-drawn
// fallback. Only the scale is recorded (native em 48 px at scale 1,
// matching the old font_latin48/font_cjk48 size). Pass font=0.
fn aui_set_font(font: ptr, scale: i32) : i32 {
    g_aui_font = 0;
    g_aui_rt_mode = 1;
    if (scale > 0) { g_aui_text_scale = scale; }
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return 0;
}

// v1.16：回退字体（通常是 16x16 CJK 图集）。主字体找不到的码点在这里
// 再查一次；两套字体各自带缩放，拉丁 8x8 常用 2，汉字 16x16 常用 1。
// 传 font=0 关闭回退。
// W2: kept for API compatibility only. The fallback now lives inside
// the runtime adapter (hand-drawn 56-glyph atlas when no system font
// is present); the pointer is ignored and the scale is recorded but
// unused by the runtime path.
fn aui_set_fallback_font(font: ptr, scale: i32) : i32 {
    g_aui_font2 = 0;
    g_aui_rt_mode = 1;
    if (scale > 0) { g_aui_text_scale2 = scale; }
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return 0;
}

fn aui_version() : i32 { return 14806; }

// v2.19.2：应用版本（与框架版本 aui_version 区分：这是 APK 的版本名 +
// code）。启动日志行与 Gallery System 标签页共用同一份常量：应用在
// build 里调 aui_set_app_version 一次登记，框架只存、只读，不再写第
// 二份。登记点放 build 而不用 app_init——app_init 只存进 g_aui_init
// 从未被调用（全仓库无调用方，见 REPORT-v2192），build 是设备与
// headless 两条路径上首帧前必跑的钩子。未登记时名字为 0、code 为 0。
let g_aui_app_ver_name: ptr = 0;

let g_aui_app_ver_code: i32 = 0;

let g_aui_ver_logged: i32 = 0;

fn aui_set_app_version(name: ptr, code: i32) : i32 {
    g_aui_app_ver_name = name;
    g_aui_app_ver_code = code;
    return 0;
}

fn aui_app_version_name() : ptr { return g_aui_app_ver_name; }

fn aui_app_version_code() : i32 { return g_aui_app_ver_code; }

fn aui_debug_spin_phase() : i32 { return spin_phase_now(); }

fn aui_debug_progress_circle(key: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 31 && n.key == key) {
            *(out + 0) = n.aux;
            *(out + 4) = n.aux2;
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

// v1.33：树行的测试辅助。out[0] = 缩进层级，out[1] = 标志位。
fn aui_debug_tree_item(key: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 33 && n.key == key) {
            *(out + 0) = n.aux2;
            *(out + 4) = n.gap;
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

// v1.34：Toast 几何（像素）。out = [x,y,w,h,id,active]；找不到返回 -1。
fn aui_debug_toast(handle: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < AUI_TOAST_CAP) {
        if (g_aui_toast_on[i] != 0 && g_aui_toast_id[i] == handle) {
            *(out + 0) = g_aui_toast_x[i] >> 16;
            *(out + 4) = g_aui_toast_y[i] >> 16;
            *(out + 8) = g_aui_toast_w[i] >> 16;
            *(out + 12) = g_aui_toast_h[i] >> 16;
            *(out + 16) = handle;
            *(out + 20) = 1;
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

fn aui_debug_toast_count() : i32 {
    let n: i32 = 0;
    let i: i32 = 0;
    while (i < AUI_TOAST_CAP) {
        if (g_aui_toast_on[i] != 0) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

// v1.34：SnackBar 几何/状态。out = [x,y,w,h,ax,ay,aw,ah,id,rem_ms,state]，
// state: 0 无 / 1 可见 / 2 动作按钮按下。没有时返回 -1。
fn aui_debug_snackbar(out: ptr) : i32 {
    if (g_aui_snack_on == 0) { return -1; }
    *(out + 0) = g_aui_snack_x >> 16;
    *(out + 4) = g_aui_snack_y >> 16;
    *(out + 8) = g_aui_snack_w >> 16;
    *(out + 12) = g_aui_snack_h >> 16;
    *(out + 16) = g_aui_snack_ax >> 16;
    *(out + 20) = g_aui_snack_ay >> 16;
    *(out + 24) = g_aui_snack_aw >> 16;
    *(out + 28) = g_aui_snack_ah >> 16;
    *(out + 32) = g_aui_snack_id;
    let rem: i32 = -1;
    if (g_aui_snack_rem >= 0) {
        rem = i32(g_aui_snack_rem / 1000000);
    }
    *(out + 36) = rem;
    let st: i32 = 1;
    if (g_aui_snack_press != 0) { st = 2; }
    *(out + 40) = st;
    return 0;
}

fn aui_debug_rect(key: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.key == key) {
            *(out + 0) = n.x >> 16;
            *(out + 4) = n.y >> 16;
            *(out + 8) = n.w >> 16;
            *(out + 12) = n.h >> 16;
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

// D-2a 测试探针：按 key 读修饰值。out = [size_w_dp, size_h_dp,
// text_sp, fg_bits, fg_set, selectable]；找不到 key 返回 -1。
fn aui_debug_d2a(key: i32, out: ptr) : i32 {
    let i: i32 = 0;
    while (i < g_aui_node_count) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.key == key) {
            *(out + 0) = g_d2a_size_w[i];
            *(out + 4) = g_d2a_size_h[i];
            *(out + 8) = g_d2a_text_sp[i];
            *(out + 12) = g_d2a_fg[i];
            *(out + 16) = g_d2a_fg_set[i];
            *(out + 20) = g_d2a_sel[i];
            return 0;
        }
        i = i + 1;
    }
    return -1;
}

// D-2a：选区读回。out = [node_idx, key, start_cp, end_cp]；无选区返回 -1。
fn aui_debug_selection(out: ptr) : i32 {
    if (d2a_sel_valid() == 0) { return -1; }
    let n: ptr<AuiNode> = node_at(g_d2a_sel_node);
    *(out + 0) = g_d2a_sel_node;
    *(out + 4) = n.key;
    *(out + 8) = g_d2a_sel_start;
    *(out + 12) = g_d2a_sel_end;
    return 0;
}

// D-2a：选中文本节点的 key；无选区返回 0。
fn aui_selection_key() : i32 {
    if (d2a_sel_valid() == 0) { return 0; }
    let n: ptr<AuiNode> = node_at(g_d2a_sel_node);
    return n.key;
}

// 测试辅助：设置离屏渲染的密度（dpi）。只给离屏/qemu 测试用。
fn aui_debug_set_density(dpi: i32) : i32 {
    if (dpi <= 0) { return -1; }
    g_aui_density = (dpi << 16) / 160;
    g_aui_need_build = 1;
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    return 0;
}

// 测试辅助：给 headless 测试挂一个窗口指针，让 pump_frame_once() 走
// 真机泵路径（v2.7.1；没有窗口时它直接返回，不调任何 tick）。
// 传 0 摘掉窗口。只给离屏/qemu 测试用，渲染路径不依赖。
fn aui_debug_set_win(win: ptr) : i32 {
    g_aui_win = win;
    if (win != 0) { g_aui_have_win = 1; }
    else { g_aui_have_win = 0; }
    return 0;
}

// ---- 虚拟列表公共/调试接口（v1.45）----
fn vlist_node(key: i32) : i32 {
    let i: i32 = g_aui_node_count - 1;
    while (i >= 0) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 51 && n.key == key) { return i; }
        i = i - 1;
    }
    return -1;
}

fn aui_vlist_scroll(key: i32) : i32 {
    return scroll_get(key);                       // 已是像素
}

// 程序化滚动：像素，自动 clamp；会触发窗口重建。
fn aui_vlist_scroll_to(key: i32, px: i32) : i32 {
    let v: i32 = scroll_set(key, px);
    let vt: i32 = vlist_touch(key);
    let r: i32 = aui_invalidate_layout();
    return v;
}

// 测试辅助：out = [x,y,w,h,count,first,last,offset_px]（像素/整数）。
fn aui_debug_vlist(key: i32, out: ptr) : i32 {
    let i: i32 = vlist_node(key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    *(out + 0) = n.x >> 16;
    *(out + 4) = n.y >> 16;
    *(out + 8) = n.w >> 16;
    *(out + 12) = n.h >> 16;
    *(out + 16) = n.aux;
    *(out + 20) = g_aui_vlist_first_cur;
    *(out + 24) = g_aui_vlist_last_cur;
    let off: i32 = scroll_get(key);                // 已是像素
    *(out + 28) = off;
    let s: i32 = vlist_find(key);
    if (s >= 0) {
        *(out + 20) = g_aui_vlist_first[s];
        *(out + 24) = g_aui_vlist_last[s];
    }
    return 0;
}

// 测试辅助：当前窗口内某行的矩形；out = [x,y,w,h]。
fn aui_debug_vlist_row(key: i32, index: i32, out: ptr) : i32 {
    let i: i32 = vlist_node(key);
    if (i < 0) { return -1; }
    let vn: ptr<AuiNode> = node_at(i);
    let c: i32 = vn.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        if (cn.aux2 == index) {
            *(out + 0) = cn.x >> 16;
            *(out + 4) = cn.y >> 16;
            *(out + 8) = cn.w >> 16;
            *(out + 12) = cn.h >> 16;
            return 0;
        }
        c = cn.next_sibling;
    }
    return -1;
}

// ---- 虚拟表格公共/调试接口（v2.17）----
// 测试辅助：out = [x,y,w,h,rows,cols,first_row,last_row,first_col,
// last_col,off_y,off_x]（像素/整数）。
fn aui_debug_vtable(key: i32, out: ptr) : i32 {
    let i: i32 = vtable_node(key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    *(out + 0) = n.x >> 16;
    *(out + 4) = n.y >> 16;
    *(out + 8) = n.w >> 16;
    *(out + 12) = n.h >> 16;
    *(out + 16) = n.aux;
    *(out + 20) = n.flags;
    let s: i32 = vtable_find(key);
    if (s >= 0) {
        *(out + 24) = g_aui_vtable_first_row[s];
        *(out + 28) = g_aui_vtable_last_row[s];
        *(out + 32) = g_aui_vtable_first_col[s];
        *(out + 36) = g_aui_vtable_last_col[s];
        *(out + 40) = g_aui_vtable_off[s];
        *(out + 44) = g_aui_vtable_offx[s];
    } else {
        *(out + 24) = g_aui_vtable_first_row_cur;
        *(out + 28) = g_aui_vtable_last_row_cur;
        *(out + 32) = g_aui_vtable_first_col_cur;
        *(out + 36) = g_aui_vtable_last_col_cur;
        *(out + 40) = scroll_get(key);
        *(out + 44) = vtable_off_x(key);
    }
    return 0;
}

// 测试辅助：当前窗口内某格的矩形；out = [x,y,w,h]。格子不在窗口内返回 -1。
fn aui_debug_vtable_cell(key: i32, row: i32, col: i32, out: ptr) : i32 {
    let i: i32 = vtable_node(key);
    if (i < 0) { return -1; }
    let vn: ptr<AuiNode> = node_at(i);
    let c: i32 = vn.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        if (cn.aux == row && cn.aux2 == col) {
            *(out + 0) = cn.x >> 16;
            *(out + 4) = cn.y >> 16;
            *(out + 8) = cn.w >> 16;
            *(out + 12) = cn.h >> 16;
            return 0;
        }
        c = cn.next_sibling;
    }
    return -1;
}

// 测试辅助：直接设置横向偏移（像素，自动夹取）；纵向用 aui_debug_scroll_set。
fn aui_debug_vtable_set_x(key: i32, px: i32) : i32 {
    return vtable_set_x(key, px);
}

// ---- 不定高虚拟列表公共/调试接口（v2.10）----
fn vlvar_node(key: i32) : i32 {
    let i: i32 = g_aui_node_count - 1;
    while (i >= 0) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 58 && n.key == key) { return i; }
        i = i - 1;
    }
    return -1;
}

// 测试辅助：out = [x,y,w,h,count,first,last,offset_px]（像素/整数）。
fn aui_debug_vlist_var(key: i32, out: ptr) : i32 {
    let i: i32 = vlvar_node(key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    *(out + 0) = n.x >> 16;
    *(out + 4) = n.y >> 16;
    *(out + 8) = n.w >> 16;
    *(out + 12) = n.h >> 16;
    *(out + 16) = n.aux;
    *(out + 20) = g_aui_vlist_first_cur;
    *(out + 24) = g_aui_vlist_last_cur;
    let off: i32 = scroll_get(key);
    *(out + 28) = off;
    let s: i32 = vlist_find(key);
    if (s >= 0) {
        *(out + 20) = g_aui_vlist_first[s];
        *(out + 24) = g_aui_vlist_last[s];
    }
    return 0;
}

// 测试辅助：当前窗口内某行的矩形 + 缓存高度；
// out = [x,y,w,h,cached_h_px,measured]（未测量时 cached_h_px 为估计高）。
fn aui_debug_vlist_var_row(key: i32, index: i32, out: ptr) : i32 {
    let i: i32 = vlvar_node(key);
    if (i < 0) { return -1; }
    let vn: ptr<AuiNode> = node_at(i);
    let c: i32 = vn.first_child;
    while (c >= 0) {
        let cn: ptr<AuiNode> = node_at(c);
        if (cn.aux2 == index) {
            *(out + 0) = cn.x >> 16;
            *(out + 4) = cn.y >> 16;
            *(out + 8) = cn.w >> 16;
            *(out + 12) = cn.h >> 16;
            let s: i32 = vlist_find(key);
            let estpx: i32 = vn.aux2 >> 16;
            if (estpx < 1) { estpx = 1; }
            let ch: i32 = estpx;
            let ms: i32 = 0;
            if (s >= 0 && index >= 0 && index < AUI_VLVAR_HCAP) {
                let cv: i32 = g_aui_vlvar_h[s * AUI_VLVAR_HCAP + index];
                if (cv > 0) { ch = cv; ms = 1; }
            }
            *(out + 16) = ch;
            *(out + 20) = ms;
            return 0;
        }
        c = cn.next_sibling;
    }
    return -1;
}

// 测试辅助：out = [total_px,measured_count,write_count,cap]。
// ---- 可调分栏调试接口（v2.12）----
fn split_node(key: i32) : i32 {
    let i: i32 = g_aui_node_count - 1;
    while (i >= 0) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 61 && n.key == key) { return i; }
        i = i - 1;
    }
    return -1;
}

// 测试辅助：某窗格的矩形；out = [x,y,w,h]。
fn aui_debug_split_pane(key: i32, index: i32, out: ptr) : i32 {
    let i: i32 = split_node(key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    let c: i32 = n.first_child;
    if (index == 1) {
        if (c < 0) { return -1; }
        c = node_at(c).next_sibling;
    } else if (index != 0) {
        return -1;
    }
    if (c < 0) { return -1; }
    let cn: ptr<AuiNode> = node_at(c);
    *(out + 0) = cn.x >> 16;
    *(out + 4) = cn.y >> 16;
    *(out + 8) = cn.w >> 16;
    *(out + 12) = cn.h >> 16;
    return 0;
}

fn aui_debug_vlist_var_stats(key: i32, out: ptr) : i32 {
    let s: i32 = vlist_find(key);
    if (s < 0) { return -1; }
    let count: i32 = g_aui_vlvar_count[s];
    let estpx: i32 = g_aui_vlvar_est[s];
    if (estpx < 1) { estpx = 1; }
    *(out + 0) = vlvar_total(s, count, estpx);
    *(out + 4) = vlvar_measured(s, count);
    *(out + 8) = g_aui_vlvar_writes[s];
    *(out + 12) = AUI_VLVAR_HCAP;
    return 0;
}

// 测试辅助：角标矩形；out = [x,y,w,h,visible]。
fn aui_debug_badge(key: i32, out: ptr) : i32 {
    let i: i32 = g_aui_node_count - 1;
    while (i >= 0) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 60 && n.key == key) {
            *(out + 0) = n.x >> 16;
            *(out + 4) = n.y >> 16;
            *(out + 8) = n.w >> 16;
            *(out + 12) = n.h >> 16;
            let vis: i32 = 1;
            if (n.aux2 == 1 && n.gap <= 0) { vis = 0; }
            *(out + 16) = vis;
            return 0;
        }
        i = i - 1;
    }
    return -1;
}

// ---- 虚拟网格公共/调试接口（v1.46）----
fn vgrid_node(key: i32) : i32 {
    let i: i32 = g_aui_node_count - 1;
    while (i >= 0) {
        let n: ptr<AuiNode> = node_at(i);
        if (n.kind == 53 && n.key == key) { return i; }
        i = i - 1;
    }
    return -1;
}

fn aui_vgrid_scroll(key: i32) : i32 {
    return scroll_get(key);                       // 已是像素
}

// 程序化滚动：像素，自动 clamp；会触发窗口重建。
fn aui_vgrid_scroll_to(key: i32, px: i32) : i32 {
    let v: i32 = scroll_set(key, px);
    let vt: i32 = vgrid_touch(key);
    let r: i32 = aui_invalidate_layout();
    return v;
}

// 测试辅助：out = [x,y,w,h,count,cols,first,last,offset_px]。
fn aui_debug_vgrid(key: i32, out: ptr) : i32 {
    let i: i32 = vgrid_node(key);
    if (i < 0) { return -1; }
    let n: ptr<AuiNode> = node_at(i);
    let inner: i32 = n.w - n.pad * 2;
    if (inner < 0) { inner = 0; }
    let cols: i32 = vgrid_cols_for(n, inner);
    *(out + 0) = n.x >> 16;
    *(out + 4) = n.y >> 16;
    *(out + 8) = n.w >> 16;
    *(out + 12) = n.h >> 16;
    *(out + 16) = n.aux;
    *(out + 20) = cols;
    *(out + 24) = 0;
    *(out + 28) = 0;
    let s: i32 = vgrid_find(key);
    if (s >= 0) {
        *(out + 24) = g_aui_vgrid_first[s];
        *(out + 28) = g_aui_vgrid_last[s];
        *(out + 32) = g_aui_vgrid_off[s];
    } else {
        *(out + 32) = scroll_get(key);
    }
    return 0;
}

// 测试辅助：当前窗口内某格子的矩形；out = [x,y,w,h]。
fn aui_debug_vgrid_cell(key: i32, index: i32, out: ptr) : i32 {
