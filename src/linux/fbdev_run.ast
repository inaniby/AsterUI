// fbdev_run.ast -- Linux runner：参数解析 + 主循环。
//
// v2.20.0 (M4)。入口（examples/*_linux.ast）先调 *_headless_init()
// 注册 build/user、再调 app_init(user)，最后调 fbdev_run(argc, argv)。
// 这里按顺序做：字体候选 → fbdev_open → 公开 setter →
// aui_fbdev_attach → 输入源 → 主循环（输入步进 → aui_on_input →
// pump_frame_once → 节流）。单线程；泵线程不起（pthread 桩 -1）。
//
// 空闲节流是 50ms 轮询（设计 §1.6 的“阻塞读 evdev”改了：无 poll /
// fcntl 可把同一个 fd 在阻塞与非阻塞间切换，双开设备会收到双份
// 事件；50ms 轮询一次 uptime 读 + 一次非阻塞排空，CPU 可忽略，
// 输入延迟 ≤50ms，动效期间仍是 16ms 节拍）。

include "../../src/aster_std.ast";

// ---- 框架（aui_impl.ast） ----
extern fn aui_fbdev_attach(win: ptr, queue: ptr, logdir: ptr) -> i32;
extern fn aui_pump_need() -> i32;
extern fn aui_on_input(ident: i32, events: i32, data: ptr) -> i32;
extern fn pump_frame_once() -> i32;
extern fn aui_shutdown() -> i32;
extern fn aui_debug_set_density(dpi: i32) -> i32;
extern fn aui_edge_to_edge(on: i32) -> i32;
extern fn aui_rt_set_font_path(path: ptr) -> i32;
extern fn aui_log(level: i32, msg: ptr) -> i32;

// ---- 适配器（fbdev.ast / fbdev_input.ast） ----
extern fn fb_err(msg: ptr) -> i32;
extern fn fb_clock_ns() -> i64;
extern fn fb_busy_wait_ms(ms: i32) -> i32;
extern fn fbdev_set_tree(dev: ptr, sysfs: ptr) -> i32;
extern fn fbdev_open(w: i32, h: i32) -> i32;
extern fn fbdev_close() -> i32;
extern fn fbdev_mode() -> i32;
extern fn fbdev_w() -> i32;
extern fn fbdev_h() -> i32;
extern fn fbdev_presents() -> i32;
extern fn fbdev_win() -> ptr;
extern fn fbdev_queue() -> ptr;
extern fn fbdev_write_bmp(path: ptr) -> i32;
extern fn fb_input_step() -> i32;
extern fn fb_script_open(path: ptr) -> i32;
extern fn fb_script_quit() -> i32;
extern fn fb_script_eof() -> i32;
extern fn fb_script_set_shot_dir(dir: ptr) -> i32;
extern fn fb_evdev_open(path: ptr) -> i32;
extern fn fb_evdev_fd() -> i32;
extern fn fb_evdev_set_range(w: i32, h: i32) -> i32;
extern fn fb_evdev_discover(out: ptr, cap: i32) -> i32;

fn fb_argv(argc: i32, argv: ptr, i: i32) -> ptr {
    if (i < 0 || i >= argc) { return 0; }
    return load_ptr(argv + i * 8);
}

fn fb_streq(a: ptr, b: ptr) -> i32 {
    if (a == 0 || b == 0) { return 0; }
    let i: i32 = 0;
    while (load_u8(a + i) == load_u8(b + i)) {
        if (load_u8(a + i) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

// "1234" → 1234（前导空白允许；失败返回 -1）。
fn fb_atoi(s: ptr) -> i32 {
    if (s == 0) { return 0 - 1; }
    let i: i32 = 0;
    while (load_u8(s + i) == 32 || load_u8(s + i) == 9) { i = i + 1; }
    let neg: i32 = 0;
    if (load_u8(s + i) == 45) { neg = 1; i = i + 1; }
    let v: i32 = 0;
    let nd: i32 = 0;
    while (load_u8(s + i) >= 48 && load_u8(s + i) <= 57) {
        v = v * 10 + (load_u8(s + i) - 48);
        nd = nd + 1;
        i = i + 1;
    }
    if (nd == 0) { return 0 - 1; }
    if (neg != 0) { v = 0 - v; }
    return v;
}

// "1216x2688" → w/h（*wo/*ho 写出；失败返回 -1）。
fn fb_parse_size(s: ptr, wo: ptr, ho: ptr) -> i32 {
    if (s == 0) { return 0 - 1; }
    let i: i32 = 0;
    let w: i32 = 0;
    let nd: i32 = 0;
    while (load_u8(s + i) >= 48 && load_u8(s + i) <= 57) {
        w = w * 10 + (load_u8(s + i) - 48);
        nd = nd + 1;
        i = i + 1;
    }
    if (nd == 0) { return 0 - 1; }
    let x: i32 = load_u8(s + i);
    if (x != 120 && x != 88) { return 0 - 1; }
    i = i + 1;
    let h: i32 = 0;
    let nd2: i32 = 0;
    while (load_u8(s + i) >= 48 && load_u8(s + i) <= 57) {
        h = h * 10 + (load_u8(s + i) - 48);
        nd2 = nd2 + 1;
        i = i + 1;
    }
    if (nd2 == 0) { return 0 - 1; }
    *(wo) = w;
    *(ho) = h;
    return 0;
}

fn fb_usage() -> i32 {
    let e0: i32 = fb_err("usage: gallery-linux [options]");
    let e1: i32 = fb_err("  --size WxH       framebuffer size (default 1280x720)");
    let e2: i32 = fb_err("  --dpi N          density dpi (default 160)");
    let e3: i32 = fb_err("  --font PATH      explicit font file");
    let e4: i32 = fb_err("  --log DIR        trace.txt/aui.log dir (default .)");
    let e5: i32 = fb_err("  --frames DIR     BMP shot dir (default ./frames)");
    let e6: i32 = fb_err("  --script PATH    input script (tap/drag/tab/sleep/shot/quit)");
    let e7: i32 = fb_err("  --input PATH     evdev device (default: auto-discover)");
    let e8: i32 = fb_err("  --no-evdev       do not open any evdev device");
    let e9: i32 = fb_err("  --touch-range W H  touch raw range for scaling");
    let ea: i32 = fb_err("  --dev PATH       fb device override (test/fake tree)");
    let eb: i32 = fb_err("  --sysfs-root DIR sysfs root override (test/fake tree)");
    let ec: i32 = fb_err("  --dump-fb PATH   present one frame to BMP and exit");
    let ed: i32 = fb_err("  --max-frames N   exit after N presents (0 = run)");
    let ee: i32 = fb_err("  --max-seconds N  exit after N seconds (0 = run)");
    return 0;
}

fn fbdev_run(argc: i32, argv: ptr) -> i32 {
    let w: i32 = 1280;
    let h: i32 = 720;
    let dpi: i32 = 160;
    let font: ptr = 0;
    let logdir: ptr = ".";
    let shotdir: ptr = "./frames";
    let script: ptr = 0;
    let input: ptr = 0;
    let no_evdev: i32 = 0;
    let touch_w: i32 = 0;
    let touch_h: i32 = 0;
    let dev: ptr = 0;
    let sysfs: ptr = 0;
    let dump: ptr = 0;
    let max_frames: i32 = 0;
    let max_seconds: i32 = 0;

    let i: i32 = 1;
    while (i < argc) {
        let a: ptr = fb_argv(argc, argv, i);
        if (a == 0) { i = i + 1; continue; }
        if (fb_streq(a, "--help") != 0) {
            let u: i32 = fb_usage();
            return 0;
        } else if (fb_streq(a, "--size") != 0 && i + 1 < argc) {
            let wo: i32[1] = 0;
            let ho: i32[1] = 0;
            let r: i32 = fb_parse_size(fb_argv(argc, argv, i + 1), wo, ho);
            if (r == 0 && wo[0] > 0 && ho[0] > 0) { w = wo[0]; h = ho[0]; }
            i = i + 2;
            continue;
        } else if (fb_streq(a, "--dpi") != 0 && i + 1 < argc) {
            let d: i32 = fb_atoi(fb_argv(argc, argv, i + 1));
            if (d > 0) { dpi = d; }
            i = i + 2;
            continue;
        } else if (fb_streq(a, "--font") != 0 && i + 1 < argc) {
            font = fb_argv(argc, argv, i + 1);
            i = i + 2;
            continue;
        } else if (fb_streq(a, "--log") != 0 && i + 1 < argc) {
            logdir = fb_argv(argc, argv, i + 1);
            i = i + 2;
            continue;
        } else if (fb_streq(a, "--frames") != 0 && i + 1 < argc) {
            shotdir = fb_argv(argc, argv, i + 1);
            i = i + 2;
            continue;
        } else if (fb_streq(a, "--script") != 0 && i + 1 < argc) {
            script = fb_argv(argc, argv, i + 1);
            i = i + 2;
            continue;
        } else if (fb_streq(a, "--input") != 0 && i + 1 < argc) {
            input = fb_argv(argc, argv, i + 1);
            i = i + 2;
            continue;
        } else if (fb_streq(a, "--no-evdev") != 0) {
            no_evdev = 1;
            i = i + 1;
            continue;
        } else if (fb_streq(a, "--touch-range") != 0 && i + 2 < argc) {
            let tw: i32 = fb_atoi(fb_argv(argc, argv, i + 1));
            let th: i32 = fb_atoi(fb_argv(argc, argv, i + 2));
            if (tw > 0 && th > 0) { touch_w = tw; touch_h = th; }
            i = i + 3;
            continue;
        } else if (fb_streq(a, "--dev") != 0 && i + 1 < argc) {
            dev = fb_argv(argc, argv, i + 1);
            i = i + 2;
            continue;
        } else if (fb_streq(a, "--sysfs-root") != 0 && i + 1 < argc) {
            sysfs = fb_argv(argc, argv, i + 1);
            i = i + 2;
            continue;
        } else if (fb_streq(a, "--dump-fb") != 0 && i + 1 < argc) {
            dump = fb_argv(argc, argv, i + 1);
            i = i + 2;
            continue;
        } else if (fb_streq(a, "--max-frames") != 0 && i + 1 < argc) {
            let mf: i32 = fb_atoi(fb_argv(argc, argv, i + 1));
            if (mf > 0) { max_frames = mf; }
            i = i + 2;
            continue;
        } else if (fb_streq(a, "--max-seconds") != 0 && i + 1 < argc) {
            let ms: i32 = fb_atoi(fb_argv(argc, argv, i + 1));
            if (ms > 0) { max_seconds = ms; }
            i = i + 2;
            continue;
        }
        // 未知参数：警告后跳过（runner 宁可跑起来也不在参数上死）。
        let w0: i32 = fb_err("fbdev: unknown arg, ignored");
        i = i + 1;
    }

    // ---- 字体：--font 优先，否则按候选顺序逐个试 ----
    if (font != 0) {
        let f0: i32 = aui_rt_set_font_path(font);
        if (f0 != 1) {
            let w1: i32 = fb_err("fbdev: --font did not load, continuing with fallback");
        }
    } else {
        let c0: i32 = aui_rt_set_font_path("/system/fonts/NotoSansCJK-Regular.ttc");
        if (c0 != 1) {
            let c1: i32 = aui_rt_set_font_path("/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc");
            if (c1 != 1) {
                let c2: i32 = aui_rt_set_font_path("/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc");
                if (c2 != 1) {
                    let c3: i32 = aui_rt_set_font_path("/usr/share/fonts/TTF/DejaVuSans.ttf");
                    if (c3 != 1) {
                        let w2: i32 = fb_err("fbdev: no system font found, continuing with fallback");
                    }
                }
            }
        }
    }

    // ---- 打开帧缓冲（无 fb0 时回落内存，不崩） ----
    if (dev != 0 || sysfs != 0) {
        let st: i32 = fbdev_set_tree(dev, sysfs);
    }
    let mode: i32 = fbdev_open(w, h);
    if (mode < 0) {
        let e0: i32 = fb_err("fbdev: open failed entirely");
        return 1;
    }
    if (mode == 0) {
        let m0: i32 = fb_err("fbdev: memory framebuffer");
    } else if (mode == 1) {
        let m1: i32 = fb_err("fbdev: real fb0, 32bpp XRGB");
    } else {
        let m2: i32 = fb_err("fbdev: real fb0, 16bpp RGB565");
    }

    // ---- 平台 setter（attach 之前定好）→ attach ----
    let sd: i32 = aui_debug_set_density(dpi);
    let ee: i32 = aui_edge_to_edge(1);
    let at: i32 = aui_fbdev_attach(fbdev_win(), fbdev_queue(), logdir);

    // ---- 输入源 ----
    let ss: i32 = fb_script_set_shot_dir(shotdir);
    if (script != 0) {
        let so: i32 = fb_script_open(script);
        if (so < 0) {
            let w3: i32 = fb_err("fbdev: script not opened, continuing without it");
        }
    }
    if (no_evdev == 0) {
        if (input != 0) {
            let eo: i32 = fb_evdev_open(input);
            if (eo < 0) {
                let w4: i32 = fb_err("fbdev: evdev device not opened");
            }
        } else {
            let disc: u8[64] = 0;
            let dr: i32 = fb_evdev_discover(disc, 64);
            if (dr == 0) {
                let eo2: i32 = fb_evdev_open(disc);
                if (eo2 < 0) {
                    let w5: i32 = fb_err("fbdev: discovered evdev not opened (no permission?)");
                }
            }
        }
        if (touch_w > 0 && touch_h > 0) {
            let tr: i32 = fb_evdev_set_range(touch_w, touch_h);
        }
    }

    // ---- --dump-fb：出一帧、存 BMP、退出 ----
    if (dump != 0) {
        let k: i32 = 0;
        while (k < 5) {
            let p: i32 = pump_frame_once();
            k = k + 1;
        }
        let dw: i32 = fbdev_write_bmp(dump);
        if (dw != 0) {
            let w6: i32 = fb_err("fbdev: dump-fb write failed");
            let sh0: i32 = aui_shutdown();
            let cl0: i32 = fbdev_close();
            return 1;
        }
        let sh1: i32 = aui_shutdown();
        let cl1: i32 = fbdev_close();
        return 0;
    }

    // ---- 主循环 ----
    let start_ns: i64 = fb_clock_ns();
    let presents0: i32 = fbdev_presents();
    let quit: i32 = 0;
    while (quit == 0) {
        let t0: i64 = fb_clock_ns();
        let stepped: i32 = fb_input_step();
        if (stepped != 0) {
            let d: i32 = aui_on_input(1, 0, 0);
        }
        let p: i32 = pump_frame_once();
        if (fb_script_quit() != 0) { quit = 1; }
        if (fb_script_eof() != 0 && fb_evdev_fd() < 0) { quit = 1; }
        if (max_frames > 0 && fbdev_presents() - presents0 >= max_frames) { quit = 1; }
        if (max_seconds > 0) {
            let el: i64 = fb_clock_ns() - start_ns;
            if (el >= i64(max_seconds) * 1000000000) { quit = 1; }
        }
        if (quit == 0) {
            let need: i32 = aui_pump_need();
            let wait_ms: i32 = 50;
            if (need != 0) { wait_ms = 16; }
            let t1: i64 = fb_clock_ns();
            let el_ms: i32 = i32((t1 - t0) / 1000000);
            let rem: i32 = wait_ms - el_ms;
            if (rem > 0) {
                let bw: i32 = fb_busy_wait_ms(rem);
            }
        }
    }
    let sh2: i32 = aui_shutdown();
    let cl2: i32 = fbdev_close();
    return 0;
}
