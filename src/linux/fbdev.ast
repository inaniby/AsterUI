// fbdev.ast -- Linux fbdev 后端：NDK 表面第二份实现 + fbdev 打开流程。
//
// v2.20.0 (M4 / GAP #13)。框架只消费一组命名 extern 函数（见
// tests/fake_ndk.ast 的同一张表）；本文件提供 Linux 实现，Android
// 路径一行不动。编译器只有 7 个 syscall 内建（write/read/openat/
// close/fstat/mmap/brk），无 ioctl / clock_gettime / poll / nanosleep，
// 所以：几何读 sysfs，时钟读 /proc/uptime，等待用阻塞读 + 忙等。
//
// 链接约束：只链 libc/libm 的等价物——本文件是纯 Aster + syscall
// 内建，link-obj 产静态 ET_EXEC，Termux（aarch64、Android linker）
// 可直接跑。绝不引用 libandroid.so 或任何 Android 专属库。
//
// 模式（fbdev_open 返回）：0 = 内存回落（无 fb0 或几何非法时，
// 现代 Android 手机上的常态分支）；1 = 真 fb0 32bpp XRGB8888
// （staging + 整帧 R/B 对换）；2 = 真 fb0 16bpp RGB565（直接当 bits，
// fmt 4，无转换）。无 vsync；32bpp 每呈现一帧做一次全帧转换。

// ---- 状态 ----
let g_fb_mode: i32 = 0;            // 0 内存 / 1 fb32 / 2 fb16
let g_fb_opened: i32 = 0;          // 1 = 已打开（任一模式）
let g_fb_fd: i32 = 0 - 1;          // fb0 fd（内存模式为 -1）
let g_fb_ptr: ptr = 0;             // fb0 mmap（32/16bpp）或内存缓冲
let g_fb_stage: ptr = 0;           // 32bpp staging（框架画这里）
let g_fb_w: i32 = 0;
let g_fb_h: i32 = 0;
let g_fb_stride: i32 = 0;          // 像素/行（报给框架）
let g_fb_stride_bytes: i32 = 0;    // 字节/行（sysfs stride）
let g_fb_fmt: i32 = 1;             // 报给框架：1 = RGBA，4 = RGB565
let g_fb_bpp: i32 = 32;
let g_fb_presents: i32 = 0;        // unlockAndPost 次数
let g_fb_dev0: ptr = 0;            // 0 = 默认 /dev/graphics/fb0
let g_fb_tree_set: i32 = 0;        // 1 = 测试用假设备树
let g_fb_sysfs: ptr = 0;           // 0 = 默认 /sys/class/graphics/fb0
let g_fb_win_obj: i64[4] = 0;      // 哑窗口句柄（非空即可）
let g_fb_queue_obj: i64[4] = 0;    // 哑输入队列句柄
let g_fb_looper_obj: i64[1] = 0;   // 哑 looper
let g_fb_err_buf: u8[512] = 0;     // stderr 行草稿
let g_fb_num_buf: u8[24] = 0;      // 数字格式化草稿
let g_fb_read_buf: u8[256] = 0;    // 小文件读草稿（sysfs / uptime）
let g_fb_bmp_row: u8[16384] = 0;   // BMP 行草稿（宽 <= 4096）
let g_fb_bmp_hd: u8[54] = 0;       // BMP 文件头草稿

// ---- 小工具（本文件自含，不 include，避免与 std.o 的符号纠缠） ----
fn fb_strlen(s: ptr) -> i32 {
    if (s == 0) { return 0; }
    let i: i32 = 0;
    while (load_u8(s + i) != 0) { i = i + 1; }
    return i;
}

fn fb_write_all(fd: i32, buf: ptr, n: i32) -> i32 {
    let done: i32 = 0;
    while (done < n) {
        let w: i32 = write(fd, buf + done, n - done);
        if (w <= 0) { return done; }
        done = done + w;
    }
    return done;
}

// stderr 一行（不经过 aui_log：attach 之前日志还没起来也要能说话）。
fn fb_err(msg: ptr) -> i32 {
    if (msg == 0) { return 0; }
    let n: i32 = fb_strlen(msg);
    let w: i32 = fb_write_all(2, msg, n);
    let nl: i32 = store_u8(g_fb_err_buf + 0, 10);
    let w2: i32 = fb_write_all(2, g_fb_err_buf, 1);
    return w;
}

fn fb_err_i32(prefix: ptr, v: i32) -> i32 {
    // "prefix<number>\n"：数字格式化进 g_fb_num_buf 再拼。
    let n0: i32 = fb_strlen(prefix);
    let i: i32 = 0;
    while (i < n0) {
        let c: i32 = store_u8(g_fb_err_buf + i, load_u8(prefix + i));
        i = i + 1;
    }
    // 十进制（v 可能为负；0 单独处理）。
    let neg: i32 = 0;
    let x: i32 = v;
    if (x < 0) { neg = 1; x = 0 - x; }
    let d: u8[12] = 0;
    let nd: i32 = 0;
    if (x == 0) {
        d[0] = 48;
        nd = 1;
    } else {
        while (x > 0) {
            d[nd] = 48 + (x - (x / 10) * 10);
            nd = nd + 1;
            x = x / 10;
        }
    }
    let at: i32 = n0;
    if (neg != 0) {
        let c0: i32 = store_u8(g_fb_err_buf + at, 45);
        at = at + 1;
    }
    let j: i32 = nd - 1;
    while (j >= 0) {
        let c1: i32 = store_u8(g_fb_err_buf + at, d[j]);
        at = at + 1;
        j = j - 1;
    }
    let c2: i32 = store_u8(g_fb_err_buf + at, 10);
    at = at + 1;
    let w: i32 = fb_write_all(2, g_fb_err_buf, at);
    return w;
}

// 前导空白后读一个十进制整数（可负）；*used 写消耗的字节数。
// 失败返回 0 且 used=0。
fn fb_parse_i32(buf: ptr, ln: i32, used: ptr) -> i32 {
    let i: i32 = 0;
    while (i < ln) {
        let c: i32 = load_u8(buf + i);
        if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
        i = i + 1;
    }
    let neg: i32 = 0;
    if (i < ln && load_u8(buf + i) == 45) { neg = 1; i = i + 1; }
    let v: i32 = 0;
    let nd: i32 = 0;
    while (i < ln) {
        let c: i32 = load_u8(buf + i);
        if (c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        nd = nd + 1;
        i = i + 1;
    }
    if (nd == 0) {
        *(used) = 0;
        return 0;
    }
    if (neg != 0) { v = 0 - v; }
    *(used) = i;
    return v;
}

// 读一个小文本文件（sysfs / proc）进 g_fb_read_buf，返回字节数，-1 失败。
fn fb_read_small(path: ptr, max: i32) -> i32 {
    let fd: i32 = openat(-100, path, 0, 0);
    if (fd < 0) { return 0 - 1; }
    let n: i32 = read(fd, g_fb_read_buf, max);
    let c: i32 = close(fd);
    if (n < 0) { return 0 - 1; }
    return n;
}

// 拼 "<dir>/<name>" 进 g_fb_read_buf 的尾部？不——路径拼进调用方给的 out。
fn fb_join_path(out: ptr, dir: ptr, name: ptr) -> i32 {
    let n: i32 = fb_strlen(dir);
    if (n <= 0 || n > 200) { return 0 - 1; }
    let i: i32 = 0;
    while (i < n) {
        let c: i32 = store_u8(out + i, load_u8(dir + i));
        i = i + 1;
    }
    let s: i32 = store_u8(out + n, 47);
    let m: i32 = fb_strlen(name);
    let j: i32 = 0;
    while (j < m) {
        let c2: i32 = store_u8(out + n + 1 + j, load_u8(name + j));
        j = j + 1;
    }
    let z: i32 = store_u8(out + n + 1 + m, 0);
    return 0;
}

// ---- 时钟：/proc/uptime（"秒.百分秒"），10ms 分辨率 ----
// 单点函数：编译器以后加 clock_gettime 内建只改这里。
fn fb_clock_ns() -> i64 {
    let n: i32 = fb_read_small("/proc/uptime", 64);
    if (n <= 0) { return 0; }
    // 整数部分（秒）。
    let used: i32[1] = 0;
    let sec: i32 = fb_parse_i32(g_fb_read_buf, n, used);
    let u: i32 = used[0];
    if (u == 0) { return 0; }
    // 小数部分（百分秒 → 纳秒，缺位补 0）。
    let frac: i32 = 0;
    if (u < n && load_u8(g_fb_read_buf + u) == 46) {
        let k: i32 = u + 1;
        let d0: i32 = 0;
        let d1: i32 = 0;
        if (k < n && load_u8(g_fb_read_buf + k) >= 48 && load_u8(g_fb_read_buf + k) <= 57) {
            d0 = load_u8(g_fb_read_buf + k) - 48;
            k = k + 1;
        }
        if (k < n && load_u8(g_fb_read_buf + k) >= 48 && load_u8(g_fb_read_buf + k) <= 57) {
            d1 = load_u8(g_fb_read_buf + k) - 48;
            k = k + 1;
        }
        frac = d0 * 10 + d1;
    }
    let ns: i64 = i64(sec) * 1000000000 + i64(frac) * 10000000;
    return ns;
}

fn fb_busy_wait_ms(ms: i32) -> i32 {
    if (ms <= 0) { return 0; }
    let t0: i64 = fb_clock_ns();
    let want: i64 = i64(ms) * 1000000;
    let el: i64 = 0;
    while (el < want) {
        let t1: i64 = fb_clock_ns();
        el = t1 - t0;
        if (el < 0) { el = want; }
    }
    return 0;
}

// clock_gettime 适配：框架的 clock_ns() 调它（CLOCK_MONOTONIC=1）。
// timespec：sec i64 在 +0，nsec i64 在 +8。失败返回 -1。
fn clock_gettime(clk: i32, tp: ptr) -> i32 {
    let ns: i64 = fb_clock_ns();
    if (ns == 0) {
        // uptime 读不到（不应发生）：填 0 保证单调不回退，返回 -1
        // 让框架的 clock_ns() 走 0 分支。
        *(tp) = 0;
        *(tp + 8) = 0;
        return 0 - 1;
    }
    let sec: i64 = ns / 1000000000;
    *(tp) = sec;
    *(tp + 8) = ns - sec * 1000000000;
    return 0;
}

// ---- fbdev 打开流程 ----
fn fbdev_set_tree(dev: ptr, sysfs: ptr) -> i32 {
    if (dev == 0) {
        g_fb_dev0 = 0;
        g_fb_tree_set = 0;
    } else {
        g_fb_dev0 = dev;
        g_fb_tree_set = 1;
    }
    if (sysfs == 0) {
        g_fb_sysfs = 0;
    } else {
        g_fb_sysfs = sysfs;
    }
    return 0;
}

fn fbdev_reset() -> i32 {
    if (g_fb_fd >= 0) {
        let c: i32 = close(g_fb_fd);
        g_fb_fd = 0 - 1;
    }
    g_fb_opened = 0;
    g_fb_mode = 0;
    g_fb_ptr = 0;
    g_fb_stage = 0;
    g_fb_w = 0;
    g_fb_h = 0;
    g_fb_stride = 0;
    g_fb_stride_bytes = 0;
    g_fb_fmt = 1;
    g_fb_bpp = 32;
    return 0;
}

// 匿名内存缓冲（回落模式与 32bpp staging 共用同一路）。
fn fb_alloc_anon(bytes: i64) -> ptr {
    if (bytes <= 0) { return 0; }
    let p: ptr = mmap(ptr(0), bytes, 3, 34, 0 - 1, 0);
    return p;
}

// 读 sysfs 三件套：virtual_size "W,H"、stride（字节/行）、
// bits_per_pixel。任一失败返回 -1。路径拼进局部缓冲。
fn fb_read_sysfs(w: ptr, h: ptr, stride_b: ptr, bpp: ptr) -> i32 {
    let root: ptr = g_fb_sysfs;
    if (root == 0) { root = "/sys/class/graphics/fb0"; }
    let path: u8[256] = 0;
    let p0: i32 = fb_join_path(path, root, "virtual_size");
    if (p0 != 0) { return 0 - 1; }
    let n: i32 = fb_read_small(path, 64);
    if (n <= 0) { return 0 - 1; }
    let used: i32[1] = 0;
    let vw: i32 = fb_parse_i32(g_fb_read_buf, n, used);
    let u: i32 = used[0];
    if (u == 0 || vw <= 0) { return 0 - 1; }
    // 跳过 ',' 再读高。
    let k: i32 = u;
    while (k < n && load_u8(g_fb_read_buf + k) != 44) { k = k + 1; }
    if (k >= n) { return 0 - 1; }
    let vh: i32 = fb_parse_i32(g_fb_read_buf + k + 1, n - k - 1, used);
    if (used[0] == 0 || vh <= 0) { return 0 - 1; }
    let p1: i32 = fb_join_path(path, root, "stride");
    if (p1 != 0) { return 0 - 1; }
    let n1: i32 = fb_read_small(path, 64);
    if (n1 <= 0) { return 0 - 1; }
    let sb: i32 = fb_parse_i32(g_fb_read_buf, n1, used);
    if (used[0] == 0 || sb <= 0) { return 0 - 1; }
    let p2: i32 = fb_join_path(path, root, "bits_per_pixel");
    if (p2 != 0) { return 0 - 1; }
    let n2: i32 = fb_read_small(path, 64);
    if (n2 <= 0) { return 0 - 1; }
    let bp: i32 = fb_parse_i32(g_fb_read_buf, n2, used);
    if (used[0] == 0 || bp <= 0) { return 0 - 1; }
    *(w) = vw;
    *(h) = vh;
    *(stride_b) = sb;
    *(bpp) = bp;
    return 0;
}

// 内存回落：匿名 mmap 一块紧凑 RGBA 缓冲。失败返回 -1（几乎不可能）。
fn fbdev_open_mem(w: i32, h: i32) -> i32 {
    let bytes: i64 = i64(w) * i64(h) * 4;
    let p: ptr = fb_alloc_anon(bytes);
    if (p == 0) { return 0 - 1; }
    g_fb_fd = 0 - 1;
    g_fb_ptr = p;
    g_fb_stage = 0;
    g_fb_w = w;
    g_fb_h = h;
    g_fb_stride = w;
    g_fb_stride_bytes = w * 4;
    g_fb_fmt = 1;
    g_fb_bpp = 32;
    g_fb_mode = 0;
    g_fb_opened = 1;
    return 0;
}

// 打开：w/h 是内存回落的请求尺寸。返回模式 0/1/2，-1 = 连回落都失败。
fn fbdev_open(w: i32, h: i32) -> i32 {
    if (g_fb_opened != 0) {
        let r0: i32 = fbdev_reset();
    }
    if (w <= 0 || h <= 0 || w > 4096 || h > 4096) { return 0 - 1; }
    // 1. 依次开设备（O_RDWR=2）。默认模式先 /dev/graphics/fb0 再
    // /dev/fb0；假设备树模式只试 dev0（不许误捡真机 /dev/fb0）。
    let dev0: ptr = g_fb_dev0;
    if (dev0 == 0) { dev0 = "/dev/graphics/fb0"; }
    let fd: i32 = openat(-100, dev0, 2, 0);
    if (fd < 0 && g_fb_tree_set == 0) {
        fd = openat(-100, "/dev/fb0", 2, 0);
    }
    if (fd < 0) {
        let e0: i32 = fb_err("fbdev: no fb device, memory fallback");
        return fbdev_open_mem(w, h);
    }
    // 2. 读 sysfs 几何。
    let sw: i32[1] = 0;
    let sh: i32[1] = 0;
    let sb: i32[1] = 0;
    let bp: i32[1] = 0;
    let sr: i32 = fb_read_sysfs(sw, sh, sb, bp);
    if (sr != 0) {
        let e1: i32 = fb_err("fbdev: sysfs unreadable, memory fallback");
        let c0: i32 = close(fd);
        return fbdev_open_mem(w, h);
    }
    let vw: i32 = sw[0];
    let vh: i32 = sh[0];
    let sbytes: i32 = sb[0];
    let bpp: i32 = bp[0];
    if (vw <= 0 || vh <= 0 || vw > 4096 || vh > 4096 || sbytes <= 0) {
        let e2: i32 = fb_err("fbdev: bad sysfs geometry, memory fallback");
        let c1: i32 = close(fd);
        return fbdev_open_mem(w, h);
    }
    if (bpp != 32 && bpp != 16) {
        let e3: i32 = fb_err("fbdev: unsupported bpp, memory fallback");
        let c2: i32 = close(fd);
        return fbdev_open_mem(w, h);
    }
    // 3. mmap（MAP_SHARED=1，长度 stride × yres_virtual）。
    let ln: i64 = i64(sbytes) * i64(vh);
    let p: ptr = mmap(ptr(0), ln, 3, 1, fd, 0);
    if (p == 0) {
        let e4: i32 = fb_err("fbdev: mmap failed, memory fallback");
        let c3: i32 = close(fd);
        return fbdev_open_mem(w, h);
    }
    g_fb_fd = fd;
    g_fb_ptr = p;
    g_fb_w = vw;
    g_fb_h = vh;
    g_fb_stride_bytes = sbytes;
    g_fb_bpp = bpp;
    g_fb_opened = 1;
    if (bpp == 32) {
        // staging：与窗口同尺寸的紧凑 RGBA 缓冲，框架画这里。
        let st: ptr = fb_alloc_anon(i64(vw) * i64(vh) * 4);
        if (st == 0) {
            let e5: i32 = fb_err("fbdev: staging alloc failed, memory fallback");
            let c4: i32 = close(fd);
            g_fb_fd = 0 - 1;
            g_fb_ptr = 0;
            return fbdev_open_mem(w, h);
        }
        g_fb_stage = st;
        g_fb_stride = vw;
        g_fb_fmt = 1;
        g_fb_mode = 1;
        return 1;
    }
    // 16bpp：RGB565 直接当 bits，fmt 4，无转换。
    g_fb_stage = 0;
    g_fb_stride = sbytes / 2;
    g_fb_fmt = 4;
    g_fb_mode = 2;
    return 2;
}

fn fbdev_close() -> i32 {
    let r: i32 = fbdev_reset();
    return 0;
}

fn fbdev_mode() -> i32 { return g_fb_mode; }
fn fbdev_w() -> i32 { return g_fb_w; }
fn fbdev_h() -> i32 { return g_fb_h; }
fn fbdev_stride() -> i32 { return g_fb_stride; }
fn fbdev_fmt() -> i32 { return g_fb_fmt; }
fn fbdev_presents() -> i32 { return g_fb_presents; }
fn fbdev_fb_ptr() -> ptr { return g_fb_ptr; }
fn fbdev_stage() -> ptr { return g_fb_stage; }

// 当前 lock 应返回的 bits：32bpp 是 staging，16bpp/内存是直通缓冲。
fn fbdev_bits() -> ptr {
    if (g_fb_mode == 1) { return g_fb_stage; }
    return g_fb_ptr;
}

fn fbdev_win() -> ptr { return g_fb_win_obj; }
fn fbdev_queue() -> ptr { return g_fb_queue_obj; }

// ---- 像素格式转换（32bpp：staging RGBA → fb0 XRGB，全帧） ----
// 内存字节：staging [R,G,B,A]，fb0 [B,G,R,X]。逐字节洗牌——
// i64 洗牌需要 64 位十六进制掩码常量，Aster 字面量不支持，
// 字节循环最稳；真机原生速度可接受，VM 下只影响真 fb32 帧。
fn fb_convert_xrgb() -> i32 {
    if (g_fb_mode != 1) { return 0; }
    let n: i32 = g_fb_w * g_fb_h;
    let st: ptr = g_fb_stage;
    let fb: ptr = g_fb_ptr;
    let i: i32 = 0;
    while (i < n) {
        let o: i32 = i * 4;
        let r: i32 = load_u8(st + o + 0);
        let g: i32 = load_u8(st + o + 1);
        let b: i32 = load_u8(st + o + 2);
        let a: i32 = load_u8(st + o + 3);
        let s0: i32 = store_u8(fb + o + 0, b);
        let s1: i32 = store_u8(fb + o + 1, g);
        let s2: i32 = store_u8(fb + o + 2, r);
        let s3: i32 = store_u8(fb + o + 3, a);
        i = i + 1;
    }
    return 0;
}

// ---- BMP 写出（24bpp，顶朝下，biHeight 取负） ----
// 读当前已呈现面：内存模式读内存缓冲（RGBA），fb32 读 fb0（XRGB），
// fb16 读 fb0（RGB565 展开）。失败返回 -1。
fn fb_put_u16(buf: ptr, off: i32, v: i32) -> i32 {
    let a: i32 = store_u8(buf + off + 0, v & 255);
    let b: i32 = store_u8(buf + off + 1, (v >> 8) & 255);
    return 0;
}

fn fb_put_u32(buf: ptr, off: i32, v: i32) -> i32 {
    let a: i32 = store_u8(buf + off + 0, v & 255);
    let b: i32 = store_u8(buf + off + 1, (v >> 8) & 255);
    let c: i32 = store_u8(buf + off + 2, (v >> 16) & 255);
    let d: i32 = store_u8(buf + off + 3, (v >> 24) & 255);
    return 0;
}

fn fbdev_write_bmp(path: ptr) -> i32 {
    if (path == 0 || g_fb_opened == 0) { return 0 - 1; }
    let w: i32 = g_fb_w;
    let h: i32 = g_fb_h;
    if (w <= 0 || h <= 0 || w > 4096) { return 0 - 1; }
    let rowb: i32 = w * 3;
    let pad: i32 = (4 - (rowb & 3)) & 3;
    let rowbytes: i32 = rowb + pad;
    let imgsize: i32 = rowbytes * h;
    let filesize: i32 = 54 + imgsize;
    let hd: ptr = g_fb_bmp_hd;
    let c0: i32 = store_u8(hd + 0, 66);
    let c1: i32 = store_u8(hd + 1, 77);
    let p0: i32 = fb_put_u32(hd, 2, filesize);
    let p1: i32 = fb_put_u32(hd, 6, 0);
    let p2: i32 = fb_put_u32(hd, 10, 54);
    let p3: i32 = fb_put_u32(hd, 14, 40);
    let p4: i32 = fb_put_u32(hd, 18, w);
    let p5: i32 = fb_put_u32(hd, 22, 0 - h);
    let p6: i32 = fb_put_u16(hd, 26, 1);
    let p7: i32 = fb_put_u16(hd, 28, 24);
    let p8: i32 = fb_put_u32(hd, 30, 0);
    let p9: i32 = fb_put_u32(hd, 34, imgsize);
    let pa: i32 = fb_put_u32(hd, 38, 2835);
    let pb: i32 = fb_put_u32(hd, 42, 2835);
    let pc: i32 = fb_put_u32(hd, 46, 0);
    let pd: i32 = fb_put_u32(hd, 50, 0);
    // O_WRONLY|O_CREAT|O_TRUNC = 577，0644 = 420。
    let fd: i32 = openat(-100, path, 577, 420);
    if (fd < 0) { return 0 - 1; }
    let wh: i32 = fb_write_all(fd, hd, 54);
    if (wh != 54) {
        let cx: i32 = close(fd);
        return 0 - 1;
    }
    let src: ptr = fbdev_bits();
    // fb32 模式：已呈现面是 fb0 本身（XRGB），不是 staging。
    if (g_fb_mode == 1) { src = g_fb_ptr; }
    let y: i32 = 0;
    while (y < h) {
        let row: ptr = g_fb_bmp_row;
        let x: i32 = 0;
        while (x < w) {
            let r: i32 = 0;
            let g: i32 = 0;
            let b: i32 = 0;
            if (g_fb_mode == 2) {
                let off: i32 = y * g_fb_stride_bytes + x * 2;
                let v: i32 = load_u16(src + off);
                let r5: i32 = (v >> 11) & 31;
                let g6: i32 = (v >> 5) & 63;
                let b5: i32 = v & 31;
                r = (r5 * 255) / 31;
                g = (g6 * 255) / 63;
                b = (b5 * 255) / 31;
            } else if (g_fb_mode == 1) {
                let off2: i32 = y * g_fb_stride_bytes + x * 4;
                b = load_u8(src + off2 + 0);
                g = load_u8(src + off2 + 1);
                r = load_u8(src + off2 + 2);
            } else {
                let off3: i32 = (y * w + x) * 4;
                r = load_u8(src + off3 + 0);
                g = load_u8(src + off3 + 1);
                b = load_u8(src + off3 + 2);
            }
            let o: i32 = x * 3;
            let s0: i32 = store_u8(row + o + 0, b);
            let s1: i32 = store_u8(row + o + 1, g);
            let s2: i32 = store_u8(row + o + 2, r);
            x = x + 1;
        }
        let k: i32 = 0;
        while (k < pad) {
            let s3: i32 = store_u8(row + rowb + k, 0);
            k = k + 1;
        }
        let wr: i32 = fb_write_all(fd, row, rowbytes);
        if (wr != rowbytes) {
            let cy: i32 = close(fd);
            return 0 - 1;
        }
        y = y + 1;
    }
    let cz: i32 = close(fd);
    return 0;
}

// ===========================================================================
// NDK 表面（与 tests/fake_ndk.ast 同一张表；本文件是 Linux 实现）
// ===========================================================================

fn __android_log_print(prio: i32, tag: ptr, fmt: ptr) -> i32 {
    // aui_log 的 msg 从不含 %（见 aui_log 注释），原样写 stderr。
    if (fmt == 0) { return 0; }
    let n: i32 = fb_strlen(fmt);
    let w: i32 = fb_write_all(2, fmt, n);
    let nl: i32 = store_u8(g_fb_err_buf + 0, 10);
    let w2: i32 = fb_write_all(2, g_fb_err_buf, 1);
    return 0;
}

// ---- 帧泵线程桩：pthread_create 返回 -1 → pump_fail → 直切模式 ----
fn pthread_create(tid: ptr, attr: ptr, start: ptr, arg: ptr) -> i32 { return 0 - 1; }
fn pthread_join(tid: i64, ret: ptr) -> i32 { return 0; }
