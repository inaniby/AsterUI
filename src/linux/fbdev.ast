// memcpy/memmove（照抄 fake_ndk 的 Aster 循环；n 是 i64）。
fn memcpy(dst: ptr, src: ptr, n: i64) -> ptr {
    if (n <= 0) { return dst; }
    let m: i32 = i32(n);
    let i: i32 = 0;
    let m8: i32 = m & 0x7FFFFFF8;
    while (i < m8) {
        let v: i64 = load_i64(src + i);
        store_i64(dst + i, v);
        i = i + 8;
    }
    while (i < m) {
        let b: i32 = load_u8(src + i);
        store_u8(dst + i, b);
        i = i + 1;
    }
    return dst;
}

fn memmove(dst: ptr, src: ptr, n: i64) -> ptr {
    if (n <= 0 || dst == src) { return dst; }
    let m: i32 = i32(n);
    if (i64(dst) < i64(src)) {
        let r: ptr = memcpy(dst, src, n);
        return dst;
    }
    let i: i32 = m;
    while (i >= 8) {
        let v: i64 = load_i64(src + i - 8);
        store_i64(dst + i - 8, v);
        i = i - 8;
    }
    while (i > 0) {
        let b: i32 = load_u8(src + i - 1);
        store_u8(dst + i - 1, b);
        i = i - 1;
    }
    return dst;
}

fn ANativeWindow_getWidth(w: ptr) -> i32 { return g_fb_w; }
fn ANativeWindow_getHeight(w: ptr) -> i32 { return g_fb_h; }
fn ANativeWindow_setBuffersGeometry(w: ptr, width: i32, height: i32, format: i32) -> i32 {
    return 0;
}

fn ANativeWindow_lock(w: ptr, outBuffer: ptr, inOutDirty: ptr) -> i32 {
    if (g_fb_opened == 0) { return 0 - 1; }
    let pp: ptr = fbdev_bits();
    if (pp == 0) { return 0 - 1; }
    *(outBuffer + 0) = g_fb_w;
    *(outBuffer + 4) = g_fb_h;
    *(outBuffer + 8) = g_fb_stride;
    *(outBuffer + 12) = g_fb_fmt;
    *(outBuffer + 16) = pp;
    return 0;
}

fn ANativeWindow_unlockAndPost(w: ptr) -> i32 {
    g_fb_presents = g_fb_presents + 1;
    if (g_fb_mode == 1) {
        let c: i32 = fb_convert_xrgb();
    }
    return 0;
}

