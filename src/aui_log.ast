// aster:language=en
// aui_log.ast — S10 trace / log
// P4 split of src/aui_impl.ast (pure move; see phase1-p4-split.md).

// ---- extern 声明（gen_split.py 从定义处逐字抽取；定义唯一，声明随调用方）----
extern fn __android_log_print(prio: i32, tag: ptr, fmt: ptr) : i32;
extern fn str_len(s: ptr) : i32;
extern fn aui_log_now_ms() : i64;
extern let g_aui_trace_fd: i32;
extern let g_aui_trace_path: u8[256];
extern let g_aui_trace_buf: u8[16];
extern let g_aui_log_path1: u8[256];
extern let g_aui_log_path2: u8[256];
extern let g_aui_log_set: i32;
extern let g_aui_log_lines: i32;
extern let g_aui_log_line: u8[512];
extern let g_aui_log_line_len: i32;
extern let g_aui_log_msg: u8[256];
extern let g_aui_log_msg_len: i32;

// ---- 启动轨迹：/sdcard/Android/data/<pkg>/files/trace.txt ----
// 每个里程碑一行：单字母（可选加 8 位十六进制）。无 adb 时用它定位崩溃阶段。
fn trace_strlen(p: ptr) : i32 {
    let i: i32 = 0;
    if (p == 0) { return 0; }
    let b: i32 = load_u8(p + i);
    while (b != 0 && i < 240) {
        i = i + 1;
        b = load_u8(p + i);
    }
    return i;
}

fn trace_mark(tag: i32) : i32 {
    if (g_aui_trace_fd < 0) { return -1; }
    store_u8(g_aui_trace_buf + 0, tag);
    store_u8(g_aui_trace_buf + 1, 10);
    let bp: ptr = g_aui_trace_buf;
    let n: i32 = write(g_aui_trace_fd, bp, 2);
    return n;
}

fn trace_hex(tag: i32, v: i32) : i32 {
    if (g_aui_trace_fd < 0) { return -1; }
    store_u8(g_aui_trace_buf + 0, tag);
    let i: i32 = 0;
    while (i < 8) {
        let sh: i32 = (7 - i) * 4;
        let nib: i32 = (v >> sh) & 15;
        let c: i32 = 48;
        if (nib > 9) { c = 55; }
        store_u8(g_aui_trace_buf + 1 + i, c + nib);
        i = i + 1;
    }
    store_u8(g_aui_trace_buf + 9, 10);
    let bp: ptr = g_aui_trace_buf;
    let n: i32 = write(g_aui_trace_fd, bp, 10);
    return n;
}

fn trace_init(ext: ptr) : i32 {
    if (ext == 0) { return -1; }
    let n: i32 = trace_strlen(ext);
    if (n <= 0 || n > 240) { return -1; }
    let i: i32 = 0;
    while (i < n) {
        store_u8(g_aui_trace_path + i, load_u8(ext + i));
        i = i + 1;
    }
    // 追加 "/trace.txt"
    store_u8(g_aui_trace_path + n + 0, 47);
    store_u8(g_aui_trace_path + n + 1, 116);
    store_u8(g_aui_trace_path + n + 2, 114);
    store_u8(g_aui_trace_path + n + 3, 97);
    store_u8(g_aui_trace_path + n + 4, 99);
    store_u8(g_aui_trace_path + n + 5, 101);
    store_u8(g_aui_trace_path + n + 6, 46);
    store_u8(g_aui_trace_path + n + 7, 116);
    store_u8(g_aui_trace_path + n + 8, 120);
    store_u8(g_aui_trace_path + n + 9, 116);
    store_u8(g_aui_trace_path + n + 10, 0);
    let pp: ptr = g_aui_trace_path;
    // O_WRONLY|O_CREAT|O_TRUNC = 577，0666 = 438
    let fd: i32 = openat(-100, pp, 577, 438);
    if (fd < 0) { return fd; }
    g_aui_trace_fd = fd;
    trace_mark(83);   // S = attach 开始
    // v1.11.2：第二行就写版本，避免“旧包在跑、却以为在测新包”。
    let tv: i32 = trace_hex(86, 14806);   // V + 版本号 0x000039D6
    return 0;
}

// ---- 文件日志（W3 合并，见 g_aui_log_* 注释）----
// 与 trace.txt 分工：trace 记里程碑字母（启动阶段定位），这里记
// 带 i64 时间戳的完整行为行。调用方用 aui_log / aui_log1 /
// aui_log2；aui_log_tail 供应用内日志查看器回读文件尾部。
// 十进制 i64 写进 buf（不依赖 i64 取模：用 /10 + 减法，与
// i32_to_str 同一写法）。返回写出的字节数（不含 NUL）。
fn aui_log_fmt_i64(buf: ptr, v: i64) : i32 {
    let neg: i32 = 0;
    let n: i64 = v;
    if (n < 0) { neg = 1; n = 0 - n; }
    let tmp: u8[24] = 0;
    let i: i32 = 0;
    if (n == 0) {
        let w0: i32 = store_u8(tmp + 0, 48);
        i = 1;
    } else {
        while (n > 0) {
            let q: i64 = n / 10;
            let d: i64 = n - q * 10;
            let w1: i32 = store_u8(tmp + i, 48 + i32(d));
            i = i + 1;
            n = q;
        }
    }
    let at: i32 = 0;
    if (neg != 0) {
        let w2: i32 = store_u8(buf + at, 45);
        at = at + 1;
    }
    while (i > 0) {
        i = i - 1;
        let ch: i32 = load_u8(tmp + i);
        let w3: i32 = store_u8(buf + at, ch);
        at = at + 1;
    }
    return at;
}

// 优先级字母（Android prio：2 V，3 D，4 I，5 W，6 E）。
fn aui_log_level_letter(level: i32) : i32 {
    if (level == 2) { return 86; }
    if (level == 3) { return 68; }
    if (level == 4) { return 73; }
    if (level == 5) { return 87; }
    if (level == 6) { return 69; }
    return 63;
}

// 把 dir + "/aui.log" 写进 out（256 字节缓冲，超长截断）。返回 0。
fn aui_log_join(out: ptr, dir: ptr) : i32 {
    if (dir == 0) { return -1; }
    let n: i32 = str_len(dir);
    if (n <= 0 || n > 240) { return -1; }
    let i: i32 = 0;
    while (i < n) {
        let s0: i32 = store_u8(out + i, load_u8(dir + i));
        i = i + 1;
    }
    let suf: ptr = "/aui.log";
    let m: i32 = 0;
    while (m < 8) {
        let s1: i32 = store_u8(out + n + m, load_u8(suf + m));
        m = m + 1;
    }
    let z: i32 = store_u8(out + n + 8, 0);
    return 0;
}

// 初始化日志路径：内部 + 外部 files 目录各一份。attach 时调一次；
// 任一目录为空时只设另一份；两份都空则日志保持关闭（返回 -1）。
fn aui_log_init(internal: ptr, ext: ptr) : i32 {
    let ok: i32 = 0;
    let p1: ptr = g_aui_log_path1;
    let r1: i32 = aui_log_join(p1, internal);
    if (r1 == 0) { ok = 1; }
    let p2: ptr = g_aui_log_path2;
    let r2: i32 = aui_log_join(p2, ext);
    if (r2 == 0) { ok = 1; }
    if (ok != 0) { g_aui_log_set = 1; return 0; }
    return -1;
}

// 测试/无宿主路径：只设主文件（aui_log_tail 回读的就是它）。
fn aui_log_set_file(path: ptr) : i32 {
    if (path == 0) { return -1; }
    let n: i32 = str_len(path);
    if (n <= 0 || n > 240) { return -1; }
    let p1: ptr = g_aui_log_path1;
    let i: i32 = 0;
    while (i < n) {
        let s0: i32 = store_u8(p1 + i, load_u8(path + i));
        i = i + 1;
    }
    let z: i32 = store_u8(p1 + n, 0);
    g_aui_log_set = 1;
    return 0;
}

// 自 attach 起写入的行数。
fn aui_log_lines() : i32 {
    return g_aui_log_lines;
}

// 文件大小（字节），-1 = 打不开或读不到（与 stdlib file_size 同写）。
fn aui_log_file_size(path: ptr) : i64 {
    let fd: i32 = openat(-100, path, 0, 0);
    if (fd < 0) { return 0 - 1; }
    let st: u8[128] = 0;
    let r: i32 = fstat(fd, &st);
    let c: i32 = close(fd);
    if (r != 0) { return 0 - 1; }
    return load_i64(&st + 48);
}

// 把已格式化的行（g_aui_log_line，g_aui_log_line_len）写进一个文件：
// 超过 128 KiB 先截断再追加；写不满一行就按实际写出的算。返回写出
// 的字节数，路径未设置或打不开返回 0。
fn aui_log_append_one(path: ptr) : i32 {
    if (path == 0) { return 0; }
    if (load_u8(path + 0) == 0) { return 0; }
    let sz: i64 = aui_log_file_size(path);
    if (sz > 131072) {
        let tf: i32 = openat(-100, path, 577, 420);
        if (tf >= 0) {
            let tc: i32 = close(tf);
        }
    }
    let fd: i32 = openat(-100, path, 1089, 420);
    if (fd < 0) { return 0; }
    let done: i32 = 0;
    let n: i32 = g_aui_log_line_len;
    while (done < n) {
        let w: i32 = write(fd, g_aui_log_line + done, n - done);
        if (w <= 0) { break; }
        done = done + w;
    }
    let c: i32 = close(fd);
    return done;
}

// "[<ms>] <L> AUI: <msg>\n" 写进 g_aui_log_line；超长消息截断到
// 512 字节行缓冲内。返回行长度。
fn aui_log_format(level: i32, msg: ptr) : i32 {
    let at: i32 = 0;
    let c0: i32 = store_u8(g_aui_log_line + at, 91);
    at = at + 1;
    let n0: i32 = aui_log_fmt_i64(g_aui_log_line + at, aui_log_now_ms());
    at = at + n0;
    let c1: i32 = store_u8(g_aui_log_line + at, 93);
    at = at + 1;
    let c2: i32 = store_u8(g_aui_log_line + at, 32);
    at = at + 1;
    let c3: i32 = store_u8(g_aui_log_line + at, aui_log_level_letter(level));
    at = at + 1;
    let c4: i32 = store_u8(g_aui_log_line + at, 32);
    at = at + 1;
    let tag: ptr = "AUI: ";
    let i: i32 = 0;
    while (i < 5) {
        let c5: i32 = store_u8(g_aui_log_line + at, load_u8(tag + i));
        at = at + 1;
        i = i + 1;
    }
    let mlen: i32 = str_len(msg);
    let room: i32 = 512 - at - 1;
    if (mlen > room) { mlen = room; }
    if (mlen > 0) {
        let j: i32 = 0;
        while (j < mlen) {
            let c6: i32 = store_u8(g_aui_log_line + at, load_u8(msg + j));
            at = at + 1;
            j = j + 1;
        }
    }
    let c7: i32 = store_u8(g_aui_log_line + at, 10);
    at = at + 1;
    let c8: i32 = store_u8(g_aui_log_line + at, 0);
    g_aui_log_line_len = at;
    return at;
}

// 写一行日志：文件（两个路径）+ logcat 镜像。msg 里不要出现 %
// （它原样进 __android_log_print 的 fmt 参数）。永不让调用方失败。
fn aui_log(level: i32, msg: ptr) : i32 {
    if (msg == 0) { return 0; }
    let n: i32 = aui_log_format(level, msg);
    if (g_aui_log_set != 0) {
        let w1: i32 = aui_log_append_one(g_aui_log_path1);
        let w2: i32 = aui_log_append_one(g_aui_log_path2);
    }
    let s: i32 = __android_log_print(level, "AsterUI", msg);
    g_aui_log_lines = g_aui_log_lines + 1;
    return 0;
}

// --- 消息拼接："<p0><v><p1>"（aui_log1）与 "<p0><a><p1><b><p2>"（aui_log2）---
// Aster 不能把数字格式化进字面量，所以数字先拼进 g_aui_log_msg。
fn aui_log_msg_begin() : i32 {
    g_aui_log_msg_len = 0;
    return 0;
}

fn aui_log_msg_str(s: ptr) : i32 {
    let n: i32 = str_len(s);
    if (g_aui_log_msg_len + n > 255) { n = 255 - g_aui_log_msg_len; }
    if (n > 0) {
        let i: i32 = 0;
        while (i < n) {
            let c: i32 = store_u8(g_aui_log_msg + g_aui_log_msg_len, load_u8(s + i));
            g_aui_log_msg_len = g_aui_log_msg_len + 1;
            i = i + 1;
        }
    }
    return 0;
}

fn aui_log_msg_i32(v: i32) : i32 {
    let tmp: u8[24] = 0;
    let n: i32 = aui_log_fmt_i64(tmp, i64(v));
    if (g_aui_log_msg_len + n > 255) { n = 255 - g_aui_log_msg_len; }
    if (n > 0) {
        let i: i32 = 0;
        while (i < n) {
            let c: i32 = store_u8(g_aui_log_msg + g_aui_log_msg_len, load_u8(tmp + i));
            g_aui_log_msg_len = g_aui_log_msg_len + 1;
            i = i + 1;
        }
    }
    return 0;
}

fn aui_log_msg_end() : ptr {
    let z: i32 = store_u8(g_aui_log_msg + g_aui_log_msg_len, 0);
    return g_aui_log_msg;
}

fn aui_log1(level: i32, p0: ptr, v: i32, p1: ptr) : i32 {
    let b: i32 = aui_log_msg_begin();
    let s0: i32 = aui_log_msg_str(p0);
    let s1: i32 = aui_log_msg_i32(v);
    let s2: i32 = aui_log_msg_str(p1);
    let m: ptr = aui_log_msg_end();
    return aui_log(level, m);
}

fn aui_log2(level: i32, p0: ptr, a: i32, p1: ptr, b: i32, p2: ptr) : i32 {
    let bb: i32 = aui_log_msg_begin();
    let s0: i32 = aui_log_msg_str(p0);
    let s1: i32 = aui_log_msg_i32(a);
    let s2: i32 = aui_log_msg_str(p1);
    let s3: i32 = aui_log_msg_i32(b);
    let s4: i32 = aui_log_msg_str(p2);
    let m: ptr = aui_log_msg_end();
    return aui_log(level, m);
}

// v2.7.1-diag：三值日志 "<p0><a><p1><b><p2><c><p3>"（与 aui_log1/aui_log2 同模式）。
fn aui_log3(level: i32, p0: ptr, a: i32, p1: ptr, b: i32, p2: ptr, c: i32, p3: ptr) : i32 {
    let bb: i32 = aui_log_msg_begin();
    let s0: i32 = aui_log_msg_str(p0);
    let s1: i32 = aui_log_msg_i32(a);
    let s2: i32 = aui_log_msg_str(p1);
    let s3: i32 = aui_log_msg_i32(b);
    let s4: i32 = aui_log_msg_str(p2);
    let s5: i32 = aui_log_msg_i32(c);
    let s6: i32 = aui_log_msg_str(p3);
    let m: ptr = aui_log_msg_end();
    return aui_log(level, m);
}

// 回读主日志文件的尾部（查看器用）：最多 cap 字节写进 out，返回
// 实际写出的字节数；文件不存在返回 0，没有设置路径返回 -1。文件
// 比 cap 大时跳过前面的字节，只留最后 cap 字节。
fn aui_log_tail(out: ptr, cap: i32) : i32 {
    if (g_aui_log_set == 0) { return -1; }
    let path: ptr = g_aui_log_path1;
    if (load_u8(path + 0) == 0) { return -1; }
    let sz: i64 = aui_log_file_size(path);
    if (sz <= 0) { return 0; }
    let skip: i64 = 0;
    if (sz > i64(cap)) { skip = sz - i64(cap); }
    let fd: i32 = openat(-100, path, 0, 0);
    if (fd < 0) { return -1; }
    let scratch: u8[256] = 0;
    let left: i64 = skip;
    while (left > 0) {
        let want: i32 = 256;
        if (left < 256) { want = i32(left); }
        let r: i32 = read(fd, scratch, want);
        if (r <= 0) {
            let c0: i32 = close(fd);
            return -1;
        }
        left = left - i64(r);
    }
    let got: i32 = 0;
    while (got < cap) {
        let r2: i32 = read(fd, out + got, cap - got);
        if (r2 <= 0) { break; }
        got = got + r2;
    }
    let c1: i32 = close(fd);
    return got;
}
