// ---- extern 声明（gen_split.py 从定义处逐字抽取；定义唯一，声明随调用方）----
extern fn fx(v: i32) : i32;
extern fn fx_mul(a: i32, b: i32) : i32;
extern fn fx_div(a: i32, b: i32) : i32;
extern fn fx_px(v: i32) : i32;
extern fn ref_anim_to(s: i32, to: i32, dur: i64) : i32;
extern fn node_at(i: i32) : ptr<AuiNode>;
extern let g_aui_node_count: i32;
extern let g_aui_density: i32;
extern let g_aui_need_build: i32;
