// v1.27：工具提示修饰器（对照 HuxerUI Tooltip）。挂在最近创建的节点上；
// 如果刚 aui_end() 关闭了容器，则挂到那个容器。side / align 越界时取
// 默认值（上方、居中）。气泡在长按 500 ms 后显示，同一时刻只有一个。
fn tip_lookup(i: i32) : i32 {
    let k: i32 = 0;
    while (k < g_aui_tip_used) {
        if (g_aui_tips_node[k] == i) { return k; }
        k = k + 1;
    }
    return -1;
}

fn find_tip(i: i32) : i32 {
    let cur: i32 = i;
    while (cur >= 0) {
        let k: i32 = tip_lookup(cur);
        if (k >= 0) { return k; }
        let n: ptr<AuiNode> = node_at(cur);
        cur = n.parent;
    }
    return -1;
}

fn aui_tooltip(text: ptr, side: i32, align: i32) : i32 {
    let t: i32 = g_aui_last_created;
    if (t < 0) { t = g_aui_last_closed; }
    if (t < 0 || text == 0) { return -1; }
    if (side < 0 || side > 3) { side = 0; }
    if (align < 0 || align > 2) { align = 1; }
    let k: i32 = tip_lookup(t);
    if (k < 0) {
        if (g_aui_tip_used >= AUI_TIP_CAP) { return -1; }
        k = g_aui_tip_used;
        g_aui_tip_used = g_aui_tip_used + 1;
    }
    g_aui_tips_node[k] = t;
    g_aui_tips_text[k] = text;
    g_aui_tips_side[k] = side;
    g_aui_tips_align[k] = align;
    return 0;
}

// 收起气泡与待定状态。返回 1 = 之前有可见内容（调用方需要重绘）。
fn tip_dismiss() : i32 {
    let had: i32 = 0;
    if (g_aui_tip_on != 0 || g_aui_tip_pend != 0) { had = 1; }
    g_aui_tip_on = 0;
    g_aui_tip_pend = 0;
    g_aui_tip_pend_idx = -1;
    g_aui_tip_hold = 1;
    g_aui_tip_until = 0;
    g_aui_tip_text = 0;
    if (had != 0) {
        g_aui_need_paint = 1;
        g_aui_pump_need = 1;
    }
    return had;
}

// 长按判定通过：气泡接管本次手势。
fn tip_show() : i32 {
    g_aui_tip_pend = 0;
    g_aui_tip_pend_idx = -1;
    g_aui_tip_on = 1;
    g_aui_tip_hold = 1;
    g_aui_tip_until = 0;
    g_aui_pressing = 0;
    g_aui_press_key = 0;
    g_aui_need_layout = 1;
    g_aui_need_paint = 1;
    g_aui_pump_need = 1;
    return 0;
}

// 帧节拍：到 500 ms 显示；松手停留到期后收起。由 pump_ui / 帧泵每拍调用，
// 时间来自 clock_ns（测试用 fake_set_clock 注入）。
fn tip_tick() : i32 {
    let ch: i32 = 0;
    let now: i64 = clock_ns();
    if (g_aui_tip_pend != 0 && now - g_aui_tip_start >= 500000000) {
        let r: i32 = tip_show();
        let tw: i32 = pump_wake();
        // v2.7.1-diag：工具提示显示（对照实验：与长按同走 500ms 泵机制）。
        let tel: i32 = i32((now - g_aui_tip_start) / 1000000);
        let tl: i32 = aui_log1(4, "tip show el=", tel, "ms");
        ch = 1;
    }
    if (g_aui_tip_on != 0 && g_aui_tip_hold == 0 && g_aui_tip_until > 0 &&
        now >= g_aui_tip_until) {
        let r2: i32 = tip_dismiss();
        ch = 1;
    }
    return ch;
}

// 1 = 还有计时任务（待定长按或停留倒计时）。帧泵据此保持 16 ms 轮询。
fn tip_busy() : i32 {
    if (g_aui_tip_pend != 0) { return 1; }
    if (g_aui_tip_on != 0 && g_aui_tip_hold == 0 && g_aui_tip_until > 0) {
        return 1;
    }
    return 0;
}

// ---- 长按手势（v2.7）----
// 登记表与工具提示同构：节点下标查回调，命中沿祖先链向上找（find_lp）。
fn lp_lookup(i: i32) : i32 {
    let k: i32 = 0;
    while (k < g_aui_lp_used) {
        if (g_aui_lp_node[k] == i) { return k; }
        k = k + 1;
    }
    return -1;
}

fn find_lp(i: i32) : i32 {
    let cur: i32 = i;
    while (cur >= 0) {
        let k: i32 = lp_lookup(cur);
        if (k >= 0) { return k; }
        let n: ptr<AuiNode> = node_at(cur);
        cur = n.parent;
    }
    return -1;
}

// v2.7：长按修饰器（对照 HuxerUI LongPressGesture）。挂在最近创建的
// 节点上；如果刚 aui_end() 关闭了容器，则挂到那个容器。同一节点重复
// 声明覆盖回调。DOWN 后 500 ms 内不动即触发一次 cb(user)，回调里用
// aui_long_press_key() 读触发节点的 key；触发后本次抬起不再补发点按。
fn aui_long_press(cb: fn(ptr) : i32, user: ptr) : i32 {
    let t: i32 = g_aui_last_created;
    if (t < 0) { t = g_aui_last_closed; }
    if (t < 0 || cb == 0) { return -1; }
    let k: i32 = lp_lookup(t);
    if (k < 0) {
        if (g_aui_lp_used >= AUI_LP_CAP) { return -1; }
        k = g_aui_lp_used;
        g_aui_lp_used = g_aui_lp_used + 1;
    }
    g_aui_lp_node[k] = t;
    g_aui_lp_cb[k] = cb;
    g_aui_lp_user[k] = user;
    return 0;
}

// 触发时回调里读到的节点 key（分段 / 标签页的 getter 模式）。
fn aui_long_press_key() : i32 {
    return g_aui_lp_key;
}

// ---- 捏合手势（v2.18，对照 HuxerUI TransformGesture）----
// 登记表与长按同构：节点下标查回调，命中沿祖先链向上找（find_pn）。
fn pn_lookup(i: i32) : i32 {
    let k: i32 = 0;
    while (k < g_aui_pn_used) {
        if (g_aui_pn_node[k] == i) { return k; }
        k = k + 1;
    }
    return -1;
}

fn find_pn(i: i32) : i32 {
    let cur: i32 = i;
    while (cur >= 0) {
        let k: i32 = pn_lookup(cur);
        if (k >= 0) { return k; }
        let n: ptr<AuiNode> = node_at(cur);
        cur = n.parent;
    }
    return -1;
}

// v2.18：捏合修饰器（对照 HuxerUI TransformGesture 的 scale + focal
// point；rotation 不在本轮）。挂在最近创建的节点上；如果刚 aui_end()
// 关闭了容器，则挂到那个容器。同一节点重复声明覆盖回调。两指才识别：
// 第二指按下时接管并调一次 cb(user)，每次 MOVE 调一次，一指抬起或
// 取消时再调一次；回调里用 aui_pinch_scale/cx/cy/dx/dy 读状态。
fn aui_pinch(cb: fn(ptr) : i32, user: ptr) : i32 {
    let t: i32 = g_aui_last_created;
    if (t < 0) { t = g_aui_last_closed; }
    if (t < 0 || cb == 0) { return -1; }
    let k: i32 = pn_lookup(t);
    if (k < 0) {
        if (g_aui_pn_used >= AUI_PN_CAP) { return -1; }
        k = g_aui_pn_used;
        g_aui_pn_used = g_aui_pn_used + 1;
    }
    g_aui_pn_node[k] = t;
    g_aui_pn_cb[k] = cb;
    g_aui_pn_user[k] = user;
    return 0;
}

// 读数器：累计缩放 Q16.16（65536 = 1.00×）、焦点、质心位移、进行标志、
// 拥有本次/上次手势的节点 key、登记数量。
fn aui_pinch_scale() : i32 { return g_aui_pn_scale; }

fn aui_pinch_cx() : i32 { return g_aui_pn_cx; }

fn aui_pinch_cy() : i32 { return g_aui_pn_cy; }

fn aui_pinch_dx() : i32 { return g_aui_pn_dx; }

fn aui_pinch_dy() : i32 { return g_aui_pn_dy; }

fn aui_pinch_active() : i32 {
    if (g_aui_pn_state == 1) { return 1; }
    return 0;
}

fn aui_pinch_key() : i32 { return g_aui_pn_key; }

fn aui_pinch_n() : i32 { return g_aui_pn_used; }

// 测试辅助：捏合状态（0 空闲 / 1 进行中 / 2 已结束）。
fn aui_debug_pinch_state() : i32 { return g_aui_pn_state; }

// 调拥有本次手势的登记回调（Started/Changed/Ended/Canceled 共用）。
fn pn_fire() : i32 {
    if (g_aui_pn_slot < 0) { return 0; }
    let cb: fn(ptr) : i32 = g_aui_pn_cb[g_aui_pn_slot];
    let user: ptr = g_aui_pn_user[g_aui_pn_slot];
    if (cb == 0) { return 0; }
    let r: i32 = cb(user);
    return 0;
}

// 第二指按下：决定是否接管为捏合。返回 0（调用方 handle_motion 直接
// return，不落入单指链）。接管条件：已有第一指、无独占属主、第二指
// 落在捏合登记节点（含祖先）、两指间距 >= 8 dp。
fn pn_pointer_down(ev: ptr, pidx: i32) : i32 {
    if (g_aui_pn_state == 1) { return 0; }   // 第三指：忽略
    if (g_aui_pn_p0id < 0) { return 0; }     // 无第一指：忽略
    // 独占属主在接管期间不让位（与单指链的独占顺序一致）。
    if (g_aui_slider_key != 0 || g_aui_split_drag_key != 0 ||
        g_aui_pager_dragging != 0 || g_aui_sheet_drag >= 0 ||
        g_aui_menu >= 0 || g_aui_popup >= 0 ||
        g_aui_combo_open >= 0 || g_aui_select_open >= 0 ||
        g_aui_date_press_key != 0 || g_aui_time_press_key != 0 ||
        g_aui_snack_down != 0 || g_dbg_down != 0 || g_dbg_panel_down != 0 ||
        g_aui_ref_drag_key != 0) { return 0; }
    let p1id: i32 = AMotionEvent_getPointerId(ev, pidx);
    let p1x: i32 = event_xi(ev, pidx);
    let p1y: i32 = event_yi(ev, pidx);
    // 第一指的当前位置按 id 从事件里现找（index 会随抬起变化，id 稳定）。
    let n: i32 = AMotionEvent_getPointerCount(ev);
    let p0x: i32 = g_aui_pn_p0x;
    let p0y: i32 = g_aui_pn_p0y;
    let i: i32 = 0;
    while (i < n) {
        let id: i32 = AMotionEvent_getPointerId(ev, i);
        if (id == g_aui_pn_p0id) {
            p0x = event_xi(ev, i);
            p0y = event_yi(ev, i);
        }
        i = i + 1;
    }
    let hit: i32 = hit_test(g_aui_root, p1x, p1y);
    let k: i32 = find_pn(hit);
    if (k < 0) { return 0; }
    let dx: i32 = p1x - p0x;
    let dy: i32 = p1y - p0y;
    let spread: i32 = isqrt(dx * dx + dy * dy);
    let slop: i32 = dp2q(8) >> 16;
    if (spread < slop) { return 0; }
    // 接管：取消单指的软状态（点按/长按待定/滚动拖拽/分页候选），
    // 不产生 fling（UP 派发要求 was_drag != 0，而 dragging 已清）。
    let lc: i32 = lp_cancel_why(7);
    if (g_aui_tip_pend != 0) {
        g_aui_tip_pend = 0;
        g_aui_tip_pend_idx = -1;
    }
    g_aui_pressing = 0;
    g_aui_press_key = 0;
    g_aui_dragging = 0;
    g_aui_drag_key = 0;
    pager_drag_clear();
    g_aui_pn_p1id = p1id;
    g_aui_pn_p0x = p0x;
    g_aui_pn_p0y = p0y;
    g_aui_pn_p1x = p1x;
    g_aui_pn_p1y = p1y;
    g_aui_pn_spread0 = spread;
    g_aui_pn_cx = (p0x + p1x) / 2;
    g_aui_pn_cy = (p0y + p1y) / 2;
    g_aui_pn_dx = 0;
    g_aui_pn_dy = 0;
    g_aui_pn_scale = 65536;
    g_aui_pn_state = 1;
    g_aui_pn_slot = k;
    let nn: ptr<AuiNode> = node_at(g_aui_pn_node[k]);
    g_aui_pn_key = nn.key;
    let tp: i32 = trace_hex(80, pidx);        // P + pointer index
    let pf: i32 = pn_fire();
    aui_invalidate();
    return 0;
}

// 一指抬起（POINTER_UP）：捏合结束。剩下的手指不恢复滚动、不点按、
// 不 fling——接管时已清掉按压与拖动态。
fn pn_pointer_up(ev: ptr, pidx: i32) : i32 {
    if (g_aui_pn_state != 1) { return 0; }
    let id: i32 = AMotionEvent_getPointerId(ev, pidx);
    if (id != g_aui_pn_p0id && id != g_aui_pn_p1id) { return 0; }
    let e: i32 = pn_end(0);
    return 0;
}

// 捏合进行中的 MOVE：按 id 更新两指位置，重算 spread/质心/累计缩放/
// 平移增量，调回调。调用方 handle_motion 直接 return，不走单指链。
fn pn_move(ev: ptr) : i32 {
    if (g_aui_pn_state != 1) { return 0; }
    let n: i32 = AMotionEvent_getPointerCount(ev);
    let i: i32 = 0;
    while (i < n) {
        let id: i32 = AMotionEvent_getPointerId(ev, i);
        if (id == g_aui_pn_p0id) {
            g_aui_pn_p0x = event_xi(ev, i);
            g_aui_pn_p0y = event_yi(ev, i);
        }
        if (id == g_aui_pn_p1id) {
            g_aui_pn_p1x = event_xi(ev, i);
            g_aui_pn_p1y = event_yi(ev, i);
        }
        i = i + 1;
    }
    let dx: i32 = g_aui_pn_p1x - g_aui_pn_p0x;
    let dy: i32 = g_aui_pn_p1y - g_aui_pn_p0y;
    let spread: i32 = isqrt(dx * dx + dy * dy);
    if (spread < 1) { spread = 1; }
    let cx: i32 = (g_aui_pn_p0x + g_aui_pn_p1x) / 2;
    let cy: i32 = (g_aui_pn_p0y + g_aui_pn_p1y) / 2;
    g_aui_pn_dx = cx - g_aui_pn_cx;
    g_aui_pn_dy = cy - g_aui_pn_cy;
    g_aui_pn_cx = cx;
    g_aui_pn_cy = cy;
    g_aui_pn_scale = i32((i64(spread) * 65536) / i64(g_aui_pn_spread0));
    let pf: i32 = pn_fire();
    aui_invalidate();
    return 0;
}

// 结束捏合：why 0 = 一指抬起（Ended），1 = 取消（Canceled）。
// 缩放/焦点/key 保持终值，供回调后读取；状态置 2（已结束）。
fn pn_end(why: i32) : i32 {
    if (g_aui_pn_state != 1) { return 0; }
    g_aui_pn_state = 2;
    g_aui_pn_p1id = -1;
    let tq: i32 = trace_hex(81, why);         // Q + 原因
    let pf: i32 = pn_fire();
    g_aui_pn_slot = -1;
    aui_invalidate();
    return 0;
}

// 取消待定与已触发状态。返回 1 = 之前有待定或已触发（调用方需要重绘）。
// why：1=新按下，2=返回键，3=提示认领抬起，4=系统取消，5=移动超 slop，
// 6=提前抬起，7=捏合接管；0=未指定。
fn lp_cancel_why(why: i32) : i32 {
    let had: i32 = 0;
    if (g_aui_lp_pend != 0 || g_aui_lp_fired != 0) { had = 1; }
    if (had != 0) {
        // v2.7.1-diag：取消行（el=自按下起毫秒，ticks=待定期间 lp_tick 调用次数）。
        let cel: i32 = i32((clock_ns() - g_aui_lp_start) / 1000000);
        let cl: i32 = aui_log3(4, "lp cancel why=", why, " el=", cel, "ms ticks=", g_aui_lp_diag_ticks, "");
    }
    g_aui_lp_pend = 0;
    g_aui_lp_pend_idx = -1;
    g_aui_lp_pend_key = 0;
    g_aui_lp_fired = 0;
    g_aui_lp_key = 0;
    // D-2a：BACK 同时取消可选中待定（已建立的选区不受影响）。
    let sc4: i32 = d2a_sel_cancel_pend();
    if (had != 0) {
        g_aui_need_paint = 1;
        g_aui_pump_need = 1;
    }
    return had;
}

fn lp_cancel() : i32 {
    return lp_cancel_why(0);
}

// 长按判定通过：调一次回调，接管本次手势。点按互斥靠清按压态：
// 通用点按派发要求 down != 0，自然跳过。
fn lp_fire() : i32 {
    let k: i32 = g_aui_lp_pend_idx;
    g_aui_lp_pend = 0;
    g_aui_lp_pend_idx = -1;
    g_aui_lp_fired = 1;
    g_aui_lp_key = g_aui_lp_pend_key;
    g_aui_lp_pend_key = 0;
    // v2.7.1-diag：触发行（el=自按下起毫秒，ticks=待定期间 lp_tick 调用次数）。
    let fel: i32 = i32((clock_ns() - g_aui_lp_start) / 1000000);
    let fl: i32 = aui_log3(4, "lp fire key=", g_aui_lp_key, " el=", fel, "ms ticks=", g_aui_lp_diag_ticks, "");
    let cb: fn(ptr) : i32 = 0;
    let user: ptr = 0;
    if (k >= 0 && k < g_aui_lp_used) {
        cb = g_aui_lp_cb[k];
        user = g_aui_lp_user[k];
    }
    g_aui_pressing = 0;
    g_aui_press_key = 0;
    g_aui_need_paint = 1;
    g_aui_pump_need = 1;
    if (cb != 0) {
        let r: i32 = cb(user);
    }
    return 0;
}

// 帧节拍：到 500 ms 触发一次。由 pump_ui 每拍调用，时间来自
// clock_ns（测试用 fake_set_clock 注入）。
fn lp_tick() : i32 {
    // D-2a：可选中长按与长按回调共用泵节拍（同一 500 ms 阈值）。
    if (d2a_sel_tick() != 0) { return 1; }
    // v2.7.1-diag：待定期间每次被调都计数（真机日志用：ticks=0 说明
    // 泵在本次按住期间根本没调过 lp_tick）。
    if (g_aui_lp_pend != 0) {
        g_aui_lp_diag_ticks = g_aui_lp_diag_ticks + 1;
    }
    if (g_aui_lp_pend != 0 && clock_ns() - g_aui_lp_start >= AUI_LP_NS) {
        let r: i32 = lp_fire();
        let tw: i32 = pump_wake();
        return 1;
    }
    return 0;
}

// v2.7.1-diag：泵要回空闲、而长按还在待定——记一行（每按一次只记
// 一次）。若真机日志出现这行、之后又无 fire，说明泵再也没调 lp_tick。
fn lp_diag_idle() : i32 {
    if (g_aui_lp_pend == 0) { return 0; }
    if (g_aui_lp_diag_idle != 0) { return 0; }
    g_aui_lp_diag_idle = 1;
    let el: i32 = i32((clock_ns() - g_aui_lp_start) / 1000000);
    let l: i32 = aui_log2(4, "lp pump idle el=", el, "ms ticks=", g_aui_lp_diag_ticks, "");
    return 0;
}

// 1 = 还有计时任务（待定长按）。帧泵据此保持 16 ms 轮询。
fn lp_busy() : i32 {
    if (g_aui_lp_pend != 0) { return 1; }
    return 0;
}

// ---- 协作任务 / 延迟（v2.9）----
// 对照 HuxerUI Task/Delay（docs/design/tasks.md）：Delay(500ms) 在 UI
// 线程恢复，回调里可直接改 State。Aster 无闭包/协程，退化为一次性延时
// 回调。登记表固定 32 项，与长按登记表同构；handle = 槽位下标。
let AUI_TASK_CAP: i32 = 32;

let g_aui_task_cb: fn(ptr) : i32[32] = 0;

let g_aui_task_user: ptr[32] = 0;

let g_aui_task_deadline: i64[32] = 0;

let g_aui_task_seq: i32[32] = 0;

let g_aui_task_state: i32[32] = 0;

let g_aui_task_next_seq: i32 = 0;

// v2.9：一次性延时。ms < 0 或 cb 为空返回 -1；登记表满返回 -1。
// 0 ms 即 deadline = 当前时刻，下一拍 task_tick 触发。
fn aui_delay(ms: i32, cb: fn(ptr) : i32, user: ptr) : i32 {
    if (ms < 0 || cb == 0) { return -1; }
    let k: i32 = 0;
    while (k < AUI_TASK_CAP) {
        if (g_aui_task_state[k] == 0) { break; }
        k = k + 1;
    }
    if (k >= AUI_TASK_CAP) { return -1; }
    let now: i64 = clock_ns();
    g_aui_task_cb[k] = cb;
    g_aui_task_user[k] = user;
    g_aui_task_deadline[k] = now + i64(ms) * 1000000;
    g_aui_task_seq[k] = g_aui_task_next_seq;
    g_aui_task_next_seq = g_aui_task_next_seq + 1;
    g_aui_task_state[k] = 1;
    g_aui_pump_need = 1;
    let w: i32 = pump_wake();
    return k;
}

// v2.9：取消待定任务。1 = 取消了一个待定任务；0 = 句柄未知/已触发/
// 已取消（安全空操作）。
fn aui_delay_cancel(handle: i32) : i32 {
    if (handle < 0 || handle >= AUI_TASK_CAP) { return 0; }
    if (g_aui_task_state[handle] != 1) { return 0; }
    g_aui_task_state[handle] = 0;
    g_aui_task_cb[handle] = 0;
    g_aui_task_user[handle] = 0;
    return 1;
}

// v2.9：待定任务数（调试 getter；面板/诊断与 Gallery 演示用）。
fn aui_debug_task_pending() : i32 {
    let n: i32 = 0;
    let k: i32 = 0;
    while (k < AUI_TASK_CAP) {
        if (g_aui_task_state[k] == 1) { n = n + 1; }
        k = k + 1;
    }
    return n;
}

// 1 = 还有待定任务。帧泵据此保持 16 ms 轮询。
fn task_busy() : i32 {
    if (aui_debug_task_pending() != 0) { return 1; }
    return 0;
}

// 帧节拍：触发所有到期任务（deadline 升序，同 deadline 按注册顺序）。
// 每轮取当前最早到期者，槽位先释放再调回调：回调里再注册（0 ms 链式
// 任务）或取消其他任务都不会破坏扫描；每拍最多触发 32 次，回调里无限
// 链式注册 0 ms 任务也不会让这一拍死循环，剩下的下一拍触发。
// 由 pump_ui / pump_frame_once 每拍调用，时间来自 clock_ns（测试用
// fake_set_clock 注入）。
fn task_tick() : i32 {
    let fired: i32 = 0;
    let n: i32 = 0;
    while (n < AUI_TASK_CAP) {
        let now: i64 = clock_ns();
        let best: i32 = -1;
        let k: i32 = 0;
        while (k < AUI_TASK_CAP) {
            if (g_aui_task_state[k] == 1 && g_aui_task_deadline[k] <= now) {
                if (best < 0 || g_aui_task_deadline[k] < g_aui_task_deadline[best] ||
                    (g_aui_task_deadline[k] == g_aui_task_deadline[best] && g_aui_task_seq[k] < g_aui_task_seq[best])) {
                    best = k;
                }
            }
            k = k + 1;
        }
        if (best < 0) { return fired; }
        let cb: fn(ptr) : i32 = g_aui_task_cb[best];
        let user: ptr = g_aui_task_user[best];
        g_aui_task_state[best] = 0;
        g_aui_task_cb[best] = 0;
        g_aui_task_user[best] = 0;
        fired = fired + 1;
        g_aui_need_paint = 1;
        g_aui_pump_need = 1;
        let fl: i32 = aui_log1(4, "task fire h=", best, "");
        if (cb != 0) {
            let r: i32 = cb(user);
        }
        n = n + 1;
    }
    return fired;
}

fn tip_align_off(span: i32, w: i32, a: i32) : i32 {
    if (a == 1) { return (span - w) / 2; }
    if (a == 2) { return span - w; }
    return 0;
}

// v1.27：工具提示布局。先按最大宽度换行，气泡尺寸 = 文本 + 8/4 dp 内边距，
// 高度不小于 24 dp；默认锚点上方居中（HuxerUI 默认），放不下翻到对侧，
// 最后整体夹进内容区并留 8 dp 边距。
fn tip_layout(cx: i32, cy: i32, cw: i32, ch: i32) : i32 {
    if (g_aui_tip_on == 0) { return 0; }
    let s: ptr = g_aui_tip_text;
    if (s == 0) { g_aui_tip_on = 0; return 0; }
    let tlen: i32 = str_len(s);
    if (tlen <= 0) { g_aui_tip_on = 0; return 0; }
    let margin: i32 = dp2q(8);
    let gap: i32 = dp2q(4);
    let padx: i32 = dp2q(8);
    let pady: i32 = dp2q(4);
    let maxw: i32 = dp2q(320);
    let avail: i32 = cw - margin * 2;
    if (avail < maxw) { maxw = avail; }
    if (maxw <= padx * 2) { g_aui_tip_on = 0; return 0; }
    let maxtext: i32 = maxw - padx * 2;
    g_aui_tip_tw = maxtext;
    let mw: i32 = layout_text(s, tlen, maxtext);
    let lh: i32 = text_line_h();
    let w: i32 = mw + padx * 2;
    if (w > maxw) { w = maxw; }
    if (w <= 0) { g_aui_tip_on = 0; return 0; }
    let h: i32 = g_aui_mlines * lh + pady * 2;
    let minh: i32 = dp2q(24);
    if (h < minh) { h = minh; }
    let maxh: i32 = ch - margin * 2;
    if (h > maxh) { h = maxh; }
    if (h <= 0) { g_aui_tip_on = 0; return 0; }
    let ax: i32 = g_aui_tip_ax;
    let ay: i32 = g_aui_tip_ay;
    let aw: i32 = g_aui_tip_aw;
    let ah: i32 = g_aui_tip_ah;
    let side: i32 = g_aui_tip_side;
    let al: i32 = g_aui_tip_align;
    let x: i32 = 0;
    let y: i32 = 0;
    if (side == 1) {                 // 下方
        y = ay + ah + gap;
        if (y + h > cy + ch - margin) {
            let up: i32 = ay - gap - h;
            if (up >= cy + margin) { y = up; }
            else { y = cy + ch - margin - h; }
        }
        x = ax + tip_align_off(aw, w, al);
    } else if (side == 2) {          // 右侧
        x = ax + aw + gap;
        if (x + w > cx + cw - margin) {
            let lf: i32 = ax - gap - w;
            if (lf >= cx + margin) { x = lf; }
            else { x = cx + cw - margin - w; }
        }
        y = ay + tip_align_off(ah, h, al);
    } else if (side == 3) {          // 左侧
        x = ax - gap - w;
        if (x < cx + margin) {
            let rt: i32 = ax + aw + gap;
            if (rt + w <= cx + cw - margin) { x = rt; }
            else { x = cx + margin; }
        }
        y = ay + tip_align_off(ah, h, al);
    } else {                         // 上方（默认）
        y = ay - gap - h;
        if (y < cy + margin) {
            let dn: i32 = ay + ah + gap;
            if (dn + h <= cy + ch - margin) { y = dn; }
            else { y = cy + margin; }
        }
        x = ax + tip_align_off(aw, w, al);
    }
    if (x < cx + margin) { x = cx + margin; }
    if (y < cy + margin) { y = cy + margin; }
    if (x + w > cx + cw - margin) { x = cx + cw - margin - w; }
    if (y + h > cy + ch - margin) { y = cy + ch - margin - h; }
    if (x < cx) { x = cx; }
    if (y < cy) { y = cy; }
    g_aui_tip_x = x;
    g_aui_tip_y = y;
    g_aui_tip_w = w;
    g_aui_tip_h = h;
    return 0;
}
