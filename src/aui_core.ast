// ---- 长按手势（v2.7）----
// 对照 HuxerUI LongPressGesture：单指在容差内停留到 500 ms 截止即识别，
// 触发一次回调；提前抬起 / 移出容差 / 变成滚动拖拽都取消；触发后不再
// 补发点按（与 tap 互斥）。复用工具提示的待定模式：登记表 + DOWN 计时
// + 帧泵节拍推进，不另起一套手势系统。
let AUI_LP_CAP: i32 = 32;

