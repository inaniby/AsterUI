// aster:language=en
// aui_core.ast — S1 shared state + tree core + error fns + fx + state accessors
// P4 split of src/aui_impl.ast (pure move; see phase1-p4-split.md).
// Original file header (src/aui_impl.ast lines 1-11):
// aui_impl.ast — AsterUI v1 单体实现
//
// 放在 Aster 原生标准库里，不依赖 Java/Kotlin/dex：NativeActivity 回调 +
// 自绘软件光栅。所有状态在 .bss 固定池里，无堆、无 mmap。
//
// 编译：aster build-obj --pic stdlib/asterui/aui_impl.ast -o build/aui_impl.o
// 链接：见 §16.2，和应用的 .o 一起 link-so。
//
// 本文件按节组织：常量/结构 → 定点 → 字体 → 构建器 → 布局 → 绘制列表 →
// 光栅 → 输入 → Android 宿主 → 公共 API。
//

// ---- extern 声明（gen_split.py 从定义处逐字抽取；定义唯一，声明随调用方）----
extern let g_aui_sem_role: i32[4096];
extern let g_aui_sem_label: ptr[4096];
extern let g_aui_sem_hide: i32[4096];
extern let g_d2a_size_w: i32[4096];
extern let g_d2a_size_h: i32[4096];
extern let g_d2a_text_sp: i32[4096];
extern let g_d2a_fg: i32[4096];
extern let g_d2a_fg_set: i32[4096];
extern let g_d2a_sel: i32[4096];

// aui_impl.ast — AsterUI v1 单体实现
//
// 放在 Aster 原生标准库里，不依赖 Java/Kotlin/dex：NativeActivity 回调 +
// 自绘软件光栅。所有状态在 .bss 固定池里，无堆、无 mmap。
//
// 编译：aster build-obj --pic stdlib/asterui/aui_impl.ast -o build/aui_impl.o
// 链接：见 §16.2，和应用的 .o 一起 link-so。
//
// 本文件按节组织：常量/结构 → 定点 → 字体 → 构建器 → 布局 → 绘制列表 →
// 光栅 → 输入 → Android 宿主 → 公共 API。
let AUI_NODE_CAP: i32 = 4096;

let AUI_CMD_CAP: i32 = 4096;

let AUI_STACK_MAX: i32 = 30;

let AUI_STATE_CAP: i32 = 256;

// 节点 96 B：18 个 i32 + 3 个 8 字节字段（aux2 补齐了原来的 4 B 填充）。
struct AuiNode {
    kind: i32,          // 1 root, 2 column, 3 row, 4 stack, 5 label, 6 button, 7 spacer, 8 image, 9 scroll
                        // 10 text field, 11 key, 12 switch, 13 progress,
                        // 14 checkbox, 15 radio, 16 slider（v1.20）
                        // 17 segmented（容器）, 18 segment（v1.21）
                        // 19 tabs（容器）, 20 tab（v1.22）
                        // 21 pager（容器）, 22 page（v1.24）
                        // 23 dialog（遮罩，不挂树）, 24 dialog card（v1.25）
                        // 25 select（容器，弹出列表）, 26 option（v1.26）
                        // 27 date picker, 28 time picker（v1.28/v1.29）
                        // 29 refresh box, 30 chip（v1.30/v1.31）
                        // 31 progress circle（v1.32）
                        // 32 tree（容器）, 33 tree item（v1.33）
                        // 34 menu surface（浮层，不挂树）, 35 menu item,
                        // 36 menu separator（v1.35）
                        // 37 icon button, 38 icon（v1.36）
                        // 39 flow（容器）, 40 divider（v1.37）
                        // 41 sheet（遮罩，不挂树）, 42 sheet surface（v1.38）
                        // 43 popup surface（锚定浮层，不挂树，v1.39）
                        // 44 top app bar（容器，v1.40）
                        // 45 navigation bar（容器）, 46 navigation item（v1.41）
                        // 47 navigation pane（容器）, 48 navigation pane item（v1.42）
                        // 49 combo（容器）, 50 combo suggestion（v1.44）
                        // 51 vlist（容器）, 52 vlist row（v1.45）
                        // 53 vgrid（容器）, 54 grid cell（v1.46）
                        // 55 hlist（容器）, 56 hlist item（v1.47）
                        // 57 canvas（自定义绘图节点，v2.6）
                        // 58 vlist_var（容器）, 59 vlist_var row（v2.10）
                        // 60 badge（角标，v2.10）
                        // 61 split（可调分栏容器，v2.12）
                        // 62 theme（嵌套主题容器，v2.15）
                        // 63 vtable（虚拟表格容器，v2.17）
                        // 64 vtable cell（表格格子：aux = 行，-1 = 表头；
                        // aux2 = 列；flags = 行高 Q16.16，v2.17）
    flags: i32,
    key: i32,
    parent: i32,
    first_child: i32,
    next_sibling: i32,
    x: i32,             // Q16.16 px（绝对）
    y: i32,
    w: i32,
    h: i32,
    pad: i32,           // Q16.16 px；checkbox/radio 复用为“文本起始偏移”
    gap: i32,
    weight: i32,
    align: i32,         // 0 start, 1 center, 2 end, 3 stretch
    bg: u32,            // 0xAARRGGBB
    radius: i32,        // Q16.16 px
    aux: i32,           // label: 文本字节长度（-1 = NUL 结尾）；image: (h<<16)|w (dp)；spacer: 高度 dp
                        // switch: 0/1；progress: 千分比；slider: 千分比
                        // segmented: 选中段下标（v1.21）
                        // tabs: 选中页下标（v1.22）
                        // pager: 当前页下标（v1.24）
    aux2: i32,          // checkbox/radio: 0/1；slider: step（千分比，>= 1）
                        // segment: 段下标（arrange 写入）
                        // tab: 页下标（arrange 写入）
                        // pager: 拖动偏移快照（Q16.16，仅测试/调试）
                        // page: 页下标（arrange 写入）
    text: ptr,          // UTF-8 / 图片 RGBA
    cb: fn(ptr) : i32,
    user: ptr
}

// 绘制命令 64 B：48 B 几何/颜色 + 16 B 裁剪矩形。
// 每条命令自带裁剪（Q16.16），光栅器不需要维护裁剪栈；滚动容器就是
// 把自己的视口写进子树所有命令的 clip，越界部分在光栅阶段丢弃。
struct AuiCmd {
    op: i32,            // 1 rect, 2 text, 3 image, 4 ring, 5 triangle,
                        // 6 segment, 7 half-disc (v2.6.2), 8 dashed ring (v2.6.2)
                        // 9 rotated rect (v2.8), 10 rotated/sized text (v2.8)
                        // op 9/10：x/y 为旋转中心（Q16.16），w/h 为未旋转
                        // 尺寸（op 10 的 w 为整行宽），radius 为整度角，
                        // op 10 的 h 为字高（Q16.16 px）。
    x: i32,
    y: i32,
    w: i32,
    h: i32,
    color: i32,
    radius: i32,
    text: ptr,
    tlen: i32,
    aux: i32,
    cx: i32,            // clip，Q16.16 绝对坐标
    cy: i32,
    cw: i32,
    ch: i32
}

// ---- 池 ----
let g_aui_node_pool: i64[49152] = 0;

let g_aui_nodes: ptr<AuiNode> = g_aui_node_pool;

let g_aui_node_count: i32 = 0;

let g_aui_cmd_pool: i64[32768] = 0;

let g_aui_cmds: ptr<AuiCmd> = g_aui_cmd_pool;

let g_aui_cmd_count: i32 = 0;

// ---- 构建器 ----
let g_aui_root: i32 = -1;

let g_aui_depth: i32 = 0;

let g_aui_stk_parent: i32[32] = 0;

let g_aui_stk_last: i32[32] = 0;

let g_aui_last_created: i32 = -1;

let g_aui_in_build: i32 = 0;

// ---- 显示 ----
let g_aui_density: i32 = 65536;

let g_aui_sw: i32 = 0;

let g_aui_sh: i32 = 0;

let g_aui_text_scale: i32 = 2;

let g_aui_need_build: i32 = 1;

let g_aui_need_layout: i32 = 1;

let g_aui_need_paint: i32 = 1;

// v1.48.4：只滚不重建时跳过 measure。滚动只改变子节点的 y/x 偏移，
// 节点尺寸与内容高度都没变，重排一遍就够；measure 会把整棵树再量一次，
// 手指拖动时每个 MOVE 都做一遍纯属浪费。build/窗口尺寸变化会清掉它。
let g_aui_layout_light: i32 = 0;

let g_aui_fb_w: i32 = 0;

let g_aui_fb_h: i32 = 0;

// ---- 局部呈现（v1.48.2）----
// 波纹扩散/淡出时整屏内容不变，只重画波纹所在节点（一行/一个按钮），
// 避免每帧都重铺 1216×2688 的根底色与十几行背景。
let g_aui_paint_full: i32 = 1;

let g_aui_paint_gen: i32 = 0;

let g_aui_build_count: i32 = 0;

let g_aui_dmg_gen: i32 = 0;

let g_aui_dmg_valid: i32 = 0;

let g_aui_dmg_l: i32 = 0;

let g_aui_dmg_t: i32 = 0;

let g_aui_dmg_r: i32 = 0;

let g_aui_dmg_b: i32 = 0;

let g_aui_draw_on: i32 = 0;

let g_aui_draw_l: i32 = 0;

let g_aui_draw_t: i32 = 0;

let g_aui_draw_r: i32 = 0;

let g_aui_draw_b: i32 = 0;

// 整屏命令快照（v1.48.2）。局部呈现前先确认“相对上一张整屏帧，只有波纹
// 那一段命令变了”；否则波纹外别的像素（Toast 消失、输入框文字）会被漏掉。
let g_aui_snap_pool: i64[32768] = 0;

let g_aui_snap_cmds: ptr<AuiCmd> = g_aui_snap_pool;

let g_aui_snap_count: i32 = 0;

let g_aui_snap_rs: i32 = -1;

let g_aui_snap_re: i32 = -1;

let g_aui_rip_cs: i32 = -1;

let g_aui_rip_ce: i32 = -1;

// ---- 持久帧缓冲 + 纯滚动直搬（v1.48.6）----
// 1216×2688 上整屏软件光栅一帧要 20 ms 以上，而纯滚动帧真正变化的只有
// 视口里新露出的那一条。这里把上一帧留在自己的缓冲里（窗口格式、窗口
// stride），滚动帧把视口内容整体搬移一个整数像素、只补画新露出的一条与
// 滚动条，再把这一块拷回窗口缓冲。缓冲是静态 .bss，不用堆。
// v2.7.1：上限从 1M 像素提到 8M 像素（≈4K）。Aster 单个全局数组最多
// 1048576 个元素，1216×2688=3268608 像素装不进一个数组，真机上 fits
// 恒为 0、直搬永不生效、每帧全量重栅格化（20–47 ms）；所以帧缓冲改
// 成 8 块 × 1M 个 i32，每块按行对齐（块内行数 = 1048576 / stride，
// 由 present_now 在锁窗口后定），行首地址由 fb_row_ptr() 算；
// 逻辑上仍是一块 stride 步进的整帧缓冲，像素地址与原来逐字节相同。
// 超过 8M 像素的屏仍退回整屏直接画进窗口，行为与 v1.48.5 一致。
let g_aui_fbuf0: i32[1048576] = 0;

let g_aui_fbuf1: i32[1048576] = 0;

let g_aui_fbuf2: i32[1048576] = 0;

let g_aui_fbuf3: i32[1048576] = 0;

let g_aui_fbuf4: i32[1048576] = 0;

let g_aui_fbuf5: i32[1048576] = 0;

let g_aui_fbuf6: i32[1048576] = 0;

let g_aui_fbuf7: i32[1048576] = 0;

let g_aui_fb_rows_per_chunk: i32 = 0;

let g_aui_fbuf_ok: i32 = 0;

let g_aui_fbuf_w: i32 = 0;

let g_aui_fbuf_h: i32 = 0;

let g_aui_fbuf_stride: i32 = 0;

let g_aui_fbuf_fmt: i32 = 0;

// 上一张帧缓冲对应的滚动目标/偏移/视口（像素，右、下开区间）。
let g_aui_fb_key: i32 = 0;

let g_aui_fb_off: i32 = 0;

let g_aui_fb_vp_ok: i32 = 0;

let g_aui_fb_vp_l: i32 = 0;

let g_aui_fb_vp_t: i32 = 0;

let g_aui_fb_vp_r: i32 = 0;

let g_aui_fb_vp_b: i32 = 0;

let g_aui_fb_horiz: i32 = 0;

// v2.17.1：表格横向直搬的上一张视口（首列右沿起，全高）与横向偏移。
let g_aui_fb_vp_h_ok: i32 = 0;

let g_aui_fb_vp_hl: i32 = 0;

let g_aui_fb_vp_ht: i32 = 0;

let g_aui_fb_vp_hr: i32 = 0;

let g_aui_fb_vp_hb: i32 = 0;

let g_aui_fb_offx: i32 = 0;

// 本帧的滚动目标与绘制时抓到的视口/子树命令范围。
let g_aui_frame_scroll_key: i32 = 0;

let g_aui_scroll_vp_ok: i32 = 0;

let g_aui_scroll_vp_l: i32 = 0;

let g_aui_scroll_vp_t: i32 = 0;

let g_aui_scroll_vp_r: i32 = 0;

let g_aui_scroll_vp_b: i32 = 0;

// v2.17.1：本帧表格横向直搬视口（首列右沿起，全高，含表头）。
let g_aui_scroll_vp_h_ok: i32 = 0;

let g_aui_scroll_vp_hl: i32 = 0;

let g_aui_scroll_vp_ht: i32 = 0;

let g_aui_scroll_vp_hr: i32 = 0;

let g_aui_scroll_vp_hb: i32 = 0;

let g_aui_scroll_vp_rad: i32 = 0;

let g_aui_sg_start: i32 = -1;

let g_aui_sg_end: i32 = -1;

let g_aui_frame_light: i32 = 0;

let g_aui_frame_blit: i32 = 0;

let g_aui_frame_dmg: i32 = 0;

let g_aui_frame_dmg_l: i32 = -1;

let g_aui_frame_dmg_t: i32 = -1;

let g_aui_frame_dmg_r: i32 = -1;

let g_aui_frame_dmg_b: i32 = -1;

let g_aui_dmg_why: i32 = 0;

let g_aui_dmg_diffn: i32 = 0;

let g_aui_dmg_first: i32 = -1;

let g_aui_dmg_firstop: i32 = -1;

let g_aui_dmg_word: i32 = -1;

let g_aui_dmg_old: i64 = 0;

let g_aui_dmg_new: i64 = 0;

let g_aui_dmg_try_l: i32 = -1;

let g_aui_dmg_try_t: i32 = -1;

let g_aui_dmg_try_r: i32 = -1;

let g_aui_dmg_try_b: i32 = -1;

let g_aui_force_full: i32 = 0;

let g_aui_blit_fail: i32 = 0;

let g_aui_blit_dif: i32 = 0;

let g_aui_blit_bd: i32 = 0;

let g_aui_blit_dbg: i32[8] = 0;

let g_aui_blit_off: i32 = 0;

let g_aui_snap_pending: i32 = 0;

// ---- 系统状态（v1.9）----
// 内容区/安全区来自 onContentRectChanged；density/night 来自 AConfiguration。
// 三者变化都会整棵树重建，因为应用可能按它们决定布局与颜色。
let g_aui_dark: i32 = 0;

let g_aui_night: i32 = 0;

let g_aui_ct_valid: i32 = 0;

let g_aui_ct_l: i32 = 0;

let g_aui_ct_t: i32 = 0;

let g_aui_ct_r: i32 = 0;

let g_aui_ct_b: i32 = 0;

let g_aui_inset_l: i32 = 0;

let g_aui_inset_t: i32 = 0;

let g_aui_inset_r: i32 = 0;

let g_aui_inset_b: i32 = 0;

// v1.14：Android 15（API 35）起 targetSdk 35 强制 edge-to-edge，
// onContentRectChanged 会给出整窗。系统栏高度在 NDK 没有查询接口，
// 这里按 24dp 估算上下安全区；应用可用 aui_set_insets 抬高下限，
// 或 aui_edge_to_edge(1) 关掉估算、自己铺满。
// v2.14：高度现在能经 JNI 查（sysbar_measure_insets，WindowInsets）；
// 内容区是整窗/未到时优先用 JNI 实测值，取不到才按 24dp 估算。
let g_aui_sdk: i32 = 0;

let g_aui_e2e: i32 = 0;

let g_aui_min_l: i32 = 0;

let g_aui_min_t: i32 = 0;

let g_aui_min_r: i32 = 0;

let g_aui_min_b: i32 = 0;

let g_aui_inset_guess: i32 = 0;

// v1.15：edge-to-edge 条带颜色（0 = 跟随主题角色）。v2.13 起条带跟主题
// 底色走，图标颜色由框架经 JNI 换（见 sysbar_apply_icons）；API 30
// 以下或 JNI 失败时回落深色条带。
let g_aui_sysbar: u32 = 0;

// v2.13：JNI 系统栏图标状态。g_aui_jni_env/g_aui_jni_act 是测试注入
// （headless 无 JVM）；生产走 activity+16（env）/+24（clazz）。
// g_aui_sysbar_icons = 上次成功换到的 appearance（0 浅色图标 / 8 深色图标）。
// g_aui_sysbar_jni = 0 从未尝试 / 1 已换 / 2 回落。
// g_aui_sysbar_fb = 1 时条带取安全色（见 theme_system_bar）。
let g_aui_jni_env: ptr = 0;

let g_aui_jni_act: ptr = 0;

let g_aui_sysbar_icons: i32 = 0;

let g_aui_sysbar_jni: i32 = 0;

let g_aui_sysbar_fb: i32 = 0;

// v2.14：JNI 实测系统栏高（像素）。-1 = 未测到；ok = 1 时 calc_insets
// 在内容区是整窗/未到时用它代替 24dp 估算。src = 当前安全区来源：
// 0 无（铺满/全零）、1 内容区、2 JNI 实测、3 24dp 估算。
let g_aui_insets_jni_t: i32 = -1;

let g_aui_insets_jni_b: i32 = -1;

let g_aui_insets_jni_ok: i32 = 0;

let g_aui_insets_src: i32 = 0;

// v2.13：JNI 表下标（AOSP libnativehelper include_jni/jni.h，
// JNINativeInterface 结构体顺序计数）与图标 appearance 位。
let JNI_TBL_EXCEPTION_CLEAR: i32 = 17;

let JNI_TBL_DELETE_LOCAL_REF: i32 = 23;

let JNI_TBL_GET_OBJECT_CLASS: i32 = 31;

let JNI_TBL_GET_METHOD_ID: i32 = 33;

let JNI_TBL_CALL_OBJECT_METHOD_A: i32 = 36;

let JNI_TBL_CALL_VOID_METHOD_A: i32 = 63;

let JNI_TBL_EXCEPTION_CHECK: i32 = 228;

let JNI_APPEARANCE_LIGHT_STATUS_BARS: i32 = 8;

// v2.14：WindowInsets 量栏高要多用的表下标（同上来源；本轮经 JNI
// 规范的 Interface Function Table 逐项核对：GetFieldID 94、
// GetStaticMethodID 113、ExceptionCheck 228 是规范原文注明的下标，
// 其余按表顺序计数）。FindClass 6、CallIntMethodA 51、GetFieldID 94、
// GetIntField 100、GetStaticMethodID 113、CallStaticIntMethodA 131。
let JNI_TBL_FIND_CLASS: i32 = 6;

let JNI_TBL_CALL_INT_METHOD_A: i32 = 51;

let JNI_TBL_GET_FIELD_ID: i32 = 94;

let JNI_TBL_GET_INT_FIELD: i32 = 100;

let JNI_TBL_GET_STATIC_METHOD_ID: i32 = 113;

let JNI_TBL_CALL_STATIC_INT_METHOD_A: i32 = 131;

// ---- 裁剪（Q16.16，绘制列表生成期间的当前裁剪矩形）----
let g_aui_clip_x: i32 = 0;

let g_aui_clip_y: i32 = 0;

let g_aui_clip_w: i32 = 0;

let g_aui_clip_h: i32 = 0;

// ---- Canvas 绘制回调（v2.6）----
// draw_fn 执行期间为 1；原语（aui_cv_*）只在此时发命令，回调外返回 -1。
// 原点是当前 Canvas 节点的绝对位置（Q16.16 px，不含动画 paint 偏移——
// cmd_add 自己加 paint_dx/dy，原点若含了它会算两次）；尺寸是回调开始
// 时的节点实际尺寸（dp，拉伸后的值，不是 aux 里的请求值）。
let g_aui_in_cv: i32 = 0;

let g_aui_cv_ox: i32 = 0;

let g_aui_cv_oy: i32 = 0;

let g_aui_cv_w: i32 = 0;

let g_aui_cv_h: i32 = 0;

// ---- 滚动偏移：按 key 存，跨帧重建保留 ----
// 每帧都会重建节点树，滚动量不能放在节点里，否则一帧就被清零。
let AUI_SCROLL_CAP: i32 = 64;

let g_aui_scroll_key: i32[64] = 0;

let g_aui_scroll_val: i32[64] = 0;

let g_aui_scroll_max: i32[64] = 0;

let g_aui_scroll_used: i32 = 0;

// ---- 虚拟列表（v1.45）----
// 只构建视口内（上下各多一行）的行节点：行高固定，内容总高由
// count × 行高算出，所以不需要为未显示的行建节点。窗口在 build 时
// 用“当前滚动偏移 + 上一帧视口高”算；视口高按 key 跨帧保留，首帧
// 用 480 dp 的保守估计，布局后若发现视口变了就置 need_build，
// 下一拍按真实视口重建。拖动/惯性改变偏移时同样重建，保证窗口
// 始终覆盖可见区域。
let AUI_VLIST_CAP: i32 = 16;

let g_aui_vlist_key: i32[16] = 0;

let g_aui_vlist_vp: i32[16] = 0;

let g_aui_vlist_used_vp: i32[16] = 0;

let g_aui_vlist_first: i32[16] = 0;

let g_aui_vlist_last: i32[16] = 0;

// 虚拟列表的滚动偏移单独存，单位是“像素”而不是 Q16.16 px。
// 5000 行 × 168 px ≈ 84 万 px，Q16.16（上限约 32768 px）根本装不下；
// scroll_get/set/max 会按 key 分派到这里，其余滚动容器保持 Q16.16。
let g_aui_vlist_off: i32[16] = 0;

let g_aui_vlist_max: i32[16] = 0;

let g_aui_vlist_used: i32 = 0;

// build 期间 on_bind 回调的上下文（取首末行、建行时读行高/回调）。
let g_aui_vlist_cur_key: i32 = 0;

let g_aui_vlist_cur_ih: i32 = 0;

let g_aui_vlist_cur_user: ptr = 0;

let g_aui_vlist_cur_tap: fn(ptr) : i32;

let g_aui_vlist_first_cur: i32 = 0;

let g_aui_vlist_last_cur: i32 = -1;

// 点中行时先写 (容器 key, 行下标)，回调里用 aui_vlist_tap_index() 读。
let g_aui_vlist_tap_key: i32 = 0;

let g_aui_vlist_tap_idx: i32 = -1;

// ---- 不定高虚拟列表（v2.10）----
// 与固定列表共用 16 槽登记表（g_aui_vlist_*）：滚动偏移/最大偏移/视口/
// 窗口都按 key 存，拖动/惯性/滚动条/裁剪/直搬全部复用，不用第二套滚动
// 状态。g_aui_vlist_var[s] = 1 表示该槽是不定高列表。行高按下标缓存在
// g_aui_vlvar_h[s * HCAP + i]（像素，0 = 未测量，用估计高）；超出 HCAP
// 的项永远用估计高。内容宽变化整表失效（见 measure_vlist_var）。
let AUI_VLVAR_HCAP: i32 = 1024;

let g_aui_vlist_var: i32[16] = 0;

let g_aui_vlvar_h: i32[16384] = 0;

let g_aui_vlvar_w: i32[16] = 0;

let g_aui_vlvar_writes: i32[16] = 0;

let g_aui_vlvar_count: i32[16] = 0;

let g_aui_vlvar_est: i32[16] = 0;

// ---- 可调分栏（v2.12）----
// 对照 HuxerUI SplitLayout：两个窗格、一条可拖分隔条。比例按 key 跨帧
// 保留在 16 槽登记表里（与滚动偏移同规则：aui_split 的 ratio 参数只
// 作初值，之后构建沿用表里的值，拖动与 aui_split_set_ratio 维护它）。
// cb/user 也存表里，不挂节点——分隔条不是点击目标（find_clickable
// 不应把它当按钮）；拖动开始时从表里快照一份到拖动全局里。
let AUI_SPLIT_CAP: i32 = 16;

let g_aui_split_key: i32[16] = 0;

let g_aui_split_ratio: i32[16] = 500;

let g_aui_split_min: i32[16] = 48;

let g_aui_split_cb: fn(ptr) : i32[16] = 0;

let g_aui_split_user: ptr[16] = 0;

// ---- 虚拟网格（v1.46）----
// 对照 HuxerUI VirtualGrid：固定列数或按最小格宽自适应，行高固定。
// 与虚拟列表一样只构建窗口内的格子，偏移按像素存；另外每帧记住
// 实测列数/间距/视口高，下一拍窗口估算用，变化时自动重建。
let AUI_VGRID_CAP: i32 = 12;

let g_aui_vgrid_key: i32[12] = 0;

let g_aui_vgrid_vp: i32[12] = 0;

let g_aui_vgrid_used_vp: i32[12] = 0;

let g_aui_vgrid_cols: i32[12] = 0;

let g_aui_vgrid_gap: i32[12] = 0;

let g_aui_vgrid_first: i32[12] = 0;

let g_aui_vgrid_last: i32[12] = 0;

let g_aui_vgrid_off: i32[12] = 0;

let g_aui_vgrid_max: i32[12] = 0;

let g_aui_vgrid_used: i32 = 0;

let g_aui_vgrid_cur_key: i32 = 0;

let g_aui_vgrid_cur_rh: i32 = 0;

let g_aui_vgrid_cur_user: ptr = 0;

let g_aui_vgrid_cur_tap: fn(ptr) : i32;

let g_aui_vgrid_first_cur: i32 = 0;

let g_aui_vgrid_last_cur: i32 = -1;

let g_aui_vgrid_tap_key: i32 = 0;

let g_aui_vgrid_tap_idx: i32 = -1;

// ---- 横向虚拟列表（v1.47）----
// 对照 HuxerUI VirtualList.ScrollAxis(Horizontal)：项宽固定，只构建
// 窗口内的项。横向总宽同样可能超过 Q16.16 上限，偏移按像素存。
let AUI_HLIST_CAP: i32 = 12;

let g_aui_hlist_key: i32[12] = 0;

let g_aui_hlist_vp: i32[12] = 0;

let g_aui_hlist_used_vp: i32[12] = 0;

let g_aui_hlist_first: i32[12] = 0;

let g_aui_hlist_last: i32[12] = 0;

let g_aui_hlist_gap: i32[12] = 0;

let g_aui_hlist_off: i32[12] = 0;

let g_aui_hlist_max: i32[12] = 0;

let g_aui_hlist_used: i32 = 0;

let g_aui_hlist_cur_key: i32 = 0;

let g_aui_hlist_cur_iw: i32 = 0;

let g_aui_hlist_cur_ih: i32 = 0;

let g_aui_hlist_cur_user: ptr = 0;

let g_aui_hlist_cur_tap: fn(ptr) : i32;

let g_aui_hlist_first_cur: i32 = 0;

let g_aui_hlist_last_cur: i32 = -1;

let g_aui_hlist_tap_key: i32 = 0;

let g_aui_hlist_tap_idx: i32 = -1;

// ---- 拖动会话 ----
let g_aui_drag_key: i32 = 0;

let g_aui_drag_y0: i32 = 0;

let g_aui_drag_x0: i32 = 0;

let g_aui_drag_axis: i32 = 0;

// v2.17：2 = 表格待定（首个超 8 dp 容差的方向定轴）
let g_aui_drag_off0: i32 = 0;

let g_aui_drag_offx0: i32 = 0;

let g_aui_dragging: i32 = 0;

// ---- 滑块拖动（v1.20）----
// 拖动期间值只存在全局里：布局/重建不能打断手势，回调里用
// aui_slider_value(key) 读实时值。x/w 是按下时节点的 Q16.16 矩形，
// step 是构建时传入的吸附步长（千分比）。
let g_aui_slider_key: i32 = 0;

let g_aui_slider_val: i32 = 0;

let g_aui_slider_step: i32 = 1;

let g_aui_slider_x: i32 = 0;

let g_aui_slider_w: i32 = 0;

let g_aui_slider_cb: fn(ptr) : i32;

let g_aui_slider_user: ptr = 0;

// ---- 分隔条拖动（v2.12）----
// 与滑块同模式：DOWN 命中时快照按下时的比例/指针位置/可用总长/最小
// 窗格（像素），MOVE 按快照换算，布局在拖动期间变化也不会跳动。
// ratio0/total/min 都是拖动开始时的快照；live 是当前实时比例。
let g_aui_split_drag_key: i32 = 0;

let g_aui_split_drag_ratio0: i32 = 500;

let g_aui_split_drag_pos0: i32 = 0;

let g_aui_split_drag_total: i32 = 0;

let g_aui_split_drag_min: i32 = 0;

let g_aui_split_drag_horiz: i32 = 1;

let g_aui_split_drag_cb: fn(ptr) : i32;

let g_aui_split_drag_user: ptr = 0;

let g_aui_split_drag_live: i32 = 500;

// ---- 分段控件（v1.21）----
// 点中某一段时把 (父 key, 段下标) 记下来，回调里用 aui_segmented_value
// 读取；和滑块一样，重建不会打断这个查询（重建时节点 aux 已是新选中值）。
let g_aui_seg_key: i32 = 0;

let g_aui_seg_val: i32 = 0;

// ---- 标签页（v1.22）----
// 与分段控件同一套路：UP 先写 (容器 key, 页下标)，回调里用
// aui_tabs_value(容器 key) 读刚点中的页；容器 aux 始终是当前页。
let g_aui_tab_key: i32 = 0;

let g_aui_tab_val: i32 = 0;

// ---- 底部导航栏（v1.41）----
// 与标签页同一套路：UP 先写 (容器 key, 项下标)，回调里用
// aui_nav_value(容器 key) 读取；容器 aux 始终是应用传入的选中下标。
let g_aui_nav_key: i32 = 0;

let g_aui_nav_val: i32 = 0;

// ---- 分页（v1.24）----
// 与滚动偏移同一思路：节点树每帧重建，分页偏移按容器 key 存在树外。
// offset = 0 表示第一页贴住视口，第 i 页的 x = 视口 x + i*页宽 - offset。
// 松手后由 200 ms ease-out 动画把 offset 吸到目标页；动画只改布局，
// 不重建节点树（与页面转场/滚动的帧泵共用节拍）。
let AUI_PAGER_CAP: i32 = 32;

let g_aui_pager_key: i32[32] = 0;

let g_aui_pager_off: i32[32] = 0;

let g_aui_pager_max: i32[32] = 0;

let g_aui_pager_init: i32[32] = 0;

let g_aui_pager_anim_on: i32[32] = 0;

let g_aui_pager_anim_from: i32[32] = 0;

let g_aui_pager_anim_to: i32[32] = 0;

let g_aui_pager_anim_start: i64[32] = 0;

let g_aui_pager_anim_dur: i64[32] = 0;

let g_aui_pager_used: i32 = 0;

// 拖动候选：按下时同时记录分页与滚动祖先，MOVE 的第一个 8 dp 决定
// 横向（分页）还是纵向（滚动）。pager_lock：0 未定、1 横向、2 纵向。
let g_aui_pager_drag_key: i32 = 0;

let g_aui_pager_drag_x0: i32 = 0;

let g_aui_pager_drag_y0: i32 = 0;

let g_aui_pager_drag_off0: i32 = 0;

let g_aui_pager_dragging: i32 = 0;

let g_aui_pager_lock: i32 = 0;

let g_aui_pager_vel: i32 = 0;

let g_aui_pager_last_x: i32 = 0;

let g_aui_pager_last_t: i64 = 0;

let g_aui_pager_drag_idx: i32 = 0;

let g_aui_pager_drag_cnt: i32 = 0;

let g_aui_pager_drag_w: i32 = 0;

let g_aui_pager_drag_cb: fn(ptr) : i32;

let g_aui_pager_drag_user: ptr = 0;

// 刚松手提出的目标页；回调内用 aui_pager_value(容器 key) 读取。
let g_aui_pager_prop_key: i32 = 0;

let g_aui_pager_prop_val: i32 = 0;

// ---- 对话框（v1.25）----
// 模态层只有一层：dialog 节点不挂在根树上，绘制与命中都在根之后单独处理，
// 所以不会参与页面/滚动布局。卡片 key 由应用传入，dialog 自身用负 key。
let g_aui_dialog: i32 = -1;

let g_aui_dialog_card: i32 = -1;

let g_aui_dialog_reason: i32 = 0;

// ---- 底部弹出层（v1.38）----
// 对照 HuxerUI BottomSheet：整窗遮罩（42% 黑）+ 贴底表面（顶部 14 dp
// 圆角、最大 640 dp 宽、最高 85% 内容区高）。和对话框一样不挂根树，
// 布局/绘制/命中都在根之后单独处理。打开时从底部滑入 240 ms；顶部
// 32 dp 是拖拽区，向下拖过 1/4 高度（至少 96 dp）即关闭。
let g_aui_sheet: i32 = -1;

let g_aui_sheet_card: i32 = -1;

let g_aui_sheet_reason: i32 = 0;

let g_aui_sheet_had: i32 = 0;

let g_aui_sheet_anim: i32 = 0;

let g_aui_sheet_until: i64 = 0;

let g_aui_sheet_drag: i32 = -1;

let g_aui_sheet_dy0: i32 = 0;

// ---- 下拉选择（v1.26）----
// select 是普通布局里的容器（kind 25），选项（kind 26）始终作为子节点
// 存在，但只有展开时才在浮层里布局/绘制/命中。浮层几何在 layout 阶段
// 算好放全局：同一时刻只允许一个下拉展开，和对话框一样只有一层。
let g_aui_select_open: i32 = -1;

let g_aui_select_key: i32 = 0;

let g_aui_select_val: i32 = -1;

let g_aui_select_reason: i32 = 0;

let g_aui_select_press: i32 = -1;

// v1.26.2：手势归属。真机 trace 里 DOWN/UP 落在不同选项或从浮层外拖进
// 选项时会误选，所以松手判断以 DOWN 的目标为准；位移超过 8 dp 算拖动。
let g_aui_select_down: i32 = -3;

let g_aui_select_dx: i32 = 0;

let g_aui_select_dy: i32 = 0;

let g_aui_select_drag: i32 = 0;

let g_aui_select_px: i32 = 0;

let g_aui_select_py: i32 = 0;

let g_aui_select_pw: i32 = 0;

let g_aui_select_ph: i32 = 0;

let g_aui_select_vis: i32 = 0;

// ---- 可编辑组合框（v1.44）----
// combo 是普通布局里的容器（kind 49），建议项（kind 50）始终作为子节点
// 存在，只有展开时才在浮层里布局/绘制/命中。文本存在与 text_field 共用
