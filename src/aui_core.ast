// W3：文件日志（从自研 runtime/log.ast 合并，M1.1）。trace.txt 只记
// 里程碑字母，查崩溃阶段够用，但看不到带时间的完整行为；aui.log
// 补上后者，两种记录并存、互不冲突。行格式与自研一致：
//   "[<ms>] <L> AUI: <msg>\n"
// <ms> 是单调时钟毫秒（i64，见 M1.2b 的教训：不用 i32 存时间戳）；
// <L> 是 Android 优先级字母（V/D/I/W/E）。两个文件：内部 files
// 目录（私有）+ 外部 files 目录（用户可用文件应用复制）。每行都
// open/write/close，不跨帧持 fd，崩溃最多丢一行。每个文件 128 KiB
// 轮转：追加前文件已超上限就先截断（最旧的行丢掉，最新的留下）。
// 同时镜像到 logcat（__android_log_print，tag AsterUI）。目录不
// 存在或路径未设置时静默跳过：日志绝不能拖垮应用。
let g_aui_log_path1: u8[256] = 0;

let g_aui_log_path2: u8[256] = 0;

