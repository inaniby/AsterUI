let g_aui_lp_diag_idle: i32 = 0;

let g_aui_diag_moves: i32 = 0;

let g_aui_diag_moves_last: i32 = 0;

// v2.7.2：上帧两阶段耗时（ms）：rp = 光栅/直搬（fb_do_blit 或 draw_cmds），
// cp = 窗口拷贝（fb_copy_win）。c = rp + cp（毫秒取整，约等于）。
// v2.7.3：rp 再拆分——sh = 直搬移位（fb_shift_rows/cols），
// re = 命令重放（fb_replay / draw_cmds）。直搬帧 sh + re ≈ rp；
// 整屏帧 sh = 0、re = rp（draw_cmds 全是重放）。
let g_aui_diag_rp_ms: i32 = 0;

