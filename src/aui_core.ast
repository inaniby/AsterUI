// 注意：此声明必须保留。拿掉它，clock_ns() 的调用会直接走编译器
// clock_gettime 内建（无声明调用无视其他文件的同名定义，双文件
// 探针已证），无头测试的假时钟 fake_set_clock（fake_ndk.ast 的
// clock_gettime 定义）随之失效。Linux 侧由 fbdev.ast 的 wrapper
// 转发到内建（见 src/linux/fbdev.ast）；Android .so 走 libc。
extern fn clock_gettime(clk: i32, tp: ptr) : i32;

// v2.7.2：libc memcpy/memmove（bionic/glibc，NEON）。n 必须是 i64：
// C 的 size_t 是 64 位，i32 会让 libc 读到 x2 上半的垃圾。真机滚动
// 每帧两段 13 MB 拷贝走这里；headless 下 fake_ndk.ast 提供同名
// stub（Aster 循环），静态链接不受影响。注意：不要把名字改回
// mem_copy_bytes——那是 stdlib 的字节循环（已在 v2.7.2 改名让位）。
extern fn memcpy(dst: ptr, src: ptr, n: i64) : ptr;

extern fn memmove(dst: ptr, src: ptr, n: i64) : ptr;

extern fn lrintf() : i32;

extern fn AConfiguration_new() : ptr;

extern fn AConfiguration_fromAssetManager(cfg: ptr, assets: ptr) : i32;

extern fn AConfiguration_getDensity(cfg: ptr) : i32;

extern fn AConfiguration_getUiModeNight(cfg: ptr) : i32;

extern fn AConfiguration_delete(cfg: ptr) : i32;

fn fx(v: i32) : i32 { return v << 16; }

fn fx_mul(a: i32, b: i32) : i32 {
    let t: i64 = i64(a);
    let u: i64 = i64(b);
    let p: i64 = t * u;
    return i32(p >> 16);
}

fn fx_div(a: i32, b: i32) : i32 {
    let t: i64 = i64(a);
    let u: i64 = i64(b);
    let n: i64 = t * 65536;
    return i32(n / u);
}

fn fx_px(v: i32) : i32 {
    if (v >= 0) { return (v + 32768) >> 16; }
    return -((0 - v + 32768) >> 16);
}

fn node_at(i: i32) : ptr<AuiNode> {
    return g_aui_nodes + i * sizeof(AuiNode);
}

fn cmd_at(i: i32) : ptr<AuiCmd> {
    return g_aui_cmds + i * sizeof(AuiCmd);
}

// 5b. 可诊断错误与帧区度量（Phase 0 真正回收）
// 容量耗尽不再静默：最近一次错误码，0 = 无错误。错误码段见 CONTRACT.md §3
// （A-100–A-199 归 AsterUI 运行时）：A-10x 内存与容量，A-12x 线程与回调。
let g_aui_last_err: i32 = 0;

let AUI_ERR_NODE_FULL: i32 = 100;

let AUI_ERR_CMD_FULL: i32 = 101;

let AUI_ERR_NUM_OVERFLOW: i32 = 102;

let AUI_ERR_TABLE_FULL: i32 = 103;

let AUI_ERR_LINE_TRUNC: i32 = 104;

fn aui_set_err(code: i32) : i32 {
    g_aui_last_err = code;
    return code;
}

fn aui_last_error() : i32 { return g_aui_last_err; }

fn aui_clear_error() : i32 {
    g_aui_last_err = 0;
    return 0;
}

fn node_alloc(kind: i32, key: i32) : i32 {
    if (g_aui_node_count >= AUI_NODE_CAP) { let e: i32 = aui_set_err(AUI_ERR_NODE_FULL); return -1; }
    // v2.6：Canvas 绘制回调里不许建节点。回调在 paint_node 中途执行，
    // 此时新建节点会挂进正在绘制的保留树（子节点遍历已开始），属于
    // 合同越界：拒绝，不静默兜底。
    if (g_aui_in_cv != 0) { return -1; }
    g_aui_last_closed = -1;      // 新节点之后 aui_tooltip 回到“最近创建”语义
    let i: i32 = g_aui_node_count;
    g_aui_node_count = g_aui_node_count + 1;
    let n: ptr<AuiNode> = node_at(i);
    n.kind = kind;
    n.flags = 0;
    n.key = key;
    n.parent = -1;
    n.first_child = -1;
    n.next_sibling = -1;
    n.x = 0; n.y = 0; n.w = 0; n.h = 0;
    n.pad = 0;
    n.gap = 0;
    n.weight = 0;
    n.align = 0;
    n.bg = 0;
    n.radius = 0;
    n.aux = -1;
    n.aux2 = 0;
    n.text = g_aui_null;
    n.cb = 0;
    n.user = g_aui_null;
    g_aui_sem_role[i] = 0;   // v2.19：语义注册随节点复位（每帧重建）
    g_aui_sem_label[i] = 0;
    g_aui_sem_hide[i] = 0;
    g_d2a_size_w[i] = -1;     // D-2a：修饰值随节点复位（每帧重建）
    g_d2a_size_h[i] = -1;
    g_d2a_text_sp[i] = -1;
    g_d2a_fg[i] = 0;
    g_d2a_fg_set[i] = 0;
    g_d2a_sel[i] = 0;
    return i;
}

fn attach_child(child: i32) : i32 {
    if (child < 0) { return -1; }
    let par: i32 = g_aui_stk_parent[g_aui_depth];
    let last: i32 = g_aui_stk_last[g_aui_depth];
    let cn: ptr<AuiNode> = node_at(child);
    cn.parent = par;
    cn.next_sibling = -1;
    if (last < 0) {
        let pn: ptr<AuiNode> = node_at(par);
        pn.first_child = child;
    } else {
        let ln: ptr<AuiNode> = node_at(last);
        ln.next_sibling = child;
    }
    g_aui_stk_last[g_aui_depth] = child;
    return child;
}

fn push_container(kind: i32, key: i32) : i32 {
    let i: i32 = node_alloc(kind, key);
    if (i < 0) { return -1; }
    let r: i32 = attach_child(i);
    if (g_aui_depth < AUI_STACK_MAX) {
        g_aui_depth = g_aui_depth + 1;
        g_aui_stk_parent[g_aui_depth] = i;
        g_aui_stk_last[g_aui_depth] = -1;
    }
    g_aui_last_created = i;
    return i;
}

fn push_leaf(kind: i32, key: i32) : i32 {
    let i: i32 = node_alloc(kind, key);
    if (i < 0) { return -1; }
    let r: i32 = attach_child(i);
    g_aui_last_created = i;
    return i;
}

fn modify_target() : ptr<AuiNode> {
    if (g_aui_last_created < 0) { return 0; }
    return node_at(g_aui_last_created);
}

fn isqrt(v: i32) : i32 {
    if (v <= 0) { return 0; }
    let x: i32 = v;
    let y: i32 = (x + 1) / 2;
    while (y < x) {
        x = y;
        y = (x + v / x) / 2;
    }
    return x;
}

fn aui_state_get(key: i32) : i32 {
    let i: i32 = 0;
    while (i < g_aui_state_used) {
        if (g_aui_state_key[i] == key) { return g_aui_state_val[i]; }
        i = i + 1;
    }
    return 0;
}

fn aui_state_set(key: i32, value: i32) : i32 {
    let i: i32 = 0;
    while (i < g_aui_state_used) {
        if (g_aui_state_key[i] == key) {
            g_aui_state_val[i] = value;
            return 0;
        }
        i = i + 1;
    }
    if (g_aui_state_used < AUI_STATE_CAP) {
        g_aui_state_key[g_aui_state_used] = key;
        g_aui_state_val[g_aui_state_used] = value;
        g_aui_state_used = g_aui_state_used + 1;
    } else {
        // Phase 0：满表不再静默丢弃，记可诊断错误 A-103。
        let e: i32 = aui_set_err(AUI_ERR_TABLE_FULL);
    }
    return 0;
}

// Phase 0：显式释放一个 state 槽位（末尾槽换位填补，1 = 释放了一个，
// 0 = key 不存在）。state 表其余语义不变。
fn aui_state_release(key: i32) : i32 {
    let i: i32 = 0;
    while (i < g_aui_state_used) {
        if (g_aui_state_key[i] == key) {
            let last: i32 = g_aui_state_used - 1;
            g_aui_state_key[i] = g_aui_state_key[last];
            g_aui_state_val[i] = g_aui_state_val[last];
            g_aui_state_key[last] = 0;
            g_aui_state_val[last] = 0;
            g_aui_state_used = g_aui_state_used - 1;
            return 1;
        }
        i = i + 1;
    }
    return 0;
}
